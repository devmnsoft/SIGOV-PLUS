using Microsoft.AspNetCore.Mvc;&#xD;
[xUnit.net 00:00:00.51]       using Sigov.Application.Agro.Transparencia;&#xD;
[xUnit.net 00:00:00.51]       using Sigov.Application.Common;&#xD;
[xUnit.net 00:00:00.51]       &#xD;
[xUnit.net 00:00:00.51]       namespace Sigov.Api.Controllers;&#xD;
[xUnit.net 00:00:00.51]       &#xD;
[xUnit.net 00:00:00.51]       [ApiController, Route("api/publico/agro/{tenantSlug}")]&#xD;
[xUnit.net 00:00:00.51]       // Endpoints: api/publico/agro/{tenantSlug}/datasets e downloads publicados.&#xD;
[xUnit.net 00:00:00.51]       public sealed class AgroDadosAbertosController : ControllerBase&#xD;
[xUnit.net 00:00:00.51]       {&#xD;
[xUnit.net 00:00:00.51]           private readonly IAgroTransparenciaService _service;&#xD;
[xUnit.net 00:00:00.51]           public AgroDadosAbertosController(IAgroTransparenciaService service) =&gt; _service = service;&#xD;
[xUnit.net 00:00:00.51]           [HttpGet("datasets")] public async Task&lt;IActionResult&gt; Datasets(string tenantSlug, CancellationToken ct) { var result = await _service.ListarPublicosAsync(tenantSlug, ct).ConfigureAwait(false); return result.IsSuccess ? Ok(ApiResponse&lt;IReadOnlyCollection&lt;AgroDatasetPublicoResponse&gt;&gt;.Ok(result.Value!)) : NotFound(ApiResponse&lt;object&gt;.Fail(result.Error ?? "Não encontrado.")); }&#xD;
[xUnit.net 00:00:00.51]           [HttpGet("datasets/{codigo}/download.csv")] public Task&lt;IActionResult&gt; Csv(string tenantSlug, string codigo, CancellationToken ct) =&gt; Download(tenantSlug, codigo, "CSV", "text/csv", $"{codigo}.csv", ct);&#xD;
[xUnit.net 00:00:00.51]           [HttpGet("datasets/{codigo}/download.json")] public Task&lt;IActionResult&gt; DownloadJson(string tenantSlug, string codigo, CancellationToken ct) =&gt; Download(tenantSlug, codigo, "JSON", "application/json", $"{codigo}.json", ct);&#xD;
[xUnit.net 00:00:00.51]           [HttpGet("datasets/{codigo}/download.geojson")] public Task&lt;IActionResult&gt; GeoJson(string tenantSlug, string codigo, CancellationToken ct) =&gt; Download(tenantSlug, codigo, "GEOJSON", "application/geo+json", $"{codigo}.geojson", ct);&#xD;
[xUnit.net 00:00:00.51]           private async Task&lt;IActionResult&gt; Download(string tenantSlug, string codigo, string formato, string contentType, string fileName, CancellationToken ct) { var result = await _service.DownloadPublicoAsync(tenantSlug, codigo, formato, HttpContext.Connection.RemoteIpAddress?.ToString(), Request.Headers["User-Agent"].ToString(), ct).ConfigureAwait(false); if (result.IsFailure || result.Value is null) return NotFound(ApiResponse&lt;object&gt;.Fail(result.Error ?? "Dataset publicado não encontrado.")); return File(System.Text.Encoding.UTF8.GetBytes(result.Value.ConteudoTexto ?? string.Empty), contentType, fileName); }&#xD;
[xUnit.net 00:00:00.51]       }&#xD;
