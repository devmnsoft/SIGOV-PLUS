      <Output>
        <ErrorInfo>
          <Message>Expected Sidebar "@inject Sigov.Web.Services.IMenuPermissionService MenuPermissions&#xD;
@{&#xD;
  var path = Context.Request.Path.Value ?? string.Empty;&#xD;
  Func&lt;string, string&gt; active = url =&gt; path.StartsWith(url, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty;&#xD;
  Func&lt;string[], string&gt; opened = urls =&gt; urls.Any(url =&gt; path.StartsWith(url, StringComparison.OrdinalIgnoreCase)) ? "open" : string.Empty;
  var claims = User.Claims.Where(c =&gt; c.Type is "permission" or "permissions" or "scope").SelectMany(c =&gt; c.Value.Split(new[]{' ',',',';'}, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)).ToArray();
  Func&lt;string, bool&gt; hasPermission = permission =&gt; claims.Contains(permission, StringComparer.OrdinalIgnoreCase);
  Func&lt;string, bool&gt; hasModule = module =&gt; User.Claims.Any(c =&gt; c.Type == "module" &amp;&amp; string.Equals(c.Value, module, StringComparison.OrdinalIgnoreCase));
  var canSeeEnterprisePurchasing = User.IsInRole("ADMIN_GERAL") || User.IsInRole("ADMIN_TENANT") || claims.Contains("compras_empresariais.dashboard.visualizar", StringComparer.OrdinalIgnoreCase);
  var canSeeSecurity = MenuPermissions.CanSeeModule(User, "seguranca");
  var canSeeAudit = MenuPermissions.CanSeeModule(User, "auditoria-lgpd");
  var canSeeGovernanca = User.IsInRole("ADMIN_GERAL") || User.IsInRole("ADMIN_TENANT") || User.IsInRole("ADMINISTRADOR_GERAL") || User.IsInRole("AUDITOR") || claims.Any(c =&gt; c.StartsWith("governanca.", StringComparison.OrdinalIgnoreCase));
  var canSeeIndustry = hasModule("industria_producao") &amp;&amp; hasModule("core") &amp;&amp; hasModule("estoque_compras") &amp;&amp; claims.Any(c =&gt; c.StartsWith("industria.", StringComparison.OrdinalIgnoreCase));
  var canSeeAnyEnterprise = canSeeIndustry || new[] { "comercial", "ordem_servico", "estoque_compras", "manutencao_industrial" }.Any(codigo =&gt; MenuPermissions.CanSeeModule(User, codigo));
  var globalRoles = new[] { "ADMINISTRADOR_GERAL", "SIGOV_ADMIN", "SUPER_ADMIN", "SUPERADMIN", "ADMIN_GERAL" };
  var isGlobalAdmin = User.Claims.Where(c =&gt; c.Type == System.Security.Claims.ClaimTypes.Role).Any(c =&gt; globalRoles.Contains(c.Value, StringComparer.OrdinalIgnoreCase));
  var hasTenantContext = User.Claims.Any(c =&gt; c.Type == "tenant_id" &amp;&amp; long.TryParse(c.Value, out var tenantId) &amp;&amp; tenantId &gt; 0);
}&#xD;
