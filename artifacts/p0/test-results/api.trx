inais/{id:long}/pontos-criticos")] public async Task&lt;ActionResult&lt;ApiResponse&lt;long&gt;&gt;&gt; CriarPonto(long id,[FromBody]AgroPontoCriticoCreateRequest r,CancellationToken ct)=&gt;FromResult(await _p.CriarAsync(id,r,ct)); [HttpPut("api/agro/pontos-criticos/{id:long}")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; AtualizarPonto(long id,[FromBody]AgroPontoCriticoCreateRequest r,CancellationToken ct)=&gt;FromResult(await _p.AtualizarAsync(id,r,ct)); [HttpPost("api/agro/pontos-criticos/{id:long}/resolver")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; ResolverPonto(long id,CancellationToken ct)=&gt;FromResult(await _p.ResolverAsync(id,ct)); [HttpGet("api/agro/ocorrencias-rurais")] public async Task&lt;ActionResult&lt;ApiResponse&lt;PagedResult&lt;AgroOcorrenciaRuralResponse&gt;&gt;&gt;&gt; Ocorrencias([FromQuery]AgroEstradaVicinalFiltro f,CancellationToken ct)=&gt;FromResult(await _o.ListarAsync(f,ct)); [HttpGet("api/agro/ocorrencias-rurais/{id:long}")] public async Task&lt;ActionResult&lt;ApiResponse&lt;AgroOcorrenciaRuralResponse&gt;&gt;&gt; Ocorrencia(long id,CancellationToken ct)=&gt;FromResult(await _o.ObterAsync(id,ct)); [HttpPost("api/agro/ocorrencias-rurais")] public async Task&lt;ActionResult&lt;ApiResponse&lt;long&gt;&gt;&gt; CriarOcorrencia([FromBody]AgroOcorrenciaRuralCreateRequest r,CancellationToken ct)=&gt;FromResult(await _o.CriarAsync(r,ct)); [HttpPut("api/agro/ocorrencias-rurais/{id:long}")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; AtualizarOcorrencia(long id,[FromBody]AgroOcorrenciaRuralCreateRequest r,CancellationToken ct)=&gt;FromResult(await _o.AtualizarAsync(id,r,ct)); [HttpPost("api/agro/ocorrencias-rurais/{id:long}/resolver")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; ResolverOcorrencia(long id,CancellationToken ct)=&gt;FromResult(await _o.ResolverAsync(id,ct)); [HttpPost("api/agro/ocorrencias-rurais/{id:long}/cancelar")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; CancelarOcorrencia(long id,CancellationToken ct)=&gt;FromResult(await _o.CancelarAsync(id,ct)); [HttpGet("api/agro/manutencoes-rurais")] public async Task&lt;ActionResult&lt;ApiResponse&lt;PagedResult&lt;AgroManutencaoRuralResponse&gt;&gt;&gt;&gt; Manutencoes([FromQuery]AgroEstradaVicinalFiltro f,CancellationToken ct)=&gt;FromResult(await _m.ListarAsync(f,ct)); [HttpPost("api/agro/manutencoes-rurais")] public async Task&lt;ActionResult&lt;ApiResponse&lt;long&gt;&gt;&gt; CriarManutencao([FromBody]AgroManutencaoRuralCreateRequest r,CancellationToken ct)=&gt;FromResult(await _m.CriarAsync(r,ct)); [HttpPost("api/agro/manutencoes-rurais/{id:long}/executar")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; ExecutarManutencao(long id,CancellationToken ct)=&gt;FromResult(await _m.ExecutarAsync(id,ct)); [HttpPost("api/agro/manutencoes-rurais/{id:long}/cancelar")] public async Task&lt;ActionResult&lt;ApiResponse&lt;object&gt;&gt;&gt; CancelarManutencao(long id,CancellationToken ct)=&gt;FromResult(await _m.CancelarAsync(id,ct)); private ActionResult&lt;ApiResponse&lt;T&gt;&gt; FromResult&lt;T&gt;(Result&lt;T&gt; r){if(r.IsSuccess&amp;&amp;r.Value is not null)return Ok(ApiResponse&lt;T&gt;.Ok(r.Value)); if(r.Error=="403")return Forbid(); if(r.Error?.Contains("autenticado",StringComparison.OrdinalIgnoreCase)==true)return Unauthorized(ApiResponse&lt;T&gt;.Fail(r.Error)); if(r.Error?.Contains("não encontr",StringComparison.OrdinalIgnoreCase)==true)return NotFound(ApiResponse&lt;T&gt;.Fail(r.Error)); return UnprocessableEntity(ApiResponse&lt;T&gt;.Fail(r.Error??"Requisição inválida."));} private ActionResult&lt;ApiResponse&lt;object&gt;&gt; FromResult(Result r){if(r.IsSuccess)return Ok(ApiResponse&lt;object&gt;.Ok(new{ok=true})); if(r.Error=="403")return Forbid(); if(r.Error?.Contains("autenticado",StringComparison.OrdinalIgnoreCase)==true)return Unauthorized(ApiResponse&lt;object&gt;.Fail(r.Error)); return UnprocessableEntity(ApiResponse&lt;object&gt;.Fail(r.Error??"Requisição inválida."));}}&#xD;
