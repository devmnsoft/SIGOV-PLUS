[xUnit.net 00:00:00.52]           private async Task&lt;IActionResult&gt; Export(string dataset, string formato, CancellationToken ct) { var result = await _export.ExportarAsync(new AgroExportRequest(dataset, formato), ct).ConfigureAwait(false); if (result.IsFailure || result.Value is null) return result.Error == "403" ? Forbid() : BadRequest(ApiResponse&lt;object&gt;.Fail(result.Error ?? "Exportação inválida.")); return File(System.Text.Encoding.UTF8.GetBytes(result.Value.Content), result.Value.ContentType, result.Value.FileName); }&#xD;
[xUnit.net 00:00:00.52]           private ActionResult&lt;ApiResponse&lt;T&gt;&gt; FromResult&lt;T&gt;(Result&lt;T&gt; result) { if (result.IsSuccess &amp;&amp; result.Value is not null) return Ok(ApiResponse&lt;T&gt;.Ok(result.Value)); if (result.Error == "403") return Forbid(); if (result.Error?.Contains("autenticado", StringComparison.OrdinalIgnoreCase) == true) return Unauthorized(ApiResponse&lt;T&gt;.Fail(result.Error)); return BadRequest(ApiResponse&lt;T&gt;.Fail(result.Error ?? "Requisição inválida.")); }&#xD;
