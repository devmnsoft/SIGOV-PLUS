# Copie para .env e injete a credencial somente no ambiente local/secret store.
# Contrato único consumido pela aplicação e pelos gates:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sigov;Username=sigov;Password=<injetar-localmente>;Search Path=sigov;Application Name=sigov.local

APP_ENVIRONMENT=Development
APP_HTTP_PORT=8080
APP_API_HTTP_PORT=5001
APP_HTTPS_PORT=8443
APP_STORAGE_PATH=/app/storage
DATABASE_VALIDATE_SCHEMA_ON_STARTUP=true
DATABASE_FAIL_FAST_ON_INVALID_SCHEMA=false
DATABASE_DISABLE_WORKERS_WHEN_SCHEMA_INVALID=true
SIGOV_MIGRATION_MODE=Disabled
SIGOV_RUN_MIGRATIONS=false
SIGOV_RUN_WORKER=false
