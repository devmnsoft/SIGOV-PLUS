ASPNETCORE_ENVIRONMENT=Production
POSTGRES_DB=sigov
POSTGRES_USER=sigov
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
ConnectionStrings__DefaultConnection=Host=sigov-postgres;Port=5432;Database=sigov;Username=sigov;Password=REPLACE_WITH_SECRET
Sigov__Jwt__Secret=REPLACE_WITH_32_PLUS_CHARACTER_SECRET
Sigov__Security__CorsAllowedOrigins__0=https://app.example.gov.br
Sigov__Security__SwaggerEnabledInProduction=false
Sigov__Seed__Demo=false

# Disabled não abre o MigrationRunner; ValidateOnly apenas valida; ApplyPending exige autorização.
SIGOV_MIGRATION_MODE=Disabled
SIGOV_RUN_MIGRATIONS=false
SIGOV_RUN_WORKER=false
OcrWorker__Enabled=false
PreviewWorker__Enabled=false
