ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=sigov
POSTGRES_USER=sigov
POSTGRES_PASSWORD=sigov_dev_password
ConnectionStrings__DefaultConnection=Host=sigov-postgres;Port=5432;Database=sigov;Username=sigov;Password=sigov_dev_password
Sigov__Seed__Demo=true
Sigov__Tenant__AllowHeaderResolution=true
Sigov__Tenant__AllowQueryStringResolution=true
Sigov__Jwt__Secret=development-only-jwt-secret-change-before-production

# Disabled não abre o MigrationRunner; ValidateOnly apenas valida; ApplyPending exige autorização.
SIGOV_MIGRATION_MODE=Disabled
SIGOV_RUN_MIGRATIONS=false
SIGOV_RUN_WORKER=false
OcrWorker__Enabled=false
PreviewWorker__Enabled=false
