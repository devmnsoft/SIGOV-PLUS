{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=123456;Pooling=true;Maximum Pool Size=50;Minimum Pool Size=0;Timeout=30;Command Timeout=60;Search Path=sigov;Application Name=sigov.api"
},
  "Sigov": {
    "Database": {
      "Schema": "sigov",
      "RunMigrationsOnStartup": false,
      "MigrationsPath": "/app/database/postgres/migrations"
    },
    "Storage": {
      "Provider": "Local",
      "LocalPath": "/app/storage",
      "MaxUploadBytes": 10485760
    },
    "Security": {
      "SwaggerEnabledInProduction": false
    }
  },
  "OcrWorker": {
    "Enabled": false
  },
  "PreviewWorker": {
    "Enabled": false
  },
  "Workers": {
    "LoanOverdue": {
      "Enabled": false
    }
  },
  "Database": {
    "ValidateSchemaOnStartup": true,
    "FailFastOnInvalidSchema": false,
    "DisableWorkersWhenSchemaInvalid": true
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "sigov-api"
    }
  }
}
