@model Sigov.Application.Patrimonio.PatrimonioBemDto
@{ViewData["Title"]=$"Bem {Model.CodigoTombo}";}
<link rel="stylesheet" href="~/css/patrimonio.css"/><div class="patrimonio-shell narrow"><div class="page-heading"><div><span class="eyebrow">Tombo @Model.CodigoTombo</span><h1>@Model.Descricao</h1><span class="status status-@Model.Situacao.ToLowerInvariant()">@Model.Situacao</span></div><div><a class="btn btn-outline-dark" href="/Patrimonio/Bens/@Model.Id/TermoResponsabilidade">Emitir termo</a> <a class="btn btn-outline-primary" href="/Patrimonio/Bens/@Model.Id/Editar">Editar</a> <a class="btn btn-light" href="/Patrimonio/Bens">Voltar</a></div></div>
<div class="row g-3"><div class="col-lg-7"><section class="panel"><h2>Dados do bem</h2><dl class="detail-grid"><dt>Tipo</dt><dd>@Model.TipoBem</dd><dt>Categoria</dt><dd>@(Model.Categoria??"—")</dd><dt>Marca / modelo</dt><dd>@Model.Marca @Model.Modelo</dd><dt>Série</dt><dd>@(Model.NumeroSerie??"—")</dd><dt>Conservação</dt><dd>@Model.EstadoConservacao</dd><dt>Localização</dt><dd>@(Model.Localizacao??"—")</dd><dt>Unidade / setor</dt><dd>@Model.UnidadeId / @Model.SetorId</dd><dt>Responsável</dt><dd>@Model.ResponsavelUsuarioId</dd><dt>Valor atual</dt><dd>@Model.ValorAtual?.ToString("C")</dd></dl></section></div><div class="col-lg-5"><section class="panel"><h2>Movimentar</h2><form method="post" action="/Patrimonio/Bens/@Model.Id/Movimentar" data-confirm="Confirma a movimentação deste bem?">@Html.AntiForgeryToken()<input type="hidden" name="TipoMovimentacao" value="TRANSFERENCIA"/><input class="form-control mb-2" name="UnidadeDestinoId" type="number" placeholder="Unidade destino"/><input class="form-control mb-2" name="ResponsavelDestinoId" type="number" placeholder="Novo responsável"/><input class="form-control mb-2" name="LocalizacaoDestino" placeholder="Nova localização"/><textarea class="form-control mb-2" name="Justificativa" required placeholder="Justificativa obrigatória"></textarea><button class="btn btn-primary w-100" @(Model.Situacao=="BAIXADO"?"disabled":null)>Registrar movimentação</button></form></section><section class="panel mt-3 danger-panel"><h2>Baixa patrimonial</h2><form method="post" action="/Patrimonio/Bens/@Model.Id/Baixar" data-confirm="A baixa impede movimentações futuras. Confirma?">@Html.AntiForgeryToken()<select name="TipoBaixa" class="form-select mb-2" required><option value="">Tipo</option><option>ALIENACAO</option><option>INSERVIBILIDADE</option><option>PERDA</option><option>DOACAO</option></select><input name="DataBaixa" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control mb-2" required/><input name="ValorBaixa" type="number" min="0" step=".01" class="form-control mb-2" placeholder="Valor"/><textarea name="Justificativa" class="form-control mb-2" required placeholder="Justificativa obrigatória"></textarea><button class="btn btn-outline-danger w-100" @(Model.Situacao=="BAIXADO"?"disabled":null)>Registrar baixa</button></form></section></div></div></div><script src="~/js/patrimonio.js"></script>
