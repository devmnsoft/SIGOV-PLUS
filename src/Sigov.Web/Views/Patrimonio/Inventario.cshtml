@model Sigov.Application.Patrimonio.PatrimonioInventarioDetalhe
@{ ViewData["Title"] = $"Inventário {Model.Inventario.Codigo}"; }
<link rel="stylesheet" href="~/css/patrimonio.css"/>
<div class="patrimonio-shell">
  <nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Patrimonio">Patrimônio</a></li><li class="breadcrumb-item"><a href="/Patrimonio/Inventarios">Inventários</a></li><li class="breadcrumb-item active">@Model.Inventario.Codigo</li></ol></nav>
  <div class="page-heading">
    <div><span class="eyebrow">@Model.Inventario.Situacao</span><h1>@Model.Inventario.Descricao</h1><p>Escopo: <strong>@(Model.Inventario.UnidadeNome ?? "Todas as unidades")</strong> · Responsável: <strong>@(Model.Inventario.ResponsavelNome ?? "Todos os responsáveis")</strong> · @Model.Inventario.Conferidos de @Model.Inventario.TotalItens conferidos · @Model.Inventario.Divergencias divergência(s)</p></div>
    @{ var pendentes = Model.Inventario.TotalItens - Model.Inventario.Conferidos; }
    @if ((bool)ViewBag.PodeFechar && Model.Inventario.Situacao == "ABERTO")
    {
      <form method="post" action="/Patrimonio/Inventarios/@Model.Inventario.Id/Fechar" data-confirm="Fechar definitivamente o inventário? Itens sem conferência bloqueiam o fechamento.">
        @Html.AntiForgeryToken()
        <button class="btn btn-dark" @(pendentes>0?"disabled":null) title="@(pendentes>0?$"{pendentes} item(ns) sem conferência":"Fechar campanha")">@(pendentes>0?$"Fechar ({pendentes} pendente(s))":"Fechar inventário")</button>
      </form>
    }
  </div>
  @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
  @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
  <section class="panel">
    <h2>Conferência física</h2>
    @foreach (var x in Model.Itens)
    {
      <form method="post" action="/Patrimonio/Inventarios/@Model.Inventario.Id/Itens/@x.Id/Conferir" class="inventory-row">
        @Html.AntiForgeryToken()
        <div><b>@x.CodigoTombo</b><span>@x.Descricao</span><small>Cadastro: @x.EstadoCadastro · @(x.LocalizacaoCadastro ?? "sem localização")@(x.ConferidoEm is DateTimeOffset d ? $" · conferido em {d.ToLocalTime():g}" : "")</small></div>
        <select name="Localizado" class="form-select" aria-label="Localizado @x.CodigoTombo">
          <option value="true" selected="@(x.Localizado != false)">Localizado</option>
          <option value="false" selected="@(x.Localizado == false)">Não localizado</option>
        </select>
        <select name="EstadoInformado" class="form-select" aria-label="Estado encontrado @x.CodigoTombo">
          <option value="@x.EstadoCadastro">@x.EstadoCadastro</option>
          @foreach (var e in new[] { "NOVO", "BOM", "REGULAR", "RUIM", "INSERVIVEL" })
          {
            if (!string.Equals(e, x.EstadoCadastro, StringComparison.OrdinalIgnoreCase))
            {
              <option value="@e" selected="@(string.Equals(x.EstadoInformado, e, StringComparison.OrdinalIgnoreCase))">@e</option>
            }
          }
        </select>
        <input name="LocalizacaoInformada" value="@(x.LocalizacaoInformada ?? x.LocalizacaoCadastro)" class="form-control" placeholder="Localização encontrada" aria-label="Localização encontrada @x.CodigoTombo" />
        <input name="DescricaoDivergencia" value="@x.DescricaoDivergencia" class="form-control" placeholder="Descrição da divergência" aria-label="Divergência @x.CodigoTombo" />
        <button class="btn btn-sm @(x.Divergencia ? "btn-warning" : "btn-outline-primary")" @((!(bool)ViewBag.PodeConferir || Model.Inventario.Situacao != "ABERTO") ? "disabled" : null)>Salvar</button>
      </form>
    }
    @if (Model.Itens.Count == 0) { <div class="empty">O escopo selecionado não possui bens ativos.</div> }
    <details class="how-to"><summary>Como usar esta tela</summary><p>Informe se o bem foi localizado, o estado e a localização encontrados. O servidor calcula a divergência. Inventário fechado não aceita nova conferência. Permissão de conferência é independente da abertura.</p></details>
  </section>
</div>
<script src="~/js/patrimonio.js"></script>
