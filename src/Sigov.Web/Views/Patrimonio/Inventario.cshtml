@model Sigov.Application.Patrimonio.PatrimonioInventarioDetalhe
@{ViewData["Title"]=$"Inventário {Model.Inventario.Codigo}";}<link rel="stylesheet" href="~/css/patrimonio.css"/><div class="patrimonio-shell"><div class="page-heading"><div><span class="eyebrow">@Model.Inventario.Situacao</span><h1>@Model.Inventario.Descricao</h1><p>@Model.Inventario.Conferidos de @Model.Inventario.TotalItens conferidos · @Model.Inventario.Divergencias divergências</p></div>@if((bool)ViewBag.PodeFechar&&Model.Inventario.Situacao=="ABERTO"){<form method="post" action="/Patrimonio/Inventarios/@Model.Inventario.Id/Fechar" data-confirm="Fechar definitivamente o inventário?">@Html.AntiForgeryToken()<button class="btn btn-dark">Fechar inventário</button></form>}</div><section class="panel"><h2>Conferência física</h2>@foreach(var x in Model.Itens){<form method="post" action="/Patrimonio/Inventarios/@Model.Inventario.Id/Itens/@x.Id/Conferir" class="inventory-row">@Html.AntiForgeryToken()<div><b>@x.CodigoTombo</b><span>@x.Descricao</span><small>Cadastro: @x.EstadoCadastro · @(x.LocalizacaoCadastro??"sem localização")</small></div><select name="Localizado" class="form-select"><option value="true" selected="@(x.Localizado==true)">Localizado</option><option value="false" selected="@(x.Localizado==false)">Não localizado</option></select><select name="EstadoInformado" class="form-select"><option>@x.EstadoCadastro</option><option>NOVO</option><option>BOM</option><option>REGULAR</option><option>RUIM</option><option>INSERVIVEL</option></select><input name="LocalizacaoInformada" value="@x.LocalizacaoInformada" class="form-control" placeholder="Localização encontrada"/><input name="DescricaoDivergencia" value="@x.DescricaoDivergencia" class="form-control" placeholder="Descrição da divergência"/><button class="btn btn-sm @(x.Divergencia?"btn-warning":"btn-outline-primary")" disabled="@(!(bool)ViewBag.PodeConferir||Model.Inventario.Situacao!="ABERTO")">Salvar</button></form>}@if(Model.Itens.Count==0){<div class="empty">O escopo selecionado não possui bens ativos.</div>}</section></div><script src="~/js/patrimonio.js"></script>
