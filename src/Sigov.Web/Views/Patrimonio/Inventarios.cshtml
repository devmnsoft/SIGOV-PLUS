@model Sigov.Application.Patrimonio.PatrimonioPagina<Sigov.Application.Patrimonio.PatrimonioInventarioDto>
@{ViewData["Title"]="Inventários patrimoniais";}<link rel="stylesheet" href="~/css/patrimonio.css"/><div class="patrimonio-shell"><div class="page-heading"><div><span class="eyebrow">Conferência física</span><h1>Inventários</h1><p>Campanhas e divergências do acervo real.</p></div><a href="/Patrimonio" class="btn btn-light">Dashboard</a></div>@if((bool)ViewBag.PodeCriar){<section class="panel"><h2>Abrir inventário</h2><form method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-2"><input name="Codigo" class="form-control" required placeholder="Código"/></div><div class="col-md-4"><input name="Descricao" class="form-control" required placeholder="Descrição"/></div><div class="col-md-2"><input name="UnidadeId" class="form-control" type="number" placeholder="Unidade (opcional)"/></div><div class="col-md-2"><input name="ResponsavelUsuarioId" class="form-control" type="number" placeholder="Responsável"/></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Abrir</button></div></form></section>}<section class="panel mt-3"><h2>Campanhas</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Código</th><th>Descrição</th><th>Período</th><th>Progresso</th><th>Divergências</th><th></th></tr></thead><tbody>@foreach(var i in Model.Itens){<tr><td><b>@i.Codigo</b></td><td>@i.Descricao</td><td>@i.DataAbertura.ToString("dd/MM/yyyy")</td><td>@i.Conferidos / @i.TotalItens</td><td><span class="badge text-bg-warning">@i.Divergencias</span></td><td><a class="btn btn-sm btn-outline-primary" href="/Patrimonio/Inventarios/@i.Id">Conferir</a></td></tr>}@if(Model.Itens.Count==0){<tr><td colspan="6"><div class="empty">Nenhum inventário aberto ou encerrado.</div></td></tr>}</tbody></table></div></section></div>
