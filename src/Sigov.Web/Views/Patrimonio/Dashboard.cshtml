@model Sigov.Application.Patrimonio.PatrimonioDashboard
@{ ViewData["Title"]="Dashboard de Patrimônio"; }
<link rel="stylesheet" href="~/css/patrimonio.css" />
<div class="patrimonio-shell">
 <div class="module-hero"><div><span class="eyebrow">Gestão patrimonial</span><h1>Patrimônio público</h1><p>Visão operacional baseada nos registros do tenant atual.</p></div><div class="quick-actions"><a class="btn btn-light" href="/Patrimonio/Bens">Consultar bens</a><a class="btn btn-warning" href="/Patrimonio/Inventarios">Inventários</a></div></div>
 <div class="row g-3 my-1"><div class="col-6 col-xl-3"><div class="metric"><span>Bens ativos e baixados</span><strong>@Model.TotalBens</strong></div></div><div class="col-6 col-xl-3"><div class="metric"><span>Inventários abertos</span><strong>@Model.InventariosAbertos</strong></div></div><div class="col-6 col-xl-3"><div class="metric metric-alert"><span>Divergências pendentes</span><strong>@Model.DivergenciasPendentes</strong></div></div><div class="col-6 col-xl-3"><div class="metric"><span>Baixas no mês</span><strong>@Model.BaixasNoPeriodo</strong></div></div></div>
 <div class="row g-3 mt-1"><div class="col-lg-4"><section class="panel"><h2>Situação</h2>@foreach(var x in Model.PorSituacao){<div class="bar-row"><span>@x.Key</span><b>@x.Value</b></div>}</section></div><div class="col-lg-4"><section class="panel"><h2>Conservação</h2>@foreach(var x in Model.PorEstado){<div class="bar-row"><span>@x.Key</span><b>@x.Value</b></div>}</section></div><div class="col-lg-4"><section class="panel"><h2>Bens por unidade</h2>@foreach(var x in Model.PorUnidade){<div class="bar-row"><span>Unidade @x.Nome</span><b>@x.Total</b></div>}@if(Model.PorUnidade.Count==0){<div class="empty">Nenhum bem cadastrado.</div>}</section></div></div>
</div>
