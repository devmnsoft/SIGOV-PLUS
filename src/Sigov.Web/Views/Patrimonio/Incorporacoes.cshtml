@model Sigov.Application.Patrimonio.PatrimonioIncorporacoesPagina
@{ViewData["Title"]="Incorporações patrimoniais";}
<link rel="stylesheet" href="~/css/patrimonio.css" />
<div class="patrimonio-shell">
 <nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Patrimonio">Patrimônio</a></li><li class="breadcrumb-item active">Incorporações</li></ol></nav>
 <div class="page-heading"><div><span class="eyebrow">Compras → Almoxarifado → Patrimônio</span><h1>Recebimentos elegíveis</h1><p>Somente itens permanentes de recebimentos integrados e com saldo aceito.</p></div><a class="btn btn-outline-secondary" href="/Patrimonio/Bens">Consultar bens</a></div>
 @if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
 @if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
 <section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Origem</th><th>Fornecedor / produto</th><th>Recebido e aceito</th><th>Incorporado</th><th>Saldo</th><th>Ação</th></tr></thead><tbody>
 @foreach(var item in Model.Itens){<tr><td><strong>@item.Documento</strong><small>@item.Unidade</small></td><td>@item.Fornecedor<small>@item.Produto</small></td><td>@item.QuantidadeAceita</td><td>@item.QuantidadeIncorporada</td><td><strong>@item.SaldoElegivel</strong></td><td><details><summary class="btn btn-sm btn-primary">Incorporar</summary><form method="post" class="incorporation-form mt-3">@Html.AntiForgeryToken()<input type="hidden" name="RecebimentoItemId" value="@item.ItemId"/><input type="hidden" name="CorrelationId" value="@Guid.NewGuid().ToString("N")"/><div><label class="form-label">Quantidade *</label><input class="form-control" type="number" name="Quantidade" min="1" max="@decimal.Truncate(item.SaldoElegivel)" value="1" required/></div><div><label class="form-label">Categoria *</label><select class="form-select" name="CategoriaId" required><option value="">Selecione pelo nome</option>@foreach(var x in Model.Opcoes.Categorias){<option value="@x.Id">@x.Nome</option>}</select></div><div><label class="form-label">Unidade *</label><select class="form-select" name="UnidadeId" required><option value="">Selecione pelo nome</option>@foreach(var x in Model.Opcoes.Unidades){<option value="@x.Id">@x.Nome</option>}</select></div><div><label class="form-label">Localização *</label><input class="form-control" name="Localizacao" maxlength="300" required/></div><div><label class="form-label">Tipo *</label><input class="form-control" name="TipoBem" value="EQUIPAMENTO" required/></div><div><label class="form-label">Conservação *</label><select class="form-select" name="EstadoConservacao"><option>NOVO</option><option>BOM</option></select></div><div class="form-actions"><button class="btn btn-primary" disabled="@(!(bool)ViewBag.PodeIncorporar)">Confirmar incorporação</button></div></form></details></td></tr>}
 @if(Model.Itens.Count==0){<tr><td colspan="6"><div class="empty"><strong>Nenhum recebimento elegível.</strong><span>Itens de consumo, cancelados, pendentes ou totalmente incorporados não aparecem aqui.</span></div></td></tr>}
 </tbody></table></div><details class="how-to"><summary>Como usar</summary><p>Confirme o saldo, escolha categoria, unidade e localização por nome. O servidor revalida e bloqueia repetição ou concorrência acima do saldo.</p></details></section>
</div>
