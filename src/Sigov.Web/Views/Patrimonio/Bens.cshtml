@model Sigov.Application.Patrimonio.PatrimonioPagina<Sigov.Application.Patrimonio.PatrimonioBemDto>
@{ ViewData["Title"]="Bens patrimoniais"; }
<link rel="stylesheet" href="~/css/patrimonio.css" />
<div class="patrimonio-shell"><div class="page-heading"><div><span class="eyebrow">Patrimônio</span><h1>Bens patrimoniais</h1><p>@Model.Total registro(s), com dados pessoais minimizados.</p></div><div>@if((bool)ViewBag.PodeExportar){<a class="btn btn-outline-primary" href="/Patrimonio/Bens/Exportar">Exportar CSV seguro</a>} @if((bool)ViewBag.PodeCriar){<a class="btn btn-primary" href="/Patrimonio/Bens/Novo">+ Tombar bem</a>}</div></div>
<section class="panel"><h2>Filtros</h2><form method="get" class="row g-2"><div class="col-md-4"><input class="form-control" name="Busca" placeholder="Tombo ou descrição" /></div><div class="col-md-2"><select class="form-select" name="Situacao"><option value="">Toda situação</option><option>ATIVO</option><option>EM_MANUTENCAO</option><option>CEDIDO</option><option>NAO_LOCALIZADO</option><option>BAIXADO</option></select></div><div class="col-md-2"><input class="form-control" name="UnidadeId" type="number" placeholder="Unidade" /></div><div class="col-md-2"><input class="form-control" name="ResponsavelUsuarioId" type="number" placeholder="Responsável" /></div><div class="col-md-2 d-grid"><button class="btn btn-dark">Filtrar</button></div></form></section>
<section class="panel mt-3"><h2>Acervo</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tombo</th><th>Descrição</th><th>Categoria</th><th>Conservação</th><th>Situação</th><th>Unidade</th><th></th></tr></thead><tbody>@foreach(var b in Model.Itens){<tr><td><b>@b.CodigoTombo</b></td><td>@b.Descricao<small>@b.Marca @b.Modelo</small></td><td>@(b.Categoria??"—")</td><td>@b.EstadoConservacao</td><td><span class="status status-@b.Situacao.ToLowerInvariant()">@b.Situacao.Replace('_',' ')</span></td><td>@(b.UnidadeId?.ToString()??"—")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Patrimonio/Bens/@b.Id">Detalhe</a></td></tr>}@if(Model.Itens.Count==0){<tr><td colspan="7"><div class="empty">Nenhum bem corresponde aos filtros. Cadastre um bem ou refine a busca.</div></td></tr>}</tbody></table></div></section></div>
