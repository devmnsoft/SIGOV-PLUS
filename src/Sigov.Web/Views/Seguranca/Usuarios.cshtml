@model Sigov.Web.Models.Lote1.UsuariosAdminViewModel
@{ ViewData["Title"] = "Usuários"; ViewData["PageTitle"] = "Usuários"; ViewData["PageDescription"] = "CRUD real de usuários com Dapper, validação, máscara LGPD, modais e auditoria."; ViewData["PageServes"] = "Gerenciar acesso sem expor dados pessoais em listagens."; ViewData["PageHow"] = "Busque, cadastre, edite e confirme ações críticas nos modais."; ViewData["PageNext"] = "Revise perfis, permissões e trilhas de auditoria após alterações."; }
@await Html.PartialAsync("_PageIntro")
<section class="sigov-page-header d-flex justify-content-between mb-4"><div><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Usuários</li></ol></nav><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Usuários</h1><p class="text-muted">Ações críticas exibem confirmação e são auditadas quando a tabela de auditoria está disponível.</p></div><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#usuario-form">Novo usuário</button></section>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="collapse mb-3 @(Model.Form.Id.HasValue ? "show" : "")" id="usuario-form"><div class="card card-body"><form class="row g-3" method="post" action="@(Model.Form.Id.HasValue ? $"/Seguranca/Usuarios/{Model.Form.Id}/Editar" : "/Seguranca/Usuarios/Novo")">@Html.AntiForgeryToken()<input asp-for="Form.Id" type="hidden" /><div class="col-md-3"><label asp-for="Form.Login" class="form-label"></label><input asp-for="Form.Login" class="form-control" required /></div><div class="col-md-4"><label asp-for="Form.Email" class="form-label"></label><input asp-for="Form.Email" type="email" class="form-control" required /></div><div class="col-md-2"><label asp-for="Form.PessoaId" class="form-label"></label><input asp-for="Form.PessoaId" class="form-control" /></div><div class="col-md-3 d-flex align-items-end gap-3"><div class="form-check"><input asp-for="Form.Ativo" class="form-check-input" /><label asp-for="Form.Ativo" class="form-check-label"></label></div><div class="form-check"><input asp-for="Form.Bloqueado" class="form-check-input" /><label asp-for="Form.Bloqueado" class="form-check-label"></label></div></div><div class="col-12"><div class="alert alert-info mb-0">Esta operação será auditada. Senhas nunca são exibidas; novo usuário recebe senha temporária com troca obrigatória.</div></div><div class="col-12"><button class="btn btn-primary">Salvar usuário</button></div></form></div></div>
<form method="get" class="card card-body mb-3"><div class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label" for="Termo">Busca</label><input id="Termo" name="Termo" value="@Model.Filtro.Termo" class="form-control" placeholder="Nome, login ou e-mail" /></div><div class="col-md-3"><label class="form-label">Status</label><select name="Ativo" class="form-select"><option value="">Todos</option><option value="true">Ativo</option><option value="false">Inativo</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtrar</button></div></div></form>
<div class="card sigov-grid"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Login</th><th>E-mail</th><th>Perfil</th><th>Tenant</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach (var u in Model.Usuarios) {<tr><td>@u.Nome</td><td><code>@u.Login</code></td><td>@u.EmailMascarado</td><td><span class="badge text-bg-primary">@u.Perfil</span></td><td>@u.Tenant</td><td><span class="badge @(u.Bloqueado ? "text-bg-warning" : u.Ativo ? "text-bg-success" : "text-bg-secondary")">@u.Status</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Seguranca/Usuarios/@u.Id">Detalhes</a> <a class="btn btn-sm btn-outline-secondary" href="/Seguranca/Usuarios/@u.Id/Editar">Editar</a> <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#reset-@u.Id">Resetar</button> @if (u.Ativo) { <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#status-@u.Id">Inativar</button> } else { <form class="d-inline" method="post" action="/Seguranca/Usuarios/@u.Id/Ativar">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Ativar</button></form> }</td></tr><div class="modal fade" id="reset-@u.Id" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/Seguranca/Usuarios/@u.Id/ResetSenha">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Confirmar reset</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Esta operação será auditada e exigirá troca de senha no próximo login.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-warning">Confirmar</button></div></form></div></div><div class="modal fade" id="status-@u.Id" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/Seguranca/Usuarios/@u.Id/Inativar">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Confirmar inativação</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">O acesso será bloqueado e a operação registrada para auditoria.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-danger">Inativar</button></div></form></div></div>} @if (!Model.Usuarios.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">Nenhum usuário real encontrado.</td></tr> }</tbody></table></div></div>
