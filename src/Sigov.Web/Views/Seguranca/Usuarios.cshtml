@model Sigov.Web.Models.Lote1.UsuarioFormViewModel
@{ ViewData["Title"] = "Usuários"; 
    ViewData["PageTitle"] = "Usuários";
    ViewData["PageDescription"] = "Gerenciar usuários, perfis, tenant, status, último acesso e reset seguro de senha.";
    ViewData["PageServes"] = "Esta tela dá contexto, ações padronizadas, validação visual, fallback amigável e auditoria quando aplicável.";
    ViewData["PageHow"] = "Use busca e filtros, acione Novo/Editar/Detalhes e confirme ações sensíveis no modal.";
    ViewData["PageNext"] = "Revise permissões, auditoria, LGPD e módulos relacionados após salvar.";
}
@await Html.PartialAsync("_PageIntro")
<section class="sigov-page-header d-flex justify-content-between mb-4"><div><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Usuários</li></ol></nav><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Usuários</h1><p class="text-muted">CRUD padronizado com dados pessoais mascarados, validação, reset visual de senha e confirmação para ações destrutivas.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#usuario-modal">Novo usuário</button></section>
<form class="card card-body mb-3"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label" for="Termo">Busca</label><input id="Termo" class="form-control" placeholder="Nome, login ou e-mail" /></div><div class="col-md-2"><label class="form-label">Status</label><select class="form-select"><option>Todos</option><option>Ativo</option><option>Inativo</option></select></div><div class="col-md-3"><label class="form-label">Tenant</label><input class="form-control" placeholder="Prefeitura / Empresa" /></div><div class="col-md-2"><button type="button" class="btn btn-primary w-100" data-sigov-toast="Filtro aplicado.">Filtrar</button></div></div></form>
<div class="card sigov-grid"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Login</th><th>E-mail</th><th>Perfil</th><th>Tenant</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody><tr><td>Administrador SIGOV</td><td><code>admin</code></td><td>a***@@municipio.gov.br</td><td><span class="badge text-bg-primary">SIGOV_ADMIN</span></td><td>Município Demonstração</td><td><span class="badge text-bg-success">Ativo</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Seguranca/UsuarioDetalhe/1">Detalhes</a> <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#usuario-modal">Editar</button> <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#reset-modal">Resetar senha</button> <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#desativar-modal">Desativar</button></td></tr></tbody></table></div><div class="card-footer"><small>Auditoria preparada para criação, edição, desativação e reset. Nunca exibimos senha em produção.</small></div></div>
<div class="modal fade" id="usuario-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg"><form class="modal-content" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5 modal-title">Usuário</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body row g-3"><div class="col-md-6"><label class="form-label">Nome</label><input class="form-control" required /></div><div class="col-md-3"><label asp-for="Login" class="form-label"></label><input asp-for="Login" class="form-control" required /></div><div class="col-md-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Tenant</label><input class="form-control" required /></div><div class="col-md-4"><label class="form-label">Perfil</label><select class="form-select" required><option>SIGOV_ADMIN</option><option>GESTOR</option><option>OPERADOR</option></select></div><div class="col-md-4 form-check mt-4"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label"></label></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" data-sigov-toast="Usuário salvo com sucesso.">Salvar</button></div></form></div></div>
<div class="modal fade" id="desativar-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="h5">Confirmar desativação</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Deseja desativar este usuário? O acesso será bloqueado e a ação ficará registrada para auditoria.</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-danger" data-bs-dismiss="modal" data-sigov-toast="Usuário desativado.">Desativar</button></div></div></div></div>
<div class="modal fade" id="reset-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="h5">Reset visual de senha</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Será gerado um fluxo seguro de troca de senha no próximo login. Nenhuma senha será exibida.</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-warning" data-bs-dismiss="modal" data-sigov-toast="Reset de senha solicitado.">Confirmar reset</button></div></div></div></div>
@section Scripts { <script src="~/js/modules/seguranca.usuarios.js"></script> }
