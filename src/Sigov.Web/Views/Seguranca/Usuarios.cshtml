@model Sigov.Web.Models.Lote1.UsuarioFormViewModel
@{
    ViewData["Title"] = "Usuários";
}
<section class="sigov-page-header d-flex justify-content-between mb-4"><div><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Usuários</h1><p class="text-muted">Administração de contas, perfis, grupos, bloqueio, MFA e auditoria.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#usuario-modal">Novo usuário</button></section>
<form class="card card-body mb-3"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label" for="Termo">Busca</label><input id="Termo" class="form-control" placeholder="Login, e-mail ou pessoa" /></div><div class="col-md-2"><label class="form-label" for="Ativo">Ativo</label><select id="Ativo" class="form-select"><option>Todos</option><option>Sim</option><option>Não</option></select></div><div class="col-md-2"><label class="form-label" for="Bloqueado">Bloqueado</label><select id="Bloqueado" class="form-select"><option>Todos</option><option>Sim</option><option>Não</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtrar</button></div></div></form>
<div class="card sigov-grid"><table class="table table-hover mb-0"><thead><tr><th>Login</th><th>E-mail</th><th>Perfis</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody><tr><td>admin</td><td>a***@@municipio.gov.br</td><td><span class="badge text-bg-primary">SIGOV_ADMIN</span></td><td><span class="badge text-bg-success">Ativo</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Seguranca/UsuarioDetalhe/1">Detalhar</a> <button class="btn btn-sm btn-outline-warning">Bloquear</button> <button class="btn btn-sm btn-outline-secondary">Histórico</button></td></tr></tbody></table><div class="card-footer"><small>Não excluir/bloquear último administrador ativo; reset de senha nunca retorna senha em Production.</small></div></div>
<div class="modal fade" id="usuario-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg"><form class="modal-content" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5 modal-title">Usuário</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body row g-3"><div class="col-md-4"><label asp-for="PessoaId" class="form-label">Pessoa vinculada</label><input asp-for="PessoaId" class="form-control" /></div><div class="col-md-4"><label asp-for="Login" class="form-label"></label><input asp-for="Login" class="form-control" required /></div><div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" required /></div><div class="col-md-3 form-check ms-3"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label"></label></div><div class="col-md-3 form-check"><input asp-for="Bloqueado" class="form-check-input" /><label asp-for="Bloqueado" class="form-check-label"></label></div><div class="col-md-4 form-check"><input asp-for="DeveAlterarSenha" class="form-check-input" /><label asp-for="DeveAlterarSenha" class="form-check-label"></label></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Salvar</button></div></form></div></div>
@section Scripts { <script src="~/js/modules/seguranca.usuarios.js"></script> }
