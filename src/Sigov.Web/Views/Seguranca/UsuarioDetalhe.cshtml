@model Sigov.Web.Models.Lote1.UsuarioDetalheViewModel
@{ ViewData["Title"] = "Detalhe do usuário"; }
<section class="sigov-page-header mb-4"><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Detalhe do usuário</h1><p class="text-muted">Dados completos apenas nesta visão; listagens permanecem mascaradas para LGPD.</p></section>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="row g-3"><div class="col-lg-8"><div class="card card-body"><h2 class="h5">@Model.Nome</h2><dl class="row"><dt class="col-sm-3">Login</dt><dd class="col-sm-9"><code>@Model.Login</code></dd><dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Tenant</dt><dd class="col-sm-9">@Model.Tenant</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl><div class="btn-group flex-wrap"><a class="btn btn-outline-secondary" href="/Seguranca/Usuarios/@Model.Id/Editar">Editar</a><button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#reset-modal">Resetar senha</button><a class="btn btn-outline-primary" href="/Seguranca/HistoricoLogin">Ver histórico</a></div></div></div><div class="col-lg-4"><div class="card card-body"><h2 class="h5">LGPD e auditoria</h2><p class="text-muted">Reset, edição e ativação/inativação são operações críticas com ponto de auditoria.</p></div></div></div>
<div class="modal fade" id="reset-modal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/Seguranca/Usuarios/@Model.Id/ResetSenha">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Confirmar reset</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Esta operação será auditada e não exibirá senha ao operador.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-warning">Confirmar</button></div></form></div></div>
