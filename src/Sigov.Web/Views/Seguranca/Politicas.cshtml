@{ ViewData["Title"] = "Segurança avançada"; }
<section class="container-fluid py-3"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Segurança</li></ol></nav><span class="badge text-bg-warning">Base SaaS</span><h1 class="h3">Segurança avançada</h1><p class="text-muted">Política de senha, bloqueio por tentativas, MFA preparado, sessões, API keys mascaradas, CSRF, rate limit e auditoria.</p><div class="alert alert-info">Fallback honesto: se tabelas/configurações não existirem, nenhuma regra é simulada como ativa.</div><div class="row g-3">@foreach(var item in new[]{"Política de senha","Sessões","API keys","Tentativas de login","MFA preparado","Rate limit"}){<div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><span class="badge text-bg-secondary">Em governança</span><h2 class="h6 mt-2">@item</h2><p class="small text-muted mb-0">Auditoria e confirmação em ações críticas.</p></div></div></div>}</div></section>
