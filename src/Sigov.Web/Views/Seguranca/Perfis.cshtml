@model Sigov.Web.Models.Lote1.PerfisAdminViewModel
@{ ViewData["Title"] = "Perfis"; ViewData["PageTitle"] = "Perfis"; ViewData["PageDescription"] = "Cadastro real de perfis quando sigov.perfil existe; limitações são exibidas sem simular sucesso."; }
@await Html.PartialAsync("_PageIntro")
<section class="sigov-page-header mb-4"><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Perfis</h1><p class="text-muted">Perfis agrupam responsabilidades e serão vinculados a permissões em fluxo auditado.</p></section>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<form class="card card-body mb-3" method="post" action="/Seguranca/Perfis/Novo">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-3"><label asp-for="Form.Codigo" class="form-label"></label><input asp-for="Form.Codigo" class="form-control" required /></div><div class="col-md-4"><label asp-for="Form.Nome" class="form-label"></label><input asp-for="Form.Nome" class="form-control" required /></div><div class="col-md-5"><label asp-for="Form.Descricao" class="form-label"></label><input asp-for="Form.Descricao" class="form-control" /></div></div><div class="alert alert-info mt-3">Esta operação será auditada quando a tabela de auditoria existir.</div><button class="btn btn-primary mt-1 align-self-start">Salvar perfil</button></form><div class="card"><table class="table mb-0"><thead><tr><th>Código</th><th>Perfil</th><th>Descrição</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model.Perfis){<tr><td><code>@p.Codigo</code></td><td>@p.Nome</td><td>@p.Descricao</td><td><span class="badge @(p.Ativo?"text-bg-success":"text-bg-secondary")">@(p.Ativo?"Ativo":"Inativo")</span></td></tr>}@if(!Model.Perfis.Any()){<tr><td colspan="4" class="text-center text-muted py-4">Nenhum perfil real encontrado.</td></tr>}</tbody></table></div>
