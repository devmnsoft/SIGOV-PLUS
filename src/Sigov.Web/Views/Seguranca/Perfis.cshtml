@model Sigov.Web.Models.Lote1.PerfisAdminViewModel
@{ ViewData["Title"]="Perfis"; ViewData["PageTitle"]="Perfis de acesso"; ViewData["PageDescription"]="Cadastro real de perfis quando sigov.perfil está disponível, com feedback e auditoria best-effort."; }
@await Html.PartialAsync("_PageIntro")
<form class="card card-body mb-3" method="post" action="@(Model.Form is Sigov.Web.Models.Lote1.PerfilDetalheViewModel d && d.Id > 0 ? $"/Seguranca/Perfis/{d.Id}/Editar" : "/Seguranca/Perfis/Novo")">
@Html.AntiForgeryToken()
<div class="row g-3"><div class="col-md-3"><label asp-for="Form.Codigo" class="form-label"></label><input asp-for="Form.Codigo" class="form-control" required /></div><div class="col-md-4"><label asp-for="Form.Nome" class="form-label"></label><input asp-for="Form.Nome" class="form-control" required /></div><div class="col-md-5"><label asp-for="Form.Descricao" class="form-label"></label><input asp-for="Form.Descricao" class="form-control" /></div></div>
<div class="alert alert-info mt-3">Esta operação será auditada quando a tabela de auditoria existir. Permissões são salvas apenas quando a estrutura definitiva estiver disponível.</div>
<button class="btn btn-primary mt-1 align-self-start">@(Model.Form is Sigov.Web.Models.Lote1.PerfilDetalheViewModel ? "Atualizar perfil" : "Salvar perfil")</button>
</form>
@if(!string.IsNullOrWhiteSpace(Model.MensagemFallback)){<div class="alert alert-warning">@Model.MensagemFallback</div>}
<div class="card"><table class="table mb-0 align-middle"><thead><tr><th>Código</th><th>Perfil</th><th>Descrição</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach(var p in Model.Perfis){<tr><td><code>@p.Codigo</code></td><td>@p.Nome</td><td>@p.Descricao</td><td><span class="badge @(p.Ativo?"text-bg-success":"text-bg-secondary")">@(p.Ativo?"Ativo":"Inativo")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Seguranca/Perfis/@p.Id/Editar">Editar</a> <a class="btn btn-sm btn-outline-primary" href="/Seguranca/Perfis/@p.Id/Permissoes">Permissões</a> @if(p.Ativo){<button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#perfil-status-@p.Id">Inativar</button>}else{<form class="d-inline" method="post" action="/Seguranca/Perfis/@p.Id/Ativar">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Ativar</button></form>}<div class="modal fade" id="perfil-status-@p.Id" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/Seguranca/Perfis/@p.Id/Inativar">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Confirmar inativação</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Esta ação é crítica, será auditada e pode impactar acessos vinculados.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-danger">Inativar</button></div></form></div></div></td></tr>}@if(!Model.Perfis.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum perfil real encontrado.</td></tr>}</tbody></table></div>
