@model Sigov.Web.Models.Lote1.PerfilFormViewModel
@{ ViewData["Title"] = "Perfis"; }
<section class="sigov-page-header mb-4"><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Perfis</h1><p class="text-muted">Perfis com alteração de permissão sempre auditada.</p></section>
<form class="card card-body mb-3" method="post">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-3"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control" required /></div><div class="col-md-4"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" required /></div><div class="col-md-5"><label asp-for="Descricao" class="form-label"></label><input asp-for="Descricao" class="form-control" /></div></div><button class="btn btn-primary mt-3 align-self-start">Salvar perfil</button></form><div class="card"><table class="table mb-0"><thead><tr><th>Perfil</th><th>Permissões</th><th>Status</th></tr></thead><tbody><tr><td>Administrador do tenant</td><td>Administração, Segurança</td><td><span class="badge text-bg-success">Ativo</span></td></tr></tbody></table></div>
@section Scripts { <script src="~/js/modules/seguranca.perfis.js"></script> }
