@{
  ViewData["Title"] = "Permissões"; ViewData["PageTitle"]="Permissões"; ViewData["PageDescription"]="Matriz visual de permissões por módulo e ação."; ViewData["PageServes"]="Definir o que cada perfil pode visualizar, criar, editar, excluir e auditar."; ViewData["PageHow"]="Filtre o módulo, marque permissões e salve; alterações são auditáveis."; ViewData["PageNext"]="Teste o acesso com usuário do perfil e acompanhe auditoria.";
  var grupos = new[] { "Dashboard", "SaaS Admin", "Usuários", "Tenants", "Planos", "Módulos", "Auditoria", "Parâmetros" }; var acoes = new[] { "Visualizar", "Criar", "Editar", "Excluir", "Auditar" };
}
@await Html.PartialAsync("_PageIntro")
<div class="sigov-card p-3 mb-3"><label class="form-label" for="filtroPermissao">Buscar módulo/recurso</label><input id="filtroPermissao" class="form-control" placeholder="Ex.: auditoria, usuários, planos" /></div>
<form class="sigov-card p-3" method="post">@Html.AntiForgeryToken()<div class="table-responsive"><table class="table align-middle" id="permissoesTabela"><thead><tr><th>Módulo/Recurso</th>@foreach (var acao in acoes) { <th>@acao</th> }</tr></thead><tbody>@foreach (var g in grupos) { <tr><td><strong>@g</strong><div class="small text-muted">Permissões para @g.ToLowerInvariant()</div></td>@foreach (var acao in acoes) { <td><input class="form-check-input" type="checkbox" checked="@(acao != "Excluir")" /></td> }</tr> }</tbody></table></div><button class="sigov-btn sigov-btn--primary" type="submit" data-sigov-confirm="Salvar permissões? Esta operação só confirma se houver estrutura real.">Salvar permissões</button></form>
@section Scripts { <script>document.getElementById('filtroPermissao').addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('#permissoesTabela tbody tr').forEach(tr=>tr.style.display=tr.textContent.toLowerCase().includes(q)?'':'none')});</script><script src="~/js/modules/seguranca.permissoes.js"></script> }
