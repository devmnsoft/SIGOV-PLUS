@model Sigov.Web.Models.Lote1.PermissaoMatrixViewModel
@{ ViewData["Title"] = "Permissões"; var grupos = new[] { "Dashboard", "SaaS Admin", "Usuários", "Tenants", "Planos", "Módulos", "Auditoria", "Parâmetros" }; var acoes = new[] { "Visualizar", "Criar", "Editar", "Excluir", "Auditar" }; }
<section class="sigov-page-header mb-4"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Permissões</li></ol></nav><span class="badge text-bg-dark mb-2">Segurança</span><h1 class="h2">Perfis e permissões</h1><p class="text-muted">Matriz visual agrupada por módulo/recurso. Backend pode persistir em etapa posterior sem quebrar o fluxo.</p></section>
<div class="card card-body mb-3"><label class="form-label" for="filtroPermissao">Buscar módulo/recurso</label><input id="filtroPermissao" class="form-control" placeholder="Ex.: auditoria, usuários, planos" /></div>
<form class="card card-body" method="post">@Html.AntiForgeryToken()<div class="table-responsive"><table class="table align-middle" id="permissoesTabela"><thead><tr><th>Módulo/Recurso</th>@foreach (var acao in acoes) { <th>@acao</th> }</tr></thead><tbody>@foreach (var g in grupos) { <tr><td><strong>@g</strong><div class="small text-muted">Permissões para @g.ToLowerInvariant()</div></td>@foreach (var acao in acoes) { <td><input class="form-check-input" type="checkbox" checked="@(acao != "Excluir")" /></td> }</tr> }</tbody></table></div><button class="btn btn-primary align-self-start" data-sigov-toast="Permissões salvas com sucesso.">Salvar permissões</button></form>
@section Scripts { <script>document.getElementById('filtroPermissao').addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('#permissoesTabela tbody tr').forEach(tr=>tr.style.display=tr.textContent.toLowerCase().includes(q)?'':'none')});</script><script src="~/js/modules/seguranca.permissoes.js"></script> }
