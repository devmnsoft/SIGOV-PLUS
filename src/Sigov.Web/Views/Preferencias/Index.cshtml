@model Sigov.Application.Ui.UserPreferenceResponse
@{ ViewData["Title"] = "Preferências"; }
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel("Preferências de usuário", "Tema, página inicial, filtros salvos, atalhos e densidade da interface.", new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Início", "/"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Preferências", "/Preferencias", true) }))
<form method="post" data-sigov-form="true" data-sigov-ajax="true" class="sigov-form-shell">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label class="form-label" for="tema">Tema</label><select id="tema" class="form-select" data-sigov-preference="tema"><option value="light">Claro</option><option value="dark">Escuro</option></select></div><div class="col-md-4"><label class="form-label" for="densidade">Densidade</label><select id="densidade" class="form-select" data-sigov-preference="densidade"><option>Confortável</option><option>Compacta</option></select></div><div class="col-md-4"><label class="form-label" for="paginaInicial">Página inicial</label><input id="paginaInicial" class="form-control" value="/Executivo" data-sigov-preference="pagina-inicial"></div></div><button class="btn btn-primary mt-4" type="submit">Salvar preferências</button></form>
@section Scripts { <script src="~/js/sigov.preferences.js"></script> }
