@model Sigov.Application.Ambiental.AmbientalRegistroRequest
@{var recurso=(string?)ViewData["Recurso"]??"";ViewData["Title"]=(string?)ViewData["Titulo"]??"Cadastro ambiental";}<h1 class="h3">@ViewData["Title"]</h1><partial name="_Nav"/><div class="alert alert-info">Tipos, prazos, documentos, valores e fundamentos são parametrizáveis; valide os detalhes técnicos conforme a regulamentação local vigente.</div><form method="post" action="/MeioAmbiente/@recurso/Salvar" class="card card-body shadow-sm"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-3"><label class="form-label">Número/código</label><input asp-for="Codigo" class="form-control"/></div><div class="col-md-9"><label class="form-label">Descrição / nome *</label><input asp-for="Descricao" class="form-control" required maxlength="2000"/></div><div class="col-md-4"><label class="form-label">Status *</label><input asp-for="Status" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Valor (quando aplicável)</label><input asp-for="Valor" type="number" step="0.01" min="0" class="form-control"/></div><div class="col-md-4"><label class="form-label">Data</label><input asp-for="Data" type="date" class="form-control"/></div><div class="col-12"><label class="form-label">Justificativa de decisão/cancelamento</label><textarea asp-for="Justificativa" class="form-control"></textarea></div><div class="col-12"><label class="form-label">Campos técnicos (JSON)</label><textarea asp-for="DadosJson" class="form-control font-monospace" rows="7" required></textarea><div class="form-text">Metadados estruturados do recurso, referências documentais e parâmetros. Nenhum arquivo é armazenado no GED por esta tela.</div></div></div><div class="mt-4"><button class="btn btn-primary">Salvar e auditar</button><a class="btn btn-link" href="/MeioAmbiente/@recurso">Cancelar</a></div></form>
