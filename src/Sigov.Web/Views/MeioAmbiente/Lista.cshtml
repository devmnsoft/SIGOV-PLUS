@model Sigov.Web.Models.Ambiental.AmbientalListaViewModel
@{ViewData["Title"]=Model.Titulo;}<div class="d-flex justify-content-between"><div><h1 class="h3">@Model.Titulo</h1><p class="text-muted">Registros reais segregados por tenant e entidade.</p></div>@if(Model.Recurso!="auditoria"){<a class="btn btn-primary align-self-start" href="/MeioAmbiente/@Model.Recurso/Novo">Novo registro</a>}</div><partial name="_Nav"/>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}<form class="row g-2 mb-3"><div class="col-md-7"><input class="form-control" name="busca" value="@Model.Filtro.Busca" placeholder="Buscar"/></div><div class="col-md-3"><input class="form-control" name="status" value="@Model.Filtro.Status" placeholder="Status"/></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Data</th><th>Valor</th></tr></thead><tbody>@foreach(var x in Model.Pagina.Items){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge text-bg-secondary">@x.Status</span></td><td>@x.Data?.ToString("d")</td><td>@x.Valor?.ToString("C")</td></tr>}@if(Model.Pagina.Items.Count==0){<tr><td colspan="5" class="text-center text-muted py-5">Nenhum registro encontrado.</td></tr>}</tbody></table></div><div class="small text-muted">Página @Model.Pagina.Pagina · @Model.Pagina.Total registro(s)</div>
