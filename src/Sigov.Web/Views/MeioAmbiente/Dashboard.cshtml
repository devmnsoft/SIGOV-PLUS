@model Sigov.Application.Ambiental.AmbientalDashboard
@{ViewData["Title"]="Meio Ambiente";var cards=new[]{("Requerimentos abertos",Model.RequerimentosAbertos),("Em análise",Model.EmAnalise),("Pendências documentais",Model.PendenciasDocumentais),("Vistorias agendadas",Model.VistoriasAgendadas),("Licenças vigentes",Model.LicencasVigentes),("Licenças vencidas",Model.LicencasVencidas),("Licenças a vencer (30 dias)",Model.LicencasAVencer),("Condicionantes pendentes",Model.CondicionantesPendentes),("Condicionantes vencidas",Model.CondicionantesVencidas),("Denúncias abertas",Model.DenunciasAbertas),("Autos de infração",Model.AutosEmitidos),("Taxas pendentes",Model.TaxasPendentes)};}
<div class="d-flex justify-content-between align-items-start"><div><h1 class="h3">Meio Ambiente</h1><p class="text-muted">Licenciamento, fiscalização e condicionantes com fonte oficial no PostgreSQL.</p></div><a class="btn btn-primary" href="/MeioAmbiente/requerimentos/Novo">Novo requerimento</a></div><partial name="_Nav"/><form class="card card-body mb-4"><div class="row g-2"><div class="col-md-3"><label class="form-label">Início</label><input name="inicio" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Fim</label><input name="fim" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label">Status</label><input name="status" class="form-control" placeholder="Status"/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Aplicar</button></div></div></form><div class="row g-3">@foreach(var c in cards){<div class="col-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted small">@c.Item1</div><div class="display-6">@c.Item2</div></div></div></div>}</div>
