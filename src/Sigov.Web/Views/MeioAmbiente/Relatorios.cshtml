@{ViewData["Title"]="Relatórios ambientais";var reports=new[]{("empreendedores","Empreendedores por situação"),("empreendimentos","Empreendimentos por atividade/localidade"),("requerimentos","Requerimentos por status/tipo/período"),("documentos","Pendências documentais"),("licencas","Licenças vigentes/vencidas/a vencer"),("condicionantes","Condicionantes pendentes/vencidas"),("vistorias","Vistorias por fiscal/período"),("denuncias","Denúncias por status/tipo"),("autos","Autos e penalidades"),("taxas","Taxas ambientais"),("auditoria","Auditoria do módulo")};}<h1 class="h3">Relatórios CSV ambientais</h1><p class="text-muted">Exportações protegidas por RBAC, segregadas, neutralizadas contra fórmulas e auditadas.</p><partial name="_Nav"/><div class="row g-3">@foreach(var r in reports){<div class="col-md-6 col-xl-4"><a class="card card-body h-100 text-decoration-none" href="/MeioAmbiente/Relatorios/@r.Item1.csv"><strong>@r.Item2</strong><span class="small text-muted">Baixar CSV oficial</span></a></div>}</div>
