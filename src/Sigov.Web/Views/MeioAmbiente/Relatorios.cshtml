@{ViewData["Title"]="Relatórios ambientais";var reports=new[]{("empreendedores","Empreendedores por situação"),("empreendimentos","Empreendimentos por atividade/localidade"),("requerimentos","Requerimentos por status/tipo/período"),("documentos","Pendências documentais"),("licencas","Licenças vigentes/vencidas/a vencer"),("condicionantes","Condicionantes pendentes/vencidas"),("vistorias","Vistorias por fiscal/período"),("denuncias","Denúncias por status/tipo"),("autos","Autos e penalidades"),("taxas","Taxas ambientais"),("auditoria","Auditoria do módulo")};}<h1 class="h3">Relatórios CSV ambientais</h1><p class="text-muted">Exportações protegidas por RBAC, segregadas, neutralizadas contra fórmulas e auditadas.</p><partial name="_Nav"/><details class="card card-body mb-3 sigov-screen-guide"><summary class="fw-semibold">Como usar esta tela</summary><div class="small text-muted mt-2">Use os filtros para restringir esfera, órgão, unidades e território e escolha o relatório a exportar. A permissão ambiental de relatório é obrigatória; denúncias e documentos podem conter dados sensíveis. Após a solicitação, um CSV protegido contra fórmulas é gerado apenas com dados autorizados e a operação entra na trilha de auditoria; sem resultados, revise os filtros.</div></details><div class="row g-3">@foreach(var r in reports){<div class="col-md-6 col-xl-4"><a class="card card-body h-100 text-decoration-none" href="@Url.Action("Csv", "MeioAmbiente", new { relatorio = r.Item1 })"><strong>@r.Item2</strong><span class="small text-muted">Baixar CSV oficial</span></a></div>}</div>
