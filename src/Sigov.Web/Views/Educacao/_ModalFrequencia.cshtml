@model Sigov.Web.Models.Educacao.FrequenciaFormViewModel
@using Sigov.Application.Educacao
@{
    var turmas = ViewBag.Turmas as IEnumerable<TurmaResponse> ?? Array.Empty<TurmaResponse>();
    var alunos = ViewBag.Alunos as IEnumerable<AlunoResumoResponse> ?? Array.Empty<AlunoResumoResponse>();
    var professores = ViewBag.Professores as IEnumerable<ProfessorResponse> ?? Array.Empty<ProfessorResponse>();
}
<form id="form-frequencia" class="card card-body" data-api="/api/educacao/frequencias">
  @Html.AntiForgeryToken()
  <h2 class="h5">Lançar frequência</h2>
  <p class="text-muted">Como usar: selecione o contexto já autorizado, informe cada situação e revise antes de registrar. Nada é marcado como presente automaticamente.</p>
  <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
  <div class="row g-3">
    <div class="col-md-4">
      <label asp-for="TurmaId" class="form-label">Turma *</label>
      <select asp-for="TurmaId" class="form-select" required>
        <option value="">Selecione a turma</option>
        @foreach (var t in turmas)
        {
          <option value="@t.Id">@t.Nome (@t.Turno)</option>
        }
      </select>
      <span asp-validation-for="TurmaId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="AlunoId" class="form-label">Aluno *</label>
      <select asp-for="AlunoId" class="form-select" required>
        <option value="">Selecione o aluno</option>
        @foreach (var a in alunos)
        {
          <option value="@a.Id">Aluno @a.CodigoAluno (ID: @a.Id)</option>
        }
      </select>
      <span asp-validation-for="AlunoId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="ProfessorId" class="form-label">Professor atribuído *</label>
      <select asp-for="ProfessorId" class="form-select" required>
        <option value="">Selecione o professor</option>
        @foreach (var p in professores)
        {
          <option value="@p.Id">Docente @p.CodigoProfessor (@p.Formacao)</option>
        }
      </select>
      <span asp-validation-for="ProfessorId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="ComponenteCurricular" class="form-label">Componente curricular *</label>
      <select asp-for="ComponenteCurricular" class="form-select" required>
        <option value="">Selecione a disciplina</option>
        <option value="Língua Portuguesa">Língua Portuguesa</option>
        <option value="Matemática">Matemática</option>
        <option value="Ciências">Ciências</option>
        <option value="História">História</option>
        <option value="Geografia">Geografia</option>
        <option value="Artes">Artes</option>
        <option value="Educação Física">Educação Física</option>
        <option value="Inglês">Inglês</option>
      </select>
      <span asp-validation-for="ComponenteCurricular" class="text-danger"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="DataAula" class="form-label">Data da aula *</label>
      <input asp-for="DataAula" class="form-control" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required />
      <span asp-validation-for="DataAula" class="text-danger"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="Status" class="form-label">Situação *</label>
      <select asp-for="Status" class="form-select" required>
        <option value="NAO_LANCADO">Não lançado</option>
        <option value="PRESENTE">Presente</option>
        <option value="FALTA">Ausente</option>
        <option value="JUSTIFICADA">Ausente com justificativa</option>
        <option value="ABONADA">Abonada conforme política</option>
      </select>
    </div>
    <div class="col-12">
      <label asp-for="Justificativa" class="form-label">Justificativa</label>
      <textarea asp-for="Justificativa" class="form-control" rows="2" aria-describedby="ajuda-justificativa" placeholder="Obrigatória quando ausente com justificativa"></textarea>
      <div id="ajuda-justificativa" class="form-text">Obrigatória para ausência justificada; o sistema não cria texto fictício.</div>
    </div>
    <input asp-for="Presente" type="hidden" />
    <div class="col-12 d-flex justify-content-end">
      <button class="btn btn-primary" type="submit">Revisar e registrar frequência</button>
    </div>
  </div>
</form>
