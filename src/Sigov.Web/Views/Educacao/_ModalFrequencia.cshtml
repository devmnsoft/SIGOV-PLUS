@model Sigov.Web.Models.Educacao.FrequenciaFormViewModel
<form id="form-frequencia" class="card card-body" data-api="/api/educacao/frequencias">
  @Html.AntiForgeryToken()
  <h2 class="h5">Lançar frequência</h2>
  <p class="text-muted">Como usar: selecione o contexto já autorizado, informe cada situação e revise antes de registrar. Nada é marcado como presente automaticamente.</p>
  <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
  <div class="row g-3">
    <div class="col-md-4"><label asp-for="TurmaId" class="form-label">Turma <span aria-hidden="true">*</span></label><input asp-for="TurmaId" class="form-control" required /><span asp-validation-for="TurmaId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="AlunoId" class="form-label">Aluno <span aria-hidden="true">*</span></label><input asp-for="AlunoId" class="form-control" required /></div>
    <div class="col-md-4"><label asp-for="ProfessorId" class="form-label">Professor atribuído <span aria-hidden="true">*</span></label><input asp-for="ProfessorId" class="form-control" required /></div>
    <div class="col-md-4"><label asp-for="ComponenteCurricular" class="form-label">Componente curricular <span aria-hidden="true">*</span></label><input asp-for="ComponenteCurricular" class="form-control" required /></div>
    <div class="col-md-4"><label asp-for="DataAula" class="form-label">Data da aula <span aria-hidden="true">*</span></label><input asp-for="DataAula" class="form-control" required /></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label">Situação <span aria-hidden="true">*</span></label><select asp-for="Status" class="form-select" required><option value="NAO_LANCADO">Selecione…</option><option value="PRESENTE">Presente</option><option value="FALTA">Ausente</option><option value="JUSTIFICADA">Ausente com justificativa</option><option value="ABONADA">Abonada conforme política</option></select></div>
    <div class="col-12"><label asp-for="Justificativa" class="form-label">Justificativa</label><textarea asp-for="Justificativa" class="form-control" rows="2" aria-describedby="ajuda-justificativa"></textarea><div id="ajuda-justificativa" class="form-text">Obrigatória para ausência justificada; o sistema não cria texto fictício.</div></div>
    <input asp-for="Presente" type="hidden" />
    <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit">Revisar e registrar</button></div>
  </div>
</form>
