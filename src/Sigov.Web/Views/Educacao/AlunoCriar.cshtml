@model Sigov.Web.Models.Educacao.AlunoFormViewModel
@{ ViewData["Title"] = "Cadastrar Aluno"; }

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
    <li class="breadcrumb-item"><a href="/Educacao/Alunos">Alunos</a></li>
    <li class="breadcrumb-item active" aria-current="page">Novo</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3">Cadastrar Novo Aluno</h1>
    <p class="text-muted mb-0">Cadastro inicial de aluno a partir de pessoa já existente no tenant, com conformidade LGPD.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/Educacao/Alunos">Voltar para alunos</a>
</div>

<details class="how-to mb-3">
  <summary>Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Documento mascarado. Responsável pela lista. Matrícula ativa é única na escola/ano/série. Cadastre alunos a partir de pessoas já existentes no tenant e mantenha dados sensíveis protegidos.</p>
    <ul>
      <li><strong>Pessoa Existente:</strong> O aluno deve ser registrado com base em um cadastro prévio no registro de pessoas.</li>
      <li><strong>Código do Aluno:</strong> Identificador acadêmico único na rede municipal/estadual/federal.</li>
    </ul>
  </div>
</details>

<div id="educacao-toast" class="alert d-none" role="alert"></div>
<partial name="_FormAluno" model="Model" />
