@model Sigov.Web.Models.Educacao.MatriculaFormViewModel
@{ ViewData["Title"] = "Matrículas da Rede"; }

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
    <li class="breadcrumb-item active" aria-current="page">Matrículas</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3">Matrículas da Rede</h1>
    <p class="text-muted mb-0">Gestão das matrículas escolares, controle de vagas em turmas e histórico de transferências.</p>
  </div>
  <div class="btn-group">
    <a class="btn btn-outline-primary" href="/Educacao/Dashboard">Dashboard</a>
    <a class="btn btn-outline-secondary" href="/api/educacao/export/alunos.csv">CSV</a>
  </div>
</div>

<details class="how-to mb-3">
  <summary>Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Cancelar pede justificativa. Transferência não deixa duas ativas. Matrícula ativa é única por aluno, escola, ano letivo e série.</p>
    <ul>
      <li><strong>Unicidade da Matrícula:</strong> Tentativas de registrar segunda matrícula ativa para o mesmo aluno e ciclo anual são recusadas no serviço.</li>
      <li><strong>Cancelamento com Justificativa:</strong> Exige motivo formal não vazio e decrementa a lotação da turma atomicamente.</li>
      <li><strong>Transferência Segura:</strong> Registra a saída da turma de origem antes de ingressar na nova turma de destino.</li>
    </ul>
  </div>
</details>

<div id="educacao-toast" class="alert d-none" role="alert"></div>
<partial name="_FormMatricula" model="Model" />
<partial name="_GridMatriculas" />
@section Scripts { <script src="~/js/modules/educacao.matriculas.js"></script> }
