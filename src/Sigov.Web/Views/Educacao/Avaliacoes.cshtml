@model Sigov.Web.Models.Educacao.AvaliacaoFormViewModel
@{ ViewData["Title"] = "Avaliações e Notas"; var notaModel = new Sigov.Web.Models.Educacao.NotaFormViewModel(); }

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
    <li class="breadcrumb-item active" aria-current="page">Avaliações</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3">Avaliações e Notas</h1>
    <p class="text-muted mb-0">Cadastro de instrumentos avaliativos por componente curricular e lançamento de notas com escala e peso explícitos.</p>
  </div>
  <div class="btn-group">
    <a class="btn btn-outline-primary" href="/Educacao/Dashboard">Dashboard</a>
    <a class="btn btn-outline-secondary" href="/api/educacao/export/alunos.csv">CSV</a>
  </div>
</div>

<details class="how-to mb-3">
  <summary>Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Escala e peso vêm da avaliação. Avaliação fechada não recebe nota. Ausência de nota aparece como não lançado, não como zero.</p>
    <ul>
      <li><strong>Configuração da Avaliação:</strong> Defina o valor máximo da escala e o peso aplicável segundo o plano pedagógico.</li>
      <li><strong>Lançamento de Notas:</strong> Permitido exclusivamente para avaliações com status <code>ABERTA</code> e para alunos matriculados na turma.</li>
      <li><strong>Ausência de Média Arbitrária:</strong> Sem política avaliativa aprovada e persistida, o sistema não calcula notas médias automaticamente.</li>
    </ul>
  </div>
</details>

<div id="educacao-toast" class="alert d-none" role="alert"></div>
<partial name="_ModalAvaliacao" model="Model" />
<partial name="_ModalNota" model="notaModel" />
<div id="grid-avaliacoes" class="mt-3"></div>
@section Scripts { <script src="~/js/modules/educacao.avaliacoes.js"></script> }
