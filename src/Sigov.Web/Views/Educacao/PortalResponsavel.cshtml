@{ ViewData["Title"] = "Portal do Responsável"; }
<section class="edu-b3 portal-responsavel" aria-labelledby="portal-title">
 <header class="edu-b3__hero"><div><span class="lgpd-badge">LGPD • acesso autorizado</span><h1 id="portal-title">Portal do Responsável</h1><p>Consulte a vida escolar usando apenas vínculos conferidos e liberados pela Secretaria Escolar.</p></div><button class="btn btn-primary" type="button" data-reload>Atualizar</button></header>
 <details class="context-help"><summary>Para que serve e como funciona</summary><div><p><strong>Pré-requisito:</strong> identidade autenticada e vínculo ativo, conferido pela Secretaria.</p><p><strong>Regra importante:</strong> contato cadastral não libera o portal. A revogação bloqueia imediatamente novas consultas e downloads. Boletim parcial não é documento definitivo.</p><p><strong>Próximo passo:</strong> escolha um aluno e abra a área desejada. Cada operação revalida o vínculo.</p></div></details>
 <nav class="portal-tabs" aria-label="Áreas do portal"><a href="#visao-geral">Visão geral</a><a href="#vida-escolar">Vida escolar</a><a href="/Educacao/PortalBoletim">Boletim e documentos</a><a href="/Educacao/PortalComunicados">Comunicados</a></nav>
 <div class="filter-bar"><label for="portal-aluno">Aluno vinculado <span aria-hidden="true">*</span></label><select id="portal-aluno" required aria-describedby="portal-contexto"><option value="">Carregando vínculos…</option></select><p id="portal-contexto" role="status">Selecione um aluno para manter escola, turma e ano letivo no contexto desta aba.</p></div>
 <div data-error class="alert alert-danger" role="alert" hidden></div>
 <section id="visao-geral" aria-labelledby="visao-title"><h2 id="visao-title">Visão geral</h2><div class="edu-b3__kpis"><article><strong data-situacao>—</strong><span>Matrícula</span></article><article><strong data-frequencia>—</strong><span>Frequência lançada</span></article><article><strong data-contexto>—</strong><span>Escola, turma e ano</span></article></div></section>
 <section id="vida-escolar" class="responsive-data-table" aria-labelledby="vida-title"><h2 id="vida-title">Vida escolar</h2><div class="loading-skeleton" data-loading hidden>Consultando dados autorizados…</div><p data-empty>Escolha um aluno vinculado para consultar.</p></section>
</section>
<script>
(()=>{const root=document.querySelector('.portal-responsavel'),select=root.querySelector('#portal-aluno'),error=root.querySelector('[data-error]'),loading=root.querySelector('[data-loading]');let sequence=0,controller;
const showError=m=>{error.textContent=m;error.hidden=false};
async function alunos(){error.hidden=true;const r=await fetch('/api/educacao/portal/alunos',{credentials:'same-origin',headers:{Accept:'application/json'}});if(!r.ok)throw new Error('Os vínculos não puderam ser consultados. Procure a Secretaria Escolar.');const j=await r.json(),items=j.data??[];select.replaceChildren(new Option(items.length?'Selecione por nome':'Nenhum vínculo ativo',''));items.forEach(a=>select.add(new Option(`${a.nome} — ${a.escola??'escola não informada'} / ${a.turma??'turma não informada'}`,a.id)));if(!items.length)root.querySelector('[data-empty]').textContent='Nenhum vínculo ativo foi localizado. O portal não exibe cadastros de terceiros.';}
async function vida(){const aluno=select.value,my=++sequence;controller?.abort();controller=new AbortController();error.hidden=true;if(!aluno)return;loading.hidden=false;try{const r=await fetch(`/api/educacao/portal/alunos/${encodeURIComponent(aluno)}/vida-escolar`,{credentials:'same-origin',signal:controller.signal,headers:{Accept:'application/json'}});if(!r.ok)throw new Error('Acesso indisponível ou vínculo revogado.');const j=await r.json(),d=j.data;if(my!==sequence)return;root.querySelector('[data-situacao]').textContent=d.situacao;root.querySelector('[data-frequencia]').textContent=d.percentualFrequencia==null?'Não lançada':`${d.percentualFrequencia}%`;root.querySelector('[data-contexto]').textContent=`${d.escola} • ${d.turma} • ${d.anoLetivo}`;root.querySelector('[data-empty]').textContent=`${d.presencas} presenças e ${d.faltas} faltas em ${d.aulasLancadas} lançamentos. Atualizado em ${new Date(d.atualizadoEm).toLocaleString('pt-BR')}.`;}catch(e){if(e.name!=='AbortError')showError(e.message);}finally{if(my===sequence)loading.hidden=true;}}
select.addEventListener('change',vida);root.querySelector('[data-reload]').addEventListener('click',()=>alunos().catch(e=>showError(e.message)));alunos().catch(e=>showError(e.message));})();
</script>
