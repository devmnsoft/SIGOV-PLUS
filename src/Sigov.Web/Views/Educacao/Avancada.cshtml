@{ ViewData["Title"] = $"Educação · {ViewData["Modulo"]} · {ViewData["Pagina"]}"; }
<section class="education-advanced-shell" data-education-module="@ViewData["Modulo"]">
<header class="education-premium-header"><div><span class="lgpd-badge">LGPD · acesso protegido e auditado</span><h1>@ViewData["Modulo"]</h1><p>@ViewData["Pagina"] · gestão educacional multi-tenant com persistência real.</p></div><button class="btn btn-primary" type="button" data-sigov-toast="Painel atualizado">Atualizar</button></header>
<div class="education-kpi-grid"><article class="education-dashboard-card"><small>Total</small><strong>—</strong><span>registros do tenant</span></article><article class="education-dashboard-card"><small>Ativos</small><strong>—</strong><span>operação regular</span></article><article class="education-dashboard-card"><small>Pendências</small><strong>—</strong><span>exigem acompanhamento</span></article><article class="education-dashboard-card"><small>Alertas</small><strong>—</strong><span>regras e qualidade de dados</span></article></div>
<div class="filter-bar"><label>Busca segura<input class="form-control" type="search" placeholder="Código ou nome (sem documento completo)" /></label><label>Status<select class="form-select"><option>Todos</option><option>Ativo</option><option>Pendente</option></select></label><button class="btn btn-outline-primary" type="button">Filtrar</button></div>
<div class="responsive-data-table"><table class="table"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Atualização</th><th>Ações</th></tr></thead><tbody><tr class="empty-state"><td colspan="5"><strong>Nenhum registro para os filtros.</strong><br/><span>Cadastre o primeiro item para iniciar o fluxo.</span></td></tr></tbody></table></div>
<aside class="audit-timeline"><strong>Governança</strong><ol><li>Tenant, entidade, escola e ano letivo validados</li><li>Dados pessoais mascarados em listagens e CSV</li><li>CorrelationId, soft delete e auditoria JSONB nas mutações</li></ol></aside>
</section>
