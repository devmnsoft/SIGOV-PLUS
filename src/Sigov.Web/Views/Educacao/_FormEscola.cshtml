@model Sigov.Web.Models.Educacao.EscolaFormViewModel
<form id="form-escola" class="card card-body" data-api="/api/educacao/escolas">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
  <div class="row g-3">
    <div class="col-md-2">
      <label asp-for="Codigo" class="form-label">Código *</label>
      <input asp-for="Codigo" class="form-control" required maxlength="50" placeholder="Ex: ESC-001" />
      <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="Nome" class="form-label">Nome da escola *</label>
      <input asp-for="Nome" class="form-control" required maxlength="200" placeholder="Nome oficial da unidade" />
      <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="col-md-2">
      <label asp-for="TipoEscola" class="form-label">Tipo de escola</label>
      <select asp-for="TipoEscola" class="form-select">
        <option value="MUNICIPAL">Municipal</option>
        <option value="ESTADUAL">Estadual</option>
        <option value="FEDERAL">Federal</option>
        <option value="PRIVADA">Privada</option>
      </select>
    </div>
    <div class="col-md-2">
      <label asp-for="Situacao" class="form-label">Situação cadastral</label>
      <select asp-for="Situacao" class="form-select">
        <option value="ATIVA">Ativa</option>
        <option value="INATIVA">Inativa</option>
      </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <button class="btn btn-primary w-100" type="submit" data-permission="educacao.escola.criar">Salvar escola</button>
    </div>
  </div>
</form>
