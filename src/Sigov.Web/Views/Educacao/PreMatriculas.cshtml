@model Sigov.Web.Models.Educacao.PreMatriculaFormViewModel
@{ ViewData["Title"] = "Ingresso e vagas"; }
<section class="education-hero" aria-labelledby="ingresso-title"><div><span class="education-eyebrow">Educação · jornada administrativa</span><h1 id="ingresso-title">Pré-matrículas e análise</h1><p>Salve o rascunho, envie para análise e acompanhe a oferta sem confundir solicitação com matrícula efetiva.</p></div><a class="btn btn-light" href="/Educacao/Dashboard">Visão geral</a></section>
<div id="educacao-toast" class="alert d-none mt-3" role="status" aria-live="polite"></div>
<div class="card mt-3"><div class="card-header fw-semibold">Como usar</div><div class="card-body">Cadastre usando a pessoa já existente. O envio para análise é uma ação posterior e não ocupa vaga. Campos marcados com <span aria-hidden="true">*</span> são obrigatórios.</div></div>
<partial name="_ModalPreMatricula" model="Model" />
<section class="card mt-3" aria-labelledby="fila-title"><div class="card-body"><h2 id="fila-title" class="h5">Fila de análise</h2>
<form id="filtros-pre-matricula" class="row g-3" role="search"><div class="col-md-4"><label for="filtro-protocolo" class="form-label">Protocolo</label><input id="filtro-protocolo" name="protocolo" class="form-control" /></div><div class="col-md-3"><label for="filtro-status" class="form-label">Situação</label><select id="filtro-status" name="status" class="form-select"><option value="">Todas</option><option>RASCUNHO</option><option>EM_ANALISE</option><option>COMPLEMENTACAO_PENDENTE</option><option>APROVADA</option><option>OFERTA_REALIZADA</option><option>CONVERTIDA_MATRICULA</option><option>INDEFERIDA</option><option>CANCELADA</option></select></div><div class="col-md-3"><label for="filtro-ano" class="form-label">Ano letivo</label><input id="filtro-ano" name="anoLetivo" type="number" class="form-control" /></div><div class="col-md-2 d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Filtrar</button><button class="btn btn-outline-secondary" type="reset">Limpar</button></div></form></div>
<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Protocolo</th><th>Ano/etapa</th><th>Turno</th><th>Situação</th><th>Versão</th><th>Ação</th></tr></thead><tbody id="grid-pre-matriculas"></tbody></table></div><nav class="card-footer d-flex justify-content-between" aria-label="Paginação da fila"><button id="pagina-anterior" class="btn btn-sm btn-outline-primary" disabled>Anterior</button><span id="pagina-resumo"></span><button id="pagina-proxima" class="btn btn-sm btn-outline-primary" disabled>Próxima</button></nav></section>
@section Scripts { <script src="~/js/modules/educacao.pre-matriculas.js"></script> }
