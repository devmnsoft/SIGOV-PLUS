@model Sigov.Web.Models.Educacao.TurmaFormViewModel
@{ ViewData["Title"] = "Turmas"; }
@{
    ViewData["Title"] = ViewData["Title"] ?? "Educação";
}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3">@ViewData["Title"]</h1>
    <p class="text-muted mb-0">Módulo Educação Base com dados paginados, LGPD, auditoria e tenant_id.</p>
  </div>
  <div class="btn-group">
    <a class="btn btn-outline-primary" href="/Educacao/Dashboard">Dashboard</a>
    <a class="btn btn-outline-secondary" href="/api/educacao/export/alunos.csv">CSV</a>
    <a class="btn btn-outline-secondary" href="/api/educacao/export/alunos.json">JSON</a>
  </div>
</div>
<div id="educacao-toast" class="alert d-none" role="alert"></div>
<partial name="_FormTurma" model="Model" /><div id="grid-turmas" class="mt-3"></div>
@section Scripts { <script src="~/js/modules/educacao.turmas.js"></script> }
