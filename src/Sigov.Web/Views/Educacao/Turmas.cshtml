@model Sigov.Web.Models.Educacao.TurmaFormViewModel
@{ ViewData["Title"] = "Turmas e Enturmação"; }

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
    <li class="breadcrumb-item active" aria-current="page">Turmas</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3">Turmas e Enturmação</h1>
    <p class="text-muted mb-0">Organização das turmas, lotação por capacidade de vagas, calendário anual e turnos.</p>
  </div>
  <div class="btn-group">
    <a class="btn btn-outline-primary" href="/Educacao/Dashboard">Dashboard</a>
    <a class="btn btn-outline-secondary" href="/api/educacao/export/alunos.csv">CSV</a>
  </div>
</div>

<details class="how-to mb-3">
  <summary>Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Turma fechada não enturma. Capacidade é a da base; sem vaga o aluno espera. A gestão de turmas respeita o calendário do ano letivo e os turnos autorizados.</p>
    <ul>
      <li><strong>Lotação Estrita:</strong> A enturmação recusa se o saldo de vagas da turma for menor que 1.</li>
      <li><strong>Turmas Fechadas:</strong> Turmas com status <code>FECHADA</code> ou <code>CANCELADA</code> não recebem novos alunos nem novas avaliações.</li>
    </ul>
  </div>
</details>

<div id="educacao-toast" class="alert d-none" role="alert"></div>
<partial name="_FormTurma" model="Model" />
<div id="grid-turmas" class="mt-3"></div>
@section Scripts { <script src="~/js/modules/educacao.turmas.js"></script> }
