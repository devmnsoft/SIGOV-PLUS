@model Sigov.Web.Models.Educacao.AlunoFormViewModel
@{ ViewData["Title"] = "Gestão de Alunos"; }

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
    <li class="breadcrumb-item active" aria-current="page">Alunos</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3">Gestão de Alunos</h1>
    <p class="text-muted mb-0">Cadastros escolares com proteção de dados pessoais (LGPD), vínculos de responsáveis e histórico de matrículas.</p>
  </div>
  <div class="btn-group">
    <a class="btn btn-primary" href="/Educacao/Alunos/Novo">Novo aluno</a>
    <a class="btn btn-outline-primary" href="/Educacao/Dashboard">Dashboard</a>
    <a class="btn btn-outline-secondary" href="/api/educacao/export/alunos.csv">CSV</a>
  </div>
</div>

<details class="how-to mb-3">
  <summary>Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Documento mascarado. Responsável pela lista. Matrícula ativa é única na escola/ano/série. Cadastre alunos a partir de pessoas já existentes no tenant e mantenha dados sensíveis protegidos.</p>
    <ul>
      <li><strong>Privacidade e LGPD:</strong> NIS, Cartão SUS e dados sensíveis são apresentados com máscara em listas e CSV.</li>
      <li><strong>Vínculo Único:</strong> Cada aluno pode ter somente uma matrícula ativa por ciclo anual e série.</li>
    </ul>
  </div>
</details>

<div id="educacao-toast" class="alert d-none" role="alert"></div>
<partial name="_FormAluno" model="Model" />
<partial name="_GridAlunos" />
@section Scripts { <script src="~/js/modules/educacao.alunos.js"></script> }
