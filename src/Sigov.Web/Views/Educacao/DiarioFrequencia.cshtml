@{
    ViewData["Title"] = "Frequência do Diário";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Início</a></li>
        <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
        <li class="breadcrumb-item active" aria-current="page">Frequência do Diário</li>
    </ol>
</nav>

<details class="how-to mb-4" open>
    <summary class="fw-semibold">Como usar esta tela</summary>
    <div class="card card-body bg-light border-0 mt-2">
        <p class="mb-1">1. Nada começa como presença. O estado inicial de todo registro é NAO_LANCADO.</p>
        <p class="mb-1">2. Falta justificada pede motivo real documentado; o sistema nunca fabrica justificativa de falta.</p>
        <p class="mb-1">3. Só lança quem está formalmente vinculado à turma/componente, com data no ano letivo e em período aberto.</p>
        <p class="mb-0">4. Toda conferência e fechamento de diário gera registro auditado com identificação do docente e momento do lançamento.</p>
    </div>
</details>

<section class="edu-b3" data-endpoint="/api/educacao/diario-classe/pendencias">
    <header class="edu-b3__hero">
        <div>
            <span class="lgpd-badge">LGPD • acesso auditado</span>
            <h1 class="h3 mb-1">Frequência do diário</h1>
            <p>Operação educacional persistente, isolada por tenant e protegida por permissões.</p>
        </div>
        <button class="btn btn-primary" data-reload><sigov-icon name="search" size="16" /> Atualizar</button>
    </header>
    <div class="edu-b3__kpis">
        <article><strong data-total>—</strong><span>Registros</span></article>
        <article><strong>100%</strong><span>Rastreabilidade</span></article>
        <article><strong>Ativo</strong><span>Fluxo operacional</span></article>
    </div>
    <div class="filter-bar">
        <label>Busca<input type="search" data-filter placeholder="Filtrar registros"></label>
        <label>Status
            <select>
                <option value="">Todos</option>
                <option value="Aberto">Aberto</option>
                <option value="Pendente">Pendente</option>
                <option value="Concluido">Concluído</option>
            </select>
        </label>
    </div>
    <div class="responsive-data-table">
        <div class="loading-skeleton" data-loading>Consultando dados reais…</div>
        <table hidden>
            <thead>
                <tr>
                    <th>Identificador</th>
                    <th>Tipo / título</th>
                    <th>Status</th>
                    <th>Atualização</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div class="empty-state" hidden>
            <strong>Nenhum registro disponível</strong>
            <p>Quando houver dados autorizados, eles aparecerão aqui. Nenhum dado de terceiros é exibido.</p>
        </div>
    </div>
    <div class="audit-timeline">
        <span></span>
        <div>
            <strong>Trilha de auditoria habilitada</strong>
            <small>Alterações registram usuário, tenant e correlation id.</small>
        </div>
    </div>
</section>
<script src="~/js/educacao-bloco3.js" asp-append-version="true"></script>

