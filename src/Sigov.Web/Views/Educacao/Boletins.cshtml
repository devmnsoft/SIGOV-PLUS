@{
    ViewData["Title"] = "Boletins Escolares";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Início</a></li>
        <li class="breadcrumb-item"><a href="/Educacao">Educação</a></li>
        <li class="breadcrumb-item active" aria-current="page">Boletins</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge text-bg-primary mb-2"><sigov-icon name="locked" size="16" /> LGPD</span>
        <h1 class="h3 mb-1">Boletins Escolares</h1>
        <p class="text-muted mb-0">Consulta consolidada de avaliações e notas persistidas no ano letivo.</p>
    </div>
    <button class="btn btn-primary" type="button" id="consultar-boletim">
        <sigov-icon name="search" size="16" /> Consultar
    </button>
</div>

<details class="how-to mb-4" open>
    <summary class="fw-semibold">Como usar esta tela</summary>
    <div class="card card-body bg-light border-0 mt-2">
        <p class="mb-1">1. Selecione o aluno pelo nome no catálogo oficial da rede de ensino.</p>
        <p class="mb-1">2. Sem política acadêmica persistida a média não é calculada. O sistema não inventa nota de corte nem arredondamento.</p>
        <p class="mb-1">3. Ausência de nota aparece como não lançado, não como zero. Zero representa nota lançada formalmente pelo docente.</p>
        <p class="mb-0">4. As notas e pesos refletem fielmente as avaliações cadastradas e homologadas na turma.</p>
    </div>
</details>

<div class="alert alert-info d-flex align-items-center mb-4">
    <div>
        <strong>Aviso acadêmico:</strong> Sem política acadêmica persistida a média não é calculada. Ausência de nota aparece como não lançado, não como zero.
    </div>
</div>

<div id="educacao-toast" class="alert d-none" role="alert"></div>

<div class="card shadow-sm">
    <div class="card-body">
        <label class="form-label" for="aluno-boletim">Aluno</label>
        <div class="input-group mb-4">
            <select class="form-select" id="aluno-boletim">
                <option value="">-- Selecione o aluno por nome --</option>
                @if (ViewBag.Alunos != null)
                {
                    foreach (var a in (IEnumerable<dynamic>)ViewBag.Alunos)
                    {
                        <option value="@a.Id">@a.NomeCompleto (@(string.IsNullOrEmpty(a.CpfMascarado) ? "Matrícula: " + a.CodigoAluno : a.CpfMascarado))</option>
                    }
                }
            </select>
            <button class="btn btn-outline-primary" id="buscar-boletim" type="button">
                <sigov-icon name="search" size="16" /> Carregar Boletim
            </button>
        </div>

        <div id="boletim-resultado" class="table-responsive">
            <div class="text-center text-muted py-5">
                <sigov-icon name="documents" size="32" />
                <p class="mt-2 mb-0">Selecione um aluno acima para carregar o boletim acadêmico real.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/educacao.boletins.js"></script>
}

