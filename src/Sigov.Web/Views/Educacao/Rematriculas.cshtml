@{ ViewData["Title"] = "Transição de ano letivo"; var escolas=ViewBag.Escolas as IEnumerable<Sigov.Application.Educacao.EscolaResponse> ?? []; var anos=ViewBag.AnosLetivos as IEnumerable<Sigov.Application.Educacao.AnoLetivoResponse> ?? []; var turmas=ViewBag.Turmas as IEnumerable<Sigov.Application.Educacao.TurmaResponse> ?? []; }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Início</a></li><li class="breadcrumb-item"><a href="/Educacao">Educação</a></li><li class="breadcrumb-item active">Transição de ano letivo</li></ol></nav>
<h1 class="h3">Transição de ano letivo</h1>
<p class="text-muted">Conferir resultados → preparar oferta → identificar candidatos → simular → revisar → confirmar → consultar histórico.</p>
<ol class="sigov-rematricula-steps" aria-label="Etapas da jornada"><li class="active">1. Origem e destino</li><li>2. Candidatos</li><li>3. Ajustes e pendências</li><li>4. Revisão</li><li>5. Confirmação</li><li>6. Resultado</li></ol>
<details class="how-to mb-3" open><summary><strong>Para que serve:</strong> criar novas matrículas sem alterar o histórico do período de origem</summary><div class="mt-2"><p><strong>Como funciona:</strong> a simulação consulta o resultado final publicado, a progressão configurada e a oferta persistida. Ela não grava matrícula nem ocupa vaga.</p><p><strong>Pré-requisitos:</strong> escola ativa, anos distintos, resultado publicado, regra de progressão quando aplicável e turma de destino ativa com capacidade.</p><p><strong>Regras importantes:</strong> destino ausente fica como “destino não definido”; confirmação revalida resultado, permissão, turma, duplicidade e última vaga. Lotes são processados por item e exibem falhas parciais.</p><p><strong>Próximo passo:</strong> escolha o contexto, simule, revise somente os itens marcados e confirme. Cancelamentos posteriores preservam histórico e podem ser bloqueados por frequência, avaliações ou documentos.</p></div></details>
@if(ViewBag.OpcoesEducacaoErro is string erro){<div class="alert alert-danger" role="alert">@erro</div>}
<div id="rematricula-feedback" class="alert d-none" role="alert" tabindex="-1"></div>
<form id="rematricula-contexto" class="card card-body" novalidate><div class="row g-3">
 <div class="col-lg-4"><label class="form-label" for="rem-escola">Escola <span aria-hidden="true">*</span></label><select id="rem-escola" class="form-select" required><option value="">Selecione</option>@foreach(var x in escolas){<option value="@x.Id">@x.Nome</option>}</select></div>
 <div class="col-lg-3"><label class="form-label" for="rem-origem">Ano letivo de origem *</label><select id="rem-origem" class="form-select" required><option value="">Selecione</option>@foreach(var x in anos){<option value="@x.Id" data-escola="@x.EscolaId">@x.Ano — @x.Status</option>}</select></div>
 <div class="col-lg-3"><label class="form-label" for="rem-destino">Ano letivo de destino *</label><select id="rem-destino" class="form-select" required><option value="">Selecione</option>@foreach(var x in anos){<option value="@x.Id" data-escola="@x.EscolaId">@x.Ano — @x.Status</option>}</select></div>
 <div class="col-lg-2 d-grid align-self-end"><button class="btn btn-primary" type="submit">Simular</button></div>
 <div class="col-lg-6"><label class="form-label" for="rem-turma-origem">Turma de origem (opcional)</label><select id="rem-turma-origem" class="form-select"><option value="">Todas</option>@foreach(var x in turmas){<option value="@x.Id" data-escola="@x.EscolaId" data-ano="@x.AnoLetivoId">@x.Nome — @x.Turno</option>}</select></div>
 <div class="col-lg-6"><label class="form-label" for="rem-turma-destino">Destino autorizado para ajuste (opcional)</label><select id="rem-turma-destino" class="form-select"><option value="">Usar progressão configurada</option>@foreach(var x in turmas){<option value="@x.Id" data-escola="@x.EscolaId" data-ano="@x.AnoLetivoId">@x.Nome — @x.Turno (@(x.Capacidade-x.VagasOcupadas) vagas)</option>}</select></div>
</div></form>
<section class="card mt-3" aria-labelledby="titulo-previa"><div class="card-header d-flex flex-wrap justify-content-between"><div><h2 id="titulo-previa" class="h5 mb-0">Prévia sem efeitos acadêmicos</h2><small id="rem-contexto-visivel">Selecione escola, origem e destino.</small></div><strong><span id="rem-selecionados">0</span> itens marcados</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th><input id="rem-todos" type="checkbox" aria-label="Selecionar elegíveis desta prévia"></th><th>Aluno / origem</th><th>Resultado</th><th>Destino / vaga</th><th>Classificação e motivo</th></tr></thead><tbody id="rem-itens"><tr><td colspan="5" class="text-muted">Execute uma simulação para conferir os candidatos.</td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center"><span>A seleção abrange somente os itens marcados nesta prévia; filtros nunca ampliam o lote.</span><button id="rem-confirmar" class="btn btn-success" type="button" disabled>Revisar e confirmar selecionados</button></div></section>
<section class="card mt-3"><div class="card-header"><h2 class="h5 mb-0">Operações e histórico</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Operação</th><th>Origem → destino</th><th>Responsável / instante</th><th>Situação</th><th>Itens</th></tr></thead><tbody id="rem-operacoes"><tr><td colspan="5" class="text-muted">Carregando histórico...</td></tr></tbody></table></div></section>
@section Scripts { <script src="~/js/modules/educacao.rematriculas.js"></script> }
