@model Sigov.Web.Models.Educacao.EducacaoRecursoViewModel
@{ ViewData["Title"] = Model.Titulo; }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Educacao">Educação</a></li><li class="breadcrumb-item active">@Model.Titulo</li></ol></nav>
<header class="card border-0 shadow-sm mb-4"><div class="card-body p-4 d-flex flex-wrap justify-content-between gap-3"><div><span class="badge text-bg-success mb-2">Persistência preparada</span><h1 class="h3">@Model.Titulo</h1><p class="text-muted mb-0">@Model.Descricao</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmacao-operacional"><i class="bi bi-plus-lg"></i> Novo</button></div></header>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">Registros ativos</small><div class="display-6" id="recurso-total">0</div></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">Proteção</small><div class="h5 mt-2"><i class="bi bi-shield-check text-success"></i> Tenant + LGPD</div></div></div></div></div>
<div class="card"><div class="card-body"><div class="d-flex gap-2 mb-3"><input class="form-control" type="search" placeholder="Filtrar registros" aria-label="Filtrar"><button class="btn btn-outline-secondary">Filtrar</button></div><div id="recurso-grid" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span><i class="bi bi-inbox fs-1 d-block"></i>Nenhum registro encontrado.</div></div></div>
<div class="modal fade" id="confirmacao-operacional" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Novo registro</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body">O cadastro será enviado ao endpoint persistente e auditado: <code>@Model.Endpoint</code>.</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" disabled>Continuar</button></div></div></div></div>
