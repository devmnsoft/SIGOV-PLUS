@{ ViewData["Title"] = "Biblioteca escolar"; }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Educacao">Educação</a></li><li class="breadcrumb-item active" aria-current="page">Biblioteca escolar</li></ol></nav>
<header class="sigov-product-header mb-4"><div><span class="sigov-lgpd-badge"><i class="bi bi-shield-lock"></i> Tenant isolado · LGPD</span><h1>Biblioteca escolar</h1><p>Operação persistente, auditável e protegida por permissão.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#novo-registro"><i class="bi bi-plus-lg"></i> Novo item do acervo</button></header>
<section class="row g-3 mb-4" aria-label="Indicadores"><div class="col-md-4"><article class="sigov-kpi-card"><span>Itens disponíveis</span><strong id="kpi-total">—</strong><small>Atualizado a partir da API</small></article></div><div class="col-md-4"><article class="sigov-kpi-card"><span>Conformidade</span><strong><i class="bi bi-check-circle text-success"></i> Auditada</strong><small>CorrelationId por operação</small></article></div><div class="col-md-4"><article class="sigov-kpi-card"><span>Privacidade</span><strong>Protegida</strong><small>Dados pessoais mascarados</small></article></div></section>
<section class="card border-0 shadow-sm"><div class="card-body"><div class="sigov-filter-bar mb-3"><label class="visually-hidden" for="filtro">Buscar</label><input id="filtro" class="form-control" type="search" placeholder="Buscar por código, nome ou situação"><select class="form-select" aria-label="Situação"><option value="">Todas as situações</option><option>Ativo</option><option>Inativo</option></select><button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> Filtrar</button></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Título</th><th>Autor / editora</th><th>Tombo</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody id="registros"><tr><td colspan="5"><div class="sigov-empty-state"><i class="bi bi-inbox"></i><h2 class="h5">Nenhum registro encontrado</h2><p>Use “Novo item do acervo” para iniciar o fluxo.</p></div></td></tr></tbody></table></div><nav aria-label="Paginação"><ul class="pagination justify-content-end"><li class="page-item disabled"><span class="page-link">Anterior</span></li><li class="page-item active"><span class="page-link">1</span></li><li class="page-item disabled"><span class="page-link">Próxima</span></li></ul></nav></div></section>
<div class="modal fade" id="novo-registro" tabindex="-1" aria-labelledby="novo-titulo" aria-hidden="true"><div class="modal-dialog modal-lg"><form class="modal-content needs-validation" novalidate><div class="modal-header"><h2 id="novo-titulo" class="modal-title fs-5">Novo item do acervo</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><div class="alert alert-info"><i class="bi bi-shield-check"></i> Alterações são vinculadas ao tenant e registradas na auditoria.</div><div class="row g-3"><div class="col-md-4"><label class="form-label">Título</label><input class="form-control" required maxlength="120"><div class="invalid-feedback">Campo obrigatório.</div></div><div class="col-md-4"><label class="form-label">Autor / editora</label><input class="form-control" required maxlength="160"><div class="invalid-feedback">Campo obrigatório.</div></div><div class="col-md-4"><label class="form-label">Tombo</label><input class="form-control" required maxlength="120"><div class="invalid-feedback">Campo obrigatório.</div></div><div class="col-12"><label class="form-label">Observações</label><textarea class="form-control" maxlength="500"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit"><span class="spinner-border spinner-border-sm d-none"></span> Salvar</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script>document.querySelectorAll('.needs-validation').forEach(f=>f.addEventListener('submit',e=>{if(!f.checkValidity()){e.preventDefault();e.stopPropagation();}f.classList.add('was-validated');}));</script> }
