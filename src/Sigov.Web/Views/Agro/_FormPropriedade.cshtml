<form id="formAgroPropriedade" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-2"><label class="form-label">Produtor ID</label><input class="form-control" name="produtorId" type="number" required /></div><div class="col-md-3"><label class="form-label">Código</label><input class="form-control" name="codigoPropriedade" placeholder="Automático" /></div><div class="col-md-4"><label class="form-label">Nome</label><input class="form-control" name="nome" required /></div><div class="col-md-3"><label class="form-label">Situação</label><input class="form-control" name="situacao" required value="ATIVA" /></div><div class="col-md-3"><label class="form-label">Localidade</label><input class="form-control" name="localidade" /></div><div class="col-md-3"><label class="form-label">Comunidade</label><input class="form-control" name="comunidade" /></div><div class="col-md-2"><label class="form-label">Área total</label><input class="form-control" name="areaTotalHa" type="number" step="0.0001" /></div><div class="col-md-2"><label class="form-label">Área produtiva</label><input class="form-control" name="areaProdutivaHa" type="number" step="0.0001" /></div><div class="col-md-2"><label class="form-label">APP/Reserva</label><input class="form-control" name="areaPreservacaoHa" type="number" step="0.0001" /></div><div class="col-md-2"><label class="form-label">Latitude</label><input class="form-control" name="latitude" type="number" step="0.00000001" /></div><div class="col-md-2"><label class="form-label">Longitude</label><input class="form-control" name="longitude" type="number" step="0.00000001" /></div><div class="col-12"><label class="form-label">GeoJSON</label><textarea class="form-control" name="geoJson"></textarea></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvar propriedade</button></div></form>
