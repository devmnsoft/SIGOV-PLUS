@{
    ViewData["Title"] = "BI Agro";
}
<section class="container-fluid py-4 sigov-agro-bi" data-module="agro-bi">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <div><h1 class="h3 mb-1">Painel BI Agro</h1><p class="text-muted mb-0">Indicadores executivos com isolamento por tenant, entidade e exercício.</p></div>
        <div class="btn-group"><a class="btn btn-outline-primary" href="/api/agro/export/produtores.csv">CSV</a><a class="btn btn-outline-secondary" href="/api/agro/export/produtores.json">JSON</a><a class="btn btn-outline-success" href="/api/agro/export/geojson">GeoJSON</a></div>
    </div>
    <div id="agroBiCards" class="row g-3"><div class="col-12"><div class="alert alert-info">Carregando indicadores...</div></div></div>
    <div class="card mt-4"><div class="card-header">Transparência e LGPD</div><div class="card-body"><span class="badge bg-success">Dados agregados</span> <span class="badge bg-secondary">Dados pessoais mascarados por padrão</span></div></div>
</section>
@section Scripts { <script src="~/js/modules/agro.bi.js"></script> }
