@using Microsoft.AspNetCore.Authorization
@model Sigov.Application.Agro.AgroPagina
@inject IAuthorizationService Authorization
@{var recurso=(string?)ViewData["Recurso"]??"";var canManage=(await Authorization.AuthorizeAsync(User,(string)ViewData["ManagePolicy"]!)).Succeeded;}
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3">@ViewData["Title"]</h1><p class="text-muted">Registros persistidos no escopo da entidade atual.</p></div>@if(canManage){if(recurso=="produtores"){<a class="btn btn-success" href="/Agro/Produtores/Novo">Novo produtor</a>}else if(recurso=="propriedades"){<a class="btn btn-success" href="/Agro/Propriedades/Nova">Nova propriedade</a>}}</div>
<partial name="_Alerts"/><form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-6"><input class="form-control" name="Busca" value="@Context.Request.Query["Busca"]" placeholder="Buscar" /></div><div class="col-md-3"><input class="form-control" name="Status" value="@Context.Request.Query["Status"]" placeholder="Status" /></div><div class="col-md-3"><button class="btn btn-primary">Aplicar filtros</button></div></div></form>
@if(canManage&&recurso is not("produtores" or "propriedades")){<details class="card mb-3"><summary class="card-header">Adicionar registro</summary><form method="post" action="/Agro/@recurso/Novo" class="card-body row g-2">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-4"><label class="form-label">Nome / tipo / finalidade</label><input name="Titulo" required maxlength="180" class="form-control" /></div><div class="col-md-4"><label class="form-label">Descrição / local</label><input name="Descricao" maxlength="500" class="form-control" /></div><div class="col-md-2"><label class="form-label">Status</label><input name="Status" value="ATIVO" required class="form-control" /></div><div class="col-md-2"><label class="form-label">Data</label><input name="Data" type="date" class="form-control" /></div><div class="col-md-2"><label class="form-label">Produtor ID</label><input name="ProdutorId" type="number" min="1" class="form-control" /></div><div class="col-md-2"><label class="form-label">Propriedade ID</label><input name="PropriedadeId" type="number" min="1" class="form-control" /></div><div class="col-md-2"><label class="form-label">Quantidade/horas</label><input name="Quantidade" type="number" min="0" step="0.01" class="form-control" /></div><div class="col-md-4"><label class="form-label">Justificativa</label><input name="Justificativa" class="form-control" /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-success w-100">Salvar</button></div></form></details>}
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Registro</th><th>Detalhe</th><th>Status</th><th>Cadastrado</th><th></th></tr></thead><tbody>@if(Model.Itens.Count==0){<tr><td colspan="5" class="text-center text-muted py-5">Nenhum registro encontrado para os filtros informados.</td></tr>}@foreach(var item in Model.Itens){<tr><td><strong>@item.Titulo</strong><div class="small text-muted">#@item.Id</div></td><td>@item.Subtitulo</td><td><span class="badge text-bg-secondary">@item.Status</span></td><td>@item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@if(canManage){<form method="post" action="/Agro/@recurso/@item.Id/Excluir" onsubmit="return confirm('Excluir este registro?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Excluir</button></form>}</td></tr>}</tbody></table></div><div class="card-footer">Página @Model.Pagina · @Model.Total registro(s)</div></div>
