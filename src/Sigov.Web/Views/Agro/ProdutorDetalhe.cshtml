@{ ViewData["Title"] = "Detalhe do Produtor"; }
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel("Detalhe do Produtor Rural", "Abas de dados gerais, propriedades, produção, documentos, mapa e auditoria.", new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Agro", "/Agro/Dashboard"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Produtores", "/Agro/Produtores"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Detalhe", "#", true) }))
<ul class="nav nav-tabs"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#dados">Dados gerais</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#props">Propriedades</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prod">Produção</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#docs">Documentos</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mapa">Mapa</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#aud">Auditoria</button></li></ul><div class="tab-content border border-top-0 p-3"><div class="tab-pane fade show active" id="dados">@await Html.PartialAsync("_ResumoProdutor")</div><div class="tab-pane fade" id="props">@await Html.PartialAsync("_GridPropriedades")</div><div class="tab-pane fade" id="prod">@await Html.PartialAsync("_GridProducao")</div><div class="tab-pane fade" id="docs">Documentos rurais respeitam LGPD.</div><div class="tab-pane fade" id="mapa">Georreferenciamento base.</div><div class="tab-pane fade" id="aud">@await Html.PartialAsync("_AuditoriaAgro")</div></div>
