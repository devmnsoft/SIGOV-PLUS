@model Sigov.Application.Agro.PropriedadeInput
@{ViewData["Title"]="Nova propriedade rural";}<h1 class="h3">Nova propriedade rural</h1><form method="post" class="card card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label class="form-label">Nome</label><input asp-for="Nome" required class="form-control" /></div><div class="col-md-3"><label class="form-label">Área total (ha)</label><input asp-for="AreaTotal" type="number" min="0" step="0.0001" class="form-control" /></div><div class="col-md-3"><label class="form-label">Área produtiva (ha)</label><input asp-for="AreaProdutiva" type="number" min="0" step="0.0001" class="form-control" /></div><div class="col-md-6"><label class="form-label">Localização</label><input asp-for="Localizacao" class="form-control" /></div><div class="col-md-3"><label class="form-label">Comunidade</label><input asp-for="Comunidade" class="form-control" /></div><div class="col-md-3"><label class="form-label">Responsáveis (IDs separados pelo formulário)</label><input name="ProdutorIds" type="number" min="1" class="form-control" /></div><div class="col-md-2"><label class="form-label">Latitude</label><input asp-for="Latitude" type="number" min="-90" max="90" step="0.0000001" class="form-control" /></div><div class="col-md-2"><label class="form-label">Longitude</label><input asp-for="Longitude" type="number" min="-180" max="180" step="0.0000001" class="form-control" /></div><div class="col-md-2"><label class="form-label">CAR</label><input asp-for="Car" class="form-control" /></div><div class="col-md-2"><label class="form-label">ITR</label><input asp-for="Itr" class="form-control" /></div><div class="col-md-2"><label class="form-label">CCIR</label><input asp-for="Ccir" class="form-control" /></div><div class="col-md-2"><label class="form-label">Situação</label><input asp-for="Situacao" required class="form-control" /></div><div class="col-12"><label class="form-label">Observações</label><textarea asp-for="Observacoes" class="form-control"></textarea></div><div><button class="btn btn-success">Salvar</button> <a href="/Agro/Propriedades" class="btn btn-outline-secondary">Cancelar</a></div></form>
