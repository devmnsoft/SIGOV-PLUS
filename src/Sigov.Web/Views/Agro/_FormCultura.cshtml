<form id="formAgroCultura" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-2"><label class="form-label">Código</label><input class="form-control" name="codigo" required /></div><div class="col-md-4"><label class="form-label">Nome</label><input class="form-control" name="nome" required /></div><div class="col-md-3"><label class="form-label">Tipo</label><input class="form-control" name="tipoCultura" value="GRAOS" required /></div><div class="col-md-1"><label class="form-label">Ciclo</label><input class="form-control" name="cicloDias" type="number" /></div><div class="col-md-2"><label class="form-label">Unidade</label><input class="form-control" name="unidadeMedida" value="kg" required /></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvar cultura</button></div></form>
