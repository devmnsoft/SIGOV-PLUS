<form id="formAgroProdutor" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-3"><label class="form-label">Pessoa ID</label><input class="form-control" name="pessoaId" type="number" required /></div><div class="col-md-3"><label class="form-label">Código</label><input class="form-control" name="codigoProdutor" placeholder="Automático" /></div><div class="col-md-3"><label class="form-label">Tipo</label><input class="form-control" name="tipoProdutor" required value="FAMILIAR" /></div><div class="col-md-3"><label class="form-label">Situação</label><input class="form-control" name="situacao" required value="ATIVO" /></div><div class="col-md-3"><label class="form-label">Inscrição estadual</label><input class="form-control" name="inscricaoEstadual" /></div><div class="col-md-3"><label class="form-label">Inscrição municipal</label><input class="form-control" name="inscricaoMunicipal" /></div><div class="col-md-3"><label class="form-label">Nº produtor rural</label><input class="form-control" name="numeroProdutorRural" /></div><div class="col-md-3"><label class="form-label">Atividade principal</label><input class="form-control" name="principalAtividade" /></div><div class="col-12"><label class="form-label">Observação</label><textarea class="form-control" name="observacao"></textarea></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvar produtor</button></div></form>
