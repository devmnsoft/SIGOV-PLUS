<form id="formGeoFeicao" method="post" autocomplete="off">
  @Html.AntiForgeryToken()
  <input type="hidden" name="id" id="feicaoId" />
  <div class="row g-3">
    <div class="col-md-3"><label class="form-label" for="feicaoCamadaId">Camada ID</label><input class="form-control" id="feicaoCamadaId" name="camadaId" type="number" min="1" required /></div>
    <div class="col-md-5"><label class="form-label" for="feicaoNome">Nome</label><input class="form-control" id="feicaoNome" name="nome" maxlength="250" required /></div>
    <div class="col-md-4"><label class="form-label" for="feicaoTipo">Tipo geometria</label><select class="form-select" id="feicaoTipo" name="tipoGeometria"><option value="POINT">POINT</option><option value="LINESTRING">LINESTRING</option><option value="POLYGON">POLYGON</option><option value="MULTIPOLYGON">MULTIPOLYGON</option><option value="GEOJSON">GEOJSON</option></select></div>
    <div class="col-md-3"><label class="form-label" for="feicaoLatitude">Latitude</label><input class="form-control" id="feicaoLatitude" name="latitude" type="number" step="0.00000001" min="-90" max="90" /></div>
    <div class="col-md-3"><label class="form-label" for="feicaoLongitude">Longitude</label><input class="form-control" id="feicaoLongitude" name="longitude" type="number" step="0.00000001" min="-180" max="180" /></div>
    <div class="col-md-6"><label class="form-label" for="feicaoProps">Propriedades JSON</label><input class="form-control" id="feicaoProps" name="propriedadesJson" value="{}" /></div>
    <div class="col-md-12"><label class="form-label" for="feicaoGeoJson">GeoJSON</label><textarea class="form-control" id="feicaoGeoJson" name="geoJson" rows="4" placeholder='{"type":"Point","coordinates":[-48.0,-15.0]}'></textarea></div>
  </div>
  <div class="mt-3 d-flex gap-2"><button type="submit" class="btn btn-primary">Salvar feição</button><button type="reset" class="btn btn-outline-secondary">Limpar</button></div>
</form>
