@{ ViewData["Title"] = "Agroindústrias"; }
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel("Agroindústrias", "Gestão estrutural Agro Parte 5 com tenant isolation, LGPD, auditoria e integrações futuras por eventos.", new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Início", "/"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Agro", "/Agro/Dashboard"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Agroindústrias", "/Agro/Agroindustrias", true) }, "Mapa Rural", "/Agro/MapaRural"))
