@model Sigov.Application.Agro.ProdutorInput
@{ViewData["Title"]="Novo produtor rural";}<h1 class="h3">Novo produtor rural</h1><p class="alert alert-info">Dados pessoais são restritos ao atendimento público e sujeitos às políticas LGPD do SIGOV-PLUS.</p><form method="post" class="card card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-2"><label class="form-label">Pessoa</label><select asp-for="TipoPessoa" class="form-select" required><option>PF</option><option>PJ</option></select></div><div class="col-md-6"><label class="form-label">Nome / razão social</label><input asp-for="NomeRazaoSocial" class="form-control" required maxlength="180" /></div><div class="col-md-4"><label class="form-label">CPF/CNPJ</label><input asp-for="CpfCnpj" class="form-control" required inputmode="numeric" minlength="11" maxlength="18" /></div><div class="col-md-3"><label class="form-label">Telefone</label><input asp-for="Telefone" class="form-control" /></div><div class="col-md-5"><label class="form-label">E-mail</label><input asp-for="Email" type="email" class="form-control" /></div><div class="col-md-4"><label class="form-label">CAF/PRONAF</label><input asp-for="CafPronaf" class="form-control" /></div><div class="col-md-6"><label class="form-label">Endereço</label><input asp-for="Endereco" class="form-control" /></div><div class="col-md-3"><label class="form-label">Comunidade</label><input asp-for="Comunidade" class="form-control" /></div><div class="col-md-3"><label class="form-label">Localidade</label><input asp-for="Localidade" class="form-control" /></div><div class="col-md-3"><label class="form-label">Situação</label><select asp-for="Situacao" class="form-select"><option>ATIVO</option><option>INATIVO</option><option>SUSPENSO</option></select></div><div class="col-12"><label class="form-label">Observações</label><textarea asp-for="Observacoes" class="form-control"></textarea></div><div><button class="btn btn-success">Salvar</button> <a href="/Agro/Produtores" class="btn btn-outline-secondary">Cancelar</a></div></form>
