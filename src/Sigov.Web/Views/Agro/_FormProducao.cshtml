<form id="formAgroProducao" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-2"><label class="form-label">Produtor ID</label><input class="form-control" name="produtorId" type="number" required /></div><div class="col-md-2"><label class="form-label">Cultura ID</label><input class="form-control" name="culturaId" type="number" required /></div><div class="col-md-2"><label class="form-label">Propriedade ID</label><input class="form-control" name="propriedadeId" type="number" /></div><div class="col-md-2"><label class="form-label">Talhão ID</label><input class="form-control" name="talhaoId" type="number" /></div><div class="col-md-2"><label class="form-label">Área plantada</label><input class="form-control" name="areaPlantadaHa" type="number" step="0.0001" required /></div><div class="col-md-2"><label class="form-label">Unidade</label><input class="form-control" name="unidadeMedida" value="kg" required /></div><div class="col-md-3"><label class="form-label">Produção estimada</label><input class="form-control" name="producaoEstimada" type="number" step="0.0001" /></div><div class="col-md-3"><label class="form-label">Produção realizada</label><input class="form-control" name="producaoRealizada" type="number" step="0.0001" /></div><div class="col-md-3"><label class="form-label">Status</label><input class="form-control" name="status" value="PLANEJADA" required /></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvar produção</button></div></form>
