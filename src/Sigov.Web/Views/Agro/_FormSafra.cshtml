<form id="formAgroSafra" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-2"><label class="form-label">Código</label><input class="form-control" name="codigo" required /></div><div class="col-md-3"><label class="form-label">Nome</label><input class="form-control" name="nome" required /></div><div class="col-md-2"><label class="form-label">Ano início</label><input class="form-control" name="anoInicio" type="number" required /></div><div class="col-md-2"><label class="form-label">Ano fim</label><input class="form-control" name="anoFim" type="number" required /></div><div class="col-md-3"><label class="form-label">Status</label><input class="form-control" name="status" value="ATIVA" required /></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvar safra</button></div></form>
