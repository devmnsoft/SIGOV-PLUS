@model Sigov.Application.Agro.AgroDashboard
@{ViewData["Title"]="Agro e Desenvolvimento Rural";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Agro e Desenvolvimento Rural</h1><p class="text-muted mb-0">Gestão territorial, assistência técnica e serviços rurais com dados do PostgreSQL.</p></div><a class="btn btn-success" href="/Agro/Solicitacoes">Fila de solicitações</a></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-2"><label class="form-label">Início</label><input name="Inicio" type="date" class="form-control" /></div><div class="col-md-2"><label class="form-label">Fim</label><input name="Fim" type="date" class="form-control" /></div><div class="col-md-3"><label class="form-label">Comunidade</label><input name="Comunidade" class="form-control" /></div><div class="col-md-2"><label class="form-label">Programa</label><input name="Programa" class="form-control" /></div><div class="col-md-2"><label class="form-label">Status</label><input name="Status" class="form-control" /></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary">Filtrar</button></div></div></form>
<div class="row g-3 mb-4">@foreach(var x in new[]{("Produtores ativos",Model.ProdutoresAtivos.ToString("N0")),("Propriedades",Model.Propriedades.ToString("N0")),("Área total (ha)",Model.AreaTotal.ToString("N2")),("Visitas técnicas",Model.VisitasTecnicas.ToString("N0")),("Programas ativos",Model.ProgramasAtivos.ToString("N0")),("Beneficiários",Model.Beneficiarios.ToString("N0")),("Insumos distribuídos",Model.InsumosDistribuidos.ToString("N2")),("Serviços de patrulha",Model.ServicosPatrulha.ToString("N0")),("Solicitações abertas",Model.SolicitacoesAbertas.ToString("N0")),("Concluídas",Model.SolicitacoesConcluidas.ToString("N0"))}){<div class="col-6 col-lg"><div class="card h-100 shadow-sm"><div class="card-body"><div class="small text-muted">@x.Item1</div><strong class="fs-4">@x.Item2</strong></div></div></div>}</div>
<div class="card"><div class="card-header fw-semibold">Operação Agro</div><div class="list-group list-group-flush">@foreach(var x in new[]{("Produtores","/Agro/Produtores"),("Propriedades","/Agro/Propriedades"),("Atividades produtivas","/Agro/Atividades"),("Assistência técnica","/Agro/AssistenciaTecnica"),("Programas rurais","/Agro/Programas"),("Insumos","/Agro/Insumos"),("Patrulha mecanizada","/Agro/Patrulha"),("Feiras","/Agro/Feiras"),("Agroindústrias","/Agro/Agroindustrias"),("Relatórios","/Agro/Relatorios")}){<a href="@x.Item2" class="list-group-item list-group-item-action d-flex justify-content-between">@x.Item1 <span>›</span></a>}</div></div>
