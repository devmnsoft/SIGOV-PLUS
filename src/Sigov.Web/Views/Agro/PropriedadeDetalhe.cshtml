@{ ViewData["Title"] = "Detalhe da Propriedade"; }
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel("Detalhe da Propriedade Rural", "Imóvel rural, talhões, produção, documentos e georreferenciamento.", new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Agro", "/Agro/Dashboard"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Propriedades", "/Agro/Propriedades"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Detalhe", "#", true) }))
<ul class="nav nav-tabs"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#dados">Dados gerais</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#imovel">Imóvel rural</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#talhoes">Talhões</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prod">Produção</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#docs">Documentos</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#geo">Georreferenciamento</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#aud">Auditoria</button></li></ul><div class="tab-content border border-top-0 p-3"><div class="tab-pane fade show active" id="dados">@await Html.PartialAsync("_ResumoPropriedade")</div><div class="tab-pane fade" id="imovel">CAR/CCIR/INCRA informativos, sem integração real nesta etapa.</div><div class="tab-pane fade" id="talhoes">@await Html.PartialAsync("_FormTalhao")</div><div class="tab-pane fade" id="prod">@await Html.PartialAsync("_GridProducao")</div><div class="tab-pane fade" id="docs">Documentos rurais.</div><div class="tab-pane fade" id="geo">Mapa rural estrutural.</div><div class="tab-pane fade" id="aud">@await Html.PartialAsync("_AuditoriaAgro")</div></div>
