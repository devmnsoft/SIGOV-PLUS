@{ ViewData["Title"] = "Produtores Rurais"; }
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel("Produtores Rurais", "Cadastro de produtores com LGPD e isolamento por tenant.", new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Início", "/"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Agro", "/Agro/Dashboard"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Produtores", "/Agro/Produtores", true) }, "Produção", "/Agro/Producao"))
<div class="alert alert-info d-none" id="agroProdutoresLoading">Carregando produtores...</div><div class="alert alert-danger d-none" id="agroProdutoresErro"></div><div class="card mb-3"><div class="card-body">@await Html.PartialAsync("_FormProdutor")</div></div>@await Html.PartialAsync("_GridProdutores")
@section Scripts { <script src="~/js/modules/agro.produtores.js"></script> }
