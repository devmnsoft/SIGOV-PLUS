<form id="formAgroTalhao" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-2"><label class="form-label">Propriedade ID</label><input class="form-control" name="propriedadeId" type="number" required /></div><div class="col-md-2"><label class="form-label">Código</label><input class="form-control" name="codigo" required /></div><div class="col-md-4"><label class="form-label">Nome</label><input class="form-control" name="nome" required /></div><div class="col-md-2"><label class="form-label">Área ha</label><input class="form-control" name="areaHa" type="number" step="0.0001" required /></div><div class="col-md-2"><label class="form-label">Situação</label><input class="form-control" name="situacao" value="ATIVO" required /></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvar talhão</button></div></form>
