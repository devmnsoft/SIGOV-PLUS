@{ ViewData["Title"] = "Indicadores Agro"; }
<section class="container-fluid py-4"><h1 class="h3">Indicadores Agro</h1><p class="text-muted">Cadastro e acompanhamento dos indicadores do módulo Agro.</p><div id="agroIndicadoresToast" class="alert d-none"></div><div class="card"><div class="card-body"><form id="formAgroIndicador" class="row g-3"><div class="col-md-3"><label class="form-label">Código</label><input class="form-control" name="codigo" required></div><div class="col-md-4"><label class="form-label">Nome</label><input class="form-control" name="nome" required></div><div class="col-md-3"><label class="form-label">Categoria</label><select class="form-select" name="categoria"><option>PRODUTORES</option><option>PROPRIEDADES</option><option>PRODUCAO</option><option>ESTRADAS</option><option>FEIRAS</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Salvar</button></div></form></div></div><div id="agroIndicadoresGrid" class="mt-4"></div></section>
@section Scripts { <script src="~/js/modules/agro.indicadores.js"></script> }
