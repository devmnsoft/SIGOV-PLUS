@model Sigov.Application.Royalties.RoyaltiesDashboard
@{ViewData["Title"]="Royalties360";var diferenca=Model.Realizada-Model.Prevista;}
<link rel="stylesheet" href="~/css/royalties360.css" asp-append-version="true"/><main class="roy-shell"><partial name="_Nav"/><header class="roy-hero"><div><span class="eyebrow">RECEITAS E LEGADO PÚBLICO</span><h1>Royalties360</h1><p>Do repasse à entrega pública: governança rastreável sobre royalties e participações governamentais.</p></div><span class="hero-seal">◈ Pré-sal · petróleo · gás</span></header>
<form method="get" class="roy-filters"><label>Período inicial<input type="date" name="inicio"/></label><label>Período final<input type="date" name="fim"/></label><label>Tipo<select name="tipoReceita"><option value="">Todos</option><option value="ROYALTIES">Royalties</option><option value="PARTICIPACAO_ESPECIAL">Participação especial</option><option value="COMPENSACAO">Compensação</option><option value="BONUS">Bônus</option><option value="FUNDO_ESPECIAL">Fundo especial</option></select></label><label>Status<select name="status"><option value="">Todos</option><option>APROVADO</option><option>DIVERGENTE</option><option>PUBLICADO</option></select></label><button>Atualizar</button></form>
<section class="roy-metrics"><article><small>Receita prevista</small><strong>@Model.Prevista.ToString("C")</strong></article><article><small>Receita realizada</small><strong>@Model.Realizada.ToString("C")</strong></article><article class="@(diferenca<0?"risk":"ok")"><small>Previsto × realizado</small><strong>@diferenca.ToString("C")</strong></article><article><small>Repasses recebidos</small><strong>@Model.Repasses.ToString("C")</strong><em>@Model.RepassesPendentes pendentes</em></article><article><small>Aplicações vinculadas</small><strong>@Model.Aplicacoes.ToString("C")</strong></article><article class="ok"><small>Saldo disponível</small><strong>@Model.Saldo.ToString("C")</strong></article><article><small>Projetos financiados</small><strong>@Model.Projetos</strong><em>@Model.ProjetosAtrasados atrasados</em></article><article class="risk"><small>Alertas abertos</small><strong>@Model.Alertas</strong></article></section>
<section class="roy-panels"><article><h2>Impacto integrado</h2><div class="impact"><span><b>@Model.Obras</b> obras/vínculos contratuais</span><span><b>@Model.Sustentabilidade</b> projetos de energia, carbono ou sustentabilidade</span></div></article><article><h2>Governança</h2><p>Regras normativas versionadas, fontes declaradas, conciliação com receita real e publicação somente após aprovação.</p><a href="/Royalties/Governanca">Abrir trilha operacional →</a></article></section>
<section class="roy-card"><h2>Repasses recentes</h2>@if(Model.Recentes.Count==0){<div class="empty">Ainda não há repasses registrados para os filtros selecionados.</div>}else{<div class="responsive"><table><thead><tr><th>Competência</th><th>Receita</th><th>Descrição</th><th>Valor</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Recentes){<tr><td>@x.Competencia?.ToString("MM/yyyy")</td><td>@x.TipoReceita</td><td>@x.Nome</td><td>@x.Valor.ToString("C")</td><td><span class="badge @x.Status.ToLowerInvariant()">@x.Status</span></td></tr>}</tbody></table></div>}</section></main>
