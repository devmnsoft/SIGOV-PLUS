@model Sigov.Application.Royalties.RoyaltiesRequest
@{var recurso=(string)ViewData["Recurso"]!;ViewData["Title"]=ViewData["Titulo"];}
<link rel="stylesheet" href="~/css/royalties360.css" asp-append-version="true"/><main class="roy-shell"><partial name="_Nav"/><header class="page-head"><div><span class="eyebrow">CADASTRO CONTROLADO</span><h1>@ViewData["Titulo"]</h1></div></header><form method="post" action="/Royalties/@recurso/Save" class="roy-form"><input type="hidden" name="id" value="@ViewData["Id"]"/>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation wide"></div>
<label>Código obrigatório<input asp-for="Codigo"/><span asp-validation-for="Codigo"></span></label><label>Nome obrigatório<input asp-for="Nome"/><span asp-validation-for="Nome"></span></label><label>Tipo de receita<select asp-for="TipoReceita"><option value="ROYALTIES">Royalties</option><option value="PARTICIPACAO_ESPECIAL">Participação especial</option><option value="COMPENSACAO">Compensação</option><option value="BONUS">Bônus</option><option value="FUNDO_ESPECIAL">Fundo especial</option><option value="OUTRA">Outra</option></select><span asp-validation-for="TipoReceita"></span></label><label>Status<select asp-for="Status"><option>RASCUNHO</option><option>VIGENTE</option><option>VENCIDO</option><option>REVOGADO</option><option>LANCADO</option><option>CONCILIADO</option><option>DIVERGENTE</option><option>EM_ANALISE</option><option>APROVADO</option><option>EM_EXECUCAO</option><option>CONCLUIDO</option><option>CANCELADO</option><option>PUBLICADO</option></select><span asp-validation-for="Status"></span></label>
<label>Fonte de recurso obrigatória<select asp-for="FonteRecursoId" asp-items="ViewBag.Fontes"><option value="">Selecione no cadastro financeiro</option></select><span asp-validation-for="FonteRecursoId"></span></label><label>Exercício<select asp-for="ExercicioId" asp-items="ViewBag.Exercicios"><option value="">Selecione</option></select><span asp-validation-for="ExercicioId"></span></label><label>Unidade responsável<select asp-for="UnidadeId" asp-items="ViewBag.Unidades"><option value="">Selecione</option></select><span asp-validation-for="UnidadeId"></span></label><label>Operador (pessoa jurídica)<select asp-for="PessoaJuridicaId" asp-items="ViewBag.Pessoas"><option value="">Não informado</option></select><span asp-validation-for="PessoaJuridicaId"></span></label><label>Projeto financiado<select asp-for="ProjetoId" asp-items="ViewBag.Projetos"><option value="">Sem vínculo</option></select><span asp-validation-for="ProjetoId"></span></label><label>Parâmetro vigente<select asp-for="ParametroId" asp-items="ViewBag.Parametros"><option value="">Selecione quando aplicável</option></select><span asp-validation-for="ParametroId"></span></label><label>Contrato existente<select asp-for="ContratoId" asp-items="ViewBag.Contratos"><option value="">Sem vínculo</option></select><span asp-validation-for="ContratoId"></span></label>
<label>Competência<input asp-for="Competencia" type="month"/><span asp-validation-for="Competencia"></span></label><label>Data de referência/crédito<input asp-for="DataReferencia" type="date"/><span asp-validation-for="DataReferencia"></span></label><label>Vigência inicial<input asp-for="VigenciaInicio" type="date"/><span asp-validation-for="VigenciaInicio"></span></label><label>Vigência final<input asp-for="VigenciaFim" type="date"/><span asp-validation-for="VigenciaFim"></span></label><label>Valor<input asp-for="Valor" type="number" min="0" step="0.01"/><span asp-validation-for="Valor"></span></label><label>Valor bruto<input asp-for="ValorBruto" type="number" min="0" step="0.01"/><span asp-validation-for="ValorBruto"></span></label><label>Deduções<input asp-for="Deducoes" type="number" min="0" step="0.01"/><span asp-validation-for="Deducoes"></span></label><label>Valor líquido<input asp-for="ValorLiquido" type="number" min="0" step="0.01"/><span asp-validation-for="ValorLiquido"></span></label><label>Percentual/índice<input asp-for="Percentual" type="number" min="0" max="100" step="0.0001"/><span asp-validation-for="Percentual"></span></label><label>Cenário<select asp-for="Cenario"><option value="">Não aplicável</option><option>CONSERVADOR</option><option>BASE</option><option>OTIMISTA</option></select><span asp-validation-for="Cenario"></span></label>
<label class="wide">Fonte normativa<input asp-for="FonteNormativa" placeholder="Norma, artigo e referência oficial"/><span asp-validation-for="FonteNormativa"></span></label><label class="wide">Fórmula textual documentada<textarea asp-for="FormulaTextual"></textarea><span asp-validation-for="FormulaTextual"></span></label><label class="wide">Premissas<textarea asp-for="Premissas"></textarea><span asp-validation-for="Premissas"></span></label><label class="wide">Descrição técnica<textarea asp-for="Descricao"></textarea><span asp-validation-for="Descricao"></span></label><label class="wide">Justificativa de revisão/revogação/cancelamento<textarea asp-for="Justificativa"></textarea><span asp-validation-for="Justificativa"></span></label><label>Visibilidade<select asp-for="Visibilidade"><option>INTERNA</option><option>PUBLICA</option><option>SIGILOSA</option></select><span asp-validation-for="Visibilidade"></span></label><label class="check"><input asp-for="Publicavel"/> Conteúdo aprovado para publicação<span asp-validation-for="Publicavel"></span></label><div class="wide actions"><button>Salvar e registrar trilha</button><a class="ghost" href="/Royalties/@recurso">Cancelar</a></div></form></main>
