@model Sigov.Application.Royalties.RoyaltiesRegistro
@{ViewData["Title"]=$"{ViewData["Titulo"]} · {Model.Codigo}";}
<link rel="stylesheet" href="~/css/royalties360.css" asp-append-version="true"/><main class="roy-shell"><partial name="_Nav"/><header class="page-head"><div><span class="eyebrow">REGISTRO AUDITÁVEL</span><h1>@Model.Nome</h1></div><span class="badge @Model.Status.ToLowerInvariant()">@Model.Status</span></header><section class="roy-card details"><dl><div><dt>Código</dt><dd>@Model.Codigo</dd></div><div><dt>Tipo de receita</dt><dd>@Model.TipoReceita</dd></div><div><dt>Competência</dt><dd>@Model.Competencia?.ToString("MM/yyyy")</dd></div><div><dt>Valor</dt><dd>@Model.Valor.ToString("C")</dd></div><div class="wide"><dt>Descrição e evidência operacional</dt><dd>@Model.Descricao</dd></div></dl></section><a class="ghost" href="javascript:history.back()">← Voltar</a></main>
