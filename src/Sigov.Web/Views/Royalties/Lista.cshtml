@model IReadOnlyList<Sigov.Application.Royalties.RoyaltiesRegistro>
@{ViewData["Title"]=ViewData["Titulo"];var recurso=(string)ViewData["Recurso"]!;var publico=ViewData["Publico"] as bool?==true;}
<link rel="stylesheet" href="~/css/royalties360.css" asp-append-version="true"/><main class="roy-shell">@if(!publico){<partial name="_Nav"/>}<header class="page-head"><div><span class="eyebrow">ROYALTIES360</span><h1>@ViewData["Titulo"]</h1></div>@if(!publico&&ViewData["PodeGerenciar"] as bool?==true&&recurso is not("saldos" or "execucaofinanceira" or "governanca")){<a class="roy-button" href="@Request.Path/Create">Novo registro</a>}</header><form method="get" class="roy-filters"><label>Pesquisa<input name="busca" value="@Context.Request.Query["busca"]" placeholder="Código ou descrição"/></label><label>Status<select name="status"><option value="">Todos</option><option>RASCUNHO</option><option>VIGENTE</option><option>APROVADO</option><option>CONCILIADO</option><option>DIVERGENTE</option><option>PUBLICADO</option><option>ABERTO</option></select></label><label>Tipo de receita<select name="tipoReceita"><option value="">Todos</option><option value="ROYALTIES">Royalties</option><option value="PARTICIPACAO_ESPECIAL">Participação especial</option><option value="COMPENSACAO">Compensação</option><option value="BONUS">Bônus</option><option value="FUNDO_ESPECIAL">Fundo especial</option><option value="OUTRA">Outra</option></select></label><button>Filtrar</button>@if(!publico){<a class="ghost" href="/Royalties/Relatorios/@recurso.csv">CSV seguro</a>}</form><section class="roy-card"><div class="responsive"><table><thead><tr><th>Código</th><th>Descrição</th><th>Competência</th><th>Tipo</th><th>Valor</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Codigo</td><td><b>@x.Nome</b><small>@x.Descricao</small></td><td>@x.Competencia?.ToString("MM/yyyy")</td><td>@x.TipoReceita</td><td>@x.Valor.ToString("C")</td><td><span class="badge @x.Status.ToLowerInvariant()">@x.Status</span></td><td>@if(!publico){<a href="/Royalties/@recurso/Details/@x.Id">Detalhes</a>}</td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="empty">Nenhum registro aprovado ou compatível com os filtros. Revise os filtros ou cadastre a primeira informação validada.</td></tr>}</tbody></table></div></section></main>
