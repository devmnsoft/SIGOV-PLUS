@using Sigov.Application.Almoxarifado
@{ViewData["Title"]="Nova transferência";var locais=(IReadOnlyList<LocalDto>)ViewBag.Locais;var materiais=(IReadOnlyList<MaterialDto>)ViewBag.Materiais;}
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Almoxarifado">Estoque e Distribuição</a></li><li class="breadcrumb-item"><a href="/Almoxarifado/Transferencias">Transferências</a></li><li class="breadcrumb-item active">Nova</li></ol></nav>
<h1 class="h3">Nova transferência</h1><p class="text-secondary">O rascunho não altera o estoque. A transferência fica restrita à entidade e ao tenant atuais.</p>
<form method="post" class="card card-body" data-prevent-double-submit>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="origemId">Almoxarifado de origem <span aria-hidden="true">*</span></label><select class="form-select" id="origemId" name="origemId" required><option value="">Selecione</option>@foreach(var x in locais){<option value="@x.Id">@x.Nome (@x.Codigo)</option>}</select></div><div class="col-md-6"><label class="form-label" for="destinoId">Almoxarifado de destino <span aria-hidden="true">*</span></label><select class="form-select" id="destinoId" name="destinoId" required><option value="">Selecione</option>@foreach(var x in locais){<option value="@x.Id">@x.Nome (@x.Codigo)</option>}</select></div>
<div class="col-md-6"><label class="form-label" for="materialId">Material <span aria-hidden="true">*</span></label><select class="form-select" id="materialId" name="materialId" required><option value="">Selecione</option>@foreach(var x in materiais){<option value="@x.Id">@x.Descricao (@x.Codigo) — @x.UnidadeMedida</option>}</select></div><div class="col-md-3"><label class="form-label" for="quantidade">Quantidade <span aria-hidden="true">*</span></label><input class="form-control" id="quantidade" name="quantidade" type="number" min="0.0001" step="0.0001" required /></div><div class="col-md-3"><label class="form-label" for="lote">Lote</label><input class="form-control" id="lote" name="lote" maxlength="100" /></div>
<div class="col-md-4"><label class="form-label" for="esferaGoverno">Esfera de governo <span aria-hidden="true">*</span></label><select class="form-select" id="esferaGoverno" name="esferaGoverno" required><option value="municipal">Municipal</option><option value="estadual">Estadual</option><option value="federal">Federal</option></select></div><div class="col-md-8"><label class="form-label" for="responsavel">Responsável <span aria-hidden="true">*</span></label><input class="form-control" id="responsavel" name="responsavel" maxlength="200" required /></div><div class="col-12"><label class="form-label" for="justificativa">Justificativa <span aria-hidden="true">*</span></label><textarea class="form-control" id="justificativa" name="justificativa" rows="3" required></textarea></div></div>
<div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Salvar rascunho</button><a class="btn btn-outline-secondary" href="/Almoxarifado/Transferencias">Cancelar</a></div></form>
