@model Sigov.Application.Almoxarifado.AlmoxarifadoPagina<Sigov.Application.Almoxarifado.MaterialDto>
@{ViewData["Title"]="Materiais";}<div class="d-flex justify-content-between"><h1 class="h3">Materiais</h1><a class="btn btn-primary" href="/Almoxarifado/Materiais/Novo">Cadastrar</a></div><form class="row g-2 my-3"><div class="col-md-8"><input class="form-control" name="Busca" placeholder="Código ou descrição" value="@Context.Request.Query["Busca"]" /></div><div class="col-md-2"><select class="form-select" name="Ativo"><option value="">Todos</option><option value="true">Ativos</option><option value="false">Inativos</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Código</th><th>Descrição</th><th>Tipo</th><th>Unidade</th><th>Categoria</th><th>Mín./Máx.</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge bg-@(x.TipoMaterial=="PERMANENTE"?"info":"secondary")">@x.TipoMaterial</span></td><td>@x.UnidadeMedida</td><td>@x.Categoria</td><td>@x.EstoqueMinimo / @(x.EstoqueMaximo?.ToString()??"—")</td><td><span class="badge bg-@(x.Ativo?"success":"secondary")">@(x.Ativo?"Ativo":"Inativo")</span></td><td><a href="/Almoxarifado/Materiais/@x.Id/Editar">Editar</a></td></tr>}@if(Model.Itens.Count==0){<tr><td colspan="8" class="text-center text-muted py-5">Nenhum material encontrado.</td></tr>}</tbody></table></div>@if(ViewBag.Exportar==true){<a class="btn btn-sm btn-outline-secondary" href="/Almoxarifado/Exportar/catalogo">Exportar CSV</a>}
