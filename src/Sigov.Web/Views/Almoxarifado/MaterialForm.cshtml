@model Sigov.Application.Almoxarifado.MaterialInput
@{ViewData["Title"]=ViewBag.Id is null?"Novo material":"Editar material";}<h1 class="h3">@ViewData["Title"]</h1><form method="post" class="card card-body"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-3"><label class="form-label">Código</label><input asp-for="Codigo" class="form-control" required /></div><div class="col-md-9"><label class="form-label">Descrição</label><input asp-for="Descricao" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Tipo</label><select asp-for="TipoMaterial" class="form-select"><option>CONSUMO</option><option>PERMANENTE</option></select></div><div class="col-md-4"><label class="form-label">Unidade</label><input asp-for="UnidadeMedida" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Categoria</label><input asp-for="Categoria" class="form-control" /></div><div class="col-md-3"><label class="form-label">Estoque mínimo</label><input asp-for="EstoqueMinimo" class="form-control" min="0" /></div><div class="col-md-3"><label class="form-label">Estoque máximo</label><input asp-for="EstoqueMaximo" class="form-control" min="0" /></div><div class="col-md-2 form-check mt-5"><input asp-for="ControlaLote" class="form-check-input" /><label asp-for="ControlaLote" class="form-check-label">Controla lote</label></div><div class="col-md-2 form-check mt-5"><input asp-for="ControlaValidade" class="form-check-input" /><label asp-for="ControlaValidade" class="form-check-label">Controla validade</label></div><div class="col-md-2 form-check mt-5"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Ativo</label></div></div><div class="mt-3"><button class="btn btn-primary">Salvar</button><a class="btn btn-link" href="/Almoxarifado/Materiais">Cancelar</a></div></form>
