@model Sigov.Application.Almoxarifado.EntregaDto
@{ViewData["Title"]=$"Entrega {Model.Id}";}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Almoxarifado/Requisicoes/Detalhe/@Model.RequisicaoId">Solicitação #@Model.RequisicaoId</a></li><li class="breadcrumb-item active">Entrega #@Model.Id</li></ol></nav>
<header class="d-flex justify-content-between border-bottom pb-3 mb-3"><div><h1 class="h3">Revisão da entrega #@Model.Id</h1><p class="text-muted mb-0">Origem: @Model.LocalOrigem</p></div><span class="badge text-bg-primary align-self-start fs-6">● @Model.Status</span></header>
<details class="alert alert-light border"><summary class="fw-semibold">Como usar</summary><p class="mb-0 mt-2">Confira os itens antes de expedir. No destino, registre cada quantidade recebida ou recusada; não deixe a conferência implícita.</p></details>
<div class="table-responsive"><table class="table align-middle"><thead class="table-light"><tr><th>Material</th><th>Unidade</th><th class="text-end">Expedido</th><th class="text-end">Recebido</th><th class="text-end">Recusado</th><th>Divergência</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.MaterialCodigo — @x.MaterialDescricao</td><td>@x.UnidadeMedida</td><td class="text-end">@x.QuantidadeExpedida</td><td class="text-end">@x.QuantidadeRecebida</td><td class="text-end">@x.QuantidadeRecusada</td><td>@(x.Divergencia??"—")</td></tr>}</tbody></table></div>
@if(Model.Status=="SEPARADA"&&ViewBag.Expedir==true){<form method="post" action="/Almoxarifado/Entregas/@Model.Id/Expedir" class="d-flex gap-2 mb-4">@Html.AntiForgeryToken()<button class="btn btn-primary">Confirmar expedição</button><button type="button" class="btn btn-outline-secondary" onclick="window.print()">Imprimir comprovante</button></form>}
@if((Model.Status=="EXPEDIDA"||Model.Status=="RECEBIDA_PARCIAL"||Model.Status=="DIVERGENCIA")&&ViewBag.Receber==true){<form method="post" action="/Almoxarifado/Entregas/@Model.Id/Receber" class="border rounded p-3"><h2 class="h5">Confirmar recebimento</h2>@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")"/><div class="table-responsive"><table class="table"><thead><tr><th>Material</th><th>Receber agora</th><th>Recusar agora</th><th>Motivo da divergência</th></tr></thead><tbody>@for(var i=0;i<Model.Itens.Count;i++){var x=Model.Itens[i];var restante=x.QuantidadeExpedida-x.QuantidadeRecebida-x.QuantidadeRecusada;<tr><td>@x.MaterialDescricao <small class="text-muted">(pendente @restante)</small><input type="hidden" name="itens[@i].EntregaItemId" value="@x.Id"/></td><td><input class="form-control" name="itens[@i].QuantidadeRecebida" type="number" min="0" max="@restante" step="0.0001" value="0"/></td><td><input class="form-control" name="itens[@i].QuantidadeRecusada" type="number" min="0" max="@restante" step="0.0001" value="0"/></td><td><input class="form-control" name="itens[@i].Divergencia" aria-label="Motivo da divergência de @x.MaterialDescricao"/></td></tr>}</tbody></table></div><label class="form-label" for="observacao">Observação da conferência</label><textarea class="form-control mb-3" id="observacao" name="observacao"></textarea><button class="btn btn-primary">Registrar conferência</button></form>}
<style media="print">.sigov-sidebar,.navbar,button,details{display:none!important}main{margin:0!important}.table{font-size:11pt}</style>
