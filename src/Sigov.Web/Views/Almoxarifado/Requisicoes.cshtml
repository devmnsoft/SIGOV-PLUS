@model Sigov.Application.Almoxarifado.AlmoxarifadoPagina<Sigov.Application.Almoxarifado.RequisicaoDto>
@{ ViewData["Title"] = "Distribuição de materiais"; var filtros = ViewBag.FiltrosSalvos as IReadOnlyList<Sigov.Web.Services.SavedFilter> ?? Array.Empty<Sigov.Web.Services.SavedFilter>(); }
<header class="sigov-page-hero"><div><span class="sigov-eyebrow">Almoxarifado</span><h1>Distribuição de materiais</h1><p>Acompanhe solicitação, separação, expedição e recebimento.</p></div><a class="sigov-btn sigov-btn--primary" href="/Almoxarifado/Requisicoes/Nova">Nova solicitação</a></header>
<section class="sigov-filter-bar my-3" aria-labelledby="distribution-filter-title"><h2 id="distribution-filter-title" class="h5">Filtros</h2>
<form method="get" class="row g-2 align-items-end"><div class="col-sm-6 col-lg-4"><label class="form-label" for="distribution-status">Estado</label><select id="distribution-status" name="status" class="form-select"><option value="">Todos os estados</option>@foreach(var status in new[]{"RASCUNHO","ENVIADA","APROVADA","ATENDIDA","CANCELADA","REJEITADA"}){<option value="@status" selected="@(ViewBag.Status == status)">@status</option>}</select></div><div class="col-auto"><button class="sigov-btn sigov-btn--primary" type="submit">Aplicar</button></div></form>
<div class="mt-3 d-flex gap-2 flex-wrap">@foreach(var filtro in filtros){<a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="/Almoxarifado/Requisicoes?status=@filtro.Status">@(filtro.IsDefault ? "★ " : "")@filtro.Name</a><form method="post" action="/FiltrosSalvos/Excluir">@Html.AntiForgeryToken()<input type="hidden" name="screen" value="distribuicao-materiais"/><input type="hidden" name="name" value="@filtro.Name"/><button type="submit" class="btn btn-link btn-sm text-danger" aria-label="Excluir filtro @filtro.Name">Excluir</button></form><details><summary class="small">Renomear</summary><form method="post" action="/FiltrosSalvos/Renomear">@Html.AntiForgeryToken()<input type="hidden" name="screen" value="distribuicao-materiais"/><input type="hidden" name="currentName" value="@filtro.Name"/><label class="visually-hidden" for="rename-distribution-@filtro.Name.GetHashCode()">Novo nome</label><input id="rename-distribution-@filtro.Name.GetHashCode()" name="newName" maxlength="80" required/><button type="submit" class="btn btn-link btn-sm">Confirmar</button></form></details>}</div>
<details class="mt-2"><summary>Salvar filtro atual</summary><form method="post" action="/FiltrosSalvos/Salvar" class="row g-2 mt-1">@Html.AntiForgeryToken()<input type="hidden" name="screen" value="distribuicao-materiais"/><input type="hidden" name="status" value="@ViewBag.Status"/><div class="col-sm-5"><label class="form-label" for="distribution-filter-name">Nome do filtro <span aria-hidden="true">*</span></label><input class="form-control" id="distribution-filter-name" name="name" maxlength="80" required/></div><div class="col-auto form-check align-self-end mb-2"><input class="form-check-input" id="distribution-default" name="isDefault" value="true" type="checkbox"/><label class="form-check-label" for="distribution-default">Usar como padrão</label></div><div class="col-auto align-self-end"><button class="sigov-btn sigov-btn--ghost" type="submit">Salvar</button></div></form><p class="form-text">Como usar: o filtro é pessoal, restrito a este cliente e não altera suas permissões.</p></details></section>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Nº</th><th>Local</th><th>Data</th><th>Itens</th><th>Estado</th></tr></thead><tbody>@foreach(var item in Model.Itens){<tr><td><a href="/Almoxarifado/Requisicoes/Detalhe/@item.Id?status=@ViewBag.Status&pagina=@Model.Pagina">@item.Id</a></td><td>@item.LocalNome</td><td>@item.CreatedAt.ToLocalTime().ToString("g")</td><td>@item.TotalItens</td><td><span class="badge bg-secondary">@item.Status</span></td></tr>}@if(Model.Itens.Count==0){<tr><td colspan="5"><div class="sigov-empty-state-premium"><strong>Nenhuma distribuição encontrada</strong><span>Revise o estado selecionado ou crie uma solicitação autorizada.</span></div></td></tr>}</tbody></table></div>
@if(Model.Total > Model.TamanhoPagina){var paginas=(int)Math.Ceiling(Model.Total/(double)Model.TamanhoPagina);<nav aria-label="Paginação da distribuição"><ul class="pagination">@for(var pagina=1;pagina<=paginas;pagina++){<li class="page-item @(pagina==Model.Pagina?"active":"")"><a class="page-link" href="?status=@ViewBag.Status&pagina=@pagina">@pagina</a></li>}</ul></nav>}
