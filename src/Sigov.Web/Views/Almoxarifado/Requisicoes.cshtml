@model Sigov.Application.Almoxarifado.AlmoxarifadoPagina<Sigov.Application.Almoxarifado.RequisicaoDto>
@{ViewData["Title"]="Requisições";}<div class="d-flex justify-content-between"><h1 class="h3">Requisições</h1><a class="btn btn-primary" href="/Almoxarifado/Requisicoes/Nova">Nova</a></div><form class="my-3"><select name="status" class="form-select" onchange="this.form.submit()"><option value="">Todos os status</option>@foreach(var s in new[]{"RASCUNHO","ENVIADA","APROVADA","ATENDIDA","CANCELADA","REJEITADA"}){<option selected="@(Context.Request.Query["status"]==s)">@s</option>}</select></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Nº</th><th>Local</th><th>Data</th><th>Itens</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td><a href="/Almoxarifado/Requisicoes/Detalhe/@x.Id">@x.Id</a></td><td>@x.LocalNome</td><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td>@x.TotalItens</td><td><span class="badge bg-secondary">@x.Status</span></td></tr>}@if(Model.Itens.Count==0){<tr><td colspan="5" class="text-center text-muted py-5">Nenhuma requisição encontrada.</td></tr>}</tbody></table></div>
