@model Sigov.Application.Almoxarifado.AlmoxarifadoPagina<Sigov.Application.Almoxarifado.RequisicaoDto>
@{ 
    ViewData["Title"] = "Distribuição de materiais"; 
    var filtros = ViewBag.FiltrosSalvos as IReadOnlyList<Sigov.Web.Services.SavedFilter> ?? Array.Empty<Sigov.Web.Services.SavedFilter>(); 
}
<link rel="stylesheet" href="~/css/almoxarifado.css" asp-append-version="true" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Almoxarifado">Almoxarifado</a></li>
        <li class="breadcrumb-item active" aria-current="page">Distribuição e Solicitações</li>
    </ol>
</nav>

<header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Distribuição de materiais</h1>
        <p class="text-muted mb-0">Acompanhe solicitação, autorização, atendimento e conferência de entregas.</p>
    </div>
    <a class="btn btn-primary" href="/Almoxarifado/Requisicoes/Nova">Nova solicitação</a>
</header>

<details class="how-to mb-4">
    <summary>Como usar esta tela</summary>
    <div class="mt-2 text-secondary">
        <p>A distribuição operacionaliza os pedidos internos de consumo e materiais dos diversos setores e secretarias:</p>
        <ul>
            <li><strong>Fluxo formal:</strong> Rascunho &rarr; Enviada &rarr; Aprovada &rarr; Atendida ou Cancelada.</li>
            <li><strong>Unidade solicitante:</strong> Identifica a secretaria ou unidade que receberá o material.</li>
            <li><strong>Baixa de estoque:</strong> Ocorre apenas na efetivação do atendimento ou conferência das entregas parciais.</li>
        </ul>
    </div>
</details>

<section class="card card-body mb-4" aria-labelledby="distribution-filter-title">
    <h2 id="distribution-filter-title" class="h6 text-muted mb-3">Filtros de busca</h2>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-4">
            <label class="form-label" for="distribution-status">Estado / Situação</label>
            <select id="distribution-status" name="status" class="form-select">
                <option value="">Todos os estados</option>
                @foreach (var status in new[] { "RASCUNHO", "ENVIADA", "APROVADA", "ATENDIDA", "CANCELADA", "REJEITADA" })
                {
                    <option value="@status" selected="@(ViewBag.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="submit">Aplicar filtro</button>
            @if (!string.IsNullOrEmpty(ViewBag.Status as string))
            {
                <a class="btn btn-outline-secondary" href="/Almoxarifado/Requisicoes">Limpar</a>
            }
        </div>
    </form>

    <div class="mt-3 d-flex gap-2 flex-wrap">
        @foreach (var filtro in filtros)
        {
            <a class="btn btn-sm btn-outline-secondary" href="/Almoxarifado/Requisicoes?status=@filtro.Status">@(filtro.IsDefault ? "★ " : "")@filtro.Name</a>
            <form method="post" action="/FiltrosSalvos/Excluir" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="screen" value="distribuicao-materiais" />
                <input type="hidden" name="name" value="@filtro.Name" />
                <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-1" aria-label="Excluir filtro @filtro.Name">×</button>
            </form>
        }
    </div>

    <details class="mt-3">
        <summary class="small text-muted">Salvar filtro atual</summary>
        <form method="post" action="/FiltrosSalvos/Salvar" class="row g-2 mt-1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="screen" value="distribuicao-materiais" />
            <input type="hidden" name="status" value="@ViewBag.Status" />
            <div class="col-sm-5">
                <label class="form-label visually-hidden" for="distribution-filter-name">Nome do filtro</label>
                <input class="form-control form-control-sm" id="distribution-filter-name" name="name" placeholder="Nome do filtro" maxlength="80" required />
            </div>
            <div class="col-auto form-check align-self-center mb-0">
                <input class="form-check-input" id="distribution-default" name="isDefault" value="true" type="checkbox" />
                <label class="form-check-label small" for="distribution-default">Usar como padrão</label>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" type="submit">Salvar</button>
            </div>
        </form>
    </details>
</section>

<div class="table-responsive mb-4">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nº Solicitação</th>
                <th>Origem / Almoxarifado</th>
                <th>Unidade solicitante</th>
                <th>Data</th>
                <th class="text-center">Itens</th>
                <th>Situação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                var solicitanteNome = !string.IsNullOrWhiteSpace(item.UnidadeSolicitanteNome)
                    ? item.UnidadeSolicitanteNome
                    : (item.UnidadeSolicitanteId?.ToString() ?? "—");

                <tr>
                    <td>
                        <a class="fw-semibold" href="/Almoxarifado/Requisicoes/Detalhe/@item.Id?status=@ViewBag.Status&pagina=@Model.Pagina">#@item.Id</a>
                    </td>
                    <td>@item.LocalNome</td>
                    <td>@solicitanteNome</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-center">@item.TotalItens</td>
                    <td>
                        <span class="badge text-bg-@(item.Status == "ATENDIDA" ? "success" : item.Status == "APROVADA" ? "primary" : item.Status == "REJEITADA" || item.Status == "CANCELADA" ? "danger" : "secondary")">@item.Status</span>
                    </td>
                </tr>
            }
            @if (Model.Itens.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <p class="mb-0">Nenhuma solicitação encontrada no estado selecionado.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Total > Model.TamanhoPagina)
{
    var paginas = (int)Math.Ceiling(Model.Total / (double)Model.TamanhoPagina);
    <nav aria-label="Paginação da distribuição">
        <ul class="pagination">
            @for (var pagina = 1; pagina <= paginas; pagina++)
            {
                <li class="page-item @(pagina == Model.Pagina ? "active" : "")">
                    <a class="page-link" href="?status=@ViewBag.Status&pagina=@pagina">@pagina</a>
                </li>
            }
        </ul>
    </nav>
}
