@model Sigov.Application.Almoxarifado.AlmoxarifadoDashboard
@{ViewData["Title"]="Almoxarifado";}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1 class="h3 mb-1">Almoxarifado</h1><p class="text-muted mb-0">Indicadores operacionais do contexto atual.</p></div><div class="btn-group"><a class="btn btn-primary" href="/Almoxarifado/Materiais/Novo">Novo material</a><a class="btn btn-outline-primary" href="/Almoxarifado/Movimentacoes/NovaEntrada">Entrada</a><a class="btn btn-outline-danger" href="/Almoxarifado/Movimentacoes/NovaSaida">Saída</a></div></div>
<div class="row g-3">@foreach(var x in new[]{("Materiais ativos",Model.MateriaisAtivos,"primary"),("Abaixo do mínimo",Model.AbaixoMinimo,"danger"),("Requisições pendentes",Model.RequisicoesPendentes,"warning"),("Entradas no mês",Model.EntradasMes,"success"),("Saídas no mês",Model.SaidasMes,"secondary"),("Tombamentos pendentes",Model.PendenciasPatrimoniais,"info")}){<div class="col-6 col-lg-2"><div class="card h-100 border-@x.Item3"><div class="card-body"><span class="small text-muted">@x.Item1</span><div class="fs-3 fw-bold">@x.Item2</div></div></div></div>}</div>
<div class="row g-3 mt-1"><div class="col-lg-7"><div class="card"><div class="card-header fw-semibold">Últimos movimentos</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Data</th><th>Material</th><th>Local</th><th>Tipo</th><th class="text-end">Qtd.</th></tr></thead><tbody>@foreach(var x in Model.UltimosMovimentos){<tr><td>@x.OcorridoEm.ToLocalTime().ToString("g")</td><td>@x.MaterialCodigo — @x.MaterialDescricao</td><td>@x.LocalNome</td><td><span class="badge bg-@(x.Tipo=="ENTRADA"?"success":"danger")">@x.Tipo</span></td><td class="text-end">@x.Quantidade</td></tr>}@if(Model.UltimosMovimentos.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">Nenhuma movimentação registrada.</td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="card"><div class="card-header fw-semibold">Baixo estoque</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Material</th><th>Local</th><th>Saldo / mínimo</th></tr></thead><tbody>@foreach(var x in Model.BaixoEstoque){<tr><td>@x.MaterialCodigo — @x.MaterialDescricao</td><td>@x.LocalNome</td><td><span class="badge bg-danger">@x.Quantidade / @x.EstoqueMinimo</span></td></tr>}@if(Model.BaixoEstoque.Count==0){<tr><td colspan="3" class="text-center text-muted py-4">Nenhum item abaixo do mínimo.</td></tr>}</tbody></table></div></div></div></div>
<nav class="mt-3 d-flex flex-wrap gap-2"><a href="/Almoxarifado/Materiais">Materiais</a><a href="/Almoxarifado/Locais">Locais</a><a href="/Almoxarifado/Estoque">Estoque</a><a href="/Almoxarifado/Requisicoes">Requisições</a></nav>
