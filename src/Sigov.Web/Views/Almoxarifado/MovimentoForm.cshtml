@model Sigov.Application.Almoxarifado.MovimentacaoInput
@{var entrada=(bool)ViewBag.Entrada;ViewData["Title"]=entrada?"Entrada":"Saída";}<h1 class="h3">Nova @(entrada?"entrada":"saída")</h1><form method="post" action="/Almoxarifado/Movimentacoes/@(entrada?"entrada":"saida")" class="card card-body">
    @Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Almoxarifado</label><select asp-for="AlmoxarifadoId" class="form-select" required><option value="">Selecione</option>@foreach(var x in (IReadOnlyList<Sigov.Application.Almoxarifado.LocalDto>)ViewBag.Locais){<option value="@x.Id">@x.Codigo — @x.Nome</option>}</select></div><div class="col-md-6"><label class="form-label">Material</label><select asp-for="MaterialId" class="form-select" required><option value="">Selecione</option>@foreach(var x in (IReadOnlyList<Sigov.Application.Almoxarifado.MaterialDto>)ViewBag.Materiais){<option value="@x.Id">@x.Codigo — @x.Descricao</option>}</select></div><div class="col-md-3"><label class="form-label">Quantidade</label><input asp-for="Quantidade" class="form-control" min="0.0001" step="0.0001" required /></div><div class="col-md-3"><label class="form-label">Motivo</label><select asp-for="Tipo" class="form-select">@foreach(var x in (entrada?new[]{"COMPRA","DOACAO","AJUSTE_POSITIVO","TRANSFERENCIA_RECEBIDA"}:new[]{"CONSUMO","PERDA","AJUSTE_NEGATIVO","TRANSFERENCIA"})){<option>@x</option>}</select></div><div class="col-md-3"><label class="form-label">Documento</label><input asp-for="DocumentoOrigem" class="form-control" /></div><div class="col-md-3"><label class="form-label">Lote</label><input asp-for="Lote" class="form-control" /></div><div class="col-md-3"><label class="form-label">Validade</label><input asp-for="Validade" type="date" class="form-control" /></div><div class="col-md-9"><label class="form-label">Observação</label><input asp-for="Observacao" class="form-control" /></div></div><button class="btn btn-primary mt-3 align-self-start">Registrar</button></form>
