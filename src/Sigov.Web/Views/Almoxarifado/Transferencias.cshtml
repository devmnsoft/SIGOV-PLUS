@model Sigov.Application.Almoxarifado.AlmoxarifadoPagina<Sigov.Application.Almoxarifado.TransferenciaDto>
@{ViewData["Title"]="Transferências entre almoxarifados";}
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Almoxarifado">Estoque e Distribuição</a></li><li class="breadcrumb-item active" aria-current="page">Transferências</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3 mb-1">Transferências entre almoxarifados</h1><p class="text-secondary mb-0">Expedição, trânsito, recebimentos parciais e divergências dentro da entidade atual.</p></div>@if((bool)ViewBag.PodeCriar){<a class="btn btn-primary" href="/Almoxarifado/Transferencias/Nova">Nova transferência</a>}</div>
<form method="get" class="row g-2 mb-3" aria-label="Filtros"><div class="col-sm-5"><label class="form-label" for="status">Estado</label><select class="form-select" id="status" name="status"><option value="">Todos</option>@foreach(var s in new[]{"RASCUNHO","EM_TRANSITO","RECEBIDA_PARCIAL","DIVERGENCIA","RECEBIDA","CANCELADA"}){<option value="@s" selected="@(ViewBag.Status==s)">@s.Replace('_',' ')</option>}</select></div><div class="col-sm-auto align-self-end"><button class="btn btn-outline-primary">Filtrar</button></div></form>
<div class="table-responsive border rounded"><table class="table table-hover align-middle mb-0"><thead><tr><th>Documento</th><th>Origem</th><th>Destino</th><th>Estado</th><th>Data</th><th></th></tr></thead><tbody>@if(Model.Itens.Count==0){<tr><td colspan="6" class="text-center text-secondary py-4">Nenhuma transferência encontrada.</td></tr>}@foreach(var x in Model.Itens){<tr><td>#@x.Id</td><td>@x.OrigemNome</td><td>@x.DestinoNome</td><td><span class="badge text-bg-primary">@x.Status.Replace('_',' ')</span></td><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td><a class="btn btn-sm btn-outline-primary" href="/Almoxarifado/Transferencias/@x.Id">Abrir</a></td></tr>}</tbody></table></div>
<p class="small text-secondary mt-2">Página @Model.Pagina · @Model.Itens.Count de @Model.Total registros.</p>
<details class="mt-4"><summary class="fw-semibold">Como usar</summary><p class="mt-2">Crie o rascunho, confira origem, destino e itens, depois faça a expedição. No destino, registre somente o que foi efetivamente recebido e descreva recusas; pendências não são convertidas automaticamente em perda.</p></details>
