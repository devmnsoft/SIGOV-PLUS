@model IReadOnlyList<Sigov.Application.Almoxarifado.LocalDto>
@{ViewData["Title"]="Locais de estoque";}<h1 class="h3">Locais de estoque</h1><form method="post" class="card card-body mb-3"><div class="row g-2"><div class="col-md-2"><input name="Codigo" class="form-control" placeholder="Código" required /></div><div class="col-md-4"><input name="Nome" class="form-control" placeholder="Nome" required /></div><div class="col-md-4"><input name="ResponsavelNome" class="form-control" placeholder="Responsável" /></div><input type="hidden" name="Ativo" value="true"/><div class="col-md-2"><button class="btn btn-primary w-100">Cadastrar</button></div></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Código</th><th>Nome</th><th>Responsável</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Codigo</td><td>@x.Nome</td><td>@x.ResponsavelNome</td><td>@(x.Ativo?"Ativo":"Inativo")</td></tr>}@if(Model.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">Nenhum local cadastrado.</td></tr>}</tbody></table></div>
