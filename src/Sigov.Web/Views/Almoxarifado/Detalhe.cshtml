@model Sigov.Application.Almoxarifado.RequisicaoDetalhe
@{ViewData["Title"]=$"Solicitação {Model.Requisicao.Id}"; var pendente=Model.Itens.Sum(x=>x.QuantidadeSolicitada-x.QuantidadeAtendida);}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Almoxarifado">Almoxarifado</a></li><li class="breadcrumb-item"><a href="/Almoxarifado/Requisicoes">Solicitações internas</a></li><li class="breadcrumb-item active">#@Model.Requisicao.Id</li></ol></nav>
<header class="d-flex flex-wrap justify-content-between align-items-start gap-3 border-bottom pb-3 mb-3"><div><h1 class="h3 mb-1">Solicitação interna #@Model.Requisicao.Id</h1><p class="text-muted mb-0">Unidade solicitante: @(Model.Requisicao.UnidadeSolicitanteId?.ToString()??"não informada") · Origem: @Model.Requisicao.LocalNome</p></div><span class="badge text-bg-primary fs-6"><span aria-hidden="true">●</span> @Model.Requisicao.Status</span></header>
<details class="alert alert-light border mb-3"><summary class="fw-semibold">Como usar</summary><p class="mb-0 mt-2">Envie o rascunho para autorização. Depois da aprovação, informe somente as quantidades realmente separadas; revise a entrega antes de expedir. O recebimento é uma confirmação explícita e divergências ficam registradas.</p></details>
<div class="table-responsive"><table class="table align-middle"><thead class="table-light"><tr><th>Material</th><th>Unidade</th><th class="text-end">Solicitado</th><th class="text-end">Atendido</th><th class="text-end">Pendente</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.Codigo — @x.Descricao</td><td>@x.UnidadeMedida</td><td class="text-end">@x.QuantidadeSolicitada</td><td class="text-end">@x.QuantidadeAtendida</td><td class="text-end fw-semibold">@(x.QuantidadeSolicitada-x.QuantidadeAtendida)</td></tr>}</tbody><tfoot><tr><th colspan="4">Pendente total</th><th class="text-end">@pendente</th></tr></tfoot></table></div>
<div class="d-flex flex-wrap gap-2 mb-4">@if(Model.Requisicao.Status=="RASCUNHO"&&ViewBag.Criar==true){<form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/enviar">@Html.AntiForgeryToken()<button class="btn btn-primary">Enviar para autorização</button></form>}@if(Model.Requisicao.Status=="ENVIADA"&&ViewBag.Aprovar==true){<form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/aprovar">@Html.AntiForgeryToken()<button class="btn btn-success">Autorizar</button></form><form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/rejeitar" class="d-flex gap-2">@Html.AntiForgeryToken()<input name="justificativa" class="form-control" aria-label="Justificativa da rejeição" placeholder="Justificativa" required/><button class="btn btn-outline-danger">Rejeitar</button></form>}</div>
@if(Model.Requisicao.Status=="APROVADA"&&ViewBag.Atender==true){<section class="border rounded p-3 mb-4"><h2 class="h5">Separação</h2><p class="text-muted">A confirmação reserva somente esta entrega. Quantidades em branco ou zero não serão incluídas.</p><form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/Separar">@Html.AntiForgeryToken()<input type="hidden" name="almoxarifadoId" value="@Model.Requisicao.AlmoxarifadoId"/><input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")"/><div class="table-responsive"><table class="table"><thead><tr><th>Material</th><th>Disponível para solicitar</th><th>Quantidade a separar</th></tr></thead><tbody>@for(var i=0;i<Model.Itens.Count;i++){var x=Model.Itens[i];<tr><td>@x.Codigo — @x.Descricao</td><td>@(x.QuantidadeSolicitada-x.QuantidadeAtendida) @x.UnidadeMedida</td><td><input type="hidden" name="itens[@i].RequisicaoItemId" value="@x.Id"/><input name="itens[@i].Quantidade" type="number" min="0" max="@(x.QuantidadeSolicitada-x.QuantidadeAtendida)" step="0.0001" value="0" class="form-control" aria-label="Quantidade de @x.Descricao"/></td></tr>}</tbody></table></div><button class="btn btn-primary">Revisar entrega separada</button></form></section>}
@if(Model.Entregas.Count>0){<section class="mb-4"><h2 class="h5">Entregas relacionadas</h2><div class="table-responsive"><table class="table"><thead><tr><th>Entrega</th><th>Situação</th><th>Criada em</th><th></th></tr></thead><tbody>@foreach(var x in Model.Entregas){<tr><td>#@x.Id</td><td>@x.Status</td><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td><a href="/Almoxarifado/Entregas/@x.Id">Abrir conferência</a></td></tr>}</tbody></table></div></section>}
<h2 class="h5">Histórico</h2><ol class="list-group list-group-numbered">@foreach(var x in Model.Historico){<li class="list-group-item"><strong>@x.StatusNovo</strong> <span class="text-muted">@x.OcorridoEm.ToLocalTime().ToString("g")</span>@if(!string.IsNullOrWhiteSpace(x.Justificativa)){<div>@x.Justificativa</div>}</li>}</ol>
