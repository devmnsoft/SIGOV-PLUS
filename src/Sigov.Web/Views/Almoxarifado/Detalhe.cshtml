@model Sigov.Application.Almoxarifado.RequisicaoDetalhe
@{ViewData["Title"]=$"Requisição {Model.Requisicao.Id}";}<div class="d-flex justify-content-between"><h1 class="h3">Requisição #@Model.Requisicao.Id</h1><span class="badge bg-secondary fs-6">@Model.Requisicao.Status</span></div><p class="text-muted">Local: @Model.Requisicao.LocalNome · Criada em @Model.Requisicao.CreatedAt.ToLocalTime().ToString("g")</p><div class="table-responsive"><table class="table"><thead><tr><th>Material</th><th>Unidade</th><th>Solicitado</th><th>Atendido</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.Codigo — @x.Descricao</td><td>@x.UnidadeMedida</td><td>@x.QuantidadeSolicitada</td><td>@x.QuantidadeAtendida</td></tr>}</tbody></table></div><div class="d-flex flex-wrap gap-2 mb-4">@if(Model.Requisicao.Status=="RASCUNHO"&&ViewBag.Criar==true){<form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/enviar"><button class="btn btn-primary">Enviar</button></form>}@if(Model.Requisicao.Status=="ENVIADA"&&ViewBag.Aprovar==true){<form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/aprovar"><button class="btn btn-success">Aprovar</button></form><form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/rejeitar" class="d-flex"><input name="justificativa" class="form-control" placeholder="Justificativa" required/><button class="btn btn-danger">Rejeitar</button></form>}@if(Model.Requisicao.Status=="APROVADA"&&ViewBag.Atender==true){<form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/atender"><button class="btn btn-warning">Atender e baixar estoque</button></form>}@if((Model.Requisicao.Status=="RASCUNHO"||Model.Requisicao.Status=="ENVIADA")&&ViewBag.Criar==true){<form method="post" action="/Almoxarifado/Requisicoes/@Model.Requisicao.Id/cancelar" class="d-flex"><input name="justificativa" class="form-control" placeholder="Motivo" required/><button class="btn btn-outline-danger">Cancelar</button></form>}</div><h2 class="h5">Histórico</h2><ul class="list-group">@foreach(var x in Model.Historico){<li class="list-group-item"><strong>@x.StatusNovo</strong> <span class="text-muted">@x.OcorridoEm.ToLocalTime().ToString("g")</span><div>@x.Justificativa</div></li>}</ul>
