@model Sigov.Application.Almoxarifado.PoliticaReposicaoInput
@{ViewData["Title"]="Política de reposição";var locais=(IReadOnlyList<Sigov.Application.Almoxarifado.LocalDto>)ViewBag.Locais;var materiais=(IReadOnlyList<Sigov.Application.Almoxarifado.MaterialDto>)ViewBag.Materiais;var fornecedores=(IReadOnlyList<Sigov.Application.Almoxarifado.FornecedorReposicaoDto>)ViewBag.Fornecedores;}
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Almoxarifado/Reposicao">Reposição</a></li><li class="breadcrumb-item active">Política</li></ol></nav><h1 class="h3">Política de reposição</h1><p class="text-muted">Como usar: informe quantidades na unidade cadastral do material. O prazo é em dias corridos e nunca será presumido quando vazio.</p>
<form method="post" class="card card-body" novalidate><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><input asp-for="Versao" type="hidden"/><div class="row g-3"><div class="col-md-6"><label asp-for="AlmoxarifadoId" class="form-label">Almoxarifado *</label><select asp-for="AlmoxarifadoId" class="form-select" required>@foreach(var x in locais){<option value="@x.Id">@x.Codigo — @x.Nome</option>}</select></div><div class="col-md-6"><label asp-for="MaterialId" class="form-label">Material *</label><select asp-for="MaterialId" class="form-select" required>@foreach(var x in materiais){<option value="@x.Id">@x.Codigo — @x.Descricao (@x.UnidadeMedida)</option>}</select></div><div class="col-md-3"><label asp-for="EstoqueMinimo" class="form-label">Estoque mínimo *</label><input asp-for="EstoqueMinimo" class="form-control" min="0" step="0.0001" required/></div><div class="col-md-3"><label asp-for="EstoqueAlvo" class="form-label">Estoque alvo *</label><input asp-for="EstoqueAlvo" class="form-control" min="0" step="0.0001" required/></div><div class="col-md-3"><label asp-for="MultiploCompra" class="form-label">Múltiplo de compra</label><input asp-for="MultiploCompra" class="form-control" min="0.0001" step="0.0001"/></div><div class="col-md-3"><label asp-for="QuantidadeMinimaPedido" class="form-label">Quantidade mínima do pedido</label><input asp-for="QuantidadeMinimaPedido" class="form-control" min="0" step="0.0001"/></div><div class="col-md-3"><label asp-for="PrazoReposicaoDias" class="form-label">Prazo de reposição (dias)</label><input asp-for="PrazoReposicaoDias" class="form-control" min="0"/></div><div class="col-md-3"><label asp-for="FornecedorPreferencialId" class="form-label">Fornecedor preferencial</label><select asp-for="FornecedorPreferencialId" class="form-select"><option value="">Sem preferência</option>@foreach(var x in fornecedores){<option value="@x.Id">@x.Nome</option>}</select></div><div class="col-md-3"><label asp-for="VigenciaInicio" class="form-label">Início da vigência *</label><input asp-for="VigenciaInicio" type="date" class="form-control" required/></div><div class="col-md-3"><label asp-for="VigenciaFim" class="form-label">Fim da vigência</label><input asp-for="VigenciaFim" type="date" class="form-control"/></div><div class="col-12 form-check ms-2"><input asp-for="Ativa" class="form-check-input"/><label asp-for="Ativa" class="form-check-label">Política ativa</label></div><div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar política</button><a class="btn btn-outline-secondary" href="/Almoxarifado/Reposicao">Cancelar</a></div></div></form>
