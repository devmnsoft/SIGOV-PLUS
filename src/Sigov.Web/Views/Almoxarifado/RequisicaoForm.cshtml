@{ViewData["Title"]="Nova requisição";}<h1 class="h3">Nova requisição</h1><form method="post" class="card card-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Almoxarifado de atendimento</label><select name="almoxarifadoId" class="form-select" required>@foreach(var x in (IReadOnlyList<Sigov.Application.Almoxarifado.LocalDto>)ViewBag.Locais){<option value="@x.Id">@x.Codigo — @x.Nome</option>}</select></div><div class="col-md-6"><label class="form-label">Material</label><select name="materialId" class="form-select" required>@foreach(var x in (IReadOnlyList<Sigov.Application.Almoxarifado.MaterialDto>)ViewBag.Materiais){<option value="@x.Id">@x.Codigo — @x.Descricao</option>}</select></div><div class="col-md-3"><label class="form-label">Quantidade</label><input name="quantidade" type="number" min="0.0001" step="0.0001" class="form-control" required /></div><div class="col-md-9"><label class="form-label">Observação</label><input name="observacao" class="form-control" /></div></div><button class="btn btn-primary mt-3 align-self-start">Criar rascunho</button></form>
