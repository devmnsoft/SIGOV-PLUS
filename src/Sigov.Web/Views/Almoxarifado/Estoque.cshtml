@model IReadOnlyList<Sigov.Application.Almoxarifado.EstoqueDto>
@{ViewData["Title"]="Estoque";}<div class="d-flex justify-content-between"><h1 class="h3">Saldos de estoque</h1><div><a class="btn btn-outline-success" href="/Almoxarifado/Movimentacoes/NovaEntrada">Entrada</a><a class="btn btn-outline-danger" href="/Almoxarifado/Movimentacoes/NovaSaida">Saída</a></div></div><form class="my-3"><input class="form-control" name="busca" placeholder="Buscar material ou local" value="@Context.Request.Query["busca"]" /></form><div class="table-responsive"><table class="table"><thead><tr><th>Material</th><th>Local</th><th>Unidade</th><th class="text-end">Saldo</th><th class="text-end">Mínimo</th></tr></thead><tbody>@foreach(var x in Model){<tr class="@(x.AbaixoMinimo?"table-danger":"")"><td>@x.MaterialCodigo — @x.MaterialDescricao</td><td>@x.LocalCodigo — @x.LocalNome</td><td>@x.UnidadeMedida</td><td class="text-end">@x.Quantidade</td><td class="text-end">@x.EstoqueMinimo</td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="text-center text-muted py-5">Nenhum saldo registrado.</td></tr>}</tbody></table></div><a href="/Almoxarifado/Exportar/saldo">Exportar saldo CSV</a>
