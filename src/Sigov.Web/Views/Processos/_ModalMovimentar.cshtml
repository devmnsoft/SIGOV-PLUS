@model Sigov.Web.Models.Processos.ProcessoMovimentacaoFormViewModel
<div class="modal fade" id="modalMovimentar" tabindex="-1" aria-labelledby="movimentar-title"><div class="modal-dialog"><form class="modal-content" id="movimentar-form">@Html.AntiForgeryToken()<div class="modal-header"><h5 id="movimentar-title">Encaminhar processo</h5><button class="btn-close" data-bs-dismiss="modal" type="button" aria-label="Fechar"></button></div><div class="modal-body"><div class="alert alert-info">O encaminhamento registra origem, destino, responsável, despacho e situação no histórico. Se outro usuário alterar o processo, esta operação será recusada.</div><input asp-for="ProcessoId" type="hidden" /><input asp-for="StatusEsperado" type="hidden" /><label asp-for="Despacho" class="form-label">Despacho <span aria-hidden="true">*</span></label><textarea asp-for="Despacho" class="form-control" required aria-required="true"></textarea><span asp-validation-for="Despacho" class="text-danger"></span><label asp-for="UnidadeDestinoId" class="form-label mt-2">Código da unidade de destino</label><input asp-for="UnidadeDestinoId" class="form-control" inputmode="numeric" /><label asp-for="UsuarioDestinoId" class="form-label mt-2">Código do responsável de destino</label><input asp-for="UsuarioDestinoId" class="form-control" inputmode="numeric" /><div class="form-text">Informe ao menos uma unidade ou um responsável ativo. Os seletores nominais permanecem pendentes de catálogo autorizado.</div></div><div class="modal-footer"><button class="btn btn-primary" type="submit">Confirmar encaminhamento</button></div></form></div></div>
