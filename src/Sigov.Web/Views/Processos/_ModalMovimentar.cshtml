@model Sigov.Web.Models.Processos.ProcessoMovimentacaoFormViewModel
<div class="modal fade" id="modalMovimentar" tabindex="-1"><div class="modal-dialog"><form class="modal-content" id="movimentar-form">@Html.AntiForgeryToken()<div class="modal-header"><h5>Movimentar processo</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><input asp-for="ProcessoId" type="hidden" /><label asp-for="Despacho" class="form-label"></label><textarea asp-for="Despacho" class="form-control" required></textarea><span asp-validation-for="Despacho" class="text-danger"></span><label asp-for="UnidadeDestinoId" class="form-label mt-2"></label><input asp-for="UnidadeDestinoId" class="form-control" /></div><div class="modal-footer"><button class="btn btn-primary" type="submit">Movimentar</button></div></form></div></div>
