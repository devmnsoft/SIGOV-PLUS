@model Sigov.Web.Models.Processos.ProcessoParecerFormViewModel
<div class="modal fade" id="modalParecer" tabindex="-1"><div class="modal-dialog modal-lg"><form class="modal-content" id="parecer-form">@Html.AntiForgeryToken()<div class="modal-header"><h5>Emitir parecer</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><input asp-for="ProcessoId" type="hidden" /><input asp-for="Titulo" class="form-control mb-2" placeholder="Título" required /><textarea asp-for="Texto" class="form-control" rows="6" required></textarea><div class="form-check mt-2"><input asp-for="Sigiloso" class="form-check-input" /><label asp-for="Sigiloso" class="form-check-label"></label></div></div><div class="modal-footer"><button class="btn btn-primary" type="submit">Salvar parecer</button></div></form></div></div>
