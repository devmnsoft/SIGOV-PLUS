@model Sigov.Web.Models.PostBuild.SaasPlanosViewModel
@{ ViewData["Title"]="Planos SaaS"; ViewData["PageTitle"]="Planos SaaS"; ViewData["PageDescription"]="CRUD real quando sigov.plano_saas existe; catálogo honesto quando não existe."; }
@await Html.PartialAsync("_PageIntro")
@if (!string.IsNullOrWhiteSpace(Model?.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback <span class="badge bg-secondary">Em implantação</span></div> }
<div class="d-flex justify-content-between mb-3"><h2 class="h5">Catálogo comercial</h2><a class="sigov-btn sigov-btn--primary @(Model?.PodePersistir == true ? "" : "disabled")" href="/Saas/Planos/Novo">Novo plano</a></div>
<section class="row g-3">
@foreach (var p in Model?.Planos ?? Array.Empty<Sigov.Web.Models.PostBuild.SaasPlanoViewModel>()) {
  <div class="col-md-6 col-xl-4"><article class="sigov-card p-4 h-100 @(p.Recomendado ? "border border-primary" : "")"><div class="d-flex justify-content-between"><h3 class="h4">@p.Nome</h3><span class="badge bg-@(p.Persistido ? "success" : "info")">@(p.Persistido ? "Real" : "Demonstrativo")</span></div><p>@p.Descricao</p><p><strong>Mensal:</strong> @p.ValorMensal.ToString("C") <strong>Anual:</strong> @p.ValorAnual.ToString("C")</p><p><strong>Limites:</strong> @p.LimiteUsuarios usuários / @p.LimiteStorageGb GB / @p.LimiteTenants entidades</p><p><strong>Módulos:</strong> @p.ModulosInclusos</p><p><strong>Suporte:</strong> @p.Suporte</p><div class="d-flex gap-2"><a class="sigov-btn sigov-btn--ghost" href="/Saas/Planos/@p.Id">Detalhes</a><a class="sigov-btn sigov-btn--ghost @(Model?.PodePersistir == true ? "" : "disabled")" href="/Saas/Planos/@p.Id/Editar">Editar</a></div></article></div>
}
</section>
