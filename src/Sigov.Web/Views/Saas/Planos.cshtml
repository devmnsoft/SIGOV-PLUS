@{
    ViewData["Title"] = "Planos SaaS";
}
<section class="container-fluid py-3" data-sigov-page="saas-planos">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1">Planos SaaS</h1>
      <p class="text-muted mb-0">Cadastro comercial, módulos inclusos, limites e status dos planos do SIGOV.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#planoModal">Novo plano</button>
  </div>
  <div id="planosAlert" class="alert d-none" role="alert"></div>
  <div id="planosLoading" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div>Carregando planos...</div></div>
  <div id="planosGrid" class="row g-3"></div>
</section>
<div class="modal fade" id="planoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="h5 modal-title">Plano SaaS</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
    <div class="modal-body">
      <div class="row g-3">
        <div class="col-md-4"><label class="form-label">Código</label><input id="planoCodigo" class="form-control" placeholder="GOV_PLUS"></div>
        <div class="col-md-8"><label class="form-label">Nome</label><input id="planoNome" class="form-control" placeholder="Governo Plus"></div>
        <div class="col-12"><label class="form-label">Descrição</label><textarea id="planoDescricao" class="form-control" rows="2"></textarea></div>
        <div class="col-md-4"><label class="form-label">Preço base</label><input id="planoPreco" type="number" step="0.01" class="form-control" value="0"></div>
        <div class="col-md-4"><label class="form-label">Limite usuários</label><input id="planoUsuarios" type="number" class="form-control"></div>
        <div class="col-md-4"><label class="form-label">Módulos</label><input id="planoModulos" class="form-control" placeholder="dashboard,tributario"></div>
        <div class="col-md-3 form-check ms-2"><input id="planoPublico" type="checkbox" class="form-check-input" checked><label class="form-check-label">Público</label></div>
        <div class="col-md-3 form-check"><input id="planoDestaque" type="checkbox" class="form-check-input"><label class="form-check-label">Destaque</label></div>
        <div class="col-md-3 form-check"><input id="planoWhiteLabel" type="checkbox" class="form-check-input"><label class="form-check-label">White label</label></div>
        <div class="col-md-3 form-check"><input id="planoDominio" type="checkbox" class="form-check-input"><label class="form-check-label">Domínio customizado</label></div>
      </div>
    </div>
    <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button id="salvarPlano" class="btn btn-primary">Salvar</button></div>
  </div></div>
</div>
@section Scripts {
<script>
(async function(){
 const grid=document.getElementById('planosGrid'), loading=document.getElementById('planosLoading'), alert=document.getElementById('planosAlert');
 function show(type,msg){ alert.className='alert alert-'+type; alert.textContent=msg; }
 async function load(){
  try{ loading.classList.remove('d-none'); const r=await fetch('/api/saas/planos'); if(!r.ok) throw new Error('API indisponível'); const json=await r.json(); const planos=json.data||[]; grid.innerHTML=planos.map(p=>`<div class="col-12 col-xl-6"><div class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">${p.nome}</h2><span class="badge text-bg-${p.ativo?'success':'secondary'}">${p.ativo?'Ativo':'Inativo'}</span></div><p class="text-muted">${p.descricao||''}</p><div class="mb-2"><span class="badge text-bg-info">${p.codigo}</span> ${p.publico?'<span class="badge text-bg-primary">Público</span>':''} ${p.destaque?'<span class="badge text-bg-warning">Destaque</span>':''} ${p.permiteWhiteLabel?'<span class="badge text-bg-success">White label</span>':''} ${p.permiteDominioCustomizado?'<span class="badge text-bg-dark">Domínio</span>':''}</div><div class="small"><strong>Limite usuários:</strong> ${p.limiteUsuarios??'Ilimitado'}</div><div class="small"><strong>Módulos:</strong> ${(p.modulos||[]).join(', ')}</div></div></div></div>`).join(''); }
  catch(e){ show('danger','Falha ao carregar planos: '+e.message); } finally{ loading.classList.add('d-none'); }
 }
 document.getElementById('salvarPlano').addEventListener('click', async()=>{ try{ const body={ codigo:planoCodigo.value,nome:planoNome.value,descricao:planoDescricao.value,publico:planoPublico.checked,destaque:planoDestaque.checked,ordem:0,tipoPlano:'MENSAL',precoBase:Number(planoPreco.value||0),periodicidade:'MENSAL',limiteUsuarios:planoUsuarios.value?Number(planoUsuarios.value):null,limiteEntidades:null,limiteArmazenamentoMb:null,permiteWhiteLabel:planoWhiteLabel.checked,permiteDominioCustomizado:planoDominio.checked,modulos:planoModulos.value.split(',').map(x=>x.trim()).filter(Boolean)}; const r=await fetch('/api/saas/planos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); if(!r.ok) throw new Error('não foi possível salvar'); show('success','Plano salvo com sucesso.'); await load(); } catch(e){ show('danger',e.message); }});
 await load();
})();
</script>
}
