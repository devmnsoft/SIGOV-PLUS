@model Sigov.Web.Models.PostBuild.TenantsViewModel
@{ ViewData["Title"] = "Tenants / Clientes"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2"><div><h1 class="h3">Tenants / Clientes</h1><p class="text-muted">Listagem com máscara LGPD para documento, e-mail e telefone.</p></div><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#formTenant">Novo tenant</button></div>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="collapse mb-3" id="formTenant"><div class="card"><div class="card-body"><form class="row g-3"><div class="col-md-4"><label class="form-label">Nome</label><input class="form-control" placeholder="Nome do cliente" /></div><div class="col-md-2"><label class="form-label">Código</label><input class="form-control" /></div><div class="col-md-2"><label class="form-label">Documento</label><input class="form-control" /></div><div class="col-md-2"><label class="form-label">Plano</label><input class="form-control" /></div><div class="col-md-2 d-flex align-items-end"><button type="button" class="btn btn-outline-primary w-100">Salvar via API</button></div></form><div class="small text-muted mt-2">CRUD completo exposto na API /api/saas/tenants; formulário visual preparado para a próxima evolução.</div></div></div></div>
<form method="get" class="input-group mb-3"><input name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar por nome, código ou documento" /><button class="btn btn-outline-secondary">Buscar</button></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Código</th><th>Documento</th><th>E-mail</th><th>Telefone</th><th>Plano</th><th>Status</th><th>Módulos</th></tr></thead><tbody>
@foreach (var tenant in Model.Tenants) { <tr><td>@tenant.Nome</td><td><code>@tenant.Codigo</code></td><td>@tenant.Documento</td><td>@tenant.Email</td><td>@tenant.Telefone</td><td>@tenant.Plano</td><td><span class="badge @(tenant.Ativo ? "text-bg-success" : "text-bg-secondary")">@(tenant.Ativo ? "Ativo" : "Inativo")</span></td><td><a href="/Saas/Modulos?tenantId=@tenant.Id">Ver módulos</a></td></tr> }
@if (!Model.Tenants.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">Nenhum tenant encontrado ou API indisponível.</td></tr> }
</tbody></table></div></div>
