@model Sigov.Web.Models.PostBuild.TenantsViewModel
@{ ViewData["Title"] = "Tenants / Clientes"; 
    ViewData["PageTitle"] = "Clientes/Tenants";
    ViewData["PageDescription"] = "Administrar clientes SaaS, status, plano, módulos ativos e dados de white label.";
    ViewData["PageServes"] = "Esta tela dá contexto, ações padronizadas, validação visual, fallback amigável e auditoria quando aplicável.";
    ViewData["PageHow"] = "Use busca e filtros, acione Novo/Editar/Detalhes e confirme ações sensíveis no modal.";
    ViewData["PageNext"] = "Revise permissões, auditoria, LGPD e módulos relacionados após salvar.";
}
@await Html.PartialAsync("_PageIntro")
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2"><div><h1 class="h3">Tenants / Clientes</h1><p class="text-muted">Listagem com máscara LGPD para documento, e-mail e telefone.</p></div><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#formTenant">Novo tenant</button></div>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="collapse mb-3" id="formTenant"><div class="card"><div class="card-body"><form class="row g-3" method="post" action="/Saas/SalvarTenant">
@Html.AntiForgeryToken()<div class="col-md-3"><label class="form-label">Nome</label><input name="Nome" class="form-control" placeholder="Nome do cliente" required /></div><div class="col-md-2"><label class="form-label">Slug</label><input name="Slug" class="form-control" required /></div><div class="col-md-2"><label class="form-label">Documento</label><input name="Documento" class="form-control" /></div><div class="col-md-2"><label class="form-label">E-mail</label><input name="Email" type="email" class="form-control" /></div><div class="col-md-2"><label class="form-label">Telefone</label><input name="Telefone" class="form-control" /></div><div class="col-md-1 d-flex align-items-end"><div class="form-check"><input name="Ativo" value="true" class="form-check-input" type="checkbox" checked /><label class="form-check-label">Ativo</label></div></div><div class="col-md-2"><label class="form-label">Plano</label><input name="Plano" class="form-control" /></div><div class="col-md-2"><label class="form-label">Cor principal</label><input name="CorPrincipal" class="form-control" placeholder="#0d6efd" /></div><div class="col-md-3"><label class="form-label">Logo URL/caminho</label><input name="LogoUrl" class="form-control" /></div><div class="col-md-2"><label class="form-label">Subdomínio</label><input name="Subdominio" class="form-control" /></div><div class="col-md-3"><label class="form-label">E-mail suporte</label><input name="EmailSuporte" type="email" class="form-control" /></div><div class="col-md-12"><label class="form-label">Observação</label><textarea name="Observacao" class="form-control"></textarea></div><div class="col-12"><div class="alert alert-info mb-0">Esta operação será auditada quando a tabela de auditoria existir. Listagens continuam mascaradas para LGPD.</div></div><div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100" data-sigov-confirm="Salvar tenant?">Salvar</button></div></form><div class="small text-muted mt-2">O botão só informa sucesso quando a persistência em sigov.tenant ocorrer.</div></div></div></div>
<form method="get" class="input-group mb-3"><input name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar por nome, código ou documento" /><button class="btn btn-outline-secondary">Buscar</button></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Código</th><th>Documento</th><th>E-mail</th><th>Telefone</th><th>Plano</th><th>Status</th><th>Ações</th><th>Módulos</th></tr></thead><tbody>
@foreach (var tenant in Model.Tenants) { <tr><td>@tenant.Nome</td><td><code>@tenant.Codigo</code></td><td>@tenant.Documento</td><td>@tenant.Email</td><td>@tenant.Telefone</td><td>@tenant.Plano</td><td><span class="badge @(tenant.Ativo ? "text-bg-success" : "text-bg-secondary")">@(tenant.Ativo ? "Ativo" : "Inativo")</span></td><td><span class="small text-muted">Edição completa via próxima etapa; criação já persiste.</span></td><td><a href="/Saas/Modulos?tenantId=@tenant.Id">Ver módulos</a></td></tr> }
@if (!Model.Tenants.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">Nenhum tenant encontrado ou API indisponível.</td></tr> }
</tbody></table></div></div>
