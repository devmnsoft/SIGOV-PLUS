@model long
@{ ViewData["Title"] = "Assinatura do tenant"; }
<section class="container-fluid py-3"><h1 class="h3">Assinatura do tenant</h1><p class="text-muted">Plano atual, módulos, limites e histórico comercial.</p><div id="alerta" class="alert d-none"></div><div id="conteudo"><span class="spinner-border spinner-border-sm"></span> Carregando...</div></section>
@section Scripts{<script>(async()=>{const tenantId=@Model, box=conteudo, alerta=document.getElementById('alerta'); function show(t,m){alerta.className='alert alert-'+t; alerta.textContent=m;} try{const r=await fetch(`/api/saas/tenants/${tenantId}/assinatura`); if(!r.ok) throw new Error('API indisponível'); const j=await r.json(), d=j.data; box.innerHTML=`<div class="card mb-3"><div class="card-body"><h2 class="h5">${d.assinatura?.plano_nome||'Sem plano'}</h2><p>Status: <span class="badge text-bg-primary">${d.assinatura?.status||'PENDENTE'}</span></p></div></div><h2 class="h5">Histórico</h2><div class="list-group">${(d.historico||[]).map(h=>`<div class="list-group-item"><strong>${h.acao}</strong><br><span class="text-muted">${h.created_at}</span></div>`).join('')}</div>`;}catch(e){show('danger',e.message); box.innerHTML='';}})();</script>}
