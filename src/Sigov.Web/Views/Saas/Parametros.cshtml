@model long
@{ ViewData["Title"] = "Parâmetros por tenant"; }
<section class="container-fluid py-3"><h1 class="h3">Parâmetros por tenant</h1><p class="text-muted">Parametrizações iniciais, LGPD e auditoria por cliente.</p><div class="row g-3 align-items-end mb-3"><div class="col-md-4"><label class="form-label">Tenant ID</label><input id="tenantId" class="form-control" type="number" value="@Model"></div><div class="col-md-2"><button id="carregar" class="btn btn-primary w-100">Carregar</button></div></div><div id="alerta" class="alert d-none"></div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Chave</th><th>Valor</th><th>Tipo</th><th>Sensível</th></tr></thead><tbody id="parametros"></tbody></table></div></section>
@section Scripts{<script>(()=>{const tid=tenantId, tbody=parametros, alerta=document.getElementById('alerta'); function show(t,m){alerta.className='alert alert-'+t; alerta.textContent=m;} async function load(){try{const r=await fetch(`/api/saas/tenants/${tid.value}/parametros`); if(!r.ok) throw new Error('API indisponível'); const j=await r.json(); tbody.innerHTML=(j.data||[]).map(p=>`<tr><td>${p.chave}</td><td>${p.valor??''}</td><td>${p.tipo}</td><td>${p.sensivel?'Sim':'Não'}</td></tr>`).join('');}catch(e){show('danger',e.message);}} carregar.onclick=load; if(tid.value>0) load();})();</script>}
