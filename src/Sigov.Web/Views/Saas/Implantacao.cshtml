@model long
@{
  ViewData["Title"]="Implantação guiada"; ViewData["PageTitle"]="Implantação Guiada"; ViewData["PageDescription"]="Assistente premium para conduzir tenant, entidade, exercício, plano, módulos, usuários, parâmetros e revisão."; ViewData["PageServes"]="Padronizar implantação com validação, rascunho, conclusão, toasts e auditoria."; ViewData["PageHow"]="Informe o tenant, avance etapa a etapa, salve rascunho e conclua após revisar."; ViewData["PageNext"]="Acesse módulos, usuários, permissões, parâmetros e auditoria.";
  var steps = new[]{"Cliente/Tenant","Entidade","Exercício","Plano","Módulos","Usuários","Parâmetros","Revisão"};
}
@await Html.PartialAsync("_PageIntro")
<section class="sigov-card p-4 mb-4"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Tenant ID</label><input id="tenantId" class="form-control" type="number" value="@Model" placeholder="Informe o tenant"></div><div class="col-md-2"><button id="carregar" class="sigov-btn sigov-btn--primary w-100" type="button">Carregar</button></div><div class="col-md-6"><div class="alert alert-info rounded-4 mb-0">Cadastros sensíveis exibem confirmação e deixam trilha de auditoria.</div></div></div></section>
<nav class="sigov-stepper" aria-label="Etapas da implantação">@for (var i = 0; i < steps.Length; i++) { <div class="sigov-step @(i==0 ? "active" : "")" data-step="@i"><span>@(i+1).</span> @steps[i]</div> }</nav>
<div id="implantacaoAlert" class="alert d-none"></div><div id="implantacaoConteudo" class="sigov-card p-4 mb-4"><h2 class="h5">Comece pelo cliente</h2><p class="text-muted">Selecione o tenant para carregar checklist quando a API estiver disponível. Se não houver dados, a tela permanece operável com fallback visual.</p></div>
<div class="sigov-card p-3 d-flex flex-wrap gap-2 justify-content-between"><button class="sigov-btn sigov-btn--ghost" id="voltar" type="button">Voltar</button><div class="d-flex gap-2 flex-wrap"><button class="sigov-btn sigov-btn--ghost" id="rascunho" type="button">Salvar rascunho</button><button class="sigov-btn sigov-btn--primary" id="avancar" type="button">Avançar</button><button class="sigov-btn sigov-btn--primary" id="concluir" type="button">Concluir</button></div></div>
@section Scripts{<script>(()=>{let current=0;const steps=[...document.querySelectorAll('.sigov-step')],tid=document.getElementById('tenantId'),box=document.getElementById('implantacaoConteudo'),alert=document.getElementById('implantacaoAlert');function mark(){steps.forEach((s,i)=>{s.classList.toggle('active',i===current);s.classList.toggle('done',i<current);});}function show(t,m){alert.className='alert alert-'+t+' rounded-4';alert.textContent=m;}async function load(){if(!tid.value){show('warning','Informe um tenant para iniciar a implantação.');return;}try{const r=await fetch(`/api/saas/tenants/${tid.value}/implantacao`);if(!r.ok)throw new Error('API indisponível. Exibindo roteiro padrão.');const j=await r.json(),d=j.data;box.innerHTML=`<h2 class="h4">Status: ${d.implantacao.status}</h2><div class="progress mb-3"><div class="progress-bar" style="width:${d.implantacao.percentual}%">${d.implantacao.percentual}%</div></div>`;}catch(e){box.innerHTML='<h2 class="h5">Roteiro padrão de implantação</h2><p class="text-muted">Cliente, entidade, exercício, plano, módulos, usuários, parâmetros e revisão serão conduzidos em sequência.</p>';SigovNotify.warning(e.message,'Implantação');}}document.getElementById('carregar').onclick=load;document.getElementById('avancar').onclick=()=>{current=Math.min(7,current+1);mark();SigovNotify.info('Etapa atualizada.','Implantação')};document.getElementById('voltar').onclick=()=>{current=Math.max(0,current-1);mark();};document.getElementById('rascunho').onclick=()=>SigovNotify.info('Rascunho salvo visualmente.','Implantação');document.getElementById('concluir').onclick=async()=>{if(await SigovConfirm.show({title:'Concluir implantação',message:'Confirme esta ação. A conclusão será auditada.',confirmText:'Concluir'}))SigovNotify.success('Registro salvo com sucesso.','Implantação');};})();</script>}
