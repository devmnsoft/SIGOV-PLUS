@model long
@{ ViewData["Title"] = "Implantação guiada"; var steps = new[]{"Cliente/Tenant","Entidade","Exercício","Plano","Módulos","Usuários","Parâmetros","Revisão"}; }
<header class="sigov-page-header"><div><span class="sigov-badge sigov-badge--info">Onboarding</span><h1 class="h2 fw-bold mt-2">Implantação guiada</h1><p>Stepper comercial para conduzir tenant, entidade, exercício, plano, módulos, usuários, parâmetros e revisão final.</p></div><span class="sigov-badge sigov-badge--success">Operação auditável</span></header>
<section class="sigov-card p-4 mb-4"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Tenant ID</label><input id="tenantId" class="form-control" type="number" value="@Model" placeholder="Informe o tenant"></div><div class="col-md-2"><button id="carregar" class="sigov-btn sigov-btn--primary w-100">Carregar</button></div><div class="col-md-6"><div class="alert alert-info rounded-4 mb-0">Cadastros sensíveis exibem confirmação e deixam trilha de auditoria.</div></div></div></section>
<nav class="sigov-stepper" aria-label="Etapas da implantação">@for (var i = 0; i < steps.Length; i++) { <div class="sigov-step @(i==0 ? "active" : "")" data-step="@i"><span>@(i+1).</span> @steps[i]</div> }</nav>
<div id="implantacaoAlert" class="alert d-none"></div><div id="implantacaoLoading" class="sigov-card p-4 d-none"><span class="spinner-border spinner-border-sm"></span> Carregando implantação...</div><div id="implantacaoConteudo" class="mb-4"></div>
<div class="sigov-card p-3 d-flex flex-wrap gap-2 justify-content-between"><button class="sigov-btn sigov-btn--ghost" id="voltar">Voltar</button><div class="d-flex gap-2 flex-wrap"><button class="sigov-btn sigov-btn--ghost" id="rascunho">Salvar rascunho</button><button class="sigov-btn sigov-btn--primary" id="avancar">Avançar</button><button class="sigov-btn sigov-btn--primary" id="concluir">Concluir</button></div></div>
@section Scripts{<script>
(()=>{let current=0;const steps=[...document.querySelectorAll('.sigov-step')],tid=document.getElementById('tenantId'),box=document.getElementById('implantacaoConteudo'),alert=document.getElementById('implantacaoAlert'),loading=document.getElementById('implantacaoLoading');function mark(){steps.forEach((s,i)=>{s.classList.toggle('active',i===current);s.classList.toggle('done',i<current);});}function show(t,m){alert.className='alert alert-'+t+' rounded-4';alert.textContent=m;}async function load(){if(!tid.value){show('warning','Informe um tenant para iniciar a implantação.');return;}loading.classList.remove('d-none');try{const r=await fetch(`/api/saas/tenants/${tid.value}/implantacao`);if(!r.ok)throw new Error('API indisponível para implantação.');const j=await r.json(),d=j.data;box.innerHTML=`<section class="sigov-card p-4"><div class="d-flex justify-content-between flex-wrap gap-2"><div><h2 class="h4">Status: ${d.implantacao.status}</h2><p class="text-muted">Checklist por etapa com responsáveis e evidências.</p></div><span class="sigov-badge sigov-badge--info">${d.implantacao.percentual}% concluído</span></div><div class="progress mb-4" style="height:14px"><div class="progress-bar bg-success" style="width:${d.implantacao.percentual}%">${d.implantacao.percentual}%</div></div><div class="row g-3">${(d.itens||[]).map(i=>`<div class="col-md-6"><label class="sigov-card p-3 d-block h-100"><input class="form-check-input item me-2" data-id="${i.id}" type="checkbox" ${i.concluido?'checked':''}><strong>${i.ordem}. ${i.titulo}</strong><br><span class="text-muted small">${i.codigo}</span></label></div>`).join('')}</div></section>`;document.querySelectorAll('.item').forEach(el=>el.addEventListener('change',async()=>{await fetch(`/api/saas/implantacoes/${d.implantacao.id}/itens/${el.dataset.id}/${el.checked?'concluir':'reabrir'}`,{method:'POST'});SigovNotify.success('Checklist atualizado.','Implantação');await load();}));}catch(e){show('danger',e.message);SigovNotify.error(e.message,'Implantação');}finally{loading.classList.add('d-none');}}document.getElementById('carregar').onclick=load;document.getElementById('avancar').onclick=()=>{current=Math.min(7,current+1);mark();};document.getElementById('voltar').onclick=()=>{current=Math.max(0,current-1);mark();};document.getElementById('rascunho').onclick=()=>SigovNotify.info('Rascunho visual salvo nesta sessão.','Implantação');document.getElementById('concluir').onclick=async()=>{if(await SigovConfirm.show({title:'Concluir implantação',message:'Deseja concluir a implantação? A ação será auditada.',confirmText:'Concluir'}))SigovNotify.success('Implantação concluída visualmente.','Implantação');};mark();if(tid.value>0)load();})();
</script>}
