@{ViewData["Title"]="Relatórios jurídicos";}<partial name="_Nav"/><h1>Relatórios CSV</h1><p class="text-muted">Exportações auditadas do contexto atual. Conteúdo potencialmente interpretado como fórmula é neutralizado.</p><div class="list-group">@foreach(var x in new[]{"advogados","partes","processos","movimentacoes","prazos","intimacoes","audiencias","pareceres","consultas","acordos","dividaativa","custas","auditoria"}){<a class="list-group-item list-group-item-action" asp-controller="Juridico" asp-action="Csv" asp-route-recurso="@x">Exportar @x</a>}</div>
