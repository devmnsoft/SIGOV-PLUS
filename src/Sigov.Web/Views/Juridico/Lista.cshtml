@model Sigov.Web.Models.Juridico.JuridicoListaViewModel
@{ ViewData["Title"] = Model.Titulo; }
<partial name="_Nav" />
<header class="d-flex justify-content-between mb-3"><div><h1>@Model.Titulo</h1><p class="text-muted">Dados oficiais do contexto atual.</p></div>@if (Model.PermiteAlteracao) { <a class="btn btn-primary align-self-start" asp-controller="Juridico" asp-action="Novo" asp-route-recurso="@Model.Recurso">Novo registro</a> }</header>
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> } @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
<form method="get" asp-controller="Juridico" asp-action="Lista" asp-route-recurso="@Model.Recurso" class="row g-2 mb-3"><div class="col"><input class="form-control" name="busca" value="@Model.Filtro.Busca" placeholder="Buscar" /></div><div class="col"><input class="form-control" name="status" value="@Model.Filtro.Status" placeholder="Status" /></div><div class="col-auto"><button class="btn btn-outline-primary">Filtrar</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Criado em</th>@if(Model.PermiteAlteracao){<th>Ações</th>}</tr></thead><tbody>
@foreach (var item in Model.Resultado.Itens) { <tr><td>@item.Codigo</td><td>@item.Descricao</td><td><span class="badge bg-secondary">@item.Status</span></td><td>@item.CriadoEm.ToLocalTime().ToString("g")</td>@if(Model.PermiteAlteracao){<td><form method="post" asp-controller="Juridico" asp-action="Excluir" asp-route-recurso="@Model.Recurso" asp-route-id="@item.Id" class="d-flex gap-1">@Html.AntiForgeryToken()<input name="justificativa" required class="form-control form-control-sm" aria-label="Justificativa da exclusão" placeholder="Justificativa"/><button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button></form></td>}</tr> }
@if (Model.Resultado.Itens.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr> }
</tbody></table></div>
@{ var totalPages = (long)Math.Ceiling(Model.Resultado.Total / (double)Model.Resultado.Tamanho); }
@if(totalPages > 1){<nav aria-label="Paginação"><span>Página @Model.Resultado.Pagina de @totalPages</span> @if(Model.Resultado.Pagina > 1){<a asp-route-recurso="@Model.Recurso" asp-route-pagina="@(Model.Resultado.Pagina-1)" asp-route-busca="@Model.Filtro.Busca" asp-route-status="@Model.Filtro.Status">Anterior</a>} @if(Model.Resultado.Pagina < totalPages){<a asp-route-recurso="@Model.Recurso" asp-route-pagina="@(Model.Resultado.Pagina+1)" asp-route-busca="@Model.Filtro.Busca" asp-route-status="@Model.Filtro.Status">Próxima</a>}</nav>}
