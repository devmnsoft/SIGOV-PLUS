@model Sigov.Application.Juridico.JuridicoDashboard
<link rel="stylesheet" href="~/css/juridico360.css" asp-append-version="true" />
<div class="j360-shell">
@{ViewData["Title"]="Procuradoria Jurídica";var cards=new (string,object)[]{("Processos ativos",Model.ProcessosAtivos),("Prazos vencidos",Model.PrazosVencidos),("Prazos em 7 dias",Model.PrazosSeteDias),("Intimações pendentes",Model.IntimacoesPendentes),("Audiências agendadas",Model.AudienciasAgendadas),("Pareceres pendentes",Model.PareceresPendentes),("Acordos ativos",Model.AcordosAtivos),("Obrigações vencidas",Model.ObrigacoesVencidas),("Dívida judicial aberta",Model.DividasEmAberto),("Custas no mês",Model.CustasPeriodo.ToString("C"))};}
<partial name="_Nav"/><header class="j360-hero mb-4"><h1>Procuradoria Jurídica</h1><p class="text-muted">Contencioso, consultivo, acordos e dívida ativa judicial com dados oficiais.</p></header><div class="j360-metrics">@foreach(var c in cards){<article class="j360-metric"><div><span class="text-muted">@c.Item1</span><strong class="display-6 d-block">@c.Item2</strong></div></article>}</div>

</div>