@{ ViewData["Title"] = "Competências Encerradas"; }
<section class="orcamento-station" aria-labelledby="titulo-exercicios">
  <header class="mb-3">
    <h1 id="titulo-exercicios">Competências Encerradas</h1>
    <p class="text-muted mb-0">Fechamento e reabertura de competência orçamentária: exercício encerrado veda novos movimentos (CRUD orçamentário recusa com falha nomeada); reabertura exige justificativa parametrizada (Lei 4.320/64 arts. 44–53).</p>
  </header>

  @await Html.PartialAsync("_BaseLegislativa")

  <div data-mensagem class="alert alert-danger d-none" role="alert"></div>
  <div class="loading-skeleton" data-loading hidden aria-live="polite">Carregando competências…</div>
  <div data-resultado hidden>
    <div class="row g-4 mb-4">
      <div class="col-lg-6">
        <div class="card h-100"><div class="card-header fw-semibold">Encerrar exercício</div><div class="card-body">
          <form id="form-encerrar" novalidate class="row g-2">
            <label class="col-8">Exercício<select class="form-select" name="exercicioId" required></select></label>
            <label class="col-4">Ano<select class="form-select" name="ano" id="sel-ano" required></select></label>
            <label class="col-12">Motivo do encerramento<input class="form-control" name="motivo" required maxlength="300" /></label>
            <div class="col-12"><button type="submit" class="btn btn-danger btn-sm">Encerrar competência</button></div>
          </form>
        </div></div>
      </div>
      <div class="col-lg-6">
        <div class="card h-100"><div class="card-header fw-semibold">Reabrir exercício</div><div class="card-body">
          <form id="form-reabrir" novalidate class="row g-2">
            <label class="col-8">Exercício<select class="form-select" name="exercicioId" required></select></label>
            <label class="col-4">&nbsp;</label>
            <label class="col-12">Justificativa da reabertura<input class="form-control" name="justificativa" required maxlength="300" /></label>
            <div class="col-12"><button type="submit" class="btn btn-outline-warning btn-sm">Reabrir competência</button></div>
          </form>
        </div></div>
      </div>
    </div>
    <div class="card"><div class="card-header fw-semibold">Situação das competências da entidade</div><div class="card-body table-responsive">
      <table class="table table-sm table-striped"><caption class="visually-hidden">Exercícios</caption>
        <thead><tr><th>Ano</th><th>Situação</th><th>Encerrado em</th><th>Motivo</th><th>Reaberto em</th><th>Justificativa de reabertura</th></tr></thead>
        <tbody data-lista></tbody>
      </table>
    </div></div>
  </div>
</section>

<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.currentScript.previousElementSibling;
  const loading = root.querySelector('[data-loading]'), result = root.querySelector('[data-resultado]'), message = root.querySelector('[data-mensagem]');
  const envelope = async r => { const b = await r.json().catch(() => ({})); if (!r.ok) throw new Error(b.message || b.error || 'Operação não concluída.'); return b.data ?? b; };
  const notice = (t, k = 'danger') => { message.className = `alert alert-${k}`; message.textContent = t; message.classList.remove('d-none'); };
  const anoAtual = new Date().getFullYear();
  const selAno = root.querySelector('#form-encerrar #sel-ano');
  [anoAtual - 1, anoAtual, anoAtual + 1].forEach(a => { const o = document.createElement('option'); o.value = a; o.textContent = String(a); selAno.append(o); });
  selAno.value = String(anoAtual);
  let exercicios = [];
  function preencherSelects() {
    ['form-encerrar', 'form-reabrir'].forEach(fid => {
      const sel = root.querySelector('#' + fid + ' select[name=exercicioId]');
      const atual = sel.value;
      sel.innerHTML = '<option value="">— selecione —</option>';
      exercicios.forEach(x => { const o = document.createElement('option'); o.value = x.exercicioId; o.textContent = x.ano + ' — ' + x.situacao; sel.append(o); });
      if (atual) sel.value = atual;
    });
  }
  async function carregar() {
    loading.hidden = false;
    try {
      const rows = await envelope(await fetch('/api/orcamento/exercicios', { credentials: 'same-origin' }));
      exercicios = rows;
      preencherSelects();
      const body = result.querySelector('[data-lista]');
      body.replaceChildren(...rows.map(x => {
        const trEl = document.createElement('tr');
        [x.ano, x.situacao, x.encerradoEm ? x.encerradoEm.slice(0, 16).replace('T', ' ') : '—', x.encerramentoMotivo || '—', x.reabertoEm ? x.reabertoEm.slice(0, 16).replace('T', ' ') : '—', x.reaberturaJustificativa || '—'].forEach(v => { const td = document.createElement('td'); td.textContent = v; trEl.append(td); });
        return trEl;
      }));
      if (!rows.length) body.innerHTML = '<tr><td colspan="6">Nenhum exercício registrado para a entidade.</td></tr>';
      result.hidden = false;
    } catch (e) { notice(e.message); }
    finally { loading.hidden = true; }
  }
  root.querySelector('#form-encerrar').addEventListener('submit', async e => {
    e.preventDefault(); const f = new FormData(e.target);
    try { await envelope(await fetch('/api/orcamento/exercicios/encerrar', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ exercicioId: Number(f.get('exercicioId')), motivo: f.get('motivo') }) })); notice('Exercício encerrado.', 'success'); await carregar(); }
    catch (err) { notice(err.message); }
  });
  root.querySelector('#form-reabrir').addEventListener('submit', async e => {
    e.preventDefault(); const f = new FormData(e.target);
    try { await envelope(await fetch('/api/orcamento/exercicios/reabrir', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ exercicioId: Number(f.get('exercicioId')), justificativa: f.get('justificativa') }) })); notice('Exercício reaberto.', 'success'); await carregar(); }
    catch (err) { notice(err.message); }
  });
  carregar();
})();
</script>
