@{ ViewData["Title"] = "Parâmetros da Frente"; }
<section class="orcamento-station" aria-labelledby="titulo-parametros">
  <header class="mb-3">
    <h1 id="titulo-parametros">Parâmetros da Frente</h1>
    <p class="text-muted mb-0">Parâmetros efetivos de orçamento e responsabilidade fiscal (override por tenant sobre o padrão institucional) — o banco é a autoridade (regra 11).</p>
  </header>

  @await Html.PartialAsync("_BaseLegislativa")

  <div data-mensagem class="alert alert-danger d-none" role="alert"></div>
  <div class="loading-skeleton" data-loading hidden aria-live="polite">Carregando parâmetros…</div>
  <div data-resultado hidden>
    <div class="card"><div class="card-header fw-semibold">Parâmetros efetivos do tenant atual</div><div class="card-body table-responsive">
      <table class="table table-sm table-striped"><caption class="visually-hidden">Parâmetros</caption>
        <thead><tr><th>Código</th><th>Nome</th><th>Tipo</th><th>Valor efetivo</th><th>Origem</th><th>Descrição</th></tr></thead>
        <tbody data-lista></tbody>
      </table>
    </div></div>
  </div>
</section>

<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.currentScript.previousElementSibling;
  const loading = root.querySelector('[data-loading]'), result = root.querySelector('[data-resultado]'), message = root.querySelector('[data-mensagem]');
  const envelope = async r => { const b = await r.json().catch(() => ({})); if (!r.ok) throw new Error(b.message || b.error || 'Operação não concluída.'); return b.data ?? b; };
  const notice = (t, k = 'danger') => { message.className = `alert alert-${k}`; message.textContent = t; message.classList.remove('d-none'); };
  async function carregar() {
    loading.hidden = false;
    try {
      const rows = await envelope(await fetch('/api/orcamento/parametros', { credentials: 'same-origin' }));
      const body = result.querySelector('[data-lista]');
      body.replaceChildren(...rows.map(p => {
        const trEl = document.createElement('tr');
        [p.codigo, p.nome, p.tipo, p.valorEfetivo, p.origem, p.descricao || '—'].forEach(v => { const td = document.createElement('td'); td.textContent = v; trEl.append(td); });
        return trEl;
      }));
      if (!rows.length) body.innerHTML = '<tr><td colspan="6">Nenhum parâmetro ativo para o módulo.</td></tr>';
      result.hidden = false;
    } catch (e) { notice(e.message); }
    finally { loading.hidden = true; }
  }
  carregar();
})();
</script>
