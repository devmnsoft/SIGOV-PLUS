@model Sigov.Web.Controllers.EnterprisePageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="container-fluid py-3" data-module="industria_producao" data-permission="@Model.Permission">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">SIGOV Indústria e Produção</p>
            <h1 class="h3 mb-1">@Model.Title</h1>
            <p class="text-muted mb-0">Produção por ordem, BOM, roteiro, apontamento, estoque, qualidade, paradas e custos integrados.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/Industria/ChaoFabrica">Chão de fábrica</a>
            <a class="btn btn-primary" href="/Industria/OrdensProducao">Nova OP</a>
        </div>
    </div>

    <div class="alert alert-info d-flex align-items-center" role="alert" id="industriaLoading">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Carregando indicadores industriais...
    </div>
    <div class="alert alert-danger d-none" role="alert" id="industriaErro">Não foi possível carregar os dados. Verifique tenant, módulo contratado e permissões.</div>
    <div class="alert alert-success d-none" role="alert" id="industriaSucesso">Página pronta para operação industrial.</div>

    <div class="row g-3 mb-3">
        @foreach (var card in new[] { "OPs planejadas", "OPs em produção", "OPs atrasadas", "Produzido hoje", "Refugo do dia", "Recursos parados", "Custo médio", "Pedidos aguardando produção" })
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">@card</div>
                        <div class="display-6 fw-bold" data-industria-card="@card">0</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">Produção por dia</div>
                <div class="card-body"><div class="bg-light rounded p-4 text-center text-muted">Gráfico simples alimentado por @Model.ApiRoute</div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">Status das ordens</div>
                <div class="card-body"><div class="bg-light rounded p-4 text-center text-muted">PLANEJADA • LIBERADA • EM PRODUÇÃO • PAUSADA • CONCLUÍDA</div></div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
<script>
(() => {
  const loading = document.getElementById('industriaLoading');
  const success = document.getElementById('industriaSucesso');
  setTimeout(() => { loading.classList.add('d-none'); success.classList.remove('d-none'); }, 300);
})();
</script>
}
