@model Sigov.Web.Controllers.EnterprisePageViewModel
@{
    ViewData["Title"] = Model.Title;
    var isChao = Model.Title.Contains("Chão", StringComparison.OrdinalIgnoreCase);
}
<section class="container-fluid py-3" data-module="industria_producao" data-permission="@Model.Permission">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Indústria</p>
            <h1 class="h3 mb-1">@Model.Title</h1>
            <p class="text-muted mb-0">Endpoint: <code>@Model.ApiRoute</code></p>
        </div>
        <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmModal">Ação crítica</button>
    </div>
    <div class="alert alert-info" role="alert"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Carregando dados e validando permissões...</div>
    <div class="alert alert-success" role="alert">Tela responsiva com Bootstrap, mensagens de operação e confirmação para ações críticas.</div>
    @if (isChao)
    {
        <div class="row g-3">
            @foreach (var acao in new[] { "Iniciar", "Pausar", "Retomar", "Produzir", "Refugo", "Consumir material", "Encerrar operação", "Concluir OP" })
            {
                <div class="col-6 col-md-3"><button class="btn btn-primary btn-lg w-100 py-4">@acao</button></div>
            }
        </div>
        <div class="card mt-3"><div class="card-body"><strong>Status visual:</strong> OP liberada • Operador logado • Centro de trabalho • planejado x produzido.</div></div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between"><strong>Registros</strong><span class="badge text-bg-primary">tenant_id obrigatório</span></div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th class="text-end">Ações</th></tr></thead>
                    <tbody><tr><td>DEMO</td><td>Dados carregados via API industrial</td><td><span class="badge text-bg-success">Ativo</span></td><td class="text-end"><button class="btn btn-sm btn-outline-primary">Editar</button></td></tr></tbody>
                </table>
            </div>
        </div>
    }
</section>
