@model Sigov.Application.Bloco8.Bloco8DashboardDto
@{ ViewData["Title"] = ViewData["Module"] ?? "Gestão Digital"; var title=(string)ViewData["Title"]!; }
<section class="b8-hero"><div><span class="lgpd-badge">LGPD • acesso auditado</span><h1>@title</h1><p>Núcleo operacional com persistência PostgreSQL, isolamento por tenant e rastreabilidade por CorrelationId.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmacaoBloco8">Nova operação</button></section>
<div class="b8-kpis"><article><span>Total</span><strong>@Model.Total</strong></article><article><span>Pendentes</span><strong>@Model.Pendentes</strong></article><article><span>Prazos vencidos</span><strong>@Model.Vencidos</strong></article><article><span>Concluídos</span><strong>@Model.Concluidos</strong></article></div>
<section class="b8-panel"><div class="filter-bar"><input class="form-control" type="search" placeholder="Filtrar por código, título ou status" aria-label="Filtrar registros"/><span class="status-chip">Dados reais</span></div><div class="table-responsive"><table class="table responsive-data-table"><thead><tr><th>Código</th><th>Título</th><th>Tipo</th><th>Status</th><th>Criação</th></tr></thead><tbody>@foreach(var item in Model.Recentes){<tr><td>@(item.Codigo??$"#{item.Id}")</td><td>@item.Titulo @if(item.Sigiloso){<span class="lgpd-badge">restrito</span>}</td><td>@item.Tipo</td><td><span class="status-chip">@item.Status</span></td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>}@if(Model.Recentes.Count==0){<tr><td colspan="5"><div class="empty-state"><strong>Nenhum registro encontrado</strong><span>Use “Nova operação” para iniciar um fluxo.</span></div></td></tr>}</tbody></table></div></section>
<div class="modal fade" id="confirmacaoBloco8" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Confirmar nova operação</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">A operação será registrada com auditoria e contexto do tenant.</div></div></div></div>
