@{
    ViewData["Title"] = "Unidades Organizacionais";
}
<section class="sigov-page-header d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><span class="badge text-bg-primary mb-2">Administração</span><h1 class="h2">Unidades Organizacionais</h1><p class="text-muted">Tela padronizada do lote 1 com filtros, grid, antiforgery, estados amigáveis e auditoria operacional.</p></div>
  <button class="btn btn-primary" data-sigov-permission="core.unidades.criar" data-bs-toggle="modal" data-bs-target="#modal-Unidades">Novo registro</button>
</section>
<form class="card card-body mb-3" method="get" data-sigov-grid-filter="Unidades"><div class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label" for="Busca">Busca</label><input id="Busca" name="Busca" class="form-control" placeholder="Código, nome ou descrição" /></div><div class="col-md-3"><label class="form-label" for="Status">Status</label><select id="Status" name="Status" class="form-select"><option>Todos</option><option>Ativo</option><option>Inativo</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Filtrar</button></div><div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="button" data-sigov-grid-refresh>Atualizar</button></div></div></form>
<div class="card sigov-grid"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Regra</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody data-sigov-placeholder-grid><tr><td>Unidades Organizacionais principal</td><td>Hierarquia opcional, inativação por soft delete e selects apenas ativos.</td><td><span class="badge text-bg-success">Ativo</span></td><td class="text-end"><button class="btn btn-sm btn-outline-primary">Editar</button> <button class="btn btn-sm btn-outline-secondary">Auditoria</button></td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between"><small class="text-muted">tenant_id aplicado nas consultas operacionais.</small><ul class="pagination pagination-sm mb-0"><li class="page-item active"><span class="page-link">1</span></li></ul></div></div>
<div class="modal fade" id="modal-Unidades" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post" data-sigov-form="true">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="modal-title h5">Unidades Organizacionais</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label class="form-label" for="Nome">Nome</label><input id="Nome" name="Nome" class="form-control" required /><div class="form-text">Hierarquia opcional, inativação por soft delete e selects apenas ativos.</div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit">Salvar</button></div></form></div></div>
@section Scripts { <script src="~/js/modules/core.unidades.js"></script> }
