@model IReadOnlyList<Sigov.Application.Frotas.UtilizacaoDto>
@{
    ViewData["Title"] = "Utilizações de Veículos";
}
<link rel="stylesheet" href="~/css/frotas.css" asp-append-version="true" />

<div class="frotas-shell">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/Frotas">Frotas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Utilizações</li>
        </ol>
    </nav>

    <partial name="_Nav" />

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Saídas e Utilizações</h1>
            <p class="text-muted mb-0">Diário de bordo, itinerários e controle de quilometragem percorrida.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/Frotas/Exportar?tipo=utilizacoes">Exportar CSV</a>
            <a class="btn btn-primary" href="/Frotas/Utilizacoes/Nova">Abrir utilização</a>
        </div>
    </div>

    <details class="how-to mb-4">
        <summary>Como usar esta tela</summary>
        <div class="mt-2 text-muted">
            <p>Um uso aberto por veículo. Motorista ativo e CNH válida. Retorno: KM >= saída.</p>
            <ul>
                <li><strong>Viagem em Aberto:</strong> Enquanto uma utilização estiver com status <code>ABERTO</code>, o veículo não pode ser retirado para nova saída.</li>
                <li><strong>Finalização de Viagem:</strong> Ao retornar, registre a quilometragem final e a data/hora exata; o hodômetro do veículo será atualizado atomicamente.</li>
            </ul>
        </div>
    </details>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Placa</th>
                        <th>Condutor</th>
                        <th>Saída em</th>
                        <th>Km Saída</th>
                        <th>Km Retorno</th>
                        <th>Destino / Finalidade</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        var badgeClass = x.Status switch
                        {
                            "ABERTO" => "frotas-badge-aberto",
                            "FINALIZADO" => "frotas-badge-concluido",
                            _ => "frotas-badge-inativo"
                        };

                        <tr>
                            <td class="fw-bold text-dark">@x.Placa</td>
                            <td>@x.MotoristaNome</td>
                            <td>@x.SaidaEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@x.KmSaida.ToString("N0") km</td>
                            <td>@(x.KmRetorno.HasValue ? $"{x.KmRetorno.Value:N0} km" : "—")</td>
                            <td>
                                <div class="fw-semibold">@x.Destino</div>
                                <small class="text-muted">@x.Finalidade</small>
                            </td>
                            <td><span class="frotas-badge @badgeClass">@x.Status</span></td>
                            <td class="text-end">
                                @if (x.Status == "ABERTO")
                                {
                                    <a class="btn btn-sm btn-outline-success fw-semibold" href="/Frotas/Utilizacoes/@x.Id/Finalizar">
                                        Finalizar retorno
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Concluída</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="frotas-empty-state">
                                    <strong>Nenhuma utilização registrada</strong>
                                    <p class="mb-0">Clique em "Abrir utilização" para lançar uma nova saída de veículo.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>