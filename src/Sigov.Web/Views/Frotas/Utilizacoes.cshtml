@model IReadOnlyList<Sigov.Application.Frotas.UtilizacaoDto>
@{ViewData["Title"]="Utilizações";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Utilizações</h1><a class="btn btn-primary" href="/Frotas/Utilizacoes/Nova">Nova utilização</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Placa</th><th>MotoristaNome</th><th>SaidaEm</th><th>KmSaida</th><th>Destino</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Placa</td><td>@x.MotoristaNome</td><td>@x.SaidaEm</td><td>@x.KmSaida</td><td>@x.Destino</td><td>@x.Status</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>}</tbody></table></div>