@model IReadOnlyList<Sigov.Application.Frotas.ManutencaoDto>
@{ViewData["Title"]="Manutenções";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Manutenções</h1><a class="btn btn-primary" href="/Frotas/Manutencoes/Nova">Nova manutenção</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Placa</th><th>Tipo</th><th>Data de abertura</th><th>Km na abertura</th><th>Valor estimado</th><th>Estado</th><th><span class="visually-hidden">Ações</span></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Placa</td><td>@x.Tipo</td><td>@x.DataAbertura.ToString("g")</td><td>@x.KmAbertura.ToString("N2")</td><td>@x.ValorEstimado.ToString("C")</td><td><span class="badge bg-secondary">@x.Status</span></td><td><a class="btn btn-sm btn-outline-primary" href="/Frotas/Manutencoes/Detalhe/@x.Id">Consultar</a></td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="text-center text-muted py-4">Nenhuma manutenção encontrada.</td></tr>}</tbody></table></div>
