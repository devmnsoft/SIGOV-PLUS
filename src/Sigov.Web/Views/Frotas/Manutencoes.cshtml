@model IReadOnlyList<Sigov.Application.Frotas.ManutencaoDto>
@{ViewData["Title"]="Manutenções";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Manutenções</h1><a class="btn btn-primary" href="/Frotas/Manutencoes/Nova">Nova manutenção</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Placa</th><th>Tipo</th><th>DataAbertura</th><th>KmAbertura</th><th>ValorEstimado</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Placa</td><td>@x.Tipo</td><td>@x.DataAbertura</td><td>@x.KmAbertura</td><td>@x.ValorEstimado</td><td>@x.Status</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>}</tbody></table></div>