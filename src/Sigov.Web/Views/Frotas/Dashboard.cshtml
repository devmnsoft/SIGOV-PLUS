@model Sigov.Application.Frotas.FrotasDashboardDto
@{
    ViewData["Title"] = "Frotas";
    var cards = new (string Label, string Value)[]
    {
        ("Veículos ativos", Model.VeiculosAtivos.ToString()),
        ("Em manutenção", Model.VeiculosEmManutencao.ToString()),
        ("CNH vencida", Model.CnhVencida.ToString()),
        ("CNH a vencer", Model.CnhAVencer.ToString()),
        ("Documentos vencidos", Model.DocumentosVencidos.ToString()),
        ("A vencer em 30 dias", Model.DocumentosAVencer.ToString()),
        ("Abastecimentos no mês", Model.AbastecimentosMes.ToString()),
        ("Custo mensal", Model.CustoMensal.ToString("C")),
        ("Manutenções abertas", Model.ManutencoesAbertas.ToString())
    };
}
<partial name="_Nav" />
<h1 class="h3">Painel operacional</h1>
<div class="alert alert-info" role="note">
    <strong>Como usar esta tela:</strong> acompanhe os indicadores de frota e priorize documentos vencidos, habilitações e manutenções abertas.
</div>
<div class="row g-2 mb-4">
    @foreach (var card in cards)
    {
        <div class="col-6 col-lg-3">
            <section class="card h-100">
                <div class="card-body py-2">
                    <small class="text-muted">@card.Label</small>
                    <div class="fs-4 fw-semibold">@card.Value</div>
                </div>
            </section>
        </div>
    }
</div>
<div class="alert alert-warning" role="status">Alertas são derivados dos vencimentos e estados persistidos; documentos vencidos geram alerta sem bloqueio automático.</div>
