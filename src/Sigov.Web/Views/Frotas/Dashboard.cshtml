@model Sigov.Application.Frotas.FrotasDashboardDto
@{
    ViewData["Title"] = "Gestão de Frotas e Transportes";
}
<link rel="stylesheet" href="~/css/frotas.css" asp-append-version="true" />

<div class="frotas-shell">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active" aria-current="page">Gestão de Frotas</li>
        </ol>
    </nav>

    <partial name="_Nav" />

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <header class="frotas-hero">
        <div>
            <span class="badge bg-primary mb-2">FUNC04 · Frotas e Logística</span>
            <h1>Frotas, Abastecimento e Manutenção</h1>
            <p>Controle operacional de veículos oficiais, utilizações com hodômetro estrito, manutenções e baixa atômica de peças no almoxarifado.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-light fw-semibold" href="/Frotas/Utilizacoes/Nova">Abrir utilização</a>
            <a class="btn btn-outline-light" href="/Frotas/Abastecimentos/Novo">Abastecimento</a>
            <a class="btn btn-outline-light" href="/Frotas/OrdensServico/Nova">Nova OS</a>
        </div>
    </header>

    <details class="how-to mb-4">
        <summary>Como usar esta tela</summary>
        <div class="mt-2 text-muted">
            <p>Veículos ativos, em manutenção e documentos a vencer. Uso aberto impede nova saída. Peça de OS baixa no almoxarifado na conclusão.</p>
            <ul>
                <li><strong>Veículos e Vínculo Patrimonial:</strong> Cada veículo pode ser associado a um bem patrimonial ativo (FUNC01). Bens baixados são terminantemente recusados.</li>
                <li><strong>Utilizações em Trânsito:</strong> Um veículo só pode ter no máximo uma utilização aberta por vez e deve estar com status <code>ATIVO</code>. Motoristas precisam estar com CNH regular.</li>
                <li><strong>Abastecimento Operacional:</strong> Registra consumo e atualiza hodômetro de forma progressiva. Não gera saída automática de almoxarifado.</li>
                <li><strong>Ordens de Serviço e Baixa de Peças:</strong> Peças aplicadas são materiais de consumo do almoxarifado (FUNC02). A conclusão da OS reserva estoque com lock e efetua a baixa atômica na mesma transação.</li>
            </ul>
        </div>
    </details>

    <section class="row g-3 mb-4" aria-label="Indicadores operacionais de frota">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="frotas-metric-card">
                <div class="frotas-metric-label">Veículos ativos</div>
                <div class="frotas-metric-value text-success">@Model.VeiculosAtivos</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="frotas-metric-card">
                <div class="frotas-metric-label">Em manutenção</div>
                <div class="frotas-metric-value text-warning">@Model.VeiculosEmManutencao</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="frotas-metric-card">
                <div class="frotas-metric-label">Indisponíveis</div>
                <div class="frotas-metric-value text-secondary">@Model.VeiculosIndisponiveis</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="frotas-metric-card">
                <div class="frotas-metric-label">Usos abertos</div>
                <div class="frotas-metric-value text-info">@Model.UsosAbertos</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="frotas-metric-card">
                <div class="frotas-metric-label">OS abertas</div>
                <div class="frotas-metric-value text-primary">@Model.OrdensAbertas</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="frotas-metric-card">
                <div class="frotas-metric-label">Custo do mês</div>
                <div class="frotas-metric-value text-dark fs-5">@Model.CustoMensal.ToString("C")</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="frotas-metric-card border-danger">
                <div class="frotas-metric-label text-danger">CNH vencida</div>
                <div class="frotas-metric-value text-danger">@Model.CnhVencida</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="frotas-metric-card border-warning">
                <div class="frotas-metric-label text-warning">CNH a vencer (30d)</div>
                <div class="frotas-metric-value text-warning">@Model.CnhAVencer</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="frotas-metric-card border-danger">
                <div class="frotas-metric-label text-danger">Documentos vencidos</div>
                <div class="frotas-metric-value text-danger">@Model.DocumentosVencidos</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="frotas-metric-card border-warning">
                <div class="frotas-metric-label text-warning">Docs a vencer (30d)</div>
                <div class="frotas-metric-value text-warning">@Model.DocumentosAVencer</div>
            </div>
        </div>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 fw-bold mb-3">Ações rápidas e cadastros</h2>
                    <div class="row g-2 mb-4">
                        <div class="col-sm-6">
                            <a href="/Frotas/Veiculos" class="btn btn-outline-secondary w-100 text-start py-2">
                                <span class="fw-bold d-block">Catálogo de veículos</span>
                                <small class="text-muted">Cadastro, vínculo com bem tombado e situação</small>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/Frotas/Motoristas" class="btn btn-outline-secondary w-100 text-start py-2">
                                <span class="fw-bold d-block">Condutores autorizados</span>
                                <small class="text-muted">Controle de CNH e validade operacional</small>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/Frotas/Utilizacoes" class="btn btn-outline-secondary w-100 text-start py-2">
                                <span class="fw-bold d-block">Saídas e retornos</span>
                                <small class="text-muted">Registro de uso diário e quilometragem</small>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/Frotas/OrdensServico" class="btn btn-outline-secondary w-100 text-start py-2">
                                <span class="fw-bold d-block">Ordens de serviço</span>
                                <small class="text-muted">Manutenção e aplicação de peças do estoque</small>
                            </a>
                        </div>
                    </div>

                    <h2 class="h6 fw-bold mb-2">Exportações oficiais e relatórios (LGPD)</h2>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-outline-primary" href="/Frotas/Exportar?tipo=veiculos">Exportar veículos CSV</a>
                        <a class="btn btn-sm btn-outline-primary" href="/Frotas/Exportar?tipo=utilizacoes">Exportar utilizações CSV</a>
                        <a class="btn btn-sm btn-outline-primary" href="/Frotas/Exportar?tipo=abastecimentos">Exportar abastecimentos CSV</a>
                        <a class="btn btn-sm btn-outline-primary" href="/Frotas/Exportar?tipo=ordens">Exportar ordens de serviço CSV</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="frotas-rules-card mt-0 h-100">
                <h3>Regras vigentes do módulo</h3>
                <ul>
                    <li><strong>B3. Utilização única:</strong> No máximo 1 utilização em aberto por veículo. Veículo deve estar <code>ATIVO</code>. CNH do condutor não pode estar vencida.</li>
                    <li><strong>B4. Hodômetro estrito:</strong> Quilometragem de abastecimento ou retorno nunca pode ser inferior à quilometragem atual do veículo.</li>
                    <li><strong>B5. Manutenção ativa:</strong> Abrir manutenção altera o veículo para <code>EM_MANUTENCAO</code> e bloqueia saídas. Conclusão só reativa se nenhuma outra OS estiver aberta.</li>
                    <li><strong>B6. Baixa atômica no estoque:</strong> Ao concluir a OS, as peças aplicadas (materiais de consumo) são debitadas do almoxarifado com trava de concorrência. Se faltar saldo, a conclusão é estritamente impedida.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
