@model IReadOnlyList<Sigov.Application.Frotas.OrdemServicoDto>
@{ViewData["Title"]="Ordens de serviço";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Ordens de serviço</h1><a class="btn btn-primary" href="/Frotas/OrdensServico/Nova">Nova OS</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Numero</th><th>Placa</th><th>DataAbertura</th><th>PrevisaoConclusao</th><th>ValorTotal</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Numero</td><td>@x.Placa</td><td>@x.DataAbertura</td><td>@x.PrevisaoConclusao</td><td>@x.ValorTotal</td><td>@x.Status</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>}</tbody></table></div>