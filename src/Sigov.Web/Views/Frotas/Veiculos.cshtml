@model IReadOnlyList<Sigov.Application.Frotas.VeiculoDto>
@{ViewData["Title"]="Veículos";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Veículos</h1><a class="btn btn-primary" href="/Frotas/Veiculos/Novo">Novo veículo</a></div><form class="row g-2 my-3"><div class="col-md-5"><input class="form-control" name="Busca" placeholder="Placa ou modelo"/></div><div class="col-md-3"><select class="form-select" name="Status"><option value="">Todos os status</option><option>ATIVO</option><option>EM_MANUTENCAO</option><option>INATIVO</option><option>BAIXADO</option></select></div><div class="col"><button class="btn btn-outline-secondary">Filtrar</button></div></form><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Placa</th><th>Veículo</th><th>Tipo</th><th>Km</th><th>Unidade</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Placa</td><td>@x.Marca @x.Modelo</td><td>@x.Tipo</td><td>@x.QuilometragemAtual</td><td>@x.UnidadeResponsavel</td><td><span class="badge bg-secondary">@x.Status</span></td><td><a href="/Frotas/Veiculos/Detalhe/@x.Id">Detalhe</a></td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="text-center text-muted py-4">Nenhum veículo encontrado.</td></tr>}</tbody></table></div>
