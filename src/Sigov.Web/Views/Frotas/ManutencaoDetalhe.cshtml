@model Sigov.Application.Frotas.ManutencaoDto
@{ ViewData["Title"] = $"Manutenção #{Model.Id}"; }
<partial name="_Nav" />
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Frotas/Manutencoes">Manutenções</a></li><li class="breadcrumb-item active" aria-current="page">#@Model.Id</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1 class="h3 mb-1">Manutenção #@Model.Id</h1><p class="text-muted mb-0">@Model.Placa · @Model.Tipo</p></div><span class="badge bg-secondary fs-6" aria-label="Estado atual: @Model.Status">@Model.Status</span></div>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<section class="card mb-3"><div class="card-header"><strong>Dados registrados</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Problema ou serviço</dt><dd class="col-sm-9">@Model.Descricao</dd><dt class="col-sm-3">Abertura</dt><dd class="col-sm-9">@Model.DataAbertura.ToString("g")</dd><dt class="col-sm-3">Quilometragem</dt><dd class="col-sm-9">@Model.KmAbertura.ToString("N2")</dd><dt class="col-sm-3">Valor estimado</dt><dd class="col-sm-9">@Model.ValorEstimado.ToString("C")</dd><dt class="col-sm-3">Observações</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Observacao) ? "Não informadas" : Model.Observacao)</dd></dl></div></section>
@if (Model.Status is not ("CONCLUIDA" or "CANCELADA"))
{
<section class="card"><div class="card-header"><strong>Próxima ação permitida</strong></div><div class="card-body"><form method="post" action="/Frotas/Manutencoes/Detalhe/@Model.Id/Concluir" class="row g-3 align-items-end">@Html.AntiForgeryToken()<div class="col-md-4"><label for="valorFinal" class="form-label">Valor final</label><input id="valorFinal" name="valorFinal" type="number" min="0" step="0.01" value="@Model.ValorEstimado.ToString(System.Globalization.CultureInfo.InvariantCulture)" required class="form-control" /></div><div class="col-md-auto"><button class="btn btn-primary" type="submit">Concluir manutenção</button></div></form></div></section>
}
else
{
<div class="alert alert-info">Esta manutenção está encerrada e não admite conclusão silenciosa.</div>
}
