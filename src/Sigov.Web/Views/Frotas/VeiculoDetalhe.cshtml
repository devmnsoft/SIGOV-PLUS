@model Sigov.Application.Frotas.VeiculoDto
@{
    ViewData["Title"] = $"Veículo {Model.Placa}";
    var badgeClass = Model.Status switch
    {
        "ATIVO" => "frotas-badge-ativo",
        "EM_MANUTENCAO" => "frotas-badge-manut",
        "BAIXADO" => "frotas-badge-baixado",
        _ => "frotas-badge-inativo"
    };
}
<link rel="stylesheet" href="~/css/frotas.css" asp-append-version="true" />

<div class="frotas-shell">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/Frotas">Frotas</a></li>
            <li class="breadcrumb-item"><a href="/Frotas/Veiculos">Veículos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Placa</li>
        </ol>
    </nav>

    <partial name="_Nav" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">@Model.Placa</h1>
                <span class="frotas-badge @badgeClass">@Model.Status</span>
            </div>
            <p class="text-muted mb-0">@Model.Marca @Model.Modelo (@Model.Tipo)</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/Frotas/Veiculos">Voltar</a>
            <a class="btn btn-primary" href="/Frotas/Veiculos/Editar/@Model.Id">Editar veículo</a>
        </div>
    </div>

    <details class="how-to mb-4">
        <summary>Como usar esta tela</summary>
        <div class="mt-2 text-muted">
            <p>Placa única na entidade. Bem patrimonial pela lista, só ATIVO. KM não retroage. Em manutenção o veículo não sai.</p>
            <p class="mb-0">Acesse o bem patrimonial tombado para visualizar histórico de aquisição e transferências ou inicie novos lançamentos operacionais.</p>
        </div>
    </details>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h2 class="h6 fw-bold mb-0">Especificações Técnicas e Cadastrais</h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Placa Oficial</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Placa</dd>

                        <dt class="col-sm-4 text-muted">Marca / Modelo</dt>
                        <dd class="col-sm-8">@Model.Marca @Model.Modelo</dd>

                        <dt class="col-sm-4 text-muted">Categoria / Tipo</dt>
                        <dd class="col-sm-8">@Model.Tipo</dd>

                        <dt class="col-sm-4 text-muted">Renavam</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Renavam) ? "—" : Model.Renavam)</dd>

                        <dt class="col-sm-4 text-muted">Chassi</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Chassi) ? "—" : Model.Chassi)</dd>

                        <dt class="col-sm-4 text-muted">Ano Fabr. / Modelo</dt>
                        <dd class="col-sm-8">@(Model.AnoFabricacao?.ToString() ?? "—") / @(Model.AnoModelo?.ToString() ?? "—")</dd>

                        <dt class="col-sm-4 text-muted">Combustível</dt>
                        <dd class="col-sm-8">@Model.CombustivelPrincipal</dd>

                        <dt class="col-sm-4 text-muted">Unidade Responsável</dt>
                        <dd class="col-sm-8">@Model.UnidadeResponsavel</dd>

                        <dt class="col-sm-4 text-muted">Observações</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "Nenhuma observação registrada." : Model.Observacoes)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h2 class="h6 fw-bold mb-0">Status e Vínculo Patrimonial</h2>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block">Hodômetro Atual</small>
                        <span class="fs-4 fw-bold text-dark">@Model.QuilometragemAtual.ToString("N0") km</span>
                    </div>

                    @if (Model.HorimetroAtual.HasValue && Model.HorimetroAtual.Value > 0)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Horímetro Atual</small>
                            <span class="fs-5 fw-bold text-dark">@Model.HorimetroAtual.Value.ToString("N1") h</span>
                        </div>
                    }

                    <div class="mb-3">
                        <small class="text-muted d-block">Bem Patrimonial Tombado (FUNC01)</small>
                        @if (Model.BemPatrimonialId.HasValue)
                        {
                            <div class="p-2 border rounded bg-light mt-1">
                                <span class="fw-bold d-block">Nº @(Model.BemPatrimonialNumero ?? Model.BemPatrimonialId.ToString())</span>
                                <small class="text-muted d-block">@(Model.BemPatrimonialDescricao ?? "Bem tombado")</small>
                                <a href="/Patrimonio/Bens/Detalhe/@Model.BemPatrimonialId" class="btn btn-sm btn-outline-primary mt-2">
                                    Abrir ficha patrimonial
                                </a>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Nenhum bem patrimonial vinculado.</span>
                        }
                    </div>

                    <hr />

                    <h3 class="h6 fw-bold mb-2">Operações Rápidas</h3>
                    <div class="d-grid gap-2">
                        @if (Model.Status == "ATIVO")
                        {
                            <a href="/Frotas/Utilizacoes/Nova" class="btn btn-outline-primary btn-sm text-start">Abrir utilização para este veículo</a>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary btn-sm text-start" disabled title="Veículo não está ativo (@Model.Status)">
                                Utilização bloqueada (@Model.Status)
                            </button>
                        }
                        <a href="/Frotas/Abastecimentos/Novo" class="btn btn-outline-secondary btn-sm text-start">Registrar abastecimento</a>
                        <a href="/Frotas/Manutencoes/Nova" class="btn btn-outline-secondary btn-sm text-start">Abrir manutenção / OS</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
