@model Sigov.Application.Frotas.VeiculoDto
@{ViewData["Title"]="Detalhe do veículo";}<partial name="_Nav"/><h1 class="h3">@Model.Placa — @Model.Marca @Model.Modelo</h1><section class="card"><div class="card-header">Dados operacionais</div><dl class="row card-body"><dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd><dt class="col-sm-3">Quilometragem</dt><dd class="col-sm-9">@Model.QuilometragemAtual</dd><dt class="col-sm-3">Unidade</dt><dd class="col-sm-9">@Model.UnidadeResponsavel</dd><dt class="col-sm-3">Bem patrimonial</dt><dd class="col-sm-9">@(Model.BemPatrimonialId?.ToString()??"Não vinculado")</dd></dl></section><a class="btn btn-outline-primary mt-3" href="/Frotas/Veiculos/Editar/@Model.Id">Editar</a>
