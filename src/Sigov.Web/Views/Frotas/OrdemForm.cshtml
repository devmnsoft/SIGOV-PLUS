@{ViewData["Title"]="Nova ordem de serviço";}<partial name="_Nav"/><h1 class="h3">Nova ordem de serviço</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card card-body"><div class="row g-3"><div class="col-md-3"><label>Número</label><input name="Numero" required class="form-control"/></div><div class="col-md-2"><label>Exercício</label><input name="Exercicio" type="number" required class="form-control"/></div><div class="col-md-4"><label>Veículo</label><select name="VeiculoId" class="form-select">@foreach(var x in ViewBag.Veiculos){<option value="@x.Id">@x.Placa — @x.Modelo</option>}</select></div><div class="col-md-3"><label>Abertura</label><input name="DataAbertura" type="datetime-local" required class="form-control"/></div><div class="col-12"><label>Descrição</label><textarea name="Descricao" required class="form-control"></textarea></div></div><fieldset class="border rounded p-3 mt-3"><legend class="h6">Primeiro item</legend><div class="row g-2"><div class="col-md-4"><input name="Itens[0].Descricao" required class="form-control" placeholder="Descrição"/></div><div class="col-md-2"><select name="Itens[0].Tipo" class="form-select"><option>SERVICO</option><option>PECA</option><option>MATERIAL</option></select></div><div class="col-md-2"><input name="Itens[0].Quantidade" type="number" min=".0001" step=".0001" required class="form-control" placeholder="Quantidade"/></div><div class="col-md-2"><input name="Itens[0].ValorUnitario" type="number" min="0" step=".01" required class="form-control" placeholder="Valor"/></div><div class="col-md-2"><input name="Itens[0].MaterialId" type="number" class="form-control" placeholder="Material ID"/></div><div class="col-md-2"><input name="Itens[0].AlmoxarifadoId" type="number" class="form-control" placeholder="Almoxarifado ID"/></div></div></fieldset><input name="EntidadeId" value="0" type="hidden"/><button class="btn btn-primary mt-3 align-self-start">Criar OS</button></form>
