@model IReadOnlyList<Sigov.Application.Frotas.MotoristaDto>
@{ViewData["Title"]="Motoristas";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Motoristas</h1><a class="btn btn-primary" href="/Frotas/Motoristas/Novo">Novo motorista</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Nome</th><th>CPF protegido</th><th>CNH</th><th>Validade</th><th>Lotação</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nome</td><td>@x.CpfMascarado</td><td>@x.Cnh / @x.CategoriaCnh</td><td>@x.ValidadeCnh.ToString("dd/MM/yyyy")</td><td>@x.VinculoLotacao</td><td><span class="badge bg-secondary">@x.Status</span></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted">Nenhum motorista.</td></tr>}</tbody></table></div>
