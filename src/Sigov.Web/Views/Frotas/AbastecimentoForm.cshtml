@{ViewData["Title"]="Novo abastecimento";}<partial name="_Nav"/><h1 class="h3">Novo abastecimento</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card card-body">
    @Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label>Veículo</label><select name="VeiculoId" class="form-select">@foreach(var x in ViewBag.Veiculos){<option value="@x.Id">@x.Placa — @x.Modelo</option>}</select></div><div class="col-md-3"><label>Data</label><input name="DataAbastecimento" type="datetime-local" required class="form-control"/></div><div class="col-md-2"><label>Km atual</label><input name="KmAtual" type="number" min="0" step=".01" required class="form-control"/></div><div class="col-md-3"><label>Combustível</label><input name="TipoCombustivel" required class="form-control"/></div><div class="col-md-3"><label>Litros</label><input name="Litros" type="number" min=".0001" step=".0001" required class="form-control"/></div><div class="col-md-3"><label>Valor unitário</label><input name="ValorUnitario" type="number" min="0" step=".0001" required class="form-control"/></div><div class="col-md-3"><label>Contrato (opcional)</label><input name="ContratoId" type="number" class="form-control"/></div><div class="col-md-3"><label>Documento fiscal</label><input name="DocumentoFiscal" class="form-control"/></div></div><input name="EntidadeId" value="0" type="hidden"/><button class="btn btn-primary mt-3 align-self-start">Registrar</button></form><p class="text-muted mt-2">O valor total é calculado no PostgreSQL como litros × valor unitário.</p>
