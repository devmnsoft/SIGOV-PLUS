@model IReadOnlyList<Sigov.Application.Frotas.DocumentoDto>
@{
    ViewData["Title"] = "Documentos e Vencimentos";
    var veiculos = ViewBag.Veiculos as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
    var hoje = DateTime.Today;
}
<link rel="stylesheet" href="~/css/frotas.css" asp-append-version="true" />

<div class="frotas-shell">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/Frotas">Frotas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Documentos</li>
        </ol>
    </nav>

    <partial name="_Nav" />

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Documentos e Vencimentos</h1>
            <p class="text-muted mb-0">Controle de prazos de licenciamento, seguros, tacógrafo e IPVA.</p>
        </div>
        <div>
            <a class="btn btn-primary" href="#cadastrar-documento">Novo documento</a>
        </div>
    </div>

    <details class="how-to mb-4">
        <summary>Como usar esta tela</summary>
        <div class="mt-2 text-muted">
            <p>Acompanhe vencimento. O dashboard alerta 30 dias. Sem exportar arquivo.</p>
            <ul>
                <li><strong>Metadados Oficiais:</strong> Armazenamento estrito de datas e números para alertas operacionais e de conformidade.</li>
                <li><strong>Vencimentos Próximos:</strong> Documentos a vencer em até 30 dias e documentos vencidos são destacados no Painel Operacional de Frotas.</li>
            </ul>
        </div>
    </details>

    <div class="card shadow-sm border-0 mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Placa</th>
                        <th>Tipo de Documento</th>
                        <th>Número / Registro</th>
                        <th>Data de Vencimento</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        var vencido = x.DataVencimento < hoje;
                        var vence30d = !vencido && x.DataVencimento <= hoje.AddDays(30);

                        <tr>
                            <td class="fw-bold text-dark">@x.Placa</td>
                            <td><span class="badge bg-light text-dark border">@x.Tipo</span></td>
                            <td>@x.Numero</td>
                            <td>
                                @x.DataVencimento.ToString("dd/MM/yyyy")
                                @if (vencido)
                                {
                                    <span class="badge bg-danger ms-1">Vencido</span>
                                }
                                else if (vence30d)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Vence em 30d</span>
                                }
                            </td>
                            <td>
                                <span class="frotas-badge @(x.Status == "ATIVO" ? "frotas-badge-ativo" : "frotas-badge-inativo")">
                                    @x.Status
                                </span>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="frotas-empty-state">
                                    <strong>Nenhum documento cadastrado</strong>
                                    <p class="mb-0">Utilize o formulário abaixo para registrar os documentos do veículo.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="cadastrar-documento" class="card shadow-sm border-0">
        <div class="card-header bg-light py-3">
            <h2 class="h6 fw-bold mb-0">Cadastrar Documento do Veículo</h2>
        </div>
        <div class="card-body p-4">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EntidadeId" value="0" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Veículo Oficial <span class="text-danger">*</span></label>
                        <select name="VeiculoId" class="form-select" required>
                            <option value="">-- Selecione o veículo --</option>
                            @foreach (var v in veiculos)
                            {
                                <option value="@v.Id">@v.Placa — @v.Marca @v.Modelo</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tipo de Documento <span class="text-danger">*</span></label>
                        <select class="form-select" name="Tipo" required>
                            <option value="LICENCIAMENTO">LICENCIAMENTO</option>
                            <option value="SEGURO">SEGURO OBRIGATÓRIO / APÓLICE</option>
                            <option value="TACOGRAFO">CERTIFICADO DE TACÓGRAFO</option>
                            <option value="IPVA">IPVA</option>
                            <option value="OUTRO">OUTRO DOCUMENTO</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Número do Registro <span class="text-danger">*</span></label>
                        <input class="form-control" name="Numero" required placeholder="Ex: 2026-987654" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Vencimento <span class="text-danger">*</span></label>
                        <input class="form-control" name="DataVencimento" type="date" required />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary px-4">Salvar documento</button>
                </div>
            </form>
        </div>
    </div>
</div>