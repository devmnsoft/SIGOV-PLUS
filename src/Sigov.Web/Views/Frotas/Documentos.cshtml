@model IReadOnlyList<Sigov.Application.Frotas.DocumentoDto>
@{ViewData["Title"]="Documentos e vencimentos";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Documentos e vencimentos</h1><a class="btn btn-primary" href="#documento">Novo documento</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Placa</th><th>Tipo</th><th>Numero</th><th>DataVencimento</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Placa</td><td>@x.Tipo</td><td>@x.Numero</td><td>@x.DataVencimento</td><td>@x.Status</td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>}</tbody></table></div><form id="documento" method="post" class="card card-body mt-3">
    @Html.AntiForgeryToken()<h2 class="h5">Cadastrar documento</h2><div class="row g-2"><div class="col"><input class="form-control" name="VeiculoId" type="number" required placeholder="ID veículo"/></div><div class="col"><select class="form-select" name="Tipo"><option>LICENCIAMENTO</option><option>SEGURO</option><option>TACOGRAFO</option><option>IPVA</option><option>OUTRO</option></select></div><div class="col"><input class="form-control" name="Numero" required placeholder="Número"/></div><div class="col"><input class="form-control" name="DataVencimento" type="date" required/></div><div class="col-auto"><button class="btn btn-primary">Salvar</button></div></div><input type="hidden" name="EntidadeId" value="0"/></form>