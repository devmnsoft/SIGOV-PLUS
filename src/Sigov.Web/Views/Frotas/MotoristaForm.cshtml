@{ViewData["Title"]="Novo motorista";}<partial name="_Nav"/><h1 class="h3">Novo motorista</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card card-body">
    @Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-6"><label class="form-label">Nome</label><input name="Nome" required class="form-control"/></div><div class="col-md-3"><label class="form-label">CPF</label><input name="Cpf" required class="form-control" autocomplete="off"/></div><div class="col-md-3"><label class="form-label">CNH</label><input name="Cnh" required class="form-control"/></div><div class="col-md-3"><label class="form-label">Categoria</label><input name="CategoriaCnh" required class="form-control"/></div><div class="col-md-3"><label class="form-label">Validade</label><input name="ValidadeCnh" type="date" required class="form-control"/></div><div class="col-md-3"><label class="form-label">Telefone</label><input name="Telefone" class="form-control"/></div><div class="col-md-3"><label class="form-label">E-mail</label><input name="Email" type="email" class="form-control"/></div><div class="col-md-6"><label class="form-label">Vínculo/lotação</label><input name="VinculoLotacao" class="form-control"/></div><div class="col-md-3"><label class="form-label">Status</label><select name="Status" class="form-select"><option>ATIVO</option><option>SUSPENSO</option><option>INATIVO</option></select></div></div><input type="hidden" name="EntidadeId" value="0"/><button class="btn btn-primary mt-3 align-self-start">Salvar</button></form>
