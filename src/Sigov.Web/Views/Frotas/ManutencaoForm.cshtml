@{
    ViewData["Title"] = "Nova Manutenção";
    var veiculos = ViewBag.Veiculos as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
    var fornecedores = ViewBag.Fornecedores as IReadOnlyList<Sigov.Application.Frotas.FrotaSelect> ?? Array.Empty<Sigov.Application.Frotas.FrotaSelect>();
    var contratos = ViewBag.Contratos as IReadOnlyList<Sigov.Application.Frotas.FrotaSelect> ?? Array.Empty<Sigov.Application.Frotas.FrotaSelect>();
}
<link rel="stylesheet" href="~/css/frotas.css" asp-append-version="true" />

<div class="frotas-shell">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/Frotas">Frotas</a></li>
            <li class="breadcrumb-item"><a href="/Frotas/Manutencoes">Manutenções</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nova</li>
        </ol>
    </nav>

    <partial name="_Nav" />

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Abrir Manutenção de Veículo</h1>
        <p class="text-muted mb-0">Envio para oficina credenciada ou oficina municipal própria.</p>
    </div>

    <details class="how-to mb-4">
        <summary>Como usar esta tela</summary>
        <div class="mt-2 text-muted">
            <p>Abrir coloca o veículo em manutenção. Concluir só reativa se não houver outra OS/manutenção aberta. Fornecedor pela lista do Compras.</p>
            <ul>
                <li><strong>Bloqueio de Saídas:</strong> Ao registrar esta manutenção, o veículo selecionado mudará seu status para <code>EM_MANUTENCAO</code> e novas saídas ficarão bloqueadas.</li>
                <li><strong>Fornecedor e Contrato:</strong> Selecione a oficina autorizada e o contrato do módulo de Compras (FUNC03) por seus nomes oficiais.</li>
            </ul>
        </div>
    </details>

    <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                @Html.AntiForgeryToken()
                <input name="EntidadeId" value="0" type="hidden" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Veículo Oficial <span class="text-danger">*</span></label>
                        <select name="VeiculoId" class="form-select" required>
                            <option value="">-- Selecione o veículo --</option>
                            @foreach (var v in veiculos)
                            {
                                <option value="@v.Id">@v.Placa — @v.Marca @v.Modelo (Km Atual: @v.QuilometragemAtual)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tipo de Manutenção <span class="text-danger">*</span></label>
                        <select name="Tipo" class="form-select" required>
                            <option value="PREVENTIVA">PREVENTIVA</option>
                            <option value="CORRETIVA">CORRETIVA</option>
                            <option value="REVISAO">REVISÃO PROGRAMADA</option>
                            <option value="PNEU">PNEUS / ALINHAMENTO</option>
                            <option value="LAVAGEM">LAVAGEM / HIGIENIZAÇÃO</option>
                            <option value="OUTRA">OUTRA</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Data e Hora de Abertura <span class="text-danger">*</span></label>
                        <input name="DataAbertura" type="datetime-local" required class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Km no Momento da Entrada <span class="text-danger">*</span></label>
                        <input name="KmAbertura" type="number" min="0" step="0.01" required class="form-control" placeholder="Km no painel" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Valor Estimado (R$)</label>
                        <input name="ValorEstimado" type="number" min="0" step="0.01" class="form-control" placeholder="0,00" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Oficina Mecânica / Prestador (FUNC03)</label>
                        <select name="FornecedorId" class="form-select">
                            <option value="">-- Selecione a oficina credenciada (opcional) --</option>
                            @foreach (var f in fornecedores)
                            {
                                <option value="@f.Id">@f.Texto</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Contrato Administrativo Vinculado (FUNC03)</label>
                        <select name="ContratoId" class="form-select">
                            <option value="">-- Selecione o contrato (opcional) --</option>
                            @foreach (var c in contratos)
                            {
                                <option value="@c.Id">@c.Texto</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Descrição do Defeito / Diagnóstico Inicial <span class="text-danger">*</span></label>
                        <textarea name="Descricao" required class="form-control" rows="3" placeholder="Relate o problema mecânico, sintomas ou serviços preventivos necessários..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a class="btn btn-outline-secondary" href="/Frotas/Manutencoes">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">Abrir manutenção</button>
                </div>
            </form>
        </div>
    </div>
</div>
