@{ViewData["Title"]="Nova manutenção";}<partial name="_Nav"/><h1 class="h3">Nova manutenção</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card card-body">
    @Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label>Veículo</label><select name="VeiculoId" class="form-select">@foreach(var x in ViewBag.Veiculos){<option value="@x.Id">@x.Placa — @x.Modelo</option>}</select></div><div class="col-md-3"><label>Tipo</label><select name="Tipo" class="form-select"><option>PREVENTIVA</option><option>CORRETIVA</option><option>REVISAO</option><option>PNEU</option><option>LAVAGEM</option><option>OUTRA</option></select></div><div class="col-md-3"><label>Abertura</label><input name="DataAbertura" type="datetime-local" required class="form-control"/></div><div class="col-md-2"><label>Km abertura</label><input name="KmAbertura" type="number" min="0" step=".01" required class="form-control"/></div><div class="col-md-9"><label>Problema/serviço</label><textarea name="Descricao" required class="form-control"></textarea></div><div class="col-md-3"><label>Valor estimado</label><input name="ValorEstimado" type="number" min="0" step=".01" required class="form-control"/></div></div><input name="EntidadeId" value="0" type="hidden"/><button class="btn btn-primary mt-3 align-self-start">Abrir manutenção</button></form>
