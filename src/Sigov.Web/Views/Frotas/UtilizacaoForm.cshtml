@{ViewData["Title"]="Nova utilização";}<partial name="_Nav"/><h1 class="h3">Nova utilização</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card card-body"><div class="row g-3"><div class="col-md-4"><label>Veículo</label><select name="VeiculoId" class="form-select">@foreach(var x in ViewBag.Veiculos){<option value="@x.Id">@x.Placa — @x.Modelo</option>}</select></div><div class="col-md-4"><label>Motorista</label><select name="MotoristaId" class="form-select">@foreach(var x in ViewBag.Motoristas){<option value="@x.Id">@x.Nome</option>}</select></div><div class="col-md-4"><label>Unidade solicitante</label><input name="UnidadeSolicitante" required class="form-control"/></div><div class="col-md-4"><label>Saída</label><input name="SaidaEm" type="datetime-local" required class="form-control"/></div><div class="col-md-3"><label>Km saída</label><input name="KmSaida" type="number" min="0" step=".01" required class="form-control"/></div><div class="col-md-5"><label>Destino</label><input name="Destino" required class="form-control"/></div><div class="col-12"><label>Finalidade</label><textarea name="Finalidade" required class="form-control"></textarea></div></div><input name="EntidadeId" value="0" type="hidden"/><button class="btn btn-primary mt-3 align-self-start">Abrir utilização</button></form>
