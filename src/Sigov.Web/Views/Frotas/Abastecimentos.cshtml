@model IReadOnlyList<Sigov.Application.Frotas.AbastecimentoDto>
@{ViewData["Title"]="Abastecimentos";}<partial name="_Nav"/><div class="d-flex justify-content-between"><h1 class="h3">Abastecimentos</h1><a class="btn btn-primary" href="/Frotas/Abastecimentos/Novo">Novo abastecimento</a></div><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Placa</th><th>DataAbastecimento</th><th>KmAtual</th><th>TipoCombustivel</th><th>Litros</th><th>ValorTotal</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Placa</td><td>@x.DataAbastecimento</td><td>@x.KmAtual</td><td>@x.TipoCombustivel</td><td>@x.Litros</td><td>@x.ValorTotal</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>}</tbody></table></div>