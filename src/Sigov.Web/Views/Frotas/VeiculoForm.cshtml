@{ViewData["Title"]="Veículo";}<partial name="_Nav"/><h1 class="h3">@(ViewBag.Id is null?"Novo veículo":"Editar veículo")</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Placa</label><input name="Placa" class="form-control" required/></div><div class="col-md-3"><label class="form-label">Renavam</label><input name="Renavam" class="form-control"/></div><div class="col-md-3"><label class="form-label">Chassi</label><input name="Chassi" class="form-control"/></div><div class="col-md-3"><label class="form-label">Marca</label><input name="Marca" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Modelo</label><input name="Modelo" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Ano fabricação</label><input name="AnoFabricacao" type="number" class="form-control"/></div><div class="col-md-2"><label class="form-label">Ano modelo</label><input name="AnoModelo" type="number" class="form-control"/></div><div class="col-md-4"><label class="form-label">Tipo</label><select name="Tipo" class="form-select">@foreach(var x in new[]{"PASSEIO","CAMINHONETE","CAMINHAO","ONIBUS","MOTOCICLETA","MAQUINA","OUTRO"}){<option>@x</option>}</select></div><div class="col-md-3"><label class="form-label">Combustível</label><input name="CombustivelPrincipal" class="form-control" required/></div><div class="col-md-3"><label class="form-label">Quilometragem</label><input name="QuilometragemAtual" type="number" step=".01" min="0" class="form-control" required/></div><div class="col-md-3"><label class="form-label">Horímetro</label><input name="HorimetroAtual" type="number" step=".01" min="0" class="form-control"/></div><div class="col-md-3"><label class="form-label">Status</label><select name="Status" class="form-select"><option>ATIVO</option><option>EM_MANUTENCAO</option><option>INATIVO</option><option>BAIXADO</option></select></div><div class="col-md-6"><label class="form-label">Unidade responsável</label><input name="UnidadeResponsavel" class="form-control" required/></div><div class="col-md-3"><label class="form-label">Bem patrimonial</label><input name="BemPatrimonialId" type="number" class="form-control"/></div><div class="col-12"><label class="form-label">Observações</label><textarea name="Observacoes" class="form-control"></textarea></div></div><input type="hidden" name="EntidadeId" value="0"/><button class="btn btn-primary mt-3 align-self-start">Salvar</button></form>
