@{
    var code = (int?)ViewData["Code"] ?? 500;
    var title = code == 404 ? "Página não encontrada" : code == 403 ? "Acesso não autorizado" : "Erro inesperado";
    ViewData["Title"] = title;
}
<section class="container-fluid py-5"><div class="card border-0 shadow-sm"><div class="card-body p-5 text-center"><span class="badge text-bg-secondary mb-3">@code</span><h1 class="h3">@title</h1><p class="text-muted">Não foi possível concluir a solicitação. A equipe técnica recebeu os dados necessários nos logs, sem expor stacktrace ou dados pessoais.</p><p class="small text-muted">CorrelationId: @Context.TraceIdentifier</p><a class="btn btn-primary" href="/Dashboard">Voltar ao dashboard</a> <a class="btn btn-outline-secondary" href="/Ajuda">Central de ajuda</a></div></div></section>
