@model Sigov.Web.Controllers.EnterprisePageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="container-fluid py-4 enterprise-crud" data-api-route="@Model.ApiRoute" data-tenant-id="@Model.TenantId">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-primary fw-semibold mb-1">SIGOV PLUS • @Model.Module</p>
            <h1 class="display-6 mb-2">@Model.Title</h1>
            <p class="lead mb-0">Jornada operacional com CRUD real, filtros, paginação, ações, auditoria, mascaramento LGPD e fallback honesto quando a estrutura ainda não foi aplicada.</p>
        </div>
        <div class="text-lg-end">
            <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.Permission</span>
            <div class="small text-muted mt-2">Tenant: @(Model.TenantId?.ToString() ?? "não resolvido")</div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><span class="text-muted">Registros</span><h2>@Model.Dashboard.Registros</h2></div></div></div>
        <div class="col-12 col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><span class="text-muted">Pendências</span><h2>@Model.Dashboard.Pendencias</h2></div></div></div>
        <div class="col-12 col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><span class="text-muted">API</span><code class="d-block text-break">@Model.ApiRoute</code></div></div></div>
    </div>

    <div class="alert alert-info d-flex align-items-start gap-2" role="alert">
        <span class="fw-bold">LGPD</span>
        <span>Listagens e CSV exibem documento, e-mail e telefone mascarados. Dados completos exigem permissão específica e não são renderizados nesta tela operacional.</span>
    </div>

    @if (Model.Dashboard.Alertas.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Alertas operacionais:</strong>
            <ul class="mb-0">
                @foreach (var alerta in Model.Dashboard.Alertas) { <li>@alerta</li> }
            </ul>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex flex-column flex-lg-row justify-content-between gap-3">
            <form class="row gy-2 gx-2 align-items-end enterprise-filters flex-grow-1">
                <div class="col-12 col-lg-4"><label class="form-label small text-muted">Busca</label><input class="form-control" name="q" placeholder="Nome, código, status ou dado mascarado" /></div>
                <div class="col-6 col-lg-2"><label class="form-label small text-muted">Status</label><select class="form-select" name="status"><option value="">Todos</option><option>ATIVO</option><option>ABERTO</option><option>APROVADA</option><option>CONFIRMADO</option><option>CONCLUIDA_EVENTO_FINANCEIRO_FUTURO</option></select></div>
                <div class="col-6 col-lg-2"><label class="form-label small text-muted">Página</label><input class="form-control" name="page" type="number" min="1" value="1" /></div>
                <div class="col-12 col-lg-4 d-flex gap-2 flex-wrap"><button type="submit" class="btn btn-outline-primary">Filtrar</button><button type="button" class="btn btn-outline-secondary enterprise-export">Exportar CSV</button><button type="button" class="btn btn-outline-dark" data-bs-toggle="collapse" data-bs-target="#enterpriseImportPanel">Importar CSV</button></div>
            </form>
            <button type="button" class="btn btn-primary enterprise-new" data-bs-toggle="modal" data-bs-target="#enterpriseFormModal">Novo</button>
        </div>
        <div class="collapse border-top" id="enterpriseImportPanel"><div class="p-3 bg-light"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label small text-muted">Arquivo CSV seguro</label><input class="form-control enterprise-import-file" type="file" accept=".csv,text/csv" /></div><div class="col-md-3"><button type="button" class="btn btn-outline-primary enterprise-import-preview">Pré-visualizar importação</button></div><div class="col-md-4"><div class="small text-muted enterprise-import-preview-result">A prévia valida colunas obrigatórias antes de chamar endpoints reais de importação.</div></div></div></div></div><div class="enterprise-batch d-flex gap-2 align-items-center p-2 border-top bg-white"><span class="small text-muted">Ações em lote:</span><button type="button" class="btn btn-sm btn-outline-danger" data-batch-action="inativar">Inativar selecionados</button><button type="button" class="btn btn-sm btn-outline-success" data-batch-action="restaurar">Restaurar selecionados</button><button type="button" class="btn btn-sm btn-outline-secondary enterprise-export">Exportar filtrados/selecionados</button></div><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Seleção / Nome</th><th>Status</th><th>Documento</th><th>E-mail</th><th>Telefone</th><th>Atualizado</th><th class="text-end">Ações</th></tr></thead>
                <tbody class="enterprise-table-body"><tr><td colspan="7" class="text-center py-5 text-muted">Carregando dados reais...</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2"><span class="small text-muted enterprise-status">Aguardando consulta.</span><div class="btn-group enterprise-pager" role="group" aria-label="Paginação"><button type="button" class="btn btn-outline-secondary btn-sm" data-page="-1">Anterior</button><button type="button" class="btn btn-outline-secondary btn-sm" data-page="1">Próxima</button></div></div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="enterpriseDetailPanel"><div class="offcanvas-header"><h5>Detalhes, anexos e auditoria</h5><button class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar detalhes"></button></div><div class="offcanvas-body enterprise-detail-body">Selecione um registro.</div></div>

    <div class="modal fade" id="enterpriseFormModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><form class="enterprise-form"><div class="modal-header"><h5 class="modal-title">Novo / Editar registro</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" /><div class="row g-3 enterprise-form-fields"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Salvar</button></div></form></div></div></div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3"><div class="toast enterprise-toast" role="status"><div class="toast-header"><strong class="me-auto">SIGOV Enterprise</strong><button type="button" class="btn-close" data-bs-dismiss="toast"></button></div><div class="toast-body"></div></div></div>
</section>
@section Scripts { <script src="~/js/enterprise-form-metadata.js" asp-append-version="true"></script><script src="~/js/enterprise-crud.js" asp-append-version="true"></script> }
