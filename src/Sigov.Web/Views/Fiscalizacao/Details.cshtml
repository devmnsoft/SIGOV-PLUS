@model Sigov.Application.Fiscalizacao.OrdemFiscalizacaoRequest
@{ViewData["Title"]="Detalhes da ordem";}
<partial name="_Nav"/><h1>Detalhes da ordem</h1><dl class="row"><dt class="col-sm-3">Origem</dt><dd class="col-sm-9">@Model.OrigemModulo</dd><dt class="col-sm-3">Registro</dt><dd class="col-sm-9">@Model.RegistroFiscalizadoRotulo</dd><dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Tipo</dd><dt class="col-sm-3">Prioridade</dt><dd class="col-sm-9">@Model.Prioridade</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Motivo</dt><dd class="col-sm-9">@Model.Motivo</dd></dl>
<div class="d-flex gap-2"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]">Editar</a><form asp-action="Cancelar" asp-route-id="@Context.Request.RouteValues["id"]" method="post">
    @Html.AntiForgeryToken()<label for="justificativa" class="visually-hidden">Justificativa</label><input id="justificativa" name="justificativa" required class="form-control mb-2" placeholder="Justificativa do cancelamento"/><button class="btn btn-danger">Cancelar ordem</button></form></div>
