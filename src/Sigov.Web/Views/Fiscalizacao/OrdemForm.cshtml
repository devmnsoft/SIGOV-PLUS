@model Sigov.Web.Models.Fiscalizacao.FiscalizacaoOrdemFormViewModel
@{ViewData["Title"]=Model.Id.HasValue?"Editar ordem":"Nova ordem";var action=Model.Id.HasValue?"Edit":"Create";}
<partial name="_Nav"/><h1>@ViewData["Title"]</h1>
<form asp-action="@action" asp-route-id="@Model.Id" method="post" class="card card-body">
    @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="row g-3"><div class="col-md-6"><label asp-for="Ordem.OrigemModulo" class="form-label">Módulo de origem</label><select asp-for="Ordem.OrigemModulo" class="form-select"><option value="">Selecione</option><option value="OBRAS">Obras</option><option value="MEIO_AMBIENTE">Meio Ambiente</option><option value="TRANSITO">Trânsito</option><option value="DEFESA_CIVIL">Defesa Civil</option></select><span asp-validation-for="Ordem.OrigemModulo" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Ordem.RegistroFiscalizadoId" class="form-label">Registro fiscalizado</label><select asp-for="Ordem.RegistroFiscalizadoId" class="form-select"><option value="">Selecione um registro da origem</option>@foreach(var x in Model.Registros){<option value="@x.Id">@x.Rotulo</option>}</select><span asp-validation-for="Ordem.RegistroFiscalizadoId" class="text-danger"></span><input asp-for="Ordem.RegistroFiscalizadoTipo" type="hidden" value="@Model.Ordem.OrigemModulo"/><input asp-for="Ordem.RegistroFiscalizadoRotulo" type="hidden"/><span asp-validation-for="Ordem.RegistroFiscalizadoTipo" class="text-danger"></span><span asp-validation-for="Ordem.RegistroFiscalizadoRotulo" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Ordem.Tipo" class="form-label">Tipo de fiscalização</label><input asp-for="Ordem.Tipo" class="form-control"/><span asp-validation-for="Ordem.Tipo" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Ordem.Prioridade" class="form-label">Prioridade</label><select asp-for="Ordem.Prioridade" class="form-select"><option>BAIXA</option><option>NORMAL</option><option>ALTA</option><option>URGENTE</option></select><span asp-validation-for="Ordem.Prioridade" class="text-danger"></span></div>
 <div class="col-md-3"><label asp-for="Ordem.AgendadaEm" class="form-label">Agendamento</label><input asp-for="Ordem.AgendadaEm" type="datetime-local" class="form-control"/><span asp-validation-for="Ordem.AgendadaEm" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Ordem.EquipeId" class="form-label">Equipe responsável</label><select asp-for="Ordem.EquipeId" class="form-select"><option value="">Selecione</option>@foreach(var x in Model.Equipes){<option value="@x.Id">@x.Rotulo</option>}</select><span asp-validation-for="Ordem.EquipeId" class="text-danger"></span></div>
 <div class="col-12"><label asp-for="Ordem.Motivo" class="form-label">Motivo</label><textarea asp-for="Ordem.Motivo" class="form-control" rows="3"></textarea><span asp-validation-for="Ordem.Motivo" class="text-danger"></span></div><div class="col-12"><label asp-for="Ordem.Observacoes" class="form-label">Observações</label><textarea asp-for="Ordem.Observacoes" class="form-control" rows="3"></textarea><span asp-validation-for="Ordem.Observacoes" class="text-danger"></span></div></div><button class="btn btn-primary mt-4" type="submit">Salvar ordem</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
