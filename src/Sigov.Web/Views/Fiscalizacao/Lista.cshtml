@model Sigov.Web.Models.Fiscalizacao.FiscalizacaoListaViewModel
@{ViewData["Title"]=Model.Titulo;}
<partial name="_Nav"/><div class="d-flex justify-content-between align-items-center"><h1>@Model.Titulo</h1>@if(Model.Recurso=="Ordens"){<a class="btn btn-primary" asp-action="Create">Nova ordem</a>}</div>
<form method="get" class="card card-body mb-3"><div class="row g-3"><div class="col-md-3"><label for="modulo" class="form-label">Módulo</label><select id="modulo" name="modulo" class="form-select"><option value="">Todos</option><option>OBRAS</option><option>MEIO_AMBIENTE</option><option>TRANSITO</option><option>DEFESA_CIVIL</option></select></div><div class="col-md-3"><label for="status" class="form-label">Status</label><input id="status" name="status" value="@Model.Filtro.Status" class="form-control"/></div><div class="col-md-3"><label for="inicio" class="form-label">Início</label><input id="inicio" name="inicio" type="date" value="@Model.Filtro.Inicio?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-3"><label for="fim" class="form-label">Fim</label><input id="fim" name="fim" type="date" value="@Model.Filtro.Fim?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-12"><label for="busca" class="form-label">Local ou registro fiscalizado</label><input id="busca" name="busca" value="@Model.Filtro.Busca" class="form-control"/><button class="btn btn-primary mt-3">Filtrar</button></div></div></form>
@if(Model.Itens.Count==0){<div class="alert alert-info">Nenhum registro encontrado para os filtros informados.</div>}else{<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Data</th><th></th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td>@x.Status</td><td>@x.Data.ToLocalTime().ToString("g")</td><td>@if(Model.Recurso=="Ordens"){<a asp-action="Details" asp-route-id="@x.Id">Detalhar</a>}</td></tr>}</tbody></table></div>}
