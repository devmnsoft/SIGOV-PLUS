@model Sigov.Web.Models.PostBuild.MinhaCentralViewModel
@{
  ViewData["Title"] = "Minha Central";
  ViewData["PageTitle"] = "Minha Central";
  var agora = DateTimeOffset.Now;
  var primeiroNome = (User.Identity?.Name ?? "Usuário").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";
}

<header class="central-header">
  <div>
    <span class="central-header__context">@agora.ToString("dddd, dd 'de' MMMM") · @Model.Tenant</span>
    <h1>Olá, @primeiroNome</h1>
    <p>Veja o que precisa da sua atenção e retome o trabalho de onde parou.</p>
  </div>
  <div class="central-header__actions">
    <button class="sigov-btn sigov-btn--ghost" type="button" data-sigov-command-open>
      Buscar no SIGOV <kbd>Ctrl K</kbd>
    </button>
    <button class="sigov-btn sigov-btn--primary" type="button" data-sigov-quick-create>Nova atividade</button>
  </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback) && Model.Acoes.Count == 0)
{
  <div class="sigov-feedback sigov-feedback--warning" role="status">
    <strong>Não foi possível carregar todo o seu contexto.</strong>
    <span>Você ainda pode navegar pelos módulos e tentar novamente mais tarde.</span>
  </div>
}

<div class="central-grid">
  <section class="central-panel central-panel--attention" aria-labelledby="attention-title">
    <div class="central-panel__heading">
      <div><span class="central-eyebrow">Prioridades</span><h2 id="attention-title">Precisa da minha atenção</h2></div>
      @if (Model.Pendencias.Count > 0) { <span class="central-count">@Model.Pendencias.Count</span> }
    </div>
    @if (Model.Pendencias.Count == 0)
    {
      <div class="central-empty"><strong>Nenhuma pendência agora</strong><span>Novas atividades atribuídas a você aparecerão aqui.</span></div>
    }
    else
    {
      <ul class="central-worklist">
        @foreach (var item in Model.Pendencias.Take(5))
        {
          <li><a href="@item.Url"><span><strong>@item.Titulo</strong><small>@item.Descricao</small></span><span aria-hidden="true">→</span></a></li>
        }
      </ul>
    }
  </section>

  <section class="central-panel" aria-labelledby="quick-title">
    <div class="central-panel__heading"><div><span class="central-eyebrow">Atalhos</span><h2 id="quick-title">Ações recomendadas</h2></div></div>
    <nav class="central-shortcuts" aria-label="Ações recomendadas">
      @foreach (var acao in Model.Acoes.Take(6))
      {
        <a href="@acao.Url"><span class="central-shortcuts__mark" aria-hidden="true"></span><span><strong>@acao.Titulo</strong><small>@acao.Descricao</small></span></a>
      }
    </nav>
  </section>

  <section class="central-panel central-panel--wide" aria-labelledby="recent-title">
    <div class="central-panel__heading"><div><span class="central-eyebrow">Continuidade</span><h2 id="recent-title">Atividades recentes</h2></div><a href="/Auditoria/Trilhas">Ver histórico</a></div>
    @if (Model.Atividades.Count == 0)
    {
      <div class="central-empty"><strong>Sem atividades recentes</strong><span>Os registros que você consultar ou alterar aparecerão neste espaço.</span></div>
    }
    else
    {
      <ol class="central-timeline">
        @foreach (var atividade in Model.Atividades.Take(6))
        {
          <li><span class="central-timeline__dot" aria-hidden="true"></span><div><strong>@atividade.Acao</strong><span>@atividade.Entidade</span></div><time datetime="@atividade.Data?.ToString("O")">@(atividade.Data?.ToLocalTime().ToString("dd/MM, HH:mm") ?? "Data indisponível")</time></li>
        }
      </ol>
    }
  </section>

  <section class="central-panel" aria-labelledby="modules-title">
    <div class="central-panel__heading"><div><span class="central-eyebrow">Seu acesso</span><h2 id="modules-title">Módulos disponíveis</h2></div></div>
    <ul class="central-modules">
      @foreach (var modulo in Model.Modulos.Take(8))
      {
        <li><span>@modulo.Nome</span><span class="sigov-badge sigov-badge--success">@modulo.Status</span></li>
      }
    </ul>
  </section>
</div>
