@{
  ViewData["Title"] = "Minha Central";
  ViewData["PageTitle"] = "Minha Central";
  ViewData["PageDescription"] = "Seu ponto de partida no SIGOV PLUS, com perfil, tenant, pendências, atalhos e próximos passos orientados.";
  ViewData["PageServes"] = "Guiar cada usuário para as tarefas certas sem depender de menus complexos.";
  ViewData["PageHow"] = "Comece pelos cards recomendados, revise alertas LGPD e acesse módulos conforme seu perfil.";
  ViewData["PageNext"] = "Concluir implantação, ativar módulos, revisar permissões e consultar o manual por perfil.";
  var cards = new[]{("Complete a implantação","Finalize tenant, entidade, exercício e módulos.","/Saas/Implantacao","primary"),("Cadastre usuários","Crie operadores com dados mínimos e auditoria.","/Seguranca/Usuarios","info"),("Configure permissões","Revise perfis e matriz por módulo.","/Seguranca/Permissoes","warning"),("Ative módulos","Habilite governo, empresas, operação e IA.","/Saas/Modulos","success"),("Revise auditorias","Confira eventos e acessos a dados pessoais.","/Auditoria/Trilhas","danger"),("Manual do perfil","Veja rotinas diárias e cuidados LGPD.","/Manual","secondary"),("Verifique ambiente","Teste Web, API, PostgreSQL e versão.","/Operacao/Health","success")};
}
@await Html.PartialAsync("_PageIntro")
<section class="sigov-hero sigov-card p-4 mb-4">
  <div class="row g-4 align-items-center">
    <div class="col-lg-8"><span class="sigov-badge sigov-badge--success">Ambiente seguro</span><h1 class="display-6 fw-black mt-2">Olá, @(User.Identity?.Name ?? "usuário SIGOV")</h1><p class="lead mb-0">Perfil: <strong>@ViewData["Perfil"]</strong> · Tenant: <strong>@ViewData["Tenant"]</strong> · Entidade: <strong>Prefeitura Demonstração</strong> · Exercício: <strong>2026</strong></p></div>
    <div class="col-lg-4"><div class="sigov-card p-3 bg-light"><strong>Status do ambiente</strong><div class="d-flex gap-2 flex-wrap mt-2"><span class="sigov-badge sigov-badge--success">Web OK</span><span class="sigov-badge sigov-badge--success">API live</span><span class="sigov-badge sigov-badge--info">Auditoria ativa</span></div></div></div>
  </div>
</section>
<div class="row g-4 mb-4">
  <section class="col-lg-4"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">O que fazer agora</h2><ol class="text-muted"><li>Conferir implantação guiada.</li><li>Validar usuários e perfis.</li><li>Ativar módulos contratados.</li><li>Executar roteiro POC.</li></ol></div></section>
  <section class="col-lg-4"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">Pendências</h2><p class="mb-2"><span class="sigov-badge sigov-badge--warning">3 itens</span></p><p class="text-muted mb-0">Parâmetros globais, permissões LGPD e evidências de implantação aguardam revisão.</p></div></section>
  <section class="col-lg-4"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">Alerta LGPD</h2><p class="text-muted mb-0">Listagens sensíveis devem usar dados mascarados e ações críticas exigem confirmação auditável.</p></div></section>
</div>
<section><h2 class="h4 fw-bold mb-3">Ações recomendadas</h2><div class="sigov-grid sigov-grid--modules">@foreach (var c in cards){<article class="sigov-card sigov-module-card"><span class="sigov-badge sigov-badge--@c.Item4">Recomendado</span><h3 class="h5 mt-3">@c.Item1</h3><p class="text-muted">@c.Item2</p><a class="sigov-btn sigov-btn--primary w-100" href="@c.Item3">Acessar</a></article>}</div></section>
@section Scripts { <script>document.addEventListener('DOMContentLoaded',()=>window.SigovOnboarding&&SigovOnboarding.firstAccess('minha-central','Bem-vindo à Minha Central','Aqui você encontra próximos passos, pendências, atalhos e alertas LGPD do seu perfil.'));</script> }
