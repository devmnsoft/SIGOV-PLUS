@model Sigov.Web.Models.PostBuild.MinhaCentralViewModel
@{
  ViewData["Title"] = "Minha Central";
  ViewData["PageTitle"] = "Minha Central";
  ViewData["PageDescription"] = "Seu ponto de partida no SIGOV PLUS, com perfil, tenant, pendências, atalhos e próximos passos orientados.";
  ViewData["PageServes"] = "Guiar cada usuário para as tarefas certas sem depender de menus complexos.";
  ViewData["PageHow"] = "Comece pelos cards recomendados, revise alertas LGPD e acesse módulos conforme seu perfil.";
  ViewData["PageNext"] = "Concluir implantação, ativar módulos, revisar permissões e consultar o manual por perfil.";
}
@await Html.PartialAsync("_PageIntro")
<section class="sigov-hero sigov-card p-4 mb-4">
  <div class="row g-4 align-items-center">
    <div class="col-lg-8"><span class="sigov-badge sigov-badge--success">Ambiente seguro</span><h1 class="display-6 fw-black mt-2">Olá, @(User.Identity?.Name ?? "usuário SIGOV")</h1><p class="lead mb-0">Perfil: <strong>@Model.Perfil</strong> · Tenant: <strong>@Model.Tenant</strong> · Entidade: <strong>Conforme contexto</strong> · Exercício: <strong>2026</strong></p></div>
    <div class="col-lg-4"><div class="sigov-card p-3 bg-light"><strong>Status do ambiente</strong><div class="d-flex gap-2 flex-wrap mt-2">@foreach (var item in Model.Ambiente.Take(3)) { <span class="sigov-badge sigov-badge--@(item.Online ? "success" : "warning")">@item.Nome @item.Status</span> }</div></div></div>
  </div>
</section>
<div class="row g-4 mb-4">
  <section class="col-lg-4"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">O que fazer agora</h2><ol class="text-muted"><li>Conferir implantação guiada.</li><li>Validar usuários e perfis.</li><li>Ativar módulos contratados.</li><li>Executar roteiro POC.</li></ol></div></section>
  <section class="col-lg-4"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">Minhas pendências</h2><p class="mb-2"><span class="sigov-badge sigov-badge--warning">@Model.Pendencias.Count itens</span></p><ul class="text-muted mb-0">@foreach (var p in Model.Pendencias.Take(3)) { <li><a href="@p.Url">@p.Titulo</a></li> }</ul></div></section>
  <section class="col-lg-4"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">Ambiente e segurança</h2>@foreach (var alerta in Model.AlertasLgpd.Take(2)) { <p class="text-muted mb-1"><strong>@alerta.Titulo:</strong> @alerta.Descricao</p> }</div></section>
</div>
<section><h2 class="h4 fw-bold mb-3">Ações recomendadas</h2><div class="sigov-grid sigov-grid--modules">@foreach (var c in Model.Acoes){<article class="sigov-card sigov-module-card"><span class="sigov-badge sigov-badge--@c.CssClass">Recomendado</span><h3 class="h5 mt-3">@c.Titulo</h3><p class="text-muted">@c.Descricao</p><a class="sigov-btn sigov-btn--primary w-100" href="@c.Url">Acessar</a></article>}</div></section>
<section class="mt-4"><h2 class="h4 fw-bold mb-3">Meus módulos e últimas atividades</h2><div class="row g-4"><div class="col-lg-6"><div class="sigov-card p-4 h-100"><h3 class="h5">Meus módulos</h3><ul>@foreach (var m in Model.Modulos.Take(8)) { <li>@m.Nome — <span class="text-muted">@m.Status</span></li> }</ul></div></div><div class="col-lg-6"><div class="sigov-card p-4 h-100"><h3 class="h5">Últimas atividades</h3>@if (!Model.Atividades.Any()) { <p class="text-muted">Auditoria recente indisponível neste ambiente.</p> } else { <ul>@foreach (var a in Model.Atividades) { <li>@a.Acao em @a.Entidade — @a.Data</li> }</ul> }</div></div></div></section>
@section Scripts { <script>document.addEventListener('DOMContentLoaded',()=>window.SigovOnboarding&&SigovOnboarding.firstAccess('minha-central','Bem-vindo à Minha Central','Aqui você encontra próximos passos, pendências, atalhos e alertas LGPD do seu perfil.'));</script> }
<section class="sigov-card p-4 mt-4">
  <div class="d-flex flex-wrap justify-content-between gap-3"><div><span class="sigov-badge sigov-badge--info">Assistente SIGOV</span><h2 class="h5 mt-2">Sugestões e prazos recomendados</h2><p class="text-muted mb-0">Assistente, tarefas recomendadas, documentos pendentes, notificações e integrações com erro aparecem aqui quando houver configuração/schema. Fallback atual é honesto e auditável.</p></div><a class="sigov-btn sigov-btn--primary" href="/Ia">Abrir assistente</a></div>
  <div class="alert alert-warning mt-3 mb-0">Revise qualquer sugestão antes de usar. A decisão final é do usuário e dados pessoais devem ser mascarados.</div>
</section>

<section class="sigov-card p-4 my-4">
  <div class="d-flex flex-wrap justify-content-between gap-3 align-items-center"><div><span class="sigov-badge sigov-badge--info">Editais e POC</span><h2 class="h5 mt-2">Gestão de aderência em operação</h2><p class="text-muted mb-0">Editais em análise, requisitos críticos pendentes, evidências pendentes, POC em execução, relatórios e próximos prazos aparecem na rotina operacional sem marcar atendimento sem evidência.</p></div><div class="d-flex gap-2 flex-wrap"><a class="sigov-btn sigov-btn--primary" href="/Editais">Editais</a><a class="sigov-btn sigov-btn--ghost" href="/MatrizAderencia">Matriz</a><a class="sigov-btn sigov-btn--ghost" href="/Poc/Editais">POC</a></div></div>
</section>
