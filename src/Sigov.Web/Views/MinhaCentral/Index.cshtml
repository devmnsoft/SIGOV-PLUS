@model Sigov.Web.Models.PostBuild.MinhaCentralViewModel
@{
  ViewData["Title"] = "Minha Central";
  var agora = Model.AtualizadoEm == default ? DateTimeOffset.UtcNow : Model.AtualizadoEm;
  var primeiroNome = (User.Identity?.Name ?? "Usuário").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";
  var turno = agora.Hour < 12 ? "bom dia" : agora.Hour < 18 ? "boa tarde" : "boa noite";
  var admin = User.IsInRole("ADMIN_GERAL") || User.IsInRole("ADMIN_TENANT") || User.IsInRole("ADMINISTRADOR_GERAL");
  var carregado = Model.Estado == "carregado";
}
<header class="sigov-page-hero" data-sigov-tour="central-hero">
  <div>
    <span class="sigov-eyebrow">@agora.ToString("dddd, dd 'de' MMMM") · @turno</span>
    <h1>Olá, @primeiroNome. Esta é sua central de trabalho.</h1>
    <p>@Model.Tenant · @Model.Perfil · exercício @Model.Exercicio</p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a class="sigov-btn sigov-btn--ghost" href="/Preferencias/Recentes">Continuar de onde parei</a>
    <button class="sigov-btn sigov-btn--primary" type="button" data-sigov-quick-create><sigov-icon name="plus" size="16" />Criar novo</button>
    <button class="sigov-btn sigov-btn--ghost" type="button" data-sigov-command-open>Buscar <kbd>Ctrl K</kbd></button>
  </div>
</header>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback))
{
  <div class="sigov-feedback sigov-feedback--danger mt-3" role="alert"><strong>@(Model.Estado == "negado" ? "Acesso negado" : "Dados indisponíveis"):</strong><span>@Model.MensagemFallback</span><a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="/MinhaCentral">Tentar novamente</a></div>
}
@if (carregado)
{
<section class="sigov-filter-bar my-3" aria-labelledby="central-filters-title">
  <h2 id="central-filters-title" class="h5">Filtrar pendências</h2>
  <form method="get" class="row g-2 align-items-end">
    <div class="col-sm-6 col-lg-4"><label class="form-label" for="central-status">Estado</label><select class="form-select" id="central-status" name="status"><option value="">Abertas e em tratamento</option><option value="ABERTA" selected="@(ViewBag.Status == "ABERTA")">Abertas</option><option value="EM_TRATAMENTO" selected="@(ViewBag.Status == "EM_TRATAMENTO")">Em tratamento</option></select></div>
    <div class="col-auto"><button class="sigov-btn sigov-btn--primary" type="submit">Aplicar</button></div>
  </form>
  <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">
    @foreach (var filtro in (ViewBag.FiltrosSalvos as IReadOnlyList<Sigov.Web.Services.SavedFilter> ?? Array.Empty<Sigov.Web.Services.SavedFilter>())) { <a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="/MinhaCentral?status=@filtro.Status">@(filtro.IsDefault ? "★ " : "")@filtro.Name</a><form method="post" action="/FiltrosSalvos/Excluir" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="screen" value="minha-central"/><input type="hidden" name="name" value="@filtro.Name"/><button class="btn btn-link btn-sm text-danger" type="submit" aria-label="Excluir filtro @filtro.Name">Excluir</button></form><details><summary class="small">Renomear</summary><form method="post" action="/FiltrosSalvos/Renomear">@Html.AntiForgeryToken()<input type="hidden" name="screen" value="minha-central"/><input type="hidden" name="currentName" value="@filtro.Name"/><label class="visually-hidden" for="rename-central-@filtro.Name.GetHashCode()">Novo nome</label><input id="rename-central-@filtro.Name.GetHashCode()" name="newName" maxlength="80" required/><button type="submit" class="btn btn-link btn-sm">Confirmar</button></form></details> }
  </div>
  <details class="mt-2"><summary>Salvar filtro atual</summary><form method="post" action="/FiltrosSalvos/Salvar" class="row g-2 mt-1">@Html.AntiForgeryToken()<input type="hidden" name="screen" value="minha-central"/><input type="hidden" name="status" value="@ViewBag.Status"/><div class="col-sm-5"><label class="form-label" for="central-filter-name">Nome do filtro <span aria-hidden="true">*</span></label><input class="form-control" id="central-filter-name" name="name" maxlength="80" required/></div><div class="col-auto form-check align-self-end mb-2"><input class="form-check-input" id="central-default" name="isDefault" value="true" type="checkbox"/><label class="form-check-label" for="central-default">Usar como padrão</label></div><div class="col-auto align-self-end"><button class="sigov-btn sigov-btn--ghost" type="submit">Salvar</button></div></form><p class="form-text">Como usar: aplique apenas estados disponíveis e salve para reutilizar neste cliente.</p></details>
</section>
<section class="central-kpis sigov-grid sigov-grid--kpis my-4">
  <article class="sigov-kpi-premium"><small>Minhas pendências</small><strong>@Model.TotalPendencias</strong><span class="sigov-status-pill sigov-status-pill--info">Abertas · meu usuário</span></article>
  <article class="sigov-kpi-premium"><small>Tarefas vencidas</small><strong>@Model.TotalVencidas</strong><span class="sigov-status-pill sigov-status-pill--warning">Prazo anterior à atualização</span></article>
  <article class="sigov-kpi-premium"><small>Alertas de privacidade e risco</small><strong>@Model.TotalAlertas</strong><span class="sigov-status-pill sigov-status-pill--warning">Contexto institucional</span></article>
</section>
<p class="text-body-secondary small">Dados atualizados em <time datetime="@Model.AtualizadoEm.ToString("O")">@Model.AtualizadoEm.ToString("dd/MM/yyyy HH:mm 'UTC'")</time>. Os indicadores refletem o instante desta consulta.</p>
<div class="central-grid">
  <section class="central-panel central-panel--attention" aria-labelledby="meu-dia-title" data-sigov-tour="central-worklist">
    <div class="central-panel__heading"><div><span class="central-eyebrow">Meu dia</span><h2 id="meu-dia-title">Prioridades de hoje</h2></div><a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="/Pendencias">Ver todas</a></div>
    @if (Model.Pendencias.Count == 0) { <div class="sigov-empty-state-premium"><sigov-icon name="success" size="34" /><strong>Nenhuma pendência atribuída a você</strong><span>Quando uma tarefa autorizada exigir sua ação, ela aparecerá aqui.</span></div> }
    else { <ul class="sigov-timeline-premium">@foreach (var item in Model.Pendencias.Take(6)) { <li><div><strong>@item.Titulo</strong><small>@item.Modulo · @item.Identificacao</small><span>@item.Descricao</span>@if(item.Prazo.HasValue){<small>Prazo: @item.Prazo.Value.ToString("dd/MM/yyyy HH:mm 'UTC'")</small>}</div><a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="@item.Url">Abrir</a></li> }</ul> }
  </section>
  <section class="central-panel" aria-labelledby="continuidade-title">
    <div class="central-panel__heading"><div><span class="central-eyebrow">Continuidade</span><h2 id="continuidade-title">Recentes e favoritos</h2></div></div>
    <div class="sigov-empty-state-premium" data-sigov-recent-empty><sigov-icon name="recent" size="34" /><strong>Seus recentes ficam no navegador</strong><span>Abra páginas e favorite módulos pela sidebar para montar seu espaço.</span></div>
    <div class="central-shortcuts" data-sigov-recent-list></div>
  </section>
  <section class="central-panel central-panel--wide" aria-labelledby="acoes-title">
    <div class="central-panel__heading"><div><span class="central-eyebrow">Produtividade</span><h2 id="acoes-title">Atalhos recomendados</h2></div></div>
    @if (Model.Acoes.Count == 0) { <div class="sigov-empty-state-premium"><sigov-icon name="locked" size="32" /><strong>Nenhum atalho disponível para este perfil</strong><span>Os atalhos aparecem quando o perfil recebe acesso a uma jornada operacional.</span><a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="/Modulos/MeuAcesso">Consultar meu acesso</a></div> }
    else { <nav class="central-shortcuts" aria-label="Ações recomendadas">@foreach (var acao in Model.Acoes.Take(8)) { <a class="sigov-action-card" href="@acao.Url"><span class="sigov-action-card__icon"><sigov-icon name="@("warning" == acao.CssClass ? "risk" : "dashboard")" size="20" /></span><span><strong>@acao.Titulo</strong><small>@acao.Descricao</small></span></a> }</nav> }
  </section>
  @if (admin)
  {
    <section class="central-panel" aria-labelledby="ambiente-title"><div class="central-panel__heading"><div><span class="central-eyebrow">Saúde do ambiente</span><h2 id="ambiente-title">Operação</h2></div><a href="/Operacao/Health">Detalhar</a></div><ul class="central-modules">@foreach (var item in Model.Ambiente.Take(5)) { <li><span>@item.Nome</span><span class="sigov-status-pill @(item.Online ? "sigov-status-pill--success" : "sigov-status-pill--danger")">@item.Status</span></li> }</ul></section>
  }
</div>
}
@section Scripts { <script src="~/js/minha-central.js" asp-append-version="true"></script> }
