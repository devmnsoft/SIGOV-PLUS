@{ ViewData["Title"] = "Escalas"; }
<section class="rh-b2-shell" id="rp-escalas">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Escalas de ponto</h1>
      <p>Vinculação de servidor a jornada com janela de vigência. Apurações sem escala ativa falham com SEM_ESCALA.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-action="novo">Nova escala</button>
      <button type="button" class="btn btn-outline-light" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Registros</small><strong data-kpi>—</strong><span>no filtro atual</span></article>
    <article class="rh-b2-card"><small>Múltiplas ativas</small><strong>Última vale</strong><span>maior id no mesmo dia</span></article>
    <article class="rh-b2-card"><small>Inativação</small><strong>Histórico</strong><span>preservado, sem exclusão</span></article>
  </div>
  <div class="filter-bar">
    <input type="search" data-search placeholder="Buscar por servidor ou jornada (id)" aria-label="Buscar">
    <button class="btn btn-primary" type="button" data-search-go>Filtrar</button>
    <button class="btn btn-outline-secondary" type="button" data-search-clear>Limpar</button>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>#</th><th>Servidor</th><th>Jornada</th><th>Início</th><th>Fim</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody data-grid><tr><td colspan="7"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-escalas');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initEscalas(root);
})();
</script>
