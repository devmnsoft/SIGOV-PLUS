@{ ViewData["Title"] = "Jornadas"; }
<section class="rh-b2-shell" id="rp-jornadas">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Jornadas de trabalho</h1>
      <p>Carga horária, horários de referência, tolerância e dias de trabalho — parametrizável por esfera de governo.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-action="novo">Nova jornada</button>
      <button type="button" class="btn btn-outline-light" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Registros</small><strong data-kpi>—</strong><span>no filtro atual</span></article>
    <article class="rh-b2-card"><small>Campos</small><strong>6</strong><span>carga, horários, tolerância, dias</span></article>
    <article class="rh-b2-card"><small>Auditoria</small><strong>100%</strong><span>correlation ID por chamada</span></article>
  </div>
  <div class="filter-bar">
    <input type="search" data-search placeholder="Buscar por nome da jornada (ex.: Administrativo)" aria-label="Buscar">
    <button class="btn btn-primary" type="button" data-search-go>Filtrar</button>
    <button class="btn btn-outline-secondary" type="button" data-search-clear>Limpar</button>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>#</th><th>Nome</th><th>Carga horária</th><th>Entrada–Saída</th><th>Tolerância</th><th>Dias de trabalho</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody data-grid><tr><td colspan="8"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-jornadas');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initJornadas(root);
})();
</script>
