@{ ViewData["Title"] = "Relatórios de RH"; }
<h1>Relatórios de RH e Folha</h1><p class="text-muted">Exportações usam o contexto autorizado de tenant e registram auditoria.</p>
<div class="list-group">
@foreach (var r in new[]{"servidores","vinculos","lotacoes","frequencias","ferias","afastamentos","folha-eventos","folhas","folha-lancamentos","integracoes-financeiras","auditoria"}) { <a class="list-group-item list-group-item-action" href="/api/rh/export/@r.csv">Exportar @r (CSV)</a> }
</div>
