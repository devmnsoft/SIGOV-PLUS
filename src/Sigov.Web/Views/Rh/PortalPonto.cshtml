@{ ViewData["Title"] = "Meu ponto"; }
<section class="rh-b2-shell" id="rp-portal-ponto">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Meu ponto</h1>
      <p>Suas batidas e divergências — resolvidas no servidor pelo vínculo do seu usuário.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Batidas</small><strong data-kpi>—</strong><span>seu histórico visível</span></article>
    <article class="rh-b2-card"><small>Acesso</small><strong>Ligado</strong><span>por vínculo de servidor</span></article>
    <article class="rh-b2-card"><small>Auditoria</small><strong>100%</strong><span>correlation ID por chamada</span></article>
  </div>
  <div class="filter-bar">
    <input type="search" data-search placeholder="Buscar por data ou origem" aria-label="Buscar">
    <button class="btn btn-primary" type="button" data-search-go>Filtrar</button>
    <button class="btn btn-outline-secondary" type="button" data-search-clear>Limpar</button>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>Data/hora</th><th>Tipo</th><th>Origem</th><th>Justificativa</th><th>Situação</th></tr></thead>
    <tbody data-grid><tr><td colspan="5"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-portal-ponto');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initPortalPonto(root);
})();
</script>
