@{ ViewData["Title"] = "Registros de ponto"; }
<section class="rh-b2-shell" id="rp-registros">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Registros de ponto</h1>
      <p>Batidas reais (entrada, saída, intervalos) e ajustes com preservação do original na auditoria.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-action="novo">Registrar batida</button>
      <button type="button" class="btn btn-outline-light" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Batidas</small><strong data-kpi>—</strong><span>no filtro atual</span></article>
    <article class="rh-b2-card"><small>Ajuste</small><strong>Janela ±1 dia</strong><span>original sempre preservado</span></article>
    <article class="rh-b2-card"><small>Efeito</small><strong>Invalidação</strong><span>apuradas dependentes recalcular</span></article>
  </div>
  <div class="filter-bar">
    <input type="search" data-search placeholder="Buscar por servidor, data ou origem" aria-label="Buscar">
    <button class="btn btn-primary" type="button" data-search-go>Filtrar</button>
    <button class="btn btn-outline-secondary" type="button" data-search-clear>Limpar</button>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>#</th><th>Servidor</th><th>Data/hora</th><th>Tipo</th><th>Origem</th><th>Ajuste/Justificativa</th><th>Ações</th></tr></thead>
    <tbody data-grid><tr><td colspan="7"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-registros');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initRegistros(root);
})();
</script>
