@model Sigov.Web.Models.Rh.RhRegistroViewModel
@{ ViewData["Title"] = Model.Titulo; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>@Model.Titulo</h1>
    <p class="text-muted">CRUD com isolamento por tenant, auditoria e exportacao.</p>
  </div>
  <div class="btn-group">
    <a class="btn btn-outline-secondary" href="/api/rh/export/@(Model.Recurso).csv">CSV</a>
    <a class="btn btn-outline-secondary" href="/api/rh/export/@(Model.Recurso).json">JSON</a>
  </div>
</div>
<form id="rh-form" class="card mb-3 needs-validation" data-recurso="@Model.Recurso" novalidate>
  @Html.AntiForgeryToken()
  <div class="card-body">
    <input type="hidden" id="rh-id" />
    <div id="rh-fields" class="row g-3"></div>
    <label class="form-label mt-3" for="rh-json">Dados complementares JSON</label>
    <textarea class="form-control font-monospace" id="rh-json" rows="5">{}</textarea>
  </div>
  <div class="card-footer d-flex gap-2">
    <button class="btn btn-primary" type="submit">Salvar</button>
    <button class="btn btn-outline-secondary" type="button" id="rh-clear">Novo</button>
  </div>
</form>
<div class="card"><div class="card-header">Registros</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>ID</th><th>Ativo</th><th>Dados</th><th>Acoes</th></tr></thead><tbody id="rh-grid"></tbody></table></div></div>
