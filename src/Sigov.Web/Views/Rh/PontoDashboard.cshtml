@{ ViewData["Title"] = "Ponto e Frequência"; }
<section class="rh-b2-shell" id="rp-dashboard">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Ponto e Frequência</h1>
      <p>Painel operacional da jornada de ponto em todas as esferas de governo: apurações, pendências e homologações.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-primary" href="/RH/PontoApuracao">Gerenciar apurações</a>
      <button type="button" class="btn btn-outline-light" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Apurações</small><strong data-kpi>—</strong><span>no filtro atual</span></article>
    <article class="rh-b2-card"><small>Aguardando homologação</small><strong data-kpi-status="APURADA">—</strong><span>status APURADA</span></article>
    <article class="rh-b2-card"><small>Homologadas</small><strong data-kpi-status="HOMOLOGADA">—</strong><span>competência congelada</span></article>
    <article class="rh-b2-card"><small>Com pendências</small><strong data-kpi-status="PENDENCIAS">—</strong><span>exigem tratamento</span></article>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>#</th><th>Servidor</th><th>Período</th><th>Versão das regras</th><th>Trabalhado</th><th>Pendências</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody data-grid><tr><td colspan="8"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-dashboard');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initDashboard(root);
})();
</script>
