@{ ViewData["Title"] = "Justificativas"; }
<section class="rh-b2-shell" id="rp-justificativas">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Justificativas de ponto</h1>
      <p>Análise e decisão de justificativas de ausência ou atraso. O servidor não decide sobre a própria justificativa.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-action="novo">Nova justificativa</button>
      <button type="button" class="btn btn-outline-light" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Registros</small><strong data-kpi>—</strong><span>no filtro atual</span></article>
    <article class="rh-b2-card"><small>Autoaprovação</small><strong>Bloqueada</strong><span>criador ≠ decisor</span></article>
    <article class="rh-b2-card"><small>Efeito da decisão</small><strong>Invalidação</strong><span>apuradas dependentes recalcular</span></article>
  </div>
  <div class="filter-bar">
    <input type="search" data-search placeholder="Buscar por servidor, data ou motivo" aria-label="Buscar">
    <button class="btn btn-primary" type="button" data-search-go>Filtrar</button>
    <button class="btn btn-outline-secondary" type="button" data-search-clear>Limpar</button>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>#</th><th>Servidor</th><th>Data de referência</th><th>Motivo</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody data-grid><tr><td colspan="6"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-justificativas');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initJustificativas(root);
})();
</script>
