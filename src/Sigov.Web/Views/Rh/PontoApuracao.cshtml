@{ ViewData["Title"] = "Apuração e homologação"; }
<section class="rh-b2-shell" id="rp-apuracao">
  <header class="rh-b2-hero d-flex flex-wrap align-items-end justify-content-between gap-2">
    <div>
      <span class="lgpd-badge">LGPD • acesso auditado</span>
      <h1>Apuração e homologação</h1>
      <p>Cálculo em minutos por dia, memória auditável, homologação/reabertura e integração efetiva à folha.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-action="novo">Calcular apuração</button>
      <button type="button" class="btn btn-outline-light" data-action="recarregar">Atualizar</button>
    </div>
  </header>
  <div class="rh-b2-kpis">
    <article class="rh-b2-card"><small>Apurações</small><strong data-kpi>—</strong><span>no filtro atual</span></article>
    <article class="rh-b2-card"><small>Engine</small><strong>Minutos</strong><span>memória por dia + versão</span></article>
    <article class="rh-b2-card"><small>Homologada</small><strong>Não sobrescreve</strong><span>reabertura formal exigida</span></article>
  </div>
  <div class="filter-bar">
    <input type="search" data-search placeholder="Buscar por servidor, período ou versão" aria-label="Buscar">
    <button class="btn btn-primary" type="button" data-search-go>Filtrar</button>
    <button class="btn btn-outline-secondary" type="button" data-search-clear>Limpar</button>
  </div>
  <div class="responsive-data-table"><table>
    <thead><tr><th>#</th><th>Servidor</th><th>Período</th><th>Versão das regras</th><th>Recálculos</th><th>Trabalhado</th><th>Pendências</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody data-grid><tr><td colspan="9"><div class="loading-skeleton" aria-label="Carregando"></div></td></tr></tbody>
  </table></div>
</section>
<script src="~/js/modules/rh.ponto-ui.js"></script>
<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.getElementById('rp-apuracao');
  if (root && window.SigovRhPonto) window.SigovRhPonto.initApuracao(root);
})();
</script>
