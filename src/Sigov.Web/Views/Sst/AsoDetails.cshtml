@model Sigov.Application.Sst.SstAso
@{ViewData["Title"]="Detalhes do ASO";}<link rel="stylesheet" href="~/css/sst360.css" /><div class="sst-page-head"><div><span class="sst-kicker">Informação médica sensível</span><h1>ASO de @Model.Servidor</h1></div><a class="btn btn-outline-primary" href="/SST/ASO/Edit/@Model.Id">Editar</a></div><dl class="sst-details"><dt>Tipo</dt><dd>@Model.Tipo.Replace('_',' ')</dd><dt>Data</dt><dd>@Model.DataAso.ToString("dd/MM/yyyy")</dd><dt>Médico</dt><dd>@Model.Medico</dd><dt>Resultado</dt><dd><span class="sst-status sst-@Model.Resultado">@Model.Resultado.Replace('_',' ')</span></dd><dt>Restrição</dt><dd>@(Model.Restricao??"Não informada")</dd><dt>Validade</dt><dd>@(Model.Validade?.ToString("dd/MM/yyyy")??"Sem validade definida")</dd></dl>
