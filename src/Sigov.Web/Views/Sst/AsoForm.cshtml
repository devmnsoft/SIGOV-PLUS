@model Sigov.Web.Models.Sst.SstAsoForm
@{ViewData["Title"]=Model.Id.HasValue?"Editar ASO":"Novo ASO";}<link rel="stylesheet" href="~/css/sst360.css" />
<div class="sst-page-head"><div><span class="sst-kicker">LGPD · acesso auditável</span><h1>@ViewData["Title"]</h1><p>Informe somente dados necessários à finalidade ocupacional.</p></div></div>
<form method="post" class="sst-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-4">
<div class="col-md-6"><label asp-for="ServidorId" class="form-label">Servidor</label><select asp-for="ServidorId" asp-items="Model.Servidores" class="form-select"><option value="">Selecione...</option></select><span asp-validation-for="ServidorId" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" class="form-select"><option value="admissional">Admissional</option><option value="periodico">Periódico</option><option value="retorno_trabalho">Retorno ao trabalho</option><option value="mudanca_risco">Mudança de risco</option><option value="demissional">Demissional</option></select><span asp-validation-for="Tipo" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="DataAso" class="form-label"></label><input asp-for="DataAso" class="form-control"/><span asp-validation-for="DataAso" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Medico" class="form-label">Médico responsável / CRM</label><input asp-for="Medico" class="form-control" autocomplete="off"/><span asp-validation-for="Medico" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Resultado" class="form-label"></label><select asp-for="Resultado" class="form-select"><option value="pendente">Pendente</option><option value="apto">Apto</option><option value="inapto">Inapto</option><option value="apto_com_restricao">Apto com restrição</option></select><span asp-validation-for="Resultado" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Validade" class="form-label"></label><input asp-for="Validade" class="form-control"/><span asp-validation-for="Validade" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Restricao" class="form-label">Descrição da restrição</label><textarea asp-for="Restricao" class="form-control" rows="3"></textarea><span asp-validation-for="Restricao" class="text-danger"></span></div></div><div class="sst-actions"><a href="/SST/ASO" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary" type="submit">Salvar ASO</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
