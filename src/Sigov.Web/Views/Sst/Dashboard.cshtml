@model Sigov.Application.Sst.SstDashboard
@{ViewData["Title"]="SST360";}
<link rel="stylesheet" href="~/css/sst360.css" />
<header class="sst-hero"><div><span class="sst-kicker">RH · Saúde Ocupacional · eSocial</span><h1>SST360</h1><p>Prevenção, conformidade e cuidado com informações sensíveis em uma visão única.</p></div><a class="btn btn-light" href="/SST/ASO/Create">Novo ASO</a></header>
<div class="sst-grid">
@foreach(var x in new[]{("Servidores monitorados",Model.ServidoresMonitorados,"people"),("ASOs vencidos/próximos",Model.AsosCriticos,"warning"),("Exames pendentes/vencidos",Model.ExamesCriticos,"health"),("Exposições ativas",Model.ExposicoesAtivas,"risk"),("EPIs pendentes/vencidos",Model.EpisCriticos,"epi"),("CATs abertas",Model.CatsAbertas,"cat"),("Acidentes (12 meses)",Model.Acidentes,"accident"),("Afastamentos ocupacionais",Model.AfastamentosOcupacionais,"leave"),("Treinamentos vencidos",Model.TreinamentosVencidos,"training"),("eSocial pendentes",Model.EsocialPendente,"pending"),("eSocial rejeitados",Model.EsocialRejeitado,"rejected")}){<a class="sst-card" href="/SST/@(x.Item3 is "health" ? "Exames" : x.Item3 is "epi" ? "EPIs" : x.Item3 is "cat" ? "CAT" : x.Item3 is "training" ? "Treinamentos" : x.Item3 is "pending" or "rejected" ? "ESocial/Eventos" : x.Item3 is "risk" ? "Exposicoes" : "Dashboard")"><small>@x.Item1</small><strong>@x.Item2</strong><span class="sst-badge">Atualizado agora</span></a>}
</div>
<nav class="sst-nav">@foreach(var x in new[]{("Ambientes","Ambientes"),("Riscos","Riscos"),("Exposições","Exposicoes"),("PGR","PGR"),("PCMSO","PCMSO"),("LTCAT","LTCAT"),("ASO","ASO"),("EPIs","EPIs"),("Treinamentos","Treinamentos"),("CAT","CAT"),("Acidentes","Acidentes"),("eSocial","ESocial")}){<a href="/SST/@x.Item2">@x.Item1</a>}</nav>
