@model IReadOnlyList<Sigov.Web.Models.Security.ModuleAccessCardViewModel>
@{
    ViewData["Title"] = Context.Request.Path.StartsWithSegments("/Modulos/MeuAcesso") ? "Meu acesso" : "Catálogo de módulos";
}
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel(
    ViewData["Title"]?.ToString() ?? "Módulos",
    "Módulos e ações calculados a partir do perfil, permissões e habilitação do tenant.",
    new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Início", "/"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Módulos", Context.Request.Path, true) }))

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-outline-primary" href="/Modulos/Catalogo">Catálogo</a>
    <a class="btn btn-primary" href="/Modulos/MeuAcesso">Meu acesso</a>
</div>
<div class="row g-3">
@foreach (var module in Model)
{
    var badge = module.Allowed ? "bg-success" : "bg-secondary";
    <div class="col-md-6 col-xl-4">
        <article class="card h-100" aria-labelledby="module-@module.Code">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between gap-2">
                    <h2 class="h5" id="module-@module.Code"><sigov-icon name="@module.Icon" size="18" /> @module.Name</h2>
                    <span class="badge @badge">@(module.Allowed ? module.Status : "Bloqueado")</span>
                </div>
                <p class="text-muted">@module.Description</p>
                @if (module.HasSensitiveData)
                {
                    <div class="alert alert-warning py-2" role="note"><strong>LGPD:</strong> este módulo trata dados pessoais ou sensíveis.</div>
                }
                @if (module.Allowed)
                {
                    <p class="small mb-2"><strong>Ações disponíveis:</strong> @(module.Actions.Count == 0 ? "consulta" : string.Join(", ", module.Actions))</p>
                    <div class="mt-auto d-flex gap-2"><a class="btn btn-primary btn-sm" href="@module.Route">Abrir dashboard</a><a class="btn btn-outline-primary btn-sm" href="/Modulos/Detalhe/@module.Code">Detalhes</a></div>
                }
                else
                {
                    <p class="small mt-auto mb-0"><strong>Motivo:</strong> @module.BlockReason</p>
                }
            </div>
        </article>
    </div>
}
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Nenhum módulo está liberado para este perfil. Solicite a habilitação ao administrador do tenant.</div>
}
