@model long
@{
    ViewData["Title"] = "Detalhe da pessoa";
}
<input type="hidden" id="pessoa-id" value="@Model" />
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Detalhe da pessoa</h1><a class="btn btn-outline-primary" href="/Pessoas/Editar/@Model">Editar</a></div>
<div id="pessoa-detalhe" class="card card-body mb-3">Carregando...</div>
<form id="endereco-form" class="card card-body">
  <h2 class="h5">Adicionar endereço</h2>
  <div class="row g-3">
    <div class="col-md-5"><label class="form-label" for="Logradouro">Logradouro</label><input id="Logradouro" name="Logradouro" class="form-control" required /></div>
    <div class="col-md-2"><label class="form-label" for="Numero">Número</label><input id="Numero" name="Numero" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label" for="Bairro">Bairro</label><input id="Bairro" name="Bairro" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label" for="Cep">CEP</label><input id="Cep" name="Cep" class="form-control" /></div>
    <div class="col-md-5"><label class="form-label" for="Municipio">Município</label><input id="Municipio" name="Municipio" class="form-control" required /></div>
    <div class="col-md-2"><label class="form-label" for="Uf">UF</label><input id="Uf" name="Uf" maxlength="2" class="form-control text-uppercase" required /></div>
    <div class="col-md-5"><label class="form-label" for="Complemento">Complemento</label><input id="Complemento" name="Complemento" class="form-control" /></div>
  </div>
  <button class="btn btn-primary mt-3" type="submit">Adicionar</button>
</form>
@section Scripts { <script src="~/js/modules/core.pessoas.js"></script> }
