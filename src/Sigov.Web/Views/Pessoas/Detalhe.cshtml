@model long
@{
    ViewData["Title"] = "Detalhe da pessoa";
}
<input type="hidden" id="pessoa-id" value="@Model" />
<section class="sigov-page-header d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><span class="badge text-bg-primary mb-2">Core / Pessoas</span><h1 class="h2">Detalhe da pessoa</h1><p class="text-muted">Consulta audita acesso a dado pessoal e mantém documento mascarado por padrão.</p></div>
  <div class="btn-group"><a class="btn btn-outline-primary" data-sigov-permission="core.pessoas.editar" href="/Pessoas/Editar/@Model">Editar</a><button class="btn btn-outline-danger" data-sigov-action="delete-pessoa" data-id="@Model" type="button">Excluir</button></div>
</section>
<div id="pessoa-detalhe" class="card card-body mb-3">@await Html.PartialAsync("_Loading")</div>
<div class="row g-3">
  <div class="col-lg-7">
    <form id="endereco-form" class="card card-body sigov-form" method="post" data-sigov-form="true">
      @Html.AntiForgeryToken()
      <h2 class="h5">Adicionar endereço</h2>
      <partial name="_Enderecos" />
      <button class="btn btn-primary mt-3 align-self-start" type="submit">Adicionar endereço</button>
    </form>
  </div>
  <div class="col-lg-5"><partial name="_AuditoriaPessoa" /></div>
</div>
@section Scripts { <script src="~/js/modules/core.pessoas.js"></script> }
