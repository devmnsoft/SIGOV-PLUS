@model Sigov.Web.Models.Core.PessoaFormViewModel
@{
    ViewData["Title"] = "Nova pessoa";
}
<section class="sigov-page-header mb-4"><span class="badge text-bg-primary mb-2">Core / Pessoas</span><h1 class="h2">Nova pessoa</h1><p class="text-muted">Formulário padronizado com antiforgery, validação client-side/server-side e submit Ajax.</p></section>
<form id="pessoa-form" class="card card-body sigov-form" method="post" data-sigov-form="true" data-sigov-ajax="true" data-sigov-success-message="Pessoa salva com sucesso.">
  @Html.AntiForgeryToken()
  <partial name="_FormPessoa" model="Model" />
  <hr />
  <h2 class="h5">Endereço principal</h2>
  <partial name="_Enderecos" />
  <hr />
  <h2 class="h5">Contato principal</h2>
  <partial name="_Contatos" />
  <div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="/Pessoas">Cancelar</a><button class="btn btn-primary" type="submit">Salvar pessoa</button></div>
</form>
@section Scripts { <script src="~/js/modules/core.pessoas.js"></script> }
