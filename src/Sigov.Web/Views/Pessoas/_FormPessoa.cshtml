@model Sigov.Web.Models.Core.PessoaFormViewModel
<div class="row g-3">
  <div class="col-md-2"><label asp-for="TipoPessoa" class="form-label"></label><select asp-for="TipoPessoa" class="form-select"><option value="F">Física</option><option value="J">Jurídica</option></select></div>
  <div class="col-md-5"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" required /></div>
  <div class="col-md-3"><label asp-for="NomeSocial" class="form-label"></label><input asp-for="NomeSocial" class="form-control" /></div>
  <div class="col-md-2"><label asp-for="Documento" class="form-label"></label><input asp-for="Documento" class="form-control" /></div>
  <div class="col-12"><label asp-for="Observacao" class="form-label"></label><textarea asp-for="Observacao" class="form-control"></textarea></div>
  <div class="col-12 form-check ms-2"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label"></label></div>
</div>
