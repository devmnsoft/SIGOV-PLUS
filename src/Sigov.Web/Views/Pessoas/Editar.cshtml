@model Sigov.Web.Models.Core.PessoaFormViewModel
@{
    ViewData["Title"] = "Editar pessoa";
}
<input type="hidden" id="pessoa-id" value="@Model.Id" />
<section class="sigov-page-header mb-4"><span class="badge text-bg-primary mb-2">Core / Pessoas</span><h1 class="h2">Editar pessoa</h1><p class="text-muted">Alterações geram auditoria antes/depois e respeitam permissão para dados completos.</p></section>
<form id="pessoa-form" class="card card-body sigov-form" method="post" data-sigov-form="true" data-sigov-ajax="true" data-sigov-success-message="Pessoa atualizada com sucesso.">
  @Html.AntiForgeryToken()
  <partial name="_FormPessoa" model="Model" />
  <div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="/Pessoas/Detalhe/@Model.Id">Cancelar</a><button class="btn btn-primary" type="submit">Salvar alterações</button></div>
</form>
@section Scripts { <script src="~/js/modules/core.pessoas.js"></script> }
