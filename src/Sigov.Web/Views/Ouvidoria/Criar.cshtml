@model Sigov.Web.Models.Processos.OuvidoriaFormViewModel
<h1>Nova manifestação</h1><form id="ouvidoria-form" class="card card-body">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-3"><label asp-for="PessoaId" class="form-label"></label><input asp-for="PessoaId" class="form-control" /></div><div class="col-md-3"><label asp-for="TipoManifestacao" class="form-label"></label><select asp-for="TipoManifestacao" class="form-select"><option>RECLAMACAO</option><option>DENUNCIA</option><option>ELOGIO</option><option>SUGESTAO</option><option>SOLICITACAO</option><option>INFORMACAO</option></select></div><div class="col-md-6"><label asp-for="Assunto" class="form-label"></label><input asp-for="Assunto" class="form-control" required /></div><div class="col-12"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control" required></textarea></div><div class="col form-check ms-2"><input asp-for="Anonima" class="form-check-input" /><label asp-for="Anonima" class="form-check-label"></label></div><div class="col form-check"><input asp-for="Sigilosa" class="form-check-input" /><label asp-for="Sigilosa" class="form-check-label"></label></div></div><button class="btn btn-primary mt-3" type="submit">Salvar</button></form>
@section Scripts { <script src="~/js/modules/processos.ouvidoria.js"></script> }
