@model Sigov.Web.Models.Processos.OuvidoriaFiltroViewModel
<div class="d-flex justify-content-between mb-3"><h1>Ouvidoria</h1><a class="btn btn-primary" href="/Ouvidoria/Criar">Nova manifestação</a></div><form id="ouvidoria-filtro" class="card card-body mb-3">@Html.AntiForgeryToken()<div class="row g-2"><div class="col"><input asp-for="Numero" class="form-control" placeholder="Número" /></div><div class="col"><select asp-for="TipoManifestacao" class="form-select"><option value="">Tipo</option><option>RECLAMACAO</option><option>DENUNCIA</option><option>ELOGIO</option><option>SUGESTAO</option><option>SOLICITACAO</option><option>INFORMACAO</option></select></div><div class="col"><button class="btn btn-outline-primary" type="submit">Filtrar</button></div></div></form><table class="table" id="ouvidoria-table"><thead><tr><th>Número</th><th>Tipo</th><th>Assunto</th><th>Status</th><th>Sigilo</th><th>Ações</th></tr></thead><tbody></tbody></table>
@section Scripts { <script src="~/js/modules/processos.ouvidoria.js"></script> }
