@model Sigov.Web.Controllers.AssinaturasDigitaisViewModel
@{ ViewData["Title"] = "Assinaturas Digitais"; }
<section class="container-fluid py-3"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Assinaturas Digitais</li></ol></nav><div class="d-flex justify-content-between gap-3 flex-wrap mb-3"><div><span class="badge text-bg-warning">Em implantação honesta</span><h1 class="h3">Assinaturas digitais/eletrônicas</h1><p class="text-muted">Solicitações, signatários, status e trilha de auditoria. Sem provedor configurado, não há alegação de validade ICP-Brasil.</p></div><a class="btn btn-primary" href="/AssinaturasDigitais/Nova">Nova solicitação</a></div><div class="alert alert-info"><strong>LGPD e validade:</strong> documento e signatários devem ser tratados como dados pessoais. Integração oficial só será executada quando houver provedor e segredo seguro configurados.</div><div class="row g-3 mb-3">@foreach(var s in Model.Status){<div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><span class="badge text-bg-secondary">@s</span><div class="display-6">0</div></div></div></div>}</div><div class="card shadow-sm"><div class="card-header bg-white"><strong>@Model.Foco</strong></div><div class="card-body"><form method="post" action="/AssinaturasDigitais/Nova">@Html.AntiForgeryToken()<p class="text-muted">Nenhuma solicitação real encontrada sem schema <code>sigov.assinatura_documento</code>. Ação crítica exige confirmação e auditoria.</p><button class="btn btn-outline-primary" onclick="return confirm('Confirmar criação auditada de solicitação em implantação?')">Registrar solicitação controlada</button></form></div></div></section>
