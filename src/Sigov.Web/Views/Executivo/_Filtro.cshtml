@{ var f=ViewData["Filtro"] as Sigov.Application.Executive.ExecutivoFiltro ?? new(); }
<form method="get" class="executivo-filtros"><div><label for="modulo">Módulo</label><input id="modulo" name="Modulo" value="@f.Modulo" class="form-control" placeholder="Todos" /></div><div><label for="status">Status</label><input id="status" name="Status" value="@f.Status" class="form-control" placeholder="Todos" /></div><div><label for="prioridade">Prioridade</label><select id="prioridade" name="Prioridade" class="form-select"><option value="">Todas</option><option>BAIXA</option><option>MEDIA</option><option>ALTA</option><option>CRITICA</option></select></div><div><label for="inicio">Início</label><input id="inicio" type="date" name="Inicio" value="@f.Inicio?.ToString("yyyy-MM-dd")" class="form-control" /></div><div><label for="fim">Fim</label><input id="fim" type="date" name="Fim" value="@f.Fim?.ToString("yyyy-MM-dd")" class="form-control" /></div><button class="btn btn-primary" type="submit">Aplicar filtros</button></form>
