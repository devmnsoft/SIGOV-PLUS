@model IReadOnlyList<Sigov.Application.Executive.ExecutivoItem>
@if(Model.Count==0){<div class="executivo-empty"><strong>Nenhum registro no contexto atual</strong><span>A Central não simula dados. Ajuste os filtros ou registre a ocorrência no módulo de origem.</span></div>}else{<div class="table-responsive"><table class="table executivo-table"><thead><tr><th>Item</th><th>Módulo</th><th>Status</th><th>Prazo</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Titulo</strong><small>@x.Responsavel</small></td><td>@x.Modulo</td><td><span class="executivo-badge executivo-badge--@((x.Severidade??x.Prioridade??x.Status).ToLowerInvariant())">@(x.Severidade??x.Prioridade??x.Status)</span></td><td>@x.Prazo?.ToString("dd/MM/yyyy")</td></tr>}</tbody></table></div>}
