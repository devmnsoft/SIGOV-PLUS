@model Sigov.Web.Models.Convenios.ConvenioListaViewModel
@{ViewData["Title"]=Model.Titulo;}
<div class="d-flex flex-wrap justify-content-between gap-2"><h1 class="h3">@Model.Titulo</h1>@if(Model.Recurso!="Auditoria"){<a class="btn btn-primary" href="/Convenios/@Model.Recurso/Novo">Novo registro</a>}</div><partial name="_Nav"/><form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-5"><label class="form-label" for="busca">Busca</label><input class="form-control" id="busca" name="busca" value="@Model.Filtro.Busca"/></div><div class="col-md-3"><label class="form-label" for="status">Status</label><input class="form-control" id="status" name="status" value="@Model.Filtro.Status"/></div><div class="col-md-2 align-self-end"><button class="btn btn-outline-primary">Filtrar</button></div></div></form>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Identificação</th><th>Descrição</th><th>Status</th><th>Criado em</th><th>Ações</th></tr></thead><tbody>@if(Model.Pagina.Itens.Count==0){<tr><td colspan="5" class="text-center text-secondary py-5">Nenhum registro encontrado.</td></tr>}@foreach(var x in Model.Pagina.Itens){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge text-bg-secondary">@x.Status</span></td><td>@x.CriadoEm.ToLocalTime().ToString("g")</td><td><div class="d-flex gap-1 flex-wrap">@if(Model.Recurso!="Auditoria"){<a class="btn btn-sm btn-outline-secondary" href="/Convenios/@Model.Recurso/@x.Id">Detalhes</a><a class="btn btn-sm btn-outline-primary" href="/Convenios/@Model.Recurso/@x.Id/Editar">Editar</a><form method="post" action="/Convenios/@Model.Recurso/@x.Id/Excluir">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Excluir</button></form>}</div></td></tr>}</tbody></table></div>
