@model Sigov.Web.Models.Convenios.ConvenioListaViewModel
@{
    ViewData["Title"] = Model.Titulo;
    var totalPaginas = (int)Math.Ceiling(Model.Pagina.Total / (double)Model.Pagina.Tamanho);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.Titulo</h1>
    @if (Model.Recurso != "Auditoria")
    {
        <a class="btn btn-primary" asp-action="Novo" asp-route-recurso="@Model.Recurso">Novo registro</a>
    }
</div>
<partial name="_Nav" />
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
<form method="get" class="card card-body mb-3 shadow-sm">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-4">
            <label class="form-label" for="busca">Busca</label>
            <input class="form-control" id="busca" name="busca" value="@Model.Filtro.Busca" placeholder="Identificação ou descrição" />
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label class="form-label" for="status">Status</label>
            <input class="form-control" id="status" name="status" value="@Model.Filtro.Status" />
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label class="form-label" for="inicio">Criado a partir de</label>
            <input class="form-control" type="date" id="inicio" name="inicio" value="@Model.Filtro.Inicio?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label class="form-label" for="fim">Criado até</label>
            <input class="form-control" type="date" id="fim" name="fim" value="@Model.Filtro.Fim?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
            <button class="btn btn-outline-primary flex-grow-1">Filtrar</button>
            <a class="btn btn-outline-secondary" asp-action="Lista" asp-route-recurso="@Model.Recurso">Limpar</a>
        </div>
    </div>
</form>
<div class="table-responsive border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Identificação</th><th>Descrição</th><th>Status</th><th>Criado em</th><th class="text-end">Ações</th></tr></thead>
        <tbody>
        @if (Model.Pagina.Itens.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-secondary py-5">Nenhum registro corresponde aos filtros informados.</td></tr>
        }
        @foreach (var item in Model.Pagina.Itens)
        {
            <tr>
                <td class="fw-semibold">@item.Codigo</td><td>@item.Descricao</td>
                <td><span class="badge text-bg-secondary">@item.Status.Replace('_', ' ')</span></td>
                <td>@item.CriadoEm.ToLocalTime().ToString("g")</td>
                <td><div class="d-flex justify-content-end gap-1 flex-wrap">
                    @if (Model.Recurso != "Auditoria")
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-recurso="@Model.Recurso" asp-route-id="@item.Id">Detalhes</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-recurso="@Model.Recurso" asp-route-id="@item.Id">Editar</a>
                        <form method="post" asp-action="Excluir" asp-route-recurso="@Model.Recurso" asp-route-id="@item.Id" onsubmit="return confirm('Confirma a exclusão deste registro?');">
                            @Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                        </form>
                    }
                </div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (totalPaginas > 1)
{
    <nav class="mt-3" aria-label="Paginação"><ul class="pagination justify-content-center">
        @for (var pagina = 1; pagina <= totalPaginas; pagina++)
        {
            <li class="page-item @(pagina == Model.Pagina.Pagina ? "active" : null)"><a class="page-link" asp-action="Lista" asp-route-recurso="@Model.Recurso" asp-route-busca="@Model.Filtro.Busca" asp-route-status="@Model.Filtro.Status" asp-route-inicio="@Model.Filtro.Inicio" asp-route-fim="@Model.Filtro.Fim" asp-route-pagina="@pagina">@pagina</a></li>
        }
    </ul></nav>
}
