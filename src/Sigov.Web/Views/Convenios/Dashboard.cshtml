@model Sigov.Application.Convenios.ConvenioDashboard
@{ViewData["Title"]="Convênios e Emendas";var cards=new[]{("Instrumentos ativos",Model.InstrumentosAtivos.ToString("N0")),("Vencendo em 60 dias",Model.InstrumentosVencendo.ToString("N0")),("Instrumentos vencidos",Model.InstrumentosVencidos.ToString("N0")),("Valor global em execução",Model.ValorGlobalExecucao.ToString("C")),("Valor repassado",Model.ValorRepassado.ToString("C")),("Valor executado",Model.ValorExecutado.ToString("C")),("Projetos em atraso",Model.ProjetosAtrasados.ToString("N0")),("Metas pendentes",Model.MetasPendentes.ToString("N0")),("Prestações pendentes",Model.PrestacoesPendentes.ToString("N0")),("Diligências vencidas",Model.DiligenciasVencidas.ToString("N0")),("Emendas no ano",Model.EmendasAno.ToString("N0")),("Saldo das contas",Model.SaldoContas.ToString("C"))};}
<h1 class="h3">Gestão de Convênios, Emendas e Prestação de Contas</h1><partial name="_Nav"/><div class="row g-3">@foreach(var c in cards){<div class="col-12 col-sm-6 col-xl-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-secondary small">@c.Item1</div><strong class="fs-4">@c.Item2</strong></div></div></div>}</div>
