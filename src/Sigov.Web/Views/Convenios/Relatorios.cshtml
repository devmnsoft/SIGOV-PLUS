@{ViewData["Title"]="Relatórios de Convênios";var reports=new[]{("Instrumentos","Instrumentos por status, vigência e órgão"),("Emendas","Emendas por ano, parlamentar e status"),("Projetos","Projetos por status e execução"),("Metas","Metas por projeto"),("Etapas","Etapas por projeto"),("Repasses","Repasses por período"),("Despesas","Despesas por período, fornecedor e status"),("PrestacoesContas","Prestações por status e período"),("Diligencias","Diligências por prazo e status")};}<h1 class="h3">Relatórios CSV</h1><partial name="_Nav"/><p class="text-secondary">As exportações usam dados reais, respeitam o contexto tenant/entidade e aceitam os filtros da tela na query string.</p><div class="row g-3">@foreach(var r in reports){<div class="col-md-6"><a class="card card-body h-100 text-decoration-none" href="/Convenios/Relatorios/@r.Item1.csv"><strong>@r.Item2</strong><span class="small text-secondary">Baixar CSV protegido contra fórmulas</span></a></div>}</div>
