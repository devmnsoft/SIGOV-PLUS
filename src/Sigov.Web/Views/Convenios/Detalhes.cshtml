@model Sigov.Web.Models.Convenios.ConvenioDetalhesViewModel
@{ViewData["Title"]=Model.Titulo;}<h1 class="h3">@Model.Titulo</h1><partial name="_Nav"/><div class="card card-body"><dl class="row"><dt class="col-sm-3">Identificação</dt><dd class="col-sm-9">@Model.Registro.Codigo</dd><dt class="col-sm-3">Descrição</dt><dd class="col-sm-9">@Model.Registro.Descricao</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Registro.Status</dd>@foreach(var x in Model.Registro.Campos){<dt class="col-sm-3">@x.Key.Replace('_',' ')</dt><dd class="col-sm-9">@x.Value</dd>}</dl><div><a class="btn btn-primary" href="/Convenios/@Model.Recurso/@Model.Id/Editar">Editar</a> <a class="btn btn-link" href="/Convenios/@Model.Recurso">Voltar</a></div></div>
