@{
    ViewData["Title"] = "Começar cadastro";
}
<section class="container py-5">
    <h1 class="fw-bold">Auto cadastro do cliente</h1>
    <p class="text-muted">Informe os dados básicos, plano desejado, módulos e quantidade estimada de usuários para iniciar a implantação.</p>
    <form id="formCadastroCliente" class="row g-3" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" id="planoInicial" value="@ViewData["Plano"]" />
        <div class="col-md-8"><label class="form-label">Nome da organização</label><input class="form-control" name="nomeOrganizacao" required maxlength="250" /></div>
        <div class="col-md-4"><label class="form-label">Tipo do cliente</label><select class="form-select" name="tipoCliente" required><option>Municipio</option><option>Orgao</option><option>Empresa</option></select></div>
        <div class="col-md-4"><label class="form-label">Documento</label><input class="form-control" name="documento" maxlength="30" /></div>
        <div class="col-md-6"><label class="form-label">Cidade</label><input class="form-control" name="cidade" maxlength="150" /></div>
        <div class="col-md-2"><label class="form-label">UF</label><input class="form-control" name="uf" maxlength="2" /></div>
        <div class="col-md-6"><label class="form-label">Nome do responsável</label><input class="form-control" name="nomeResponsavel" required maxlength="250" /></div>
        <div class="col-md-6"><label class="form-label">E-mail</label><input class="form-control" name="emailResponsavel" type="email" required maxlength="250" /></div>
        <div class="col-md-4"><label class="form-label">Telefone</label><input class="form-control" name="telefoneResponsavel" maxlength="40" /></div>
        <div class="col-md-4"><label class="form-label">Plano desejado</label><input class="form-control" name="planoCodigo" id="planoCodigo" maxlength="80" /></div>
        <div class="col-md-4"><label class="form-label">Usuários estimados</label><input class="form-control" name="usuariosEstimados" type="number" min="1" /></div>
        <div class="col-12"><label class="form-label">Módulos de interesse</label><input class="form-control" name="modulosInteresse" placeholder="financeiro, tributario, agro" /></div>
        <div class="col-md-4 form-check ms-2"><input class="form-check-input" type="checkbox" name="desejaWhiteLabel" id="desejaWhiteLabel" /><label class="form-check-label" for="desejaWhiteLabel">Deseja white label</label></div>
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="desejaDominioCustomizado" id="desejaDominioCustomizado" /><label class="form-check-label" for="desejaDominioCustomizado">Deseja domínio customizado</label></div>
        <div class="col-md-4"><input class="form-control" name="dominioDesejado" placeholder="portal.municipio.gov.br" /></div>
        <div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="aceiteTermos" id="aceiteTermos" required /><label class="form-check-label" for="aceiteTermos">Aceito os termos de implantação e tratamento LGPD.</label></div>
        <div class="col-12"><button class="btn btn-primary btn-lg" type="submit">Enviar solicitação</button></div>
        <div id="cadastroClienteMensagem" class="col-12"></div>
    </form>
</section>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/modules/saas.cadastro-cliente.js"></script>
