@model Sigov.Web.Models.PostBuild.GlobalSearchViewModel
@{ ViewData["Title"]="Busca global"; ViewData["PageTitle"]="Busca global"; ViewData["PageDescription"]="Busca schema-safe com dados pessoais mascarados."; }
@await Html.PartialAsync("_PageIntro")
<form class="sigov-card p-3 mb-3" method="get" action="/Busca"><input class="form-control" name="q" value="@Model?.Query" placeholder="Buscar..." /></form>
@if (!string.IsNullOrWhiteSpace(Model?.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="list-group">@foreach (var r in Model?.Resultados ?? Array.Empty<Sigov.Web.Models.PostBuild.GlobalSearchResultViewModel>()) { <a class="list-group-item list-group-item-action" href="@r.Url"><span class="badge bg-primary">@r.Area</span> <strong>@r.Titulo</strong><br/><small>@r.Descricao • @r.Badge</small></a> }</div>
@if (Model?.AreasIgnoradas.Any() == true) { <p class="text-muted mt-3">Áreas ignoradas por schema ausente: @string.Join(", ", Model.AreasIgnoradas).</p> }
