@{ ViewData["Title"] = "Busca global"; var q = (string)ViewBag.Query; var grupos = new[]{"Usuários","Tenants","Módulos","Processos","Documentos","Contratos"}; }
<h1>Busca global</h1><p class="text-muted">Resultados agrupados para "@q" com fallback demonstrativo seguro.</p><form class="d-flex gap-2 mb-4"><input class="form-control" name="q" value="@q" placeholder="Digite um termo"><button class="btn btn-primary">Pesquisar</button></form>@foreach (var g in grupos) { <section class="card border-0 shadow-sm mb-3"><div class="card-body"><h2 class="h5">@g</h2><p class="mb-0">@(string.IsNullOrWhiteSpace(q) ? "Digite um termo para pesquisar." : $"Resultado demonstrativo em {g} para '{q}'.")</p></div></section> }
