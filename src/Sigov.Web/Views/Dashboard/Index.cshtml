@model Sigov.Web.Models.PostBuild.DashboardViewModel
@{ ViewData["Title"] = "Dashboard SaaS"; var modules = new[]{("🏛️","Tributário","Arrecadação, dívida ativa, certidões e inteligência fiscal.","Governo"),("📨","Protocolo","Processos digitais, ouvidoria e tramitação controlada.","Governo"),("📄","GED/OCR","Documentos, OCR, contratos e assinaturas digitais.","Operação"),("🩺","Saúde","Unidades, agenda, vacinação e prontuário operacional.","Governo"),("🎓","Educação","Matrículas, notas, frequência e Educacenso.","Governo"),("💧","Saneamento","Consumidores, leituras, faturas e ordens de serviço.","Governo"),("🛒","Comercial","Clientes, pedidos, varejo, atacado e PDV.","Empresas"),("💼","Financeiro","Fluxo de caixa, contas, conciliação e centros de custo.","Empresas"),("🏭","Indústria","Produção, qualidade, recursos e chão de fábrica.","Empresas"),("📱","Mobile/Campo","Agenda, rotas, formulários, offline e geolocalização.","Operação"),("🤖","IA","Assistente, automações, predições e relatórios.","IA")}; }
<header class="sigov-page-header"><div><span class="sigov-badge sigov-badge--info">Visão executiva</span><h1 class="h2 fw-black mt-2 mb-1">Dashboard SaaS SIGOV PLUS</h1><p>Indicadores comerciais, operacionais, LGPD e implantação para demonstração executiva.</p></div><div class="d-flex gap-2 flex-wrap"><a class="sigov-btn sigov-btn--ghost" href="/Saas/Implantacao">Implantação guiada</a><a class="sigov-btn sigov-btn--primary" href="/Operacao/Health">Ver health visual</a></div></header>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning rounded-4">@Model.MensagemFallback</div> }
<section class="sigov-grid sigov-grid--kpis mb-4">
  @foreach (var card in Model.Cards) { <article class="sigov-kpi-card"><div class="sigov-kpi-card__label">@card.Titulo</div><div class="sigov-kpi-card__value text-@card.CssClass">@card.Valor</div><p class="text-muted mb-0">@card.Descricao</p></article> }
  <article class="sigov-kpi-card"><div class="sigov-kpi-card__label">Status API</div><div class="sigov-kpi-card__value text-success">Online</div><p class="text-muted mb-0">Endpoint live disponível para monitoramento.</p></article>
  <article class="sigov-kpi-card"><div class="sigov-kpi-card__label">Status banco</div><div class="sigov-kpi-card__value text-success">OK</div><p class="text-muted mb-0">PostgreSQL conectado para o ambiente local.</p></article>
  <article class="sigov-kpi-card"><div class="sigov-kpi-card__label">Alertas LGPD</div><div class="sigov-kpi-card__value text-warning">2</div><p class="text-muted mb-0">Cadastros sensíveis exigem revisão auditável.</p></article>
</section>
<div class="row g-4 mb-4"><section class="col-lg-7"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">Últimas auditorias</h2><div class="sigov-table-wrap"><table class="sigov-table"><thead><tr><th>Evento</th><th>Usuário</th><th>Status</th></tr></thead><tbody><tr><td>Login administrativo</td><td>admin</td><td><span class="sigov-badge sigov-badge--success">auditado</span></td></tr><tr><td>Consulta LGPD</td><td>sistema</td><td><span class="sigov-badge sigov-badge--warning">revisar</span></td></tr><tr><td>Health check</td><td>monitor</td><td><span class="sigov-badge sigov-badge--info">informativo</span></td></tr></tbody></table></div></div></section><section class="col-lg-5"><div class="sigov-card p-4 h-100"><h2 class="h5 fw-bold">Implantação em andamento</h2><p class="text-muted">Cliente/Tenant, entidade, exercício, plano, módulos, usuários e parâmetros em esteira guiada.</p><div class="progress mb-3" style="height:14px"><div class="progress-bar bg-success" style="width:62%">62%</div></div><a class="sigov-btn sigov-btn--primary" href="/Saas/Implantacao">Continuar implantação</a></div></section></div>
<section><div class="sigov-page-header mb-3"><div><h2 class="h4 fw-bold">Módulos comerciais</h2><p>Catálogo visual para apresentação de escopo modular multi-tenant.</p></div></div><div class="sigov-grid sigov-grid--modules">@foreach (var m in modules) { <article class="sigov-card sigov-module-card"><div class="sigov-module-card__icon">@m.Item1</div><h3 class="h5 mt-2">@m.Item2</h3><p class="text-muted">@m.Item3</p><span class="sigov-badge sigov-badge--info">@m.Item4</span><a class="sigov-btn sigov-btn--ghost w-100 mt-3" href="/Modulos">Acessar</a></article> }</div></section>
