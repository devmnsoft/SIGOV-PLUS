@model Sigov.Web.Models.PostBuild.DashboardViewModel
@{
  ViewData["Title"] = "Dashboard SaaS";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <h1 class="h3 mb-1">Dashboard SaaS SIGOV</h1>
    <p class="text-muted mb-0">Visão inicial pós-build para validação local, onboarding e operação.</p>
  </div>
  <a class="btn btn-outline-primary" href="/Operacao/Health">Ver health visual</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="row g-3 mb-4">
@foreach (var card in Model.Cards) {
  <div class="col-sm-6 col-xl-2"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-muted small">@card.Titulo</div><div class="h3 text-@card.CssClass">@card.Valor</div><p class="small mb-0">@card.Descricao</p></div></div></div>
}
</div>
<div class="row g-4">
  <section class="col-lg-6"><div class="card h-100"><div class="card-header fw-bold">Ambiente</div><div class="list-group list-group-flush">
    @foreach (var item in Model.Ambiente) { <div class="list-group-item d-flex justify-content-between align-items-start"><div><strong>@item.Nome</strong><div class="small text-muted">@item.Detalhe</div></div><span class="badge @(item.Online ? "text-bg-success" : "text-bg-danger")">@item.Status</span></div> }
  </div></div></section>
  <section class="col-lg-6"><div class="card h-100"><div class="card-header fw-bold">Ações rápidas</div><div class="card-body d-grid gap-2">
    <a class="btn btn-outline-primary" href="/Saas/Tenants">Gerenciar tenants</a>
    <a class="btn btn-outline-primary" href="/Saas/Modulos">Gerenciar módulos</a>
    <a class="btn btn-outline-primary" href="/Operacao/Health">Ver health</a>
    <a class="btn btn-outline-secondary" href="/Placeholder/logs">Ver logs</a>
    <a class="btn btn-outline-secondary" href="/Placeholder/configuracoes-saas">Configurações SaaS</a>
  </div></div></section>
  <section class="col-12"><div class="card"><div class="card-header fw-bold">Módulos</div><div class="card-body"><div class="row g-3">
    @foreach (var modulo in Model.Modulos) { <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="fw-bold">@modulo.Nome</div><span class="badge text-bg-light border">@modulo.Status</span><p class="small text-muted mb-0 mt-2">@modulo.Descricao</p></div></div> }
  </div></div></div></section>
  <section class="col-12"><div class="alert alert-info"><strong>Próximos passos:</strong> configurar cliente, ativar módulos, criar usuários, validar permissões e iniciar implantação.</div></section>
</div>
