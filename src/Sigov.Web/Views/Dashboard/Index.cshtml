@model Sigov.Web.Models.PostBuild.DashboardViewModel
@{
  ViewData["Title"] = "Dashboard SaaS";
  var modules = new[]{("tax","Tributário","Arrecadação, dívida ativa, certidões e inteligência fiscal.","Governo"),("protocol","Protocolo","Processos digitais, ouvidoria e tramitação controlada.","Governo"),("documents","GED/OCR","Documentos, OCR, contratos e assinaturas digitais.","Operação"),("health","Saúde","Unidades, agenda, vacinação e prontuário operacional.","Governo"),("education","Educação","Matrículas, notas, frequência e Educacenso.","Governo"),("water","Saneamento","Consumidores, leituras, faturas e ordens de serviço.","Governo"),("cart","Comercial","Clientes, pedidos, varejo, atacado e PDV.","Empresas"),("finance","Financeiro","Fluxo de caixa, contas, conciliação e centros de custo.","Empresas"),("industry","Indústria","Produção, qualidade, recursos e chão de fábrica.","Empresas"),("mobile","Mobile/Campo","Agenda, rotas, formulários, offline e geolocalização.","Operação"),("ai","IA","Assistente, automações, predições e relatórios.","IA")};
}
<header class="sigov-page-hero" data-sigov-tour="dashboard-hero">
  <div><span class="sigov-eyebrow">Visão executiva · @Model.DataSource</span><h1>Dashboard SaaS SIGOV PLUS</h1><p>@(Model.IsGlobal ? "Admin Global" : $"{Model.TenantNome} ({Model.TenantId})") · indicadores operacionais, LGPD, auditoria e implantação.</p></div>
  <div class="d-flex gap-2 flex-wrap"><a class="sigov-btn sigov-btn--ghost" href="/Saas/Implantacao">Implantação guiada</a><a class="sigov-btn sigov-btn--primary" href="/Operacao/Health">Health operacional</a></div>
</header>
<form class="sigov-filter-bar my-4" method="get" aria-label="Filtro de contexto executivo"><input class="form-control" name="tenant" placeholder="Tenant" /><input class="form-control" name="entidade" placeholder="Entidade" /><input class="form-control" name="exercicio" placeholder="Exercício" value="@DateTime.UtcNow.Year" /><select class="form-select" name="periodo"><option>Últimos 30 dias</option><option>Trimestre</option><option>Exercício</option></select><select class="form-select" name="modulo"><option>Todos os módulos</option><option>Protocolo</option><option>GED/OCR</option><option>LGPD</option></select><button class="sigov-btn sigov-btn--primary" type="submit"><sigov-icon name="filter" size="16" />Filtrar</button></form>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="sigov-feedback sigov-feedback--warning" role="status"><strong>Fallback:</strong><span>@Model.MensagemFallback</span></div> }
<section class="sigov-grid sigov-grid--kpis mb-4">
  @foreach (var card in Model.Cards) { <article class="sigov-kpi-premium"><small>@card.Titulo</small><strong>@card.Valor</strong><span>@card.Descricao</span><span class="sigov-status-pill sigov-status-pill--@card.CssClass">@card.CssClass</span></article> }
  <article class="sigov-kpi-premium"><small>Alertas LGPD</small><strong>@Model.TarefasCriticas.Count</strong><span>Riscos e pendências de privacidade.</span><a href="/Lgpd/Dashboard">Detalhar</a></article>
</section>
@if (!string.IsNullOrWhiteSpace(Model.AlertaOperacional)) { <div class="sigov-feedback sigov-feedback--danger"><strong>Alerta operacional:</strong><span>@Model.AlertaOperacional</span><a href="/Operacao/Outbox">Abrir outbox</a></div> }
<div class="row g-4 mb-4">
  <section class="col-lg-7"><div class="sigov-card-premium p-4 h-100"><div class="sigov-section-title mt-0"><div><span class="sigov-eyebrow">Uso por módulo</span><h2 class="h5">Protocolos por status</h2></div></div>@if (Model.ProtocolosPorStatus.Any()) { <div class="d-grid gap-3">@foreach (var s in Model.ProtocolosPorStatus) { var width = Math.Min(100, s.Total * 20); <div class="sigov-chart-row"><div class="d-flex justify-content-between"><span>@s.Status</span><strong>@s.Total</strong></div><div class="sigov-css-bar" data-value="@width"><span></span></div></div> }</div> } else { <div class="sigov-empty-state-premium"><sigov-icon name="protocol" size="34" /><strong>Sem dados reais de protocolo</strong><span>Conecte o módulo ou refine o contexto para ver indicadores.</span></div> }</div></section>
  <section class="col-lg-5"><div class="sigov-card-premium p-4 h-100"><div class="sigov-section-title mt-0"><div><span class="sigov-eyebrow">Implantação</span><h2 class="h5">Progresso executivo</h2></div><span class="sigov-status-pill sigov-status-pill--info">62%</span></div><div class="sigov-donut" style="--sigov-progress:62" aria-label="Implantação em 62%"><span>62%</span></div><p class="text-muted">Cliente, entidade, exercício, plano, módulos, usuários e parâmetros em esteira guiada.</p><a class="sigov-btn sigov-btn--primary" href="/Saas/Implantacao">Continuar implantação</a></div></section>
</div>
<section class="row g-4 mb-4">
  <div class="col-lg-4"><div class="sigov-card-premium p-4 h-100"><h2 class="h5">Últimos protocolos</h2>@if(Model.UltimosProtocolos.Any()){<div class="list-group list-group-flush">@foreach(var item in Model.UltimosProtocolos){<a class="list-group-item list-group-item-action px-0" href="@item.Url"><strong>@item.Titulo</strong><br/><small>@item.Descricao · @item.Status</small></a>}</div>}else{<div class="sigov-empty-state-premium"><strong>Nenhum protocolo real encontrado</strong></div>}</div></div>
  <div class="col-lg-4"><div class="sigov-card-premium p-4 h-100"><h2 class="h5">Segurança e LGPD</h2><ul class="sigov-timeline-premium"><li><div><strong>Permissões incompletas</strong><span>Revise perfis com acesso sensível.</span></div><a href="/Seguranca/Permissoes">Abrir</a></li><li><div><strong>Alertas LGPD</strong><span>Valide relatórios e mascaramento.</span></div><a href="/Lgpd/Dashboard">Abrir</a></li></ul></div></div>
  <div class="col-lg-4"><div class="sigov-card-premium p-4 h-100"><h2 class="h5">Saúde operacional</h2><ul class="central-modules">@foreach(var h in Model.Ambiente.Take(5)){<li><span>@h.Nome</span><span class="sigov-status-pill @(h.Online?"sigov-status-pill--success":"sigov-status-pill--danger")">@h.Status</span></li>}</ul><a class="sigov-btn sigov-btn--ghost" href="/Operacao/Health">Ver detalhes</a></div></div>
</section>
<section class="sigov-card-premium p-4 mb-4"><div class="sigov-section-title mt-0"><div><span class="sigov-eyebrow">Insights</span><h2 class="h4">Riscos, pendências e próximos passos</h2></div></div><div class="sigov-grid sigov-grid--modules"><a class="sigov-action-card" href="/Auditoria/Trilhas"><span class="sigov-action-card__icon"><sigov-icon name="audit" size="20" /></span><span><strong>Auditoria</strong><small>Conferir trilhas recentes e eventos críticos.</small></span></a><a class="sigov-action-card" href="/Saas/Modulos"><span class="sigov-action-card__icon"><sigov-icon name="settings" size="20" /></span><span><strong>Módulos sem configuração</strong><small>Revise ativação e parâmetros por tenant.</small></span></a><a class="sigov-action-card" href="/Seguranca/Usuarios"><span class="sigov-action-card__icon"><sigov-icon name="users" size="20" /></span><span><strong>Permissões incompletas</strong><small>Valide papéis antes da operação real.</small></span></a></div></section>
<section><div class="sigov-section-title"><div><span class="sigov-eyebrow">Catálogo modular</span><h2 class="h4">Módulos comerciais</h2></div><a class="sigov-btn sigov-btn--ghost" href="/Modulos">Ver catálogo</a></div><div class="sigov-grid sigov-grid--modules">@foreach (var m in modules) { <article class="sigov-module-tile"><span class="sigov-action-card__icon"><sigov-icon name="@m.Item1" size="22" /></span><span><strong>@m.Item2</strong><small>@m.Item3</small><span class="sigov-status-pill sigov-status-pill--info">@m.Item4</span></span></article> }</div></section>
@section Scripts { <script src="~/js/sigov.dashboard.js" asp-append-version="true"></script> }
