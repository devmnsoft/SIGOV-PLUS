@model Sigov.Application.Onboarding.OnboardingJourneyDto
@{ ViewData["Title"] = "Onboarding"; }
@await Component.InvokeAsync("PageHeader", new Sigov.Web.Models.Ui.PageHeaderViewModel("Assistente de implantação", "Jornada operacional para preparar o tenant até o go-live.", new[] { new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Início", "/"), new Sigov.Web.Models.Ui.BreadcrumbItemViewModel("Onboarding", "/Onboarding", true) }))
<div class="card p-4 mb-4"><div class="d-flex justify-content-between"><strong>@Model.Name</strong><span>@Model.ProgressPercent%</span></div><div class="progress mt-2"><div class="progress-bar" style="width:@Model.ProgressPercent%">@Model.ProgressPercent%</div></div></div>
<div class="row g-3">@foreach (var step in Model.Steps) { <div class="col-md-6 col-xl-4"><div class="card sigov-step-card h-100 p-3"><span class="badge bg-secondary align-self-start">@step.Order</span><h2 class="h5 mt-2">@step.Name</h2><p class="text-muted">@step.Description</p><div class="progress"><div class="progress-bar" style="width:@step.ProgressPercent%"></div></div></div></div> }</div>
@section Scripts { <script src="~/js/modules/onboarding.js"></script> }
