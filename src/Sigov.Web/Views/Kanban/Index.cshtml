@{
  ViewData["Title"] = "Kanban Operacional";
  ViewData["PageTitle"] = "Kanban Operacional";
  ViewData["PageDescription"] = "Visão simples de tarefas, OS e propostas por status, com fallback honesto quando dados reais não estiverem disponíveis.";
  var columns = new[] { "Aberta", "Em andamento", "Aguardando", "Concluída", "Vencida" };
}
@await Html.PartialAsync("_PageIntro")
<section class="sigov-card p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between gap-3 align-items-center">
    <div><span class="sigov-badge sigov-badge--info">Razor + Bootstrap</span><h1 class="h3 mt-2">Kanban por tenant e permissão</h1><p class="text-muted mb-0">Use os filtros para alternar Tarefas, OS e Propostas. Nenhum dado sensível completo é exibido.</p></div>
    <div class="d-flex gap-2 flex-wrap"><a class="sigov-btn sigov-btn--ghost" href="/Kanban/Tarefas">Tarefas</a><a class="sigov-btn sigov-btn--ghost" href="/Kanban/OS">OS</a><a class="sigov-btn sigov-btn--ghost" href="/Kanban/Propostas">Propostas</a></div>
  </div>
</section>
<div class="row g-3">
@foreach (var col in columns) {
  <div class="col-md"><div class="sigov-card p-3 h-100"><h2 class="h6">@col</h2><article class="border rounded-4 p-3 bg-light"><span class="sigov-badge sigov-badge--warning">fallback honesto</span><h3 class="h6 mt-2">Sem cards reais carregados</h3><p class="text-muted small">Dados reais dependem das tabelas de tarefas, OS ou propostas e do tenant resolvido.</p><a class="sigov-btn sigov-btn--ghost w-100" href="/Busca?q=@Uri.EscapeDataString(col)">Abrir detalhe</a></article></div></div>
}
</div>
