@model Sigov.Application.Defesa.DefesaDashboard
@{ViewData["Title"]="Defesa Civil e Guarda Municipal";}
<h1 class="h3">Defesa Civil, Guarda Municipal e Segurança Pública Municipal</h1><partial name="_Nav"/>
@if(Model.OcorrenciasCriticas>0){<div class="alert alert-danger" role="alert"><strong>Atenção:</strong> há @Model.OcorrenciasCriticas ocorrência(s) crítica(s) aberta(s).</div>}
<div class="row g-3">@foreach(var item in new[]{("Ocorrências abertas",Model.OcorrenciasAbertas),("Ocorrências críticas",Model.OcorrenciasCriticas),("Fechadas no mês",Model.OcorrenciasFechadasMes),("Acionamentos em andamento",Model.AcionamentosAndamento),("Vistorias pendentes",Model.VistoriasPendentes),("Áreas críticas",Model.AreasCriticas),("Abrigos ativos",Model.AbrigosAtivos),("Ocupação dos abrigos",Model.OcupacaoAbrigos),("Capacidade dos abrigos",Model.CapacidadeAbrigos),("Rondas em andamento",Model.RondasAndamento),("Ordens abertas",Model.OrdensAbertas),("Notificações pendentes",Model.NotificacoesPendentes)}){<div class="col-12 col-sm-6 col-xl-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-secondary">@item.Item1</div><strong class="display-6">@item.Item2</strong></div></div></div>}</div>
