@model Sigov.Web.Models.Defesa.DefesaListaViewModel
@{ViewData["Title"]=Model.Titulo;}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><h1 class="h3">@Model.Titulo</h1>@if(Model.Recurso!="Auditoria"){<a class="btn btn-primary" href="/Defesa/@Model.Recurso/Novo">Novo registro</a>}</div><partial name="_Nav"/>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><label for="busca" class="form-label">Busca</label><input id="busca" name="busca" value="@Model.Filtro.Busca" class="form-control" placeholder="Número, matrícula, nome ou descrição"/></div><div class="col-md-3"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">Todos</option>@foreach(var s in new[]{"ATIVO","ATIVA","ABERTA","PENDENTE","EM_ANDAMENTO","CONCLUIDA","FECHADA","INATIVO","CANCELADA"}){<option selected="@(Model.Filtro.Status==s)">@s</option>}</select></div><div class="col-md-2"><label for="inicio" class="form-label">De</label><input id="inicio" type="date" name="inicio" value="@Model.Filtro.Inicio?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label for="fim" class="form-label">Até</label><input id="fim" type="date" name="fim" value="@Model.Filtro.Fim?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary">Filtrar</button></div></div></form>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Identificação</th><th>Descrição</th><th>Status</th><th>Criado em</th><th></th></tr></thead><tbody>@if(Model.Pagina.Itens.Count==0){<tr><td colspan="5" class="text-center text-secondary py-5">Nenhum registro encontrado para os filtros informados.</td></tr>}@foreach(var x in Model.Pagina.Itens){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge @(x.Status is "CRITICA" or "ABERTA"?"text-bg-danger":"text-bg-secondary")">@x.Status</span></td><td>@x.CriadoEm.ToLocalTime().ToString("g")</td><td>@if(Model.Recurso!="Auditoria"){<form method="post" action="/Defesa/@Model.Recurso/@x.Id/Excluir">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Excluir</button></form>}</td></tr>}</tbody></table></div>
