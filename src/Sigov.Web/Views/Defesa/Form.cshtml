@model Sigov.Web.Models.Defesa.DefesaFormViewModel
@using Sigov.Application.Defesa
@{
 ViewData["Title"]=Model.Titulo;
 var relations=new Dictionary<string,(string Key,string Options)[]>{
  ["Equipes"]=[("responsavel_agente_id","Agentes")], ["Ocorrencias"]=[("area_risco_id","AreasRisco"),("equipe_responsavel_id","Equipes")],
  ["Acionamentos"]=[("ocorrencia_id","Ocorrencias"),("equipe_id","Equipes"),("agente_responsavel_id","Agentes")],
  ["Vistorias"]=[("area_risco_id","AreasRisco"),("ocorrencia_id","Ocorrencias"),("agente_responsavel_id","Agentes")],
  ["Atendimentos"]=[("ocorrencia_id","Ocorrencias"),("abrigo_id","Abrigos")], ["Rondas"]=[("equipe_id","Equipes"),("agente_responsavel_id","Agentes")],
  ["OrdensServico"]=[("equipe_id","Equipes"),("agente_responsavel_id","Agentes")], ["Notificacoes"]=[("vistoria_id","Vistorias"),("area_risco_id","AreasRisco")],
  ["PlanosContingencia"]=[("area_risco_id","AreasRisco"),("responsavel_agente_id","Agentes")]
 };
 var fields=new Dictionary<string,string>{
  ["Agentes"]="cpf,telefone,email,tipo_agente,cargo_funcao,data_inicio,data_fim,observacao,active",["Equipes"]="tipo_equipe,turno,observacao,active",["Recursos"]="tipo,patrimonio_codigo,placa_viatura,localizacao,observacao,active",
  ["AreasRisco"]="tipo_risco,nivel_risco,endereco,bairro,latitude,longitude,populacao_estimada",["Ocorrencias"]="tipo_ocorrencia,origem_chamado,data_hora_abertura,data_hora_fechamento,endereco,bairro,latitude,longitude,prioridade,providencias,resultado",
  ["Acionamentos"]="data_hora_acionamento,data_hora_chegada,data_hora_encerramento",["Vistorias"]="tipo_vistoria,data_vistoria,endereco,bairro,recomendacoes,prazo_regularizacao",
  ["Abrigos"]="tipo,endereco,bairro,capacidade_total,capacidade_ocupada,responsavel_nome,responsavel_telefone,observacao",["Atendimentos"]="documento_responsavel,telefone,quantidade_pessoas,quantidade_criancas,quantidade_idosos,necessidade_especial,tipo_apoio,descricao_apoio,data_atendimento,observacao",
  ["Rondas"]="data_hora_inicio,data_hora_fim,tipo_ronda,resumo",["OrdensServico"]="tipo_servico,solicitante,data_abertura,data_previsao,data_conclusao,prioridade,resultado",["Notificacoes"]="destinatario_documento,endereco,data_emissao,prazo_atendimento,motivo,recomendacao",
  ["PlanosContingencia"]="tipo_evento,vigencia_inicio,vigencia_fim,resumo,medidas_preventivas,fluxos_acionamento"};
 string[] textareas=["observacao","providencias","resultado","recomendacoes","necessidade_especial","descricao_apoio","resumo","motivo","recomendacao","medidas_preventivas","fluxos_acionamento"];
 string[] dropdowns=["tipo_agente","tipo_risco","nivel_risco","prioridade","tipo_equipe","tipo_vistoria","tipo_ronda","tipo_apoio","tipo_evento","tipo_servico","tipo"];
}
<h1 class="h3">@Model.Titulo — novo registro</h1><partial name="_Nav"/>
<form method="post" action="/Defesa/@Model.Recurso/Salvar" class="card card-body shadow-sm">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger" role="alert"></div><p class="text-secondary"><span class="text-danger">*</span> campos obrigatórios. Relacionamentos são selecionados por rótulos; nenhum ID precisa ser digitado.</p><div class="row g-3">
 <div class="col-md-4"><label asp-for="Registro.Codigo" class="form-label">Número / matrícula / identificação *</label><input asp-for="Registro.Codigo" class="form-control"/><span asp-validation-for="Registro.Codigo" class="text-danger"></span></div>
 <div class="col-md-8"><label asp-for="Registro.Descricao" class="form-label">Nome / descrição / responsável *</label><input asp-for="Registro.Descricao" class="form-control"/><span asp-validation-for="Registro.Descricao" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="Registro.Status" class="form-label">Status *</label><select asp-for="Registro.Status" class="form-select"><option value="">Selecione...</option>@foreach(var s in new[]{"ATIVO","ATIVA","ABERTA","PENDENTE","ACIONADO","EM_DESLOCAMENTO","NO_LOCAL","EM_ANDAMENTO","CONCLUIDA","FECHADA","INATIVO","CANCELADA"}){<option>@s</option>}</select><span asp-validation-for="Registro.Status" class="text-danger"></span></div>
 @if(relations.TryGetValue(Model.Recurso,out var rels)){foreach(var rel in rels){<div class="col-md-6"><label class="form-label" for="rel-@rel.Key">@rel.Options.Replace("AreasRisco","Área de risco").Replace("Ocorrencias","Ocorrência").Replace("Agentes","Agente").Replace("Equipes","Equipe").Replace("Abrigos","Abrigo").Replace("Vistorias","Vistoria")</label><select id="rel-@rel.Key" name="Registro.Campos[@rel.Key]" class="form-select"><option value="">Selecione pelo nome...</option>@foreach(var o in Model.Opcoes[rel.Options]){<option value="@o.Id" selected="@(Model.Registro.Campos.GetValueOrDefault(rel.Key)==o.Id.ToString())">@o.Rotulo</option>}</select></div>}}
 @if(Model.Recurso=="Equipes"){<fieldset class="col-12"><legend class="h6">Integrantes ativos *</legend><div class="row">@if(Model.Opcoes["Agentes"].Count==0){<p class="text-secondary">Cadastre agentes ativos antes de formar uma equipe.</p>}@foreach(var agente in Model.Opcoes["Agentes"]){<div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="Registro.AgentesSelecionados" value="@agente.Id" id="agente-@agente.Id" checked="@Model.Registro.AgentesSelecionados.Contains(agente.Id)"/><label class="form-check-label" for="agente-@agente.Id">@agente.Rotulo</label></div>}</div></fieldset>}
 @if(fields.TryGetValue(Model.Recurso,out var fs)){foreach(var f in fs.Split(',')){var type=f.Contains("data_hora")?"datetime-local":f.StartsWith("data_")||f.Contains("vigencia")||f.Contains("prazo")?"date":f.Contains("capacidade")||f.Contains("quantidade")||f.Contains("latitude")||f.Contains("longitude")||f.Contains("populacao")?"number":"text";if(f=="active"){<div class="col-md-4 form-check mt-5"><input type="hidden" name="Registro.Campos[@f]" value="false"/><input id="f-@f" type="checkbox" name="Registro.Campos[@f]" value="true" checked="@(Model.Registro.Campos.GetValueOrDefault(f)!="false")" class="form-check-input"/><label for="f-@f" class="form-check-label">Ativo</label></div>}else if(textareas.Contains(f)){<div class="col-12"><label for="f-@f" class="form-label">@f.Replace('_',' ') @(f is "recomendacoes" or "motivo" or "recomendacao"?"*":"")</label><textarea id="f-@f" name="Registro.Campos[@f]" class="form-control" rows="3">@Model.Registro.Campos.GetValueOrDefault(f)</textarea></div>}else if(dropdowns.Contains(f)){<div class="col-md-4"><label for="f-@f" class="form-label">@f.Replace('_',' ') *</label><select id="f-@f" name="Registro.Campos[@f]" class="form-select"><option value="">Selecione...</option>@foreach(var o in new[]{"DEFESA_CIVIL","GUARDA_MUNICIPAL","APOIO","ALAGAMENTO","DESLIZAMENTO","INCENDIO","ESTRUTURAL","AMBIENTAL","OUTRO","BAIXO","MEDIO","ALTO","CRITICO","BAIXA","MEDIA","ALTA","OPERACIONAL","PREVENTIVA","PATRULHAMENTO","SOCORRO","ABRIGAMENTO","ALIMENTACAO","TRANSPORTE","VISTORIA"}){<option selected="@(Model.Registro.Campos.GetValueOrDefault(f)==o)">@o</option>}</select></div>}else{<div class="col-md-4"><label for="f-@f" class="form-label">@f.Replace('_',' ')</label><input id="f-@f" type="@type" step="@(type=="number"?"0.000001":null)" min="@(f.Contains("capacidade")||f.Contains("quantidade")?"0":null)" name="Registro.Campos[@f]" value="@Model.Registro.Campos.GetValueOrDefault(f)" class="form-control"/></div>}}}
 </div><div class="mt-4"><button class="btn btn-primary">Salvar e auditar</button><a class="btn btn-link" href="/Defesa/@Model.Recurso">Cancelar</a></div></form><partial name="_ValidationScriptsPartial"/>
