@model Sigov.Web.Models.Defesa.DefesaFormViewModel
@{
 ViewData["Title"]=Model.Titulo;
 var relations=new Dictionary<string,(string Key,string Options,string Label)[]>{
  ["Equipes"]=[("responsavel_usuario_id","Usuarios","Responsável"),("unidade_id","Unidades","Unidade")],
  ["AreasRisco"]=[("unidade_id","Unidades","Unidade de referência")],
  ["Ocorrencias"]=[("area_risco_id","AreasRisco","Área de risco"),("equipe_id","Equipes","Equipe responsável")],
  ["Abrigos"]=[("responsavel_usuario_id","Usuarios","Responsável"),("unidade_id","Unidades","Unidade")],
  ["CenariosRisco"]=[("area_risco_id","AreasRisco","Área de risco")],
  ["PlanosContingencia"]=[("cenario_risco_id","CenariosRisco","Cenário de risco"),("responsavel_usuario_id","Usuarios","Responsável"),("aprovado_por","Usuarios","Aprovador")],
  ["RotasEvacuacao"]=[("plano_id","PlanosContingencia","Plano de contingência")],
  ["Resposta"]=[("ocorrencia_id","Ocorrencias","Ocorrência"),("equipe_id","Equipes","Equipe"),("recurso_id","Recursos","Recurso")],
  ["Estoques"]=[("abrigo_id","Abrigos","Abrigo")], ["Doacoes"]=[("destino_abrigo_id","Abrigos","Abrigo de destino")],
  ["Alertas"]=[("area_risco_id","AreasRisco","Área de risco"),("aprovado_por","Usuarios","Aprovador")],
  ["Comunicacoes"]=[("alerta_id","Alertas","Alerta")], ["Ocupacao"]=[("abrigo_id","Abrigos","Abrigo"),("pessoa_id","Pessoas","Pessoa protegida")], ["Evidencias"]=[("evidencia_id","EvidenciasCanonicas","Evidência real"),("contexto_id","AreasRisco","Área de risco relacionada")],
  ["Acionamentos"]=[("ocorrencia_id","Ocorrencias","Ocorrência"),("equipe_id","Equipes","Equipe"),("agente_responsavel_id","Agentes","Agente")],
  ["Vistorias"]=[("area_risco_id","AreasRisco","Área de risco"),("ocorrencia_id","Ocorrencias","Ocorrência"),("agente_responsavel_id","Agentes","Agente")]
 };
 var fields=new Dictionary<string,string>{
  ["Equipes"]="tipo",["Recursos"]="tipo,quantidade,quantidade_mobilizada",["AreasRisco"]="tipo,nivel_risco,bairro,localidade,populacao_estimada,latitude,longitude,vulnerabilidades",
  ["Ocorrencias"]="tipo,severidade,nivel_resposta,local,inicio_em,encerrada_em",["Abrigos"]="endereco,bairro,capacidade,vagas_reservadas,estrutura",
  ["CenariosRisco"]="tipo,severidade,probabilidade,populacao_exposta,impactos,gatilhos",["PlanosContingencia"]="versao,vigencia_inicio,vigencia_fim,aprovado_em",
  ["RotasEvacuacao"]="origem,destino,restricoes,recursos_necessarios",["Resposta"]="acao,inicio_em,fim_em",["Estoques"]="saldo,nivel_critico,unidade_medida",
  ["Doacoes"]="origem,tipo,quantidade,prestacao",["Alertas"]="severidade,mensagem,valido_de,valido_ate,canal,publicado_em",["FontesMonitoramento"]="tipo,identificacao,periodicidade_minutos,ultima_atualizacao,erro_sanitizado",
  ["Comunicacoes"]="canal,mensagem,publicada_em,erro_sanitizado",["Ocupacao"]="entrada_em,saida_em,justificativa_excedente",["Evidencias"]="contexto_tipo"};
 var textareas=new[]{"vulnerabilidades","estrutura","impactos","gatilhos","origem","destino","restricoes","recursos_necessarios","acao","prestacao","mensagem","erro_sanitizado","justificativa_excedente"};
 var statuses=new Dictionary<string,string[]>{["AreasRisco"]=["ATIVA","MONITORADA","INATIVA"],["CenariosRisco"]=["ATIVO","INATIVO"],["Equipes"]=["ATIVA","INATIVA"],["Recursos"]=["DISPONIVEL","EM_USO","MANUTENCAO","INATIVO"],["Ocorrencias"]=["ABERTA","EM_ATENDIMENTO","ENCERRADA","CANCELADA"],["PlanosContingencia"]=["RASCUNHO","EM_APROVACAO","APROVADO","PUBLICADO","INATIVO"],["RotasEvacuacao"]=["ATIVA","INATIVA"],["Resposta"]=["EM_ANDAMENTO","CONCLUIDA","CANCELADA"],["Abrigos"]=["ATIVO","INATIVO"],["Ocupacao"]=["ABRIGADA","ENCERRADA"],["Estoques"]=["ATIVO","INATIVO"],["Doacoes"]=["RECEBIDA","DESTINADA","PRESTADA","CANCELADA"],["Alertas"]=["RASCUNHO","APROVADO","PUBLICADO","EXPIRADO","CANCELADO"],["FontesMonitoramento"]=["ATIVA","DESATUALIZADA","INDISPONIVEL","INATIVA"],["Comunicacoes"]=["PENDENTE","PUBLICADA","ERRO","CANCELADA"],["Evidencias"]=["ATIVA","INATIVA"]};
 var choices=new Dictionary<string,string[]>{["nivel_risco"]=["BAIXO","MEDIO","ALTO","CRITICO"],["severidade"]=["BAIXA","MEDIA","ALTA","CRITICA"],["nivel_resposta"]=["OBSERVACAO","ATENCAO","ALERTA","EMERGENCIA"],["probabilidade"]=["BAIXA","MEDIA","ALTA","MUITO_ALTA"],["contexto_tipo"]=["AREA_RISCO"]};
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><p class="text-uppercase text-primary fw-semibold mb-1">DefesaCivil360</p><h1 class="h3 mb-0">@Model.Titulo — @(Model.Id.HasValue?"editar":"novo registro")</h1></div><a class="btn btn-outline-secondary" href="/DefesaCivil/@Model.Recurso">Voltar</a></div><partial name="_Nav"/>
<form method="post" action="/DefesaCivil/@Model.Recurso/Salvar" class="card border-0 shadow-sm"><div class="card-body p-4">@Html.AntiForgeryToken()@if(Model.Id.HasValue){<input type="hidden" name="id" value="@Model.Id"/>}<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><p class="text-secondary">Campos com * são obrigatórios. Selecione vínculos pelos nomes; identificadores técnicos nunca precisam ser digitados.</p><div class="row g-3">
 <div class="col-md-4"><label asp-for="Registro.Codigo" class="form-label">Código *</label><input asp-for="Registro.Codigo" class="form-control"/><span asp-validation-for="Registro.Codigo" class="text-danger"></span></div>
 <div class="col-md-8"><label asp-for="Registro.Descricao" class="form-label">Nome ou descrição *</label><input asp-for="Registro.Descricao" class="form-control"/><span asp-validation-for="Registro.Descricao" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="Registro.Status" class="form-label">Status *</label><select asp-for="Registro.Status" class="form-select"><option value="">Selecione...</option>@foreach(var s in statuses.GetValueOrDefault(Model.Recurso,new[]{"ATIVO","INATIVO"})){<option value="@s">@s.Replace('_',' ')</option>}</select><span asp-validation-for="Registro.Status" class="text-danger"></span></div>
 @if(relations.TryGetValue(Model.Recurso,out var rels)){foreach(var rel in rels){<div class="col-md-6"><label for="rel-@rel.Key" class="form-label">@rel.Label</label><select id="rel-@rel.Key" name="Registro.Campos[@rel.Key]" class="form-select"><option value="">Selecione...</option>@foreach(var o in Model.Opcoes[rel.Options]){<option value="@o.Id" selected="@(Model.Registro.Campos.GetValueOrDefault(rel.Key)==o.Id.ToString())">@o.Rotulo</option>}</select><span class="text-danger field-validation-valid" data-valmsg-for="Registro.Campos[@rel.Key]" data-valmsg-replace="true"></span></div>}}
 @if(fields.TryGetValue(Model.Recurso,out var fs)){foreach(var f in fs.Split(',')){var value=Model.Registro.Campos.GetValueOrDefault(f);var type=f.EndsWith("_em")||f=="ultima_atualizacao"?"datetime-local":f.StartsWith("vigencia_")?"date":f.Contains("quantidade")||f is "saldo" or "nivel_critico" or "capacidade" or "vagas_reservadas" or "populacao_exposta" or "periodicidade_minutos" or "versao" or "latitude" or "longitude"?"number":"text";<div class="@(textareas.Contains(f)?"col-12":"col-md-4")"><label for="f-@f" class="form-label">@f.Replace('_',' ')</label>@if(choices.TryGetValue(f,out var opts)){<select id="f-@f" name="Registro.Campos[@f]" class="form-select"><option value="">Selecione...</option>@foreach(var o in opts){<option value="@o" selected="@(value==o)">@o.Replace('_',' ')</option>}</select>}else if(textareas.Contains(f)){<textarea id="f-@f" name="Registro.Campos[@f]" class="form-control" rows="3">@value</textarea>}else{<input id="f-@f" type="@type" step="@(type=="number"?"any":null)" min="@(type=="number"&&f is not "latitude" and not "longitude"?"0":null)" name="Registro.Campos[@f]" value="@value" class="form-control"/>}<span class="text-danger field-validation-valid" data-valmsg-for="Registro.Campos[@f]" data-valmsg-replace="true"></span></div>}}
 </div></div><div class="card-footer bg-transparent p-4 d-flex gap-2"><button class="btn btn-primary">Salvar e auditar</button><a class="btn btn-link" href="/DefesaCivil/@Model.Recurso">Cancelar</a></div></form><partial name="_ValidationScriptsPartial"/>
