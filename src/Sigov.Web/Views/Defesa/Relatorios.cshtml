@{ViewData["Title"]="Relatórios DefesaCivil360";}
<h1 class="h3">Relatórios operacionais CSV</h1><partial name="_Nav"/>
<div class="alert alert-info">Abrigos e ocupação são exportados de forma agregada. Dados pessoais sensíveis não integram relatórios operacionais comuns.</div>
<p class="text-secondary">Busca, status e período informados na URL são aplicados ao contexto autenticado. Células com fórmulas são neutralizadas.</p>
<div class="row g-3">@foreach(var x in new[]{("AreasRisco","Áreas e cenários de risco"),("PlanosContingencia","Planos de contingência"),("Ocorrencias","Ocorrências"),("Resposta","Respostas"),("Abrigos","Abrigos e ocupação agregada"),("Recursos","Recursos e embarcações"),("Estoques","Estoque"),("Doacoes","Doações"),("Alertas","Alertas"),("FontesMonitoramento","Fontes de monitoramento"),("Auditoria","Auditoria operacional")}){<div class="col-md-6 col-xl-4"><a class="card card-body h-100 text-decoration-none shadow-sm" href="@Url.Action("Csv", "Defesa", new { recurso = x.Item1 })"><strong>@x.Item2</strong><span class="text-secondary">Exportar CSV seguro</span></a></div>}</div>
