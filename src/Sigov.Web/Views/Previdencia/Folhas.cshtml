@{ ViewData["Title"] = "Folha de Pagamento"; }
<section class="previdencia-station" aria-labelledby="titulo-folhas">
  <header class="mb-3">
    <h1 id="titulo-folhas">Folha de Pagamento</h1>
    <p class="text-muted mb-0">Abertura, fechamento determinístico (faixas INSS/RPPS, IRRF progressivo, teto constitucional por esfera), reabertura justificada, reprocesso versionado e situação do 13º.</p>
  </header>

  @await Html.PartialAsync("_BaseLegislativa")

  <div class="card mb-4"><div class="card-header fw-semibold">Competência</div><div class="card-body">
    <form id="form-folha" novalidate class="row g-2 align-items-end">
      <label class="col-md-4 col-lg-3">Competência (1º do mês)<input class="form-control" name="competencia" type="date" required /></label>
      <label class="col-md-4 col-lg-3">Data-base do cálculo (fixa e auditável)<input class="form-control" name="dataFixa" type="date" required /></label>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary" type="button" data-abrir>Abrir competência</button>
        <button class="btn btn-primary" type="button" data-fechar>Fechar folha</button>
        <button class="btn btn-outline-warning" type="button" data-reabrir>Reabrir (com justificativa)</button>
      </div>
    </form>
  </div></div>

  <div class="row g-4 mb-4">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Reprocessar cálculo (nova versão veta a anterior)</div><div class="card-body">
      <form id="form-reprocesso" novalidate class="row g-2 align-items-end">
        <label class="col-4">Vínculo (id)<input class="form-control" name="vinculoId" type="number" min="1" required /></label>
        <label class="col-4">Competência<input class="form-control" name="competencia" type="date" required /></label>
        <label class="col-4">Data-base<input class="form-control" name="dataFixa" type="date" required /></label>
        <label class="col-12">Justificativa do reprocesso<input class="form-control" name="justificativa" required maxlength="240" /></label>
        <div class="col-12"><button class="btn btn-outline-primary" type="submit">Reprocessar</button></div>
      </form>
    </div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Situação do 13º salário (Lei 4.749/65)</div><div class="card-body">
      <form id="form-decimo" novalidate class="row g-2 align-items-end">
        <label class="col-5">Vínculo (id)<input class="form-control" name="vinculoId" type="number" min="1" required /></label>
        <label class="col-4">Ano<input class="form-control" name="ano" type="number" min="2000" max="2100" required /></label>
        <div class="col-3"><button class="btn btn-outline-secondary" type="submit">Consultar</button></div>
        <p class="col-12 text-muted small mb-0" data-decimo>—</p>
      </form>
    </div></div></div>
  </div>

  <div class="alert d-none" data-mensagem role="status" aria-live="polite"></div>
  <div data-resultado hidden>
    <div class="responsive-data-table mb-4"><table class="table table-striped"><caption class="visually-hidden">Resultado da última operação de folha</caption>
      <thead><tr><th>Competência</th><th>Status</th><th>Idempotente</th><th>Cálculos gerados</th><th>Total cálculos</th><th>Bruto (R$)</th><th>INSS (R$)</th><th>IRRF (R$)</th><th>Líquido (R$)</th></tr></thead>
      <tbody data-fechamento></tbody>
    </table></div>
    <h2 class="h5">Versões do cálculo por vínculo</h2>
    <div class="responsive-data-table"><table class="table table-sm table-striped"><caption class="visually-hidden">Histórico de versões</caption>
      <thead><tr><th>Versão</th><th>Status</th><th>Data-base</th><th>Motivo de veto</th></tr></thead>
      <tbody data-versoes><tr><td colspan="4">Informe vínculo e competência para listar versões.</td></tr></tbody>
    </table></div>
  </div>
</section>

<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.currentScript.previousElementSibling;
  const form = root.querySelector('#form-folha'), message = root.querySelector('[data-mensagem]'), result = root.querySelector('[data-resultado]');
  const envelope = async r => { const b = await r.json().catch(() => ({})); if (!r.ok) throw new Error(b.message || b.error || 'Operação não concluída.'); return b.data ?? b; };
  const notice = (t, k = 'danger') => { message.className = `alert alert-${k}`; message.textContent = t; };
  const brl = v => Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
  const payload = () => ({ competencia: form.competencia.value, dataFixa: form.dataFixa.value });
  const showFechamento = d => {
    const tr = document.createElement('tr');
    [d.competencia, d.status, d.idempotente ? 'Sim' : 'Não', d.calculosGerados, d.totalCalculos, brl(d.totais?.bruto), brl(d.totais?.inssValor), brl(d.totais?.irrfValor), brl(d.totais?.liquido)].forEach(v => { const td = document.createElement('td'); td.textContent = v; tr.append(td); });
    result.querySelector('[data-fechamento]').replaceChildren(tr);
    result.hidden = false;
  };
  const op = async (url, p, body) => { try { const d = await envelope(await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })); if (d && d.totais) showFechamento(d); else notice('Operação concluída.', 'success'); return d; } catch (e) { notice(e.message); return null; } };
  form.querySelector('[data-abrir]').addEventListener('click', () => op('/api/previdencia/folhas/abrir', payload()));
  form.querySelector('[data-fechar]').addEventListener('click', () => op('/api/previdencia/folhas/fechar', payload()));
  form.querySelector('[data-reabrir]').addEventListener('click', () => { const j = prompt('Justificativa obrigatória da reabertura:'); if (!j) return; op('/api/previdencia/folhas/reabrir', { ...payload(), justificativa: j }); });
  root.querySelector('#form-reprocesso').addEventListener('submit', async e => { e.preventDefault(); const f = new FormData(e.target); const d = await op('/api/previdencia/folhas/reprocessar', { vinculoId: Number(f.get('vinculoId')), competencia: f.get('competencia'), dataFixa: f.get('dataFixa'), justificativa: f.get('justificativa') }); if (d) { const bodyV = result.querySelector('[data-versoes]'); bodyV.replaceChildren(); const tr = document.createElement('tr'); [d.versao, d.status, d.dataBaseCalculo, d.motivoVeto || '—'].forEach(v => { const td = document.createElement('td'); td.textContent = v; tr.append(td); }); bodyV.append(tr); notice('Reprocesso versionado com sucesso.', 'success'); } });
  root.querySelector('#form-decimo').addEventListener('submit', async e => { e.preventDefault(); const f = new FormData(e.target); const out = root.querySelector('[data-decimo]'); try { const d = await envelope(await fetch(`/api/previdencia/decimo?vinculoId=${f.get('vinculoId')}&ano=${f.get('ano')}`, { credentials: 'same-origin' })); out.textContent = `Status: ${d.status}` + (d.parcela1Valor != null ? ` | 1ª parcela: R$ ${brl(d.parcela1Valor)} (${d.mesesAte1aParcela} meses)` : '') + (d.parcela2Valor != null ? ` | 2ª parcela: R$ ${brl(d.parcela2Valor)}` : ''); } catch (err) { out.textContent = err.message; } });
  result.hidden = false;
})();
</script>
