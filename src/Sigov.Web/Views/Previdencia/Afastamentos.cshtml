@{ ViewData["Title"] = "Afastamentos"; }
<section class="previdencia-station" aria-labelledby="titulo-afastamentos">
  <header class="mb-3">
    <h1 id="titulo-afastamentos">Afastamentos e Licenças</h1>
    <p class="text-muted mb-0">Registro com documento GED obrigatório, duração parametrizada (maternidade 120d, paternidade 5d, adoção 120d), sobreposição bloqueada e devolução condicional.</p>
  </header>

  @await Html.PartialAsync("_BaseLegislativa")

  <div class="row g-4 mb-4">
    <div class="col-lg-7"><div class="card h-100"><div class="card-header fw-semibold">Registrar afastamento</div><div class="card-body">
      <form id="form-registro" novalidate class="row g-2 align-items-end">
        <label class="col-6 col-md-4">Vínculo (id)<input class="form-control" name="vinculoId" type="number" min="1" required /></label>
        <label class="col-6 col-md-4">Tipo
          <select class="form-select" name="tipo" required>
            <option value="SAUDE">Saúde</option>
            <option value="ESTUDO">Estudo</option>
            <option value="MATERNIDADE">Maternidade (120 dias)</option>
            <option value="PATERNIDADE">Paternidade (5 dias)</option>
            <option value="ADOCAO">Adoção (120 dias)</option>
          </select></label>
        <label class="col-6 col-md-4">Regime de opção
          <select class="form-select" name="regimeOpcao"><option value="RPSS">RPSS (regime próprio)</option><option value="RGPS">RGPS (INSS)</option></select></label>
        <label class="col-6 col-md-4">Data-base<input class="form-control" name="dataFixa" type="date" required /></label>
        <label class="col-6 col-md-4">Início<input class="form-control" name="dataInicio" type="date" required /></label>
        <label class="col-6 col-md-4">Fim<input class="form-control" name="dataFim" type="date" required /></label>
        <label class="col-12">Documento GED (identificador obrigatório)<input class="form-control" name="documentoGed" required maxlength="80" /></label>
        <div class="col-12"><button class="btn btn-primary" type="submit">Registrar</button></div>
      </form>
    </div></div></div>
    <div class="col-lg-5"><div class="card h-100"><div class="card-header fw-semibold">Devolver ao serviço (condicional)</div><div class="card-body">
      <form id="form-devolucao" novalidate class="row g-2 align-items-end">
        <label class="col-4">Afastamento (id)<input class="form-control" name="afastamentoId" type="number" min="1" required /></label>
        <label class="col-4">Data-base<input class="form-control" name="dataFixa" type="date" required /></label>
        <label class="col-4">Motivo<input class="form-control" name="motivo" required maxlength="160" /></label>
        <p class="col-12 text-muted small mb-0">A devolução só é liberada quando a data-base atingir ou ultrapassar o fim do afastamento.</p>
        <div class="col-12"><button class="btn btn-outline-warning" type="submit">Devolver</button></div>
      </form>
    </div></div></div>
  </div>

  <div class="alert d-none" data-mensagem role="status" aria-live="polite"></div>
</section>

<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.currentScript.previousElementSibling;
  const message = root.querySelector('[data-mensagem]');
  const envelope = async r => { const b = await r.json().catch(() => ({})); if (!r.ok) throw new Error(b.message || b.error || 'Operação não concluída.'); return b.data ?? b; };
  const notice = (t, k = 'danger') => { message.className = `alert alert-${k}`; message.textContent = t; };
  root.querySelector('#form-registro').addEventListener('submit', async e => {
    e.preventDefault(); const f = new FormData(e.target);
    try {
      const d = await envelope(await fetch('/api/previdencia/afastamentos', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ vinculoId: Number(f.get('vinculoId')), tipo: f.get('tipo'), dataFixa: f.get('dataFixa'), dataInicio: f.get('dataInicio'), dataFim: f.get('dataFim'), documentoGed: f.get('documentoGed'), regimeOpcao: f.get('regimeOpcao') }) }));
      notice(`Afastamento #${d.id} registrado (${d.dias} dias, GED ${d.documentoGed}).`, 'success'); e.target.reset();
    } catch (err) { notice(err.message); }
  });
  root.querySelector('#form-devolucao').addEventListener('submit', async e => {
    e.preventDefault(); const f = new FormData(e.target);
    try {
      const d = await envelope(await fetch(`/api/previdencia/afastamentos/${f.get('afastamentoId')}/devolver`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ afastamentoId: Number(f.get('afastamentoId')), dataFixa: f.get('dataFixa'), motivo: f.get('motivo') }) }));
      notice(`Afastamento #${d.id} devolvido.`, 'success'); e.target.reset();
    } catch (err) { notice(err.message); }
  });
})();
</script>
