@{ ViewData["Title"] = "Cargos e Classes"; }
<section class="previdencia-station" aria-labelledby="titulo-cargos">
  <header class="mb-3">
    <h1 id="titulo-cargos">Cargos e Classes</h1>
    <p class="text-muted mb-0">Cadastro de cargos públicos por esfera de governo, com modo de remuneração (subsídio ou vencimento + adicionais) e valor de referência.</p>
  </header>

  @await Html.PartialAsync("_BaseLegislativa")

  <div class="card mb-4"><div class="card-header fw-semibold">Novo cargo</div><div class="card-body">
    <form id="form-cargo" novalidate class="row g-2 align-items-end">
      <label class="col-md-3 col-lg-2">Código externo<input class="form-control" name="codigoExterno" required maxlength="40" /></label>
      <label class="col-md-5 col-lg-3">Nome do cargo<input class="form-control" name="nome" required maxlength="120" /></label>
      <label class="col-md-2 col-lg-2">Classe<input class="form-control" name="classe" maxlength="20" /></label>
      <label class="col-md-2 col-lg-2">Padrão<input class="form-control" name="padrao" maxlength="20" /></label>
      <label class="col-md-2 col-lg-2">Nível<input class="form-control" name="nivel" maxlength="20" /></label>
      <label class="col-md-3 col-lg-2">Modo de remuneração
        <select class="form-select" name="modoRemuneracao" required>
          <option value="VENCIMENTO_ADICIONAIS">Vencimento + adicionais</option>
          <option value="SUBSIDIO">Subsídio</option>
        </select></label>
      <label class="col-md-3 col-lg-2">Valor de referência (R$)<input class="form-control" name="valorReferencia" type="number" min="0" step="0.01" required /></label>
      <div class="col-12"><button class="btn btn-primary" type="submit">Cadastrar cargo</button></div>
    </form>
  </div></div>

  <div class="alert d-none" data-mensagem role="status" aria-live="polite"></div>
  <div class="loading-skeleton" data-loading hidden aria-live="polite">Carregando cargos…</div>
  <div data-resultado hidden>
    <div class="responsive-data-table"><table class="table table-striped"><caption class="visually-hidden">Cargos cadastrados</caption>
      <thead><tr><th>Código</th><th>Nome</th><th>Classe/Padrão/Nível</th><th>Modo</th><th>Ref. (R$)</th><th>Situação</th></tr></thead>
      <tbody data-lista></tbody>
    </table></div>
  </div>
</section>

<script nonce="@Context.Items["CspNonce"]">
(() => {
  const root = document.currentScript.previousElementSibling;
  const form = root.querySelector('#form-cargo'), loading = root.querySelector('[data-loading]'), result = root.querySelector('[data-resultado]'), message = root.querySelector('[data-mensagem]');
  const envelope = async r => { const b = await r.json().catch(() => ({})); if (!r.ok) throw new Error(b.message || b.error || 'Operação não concluída.'); return b.data ?? b; };
  const notice = (t, k = 'danger') => { message.className = `alert alert-${k}`; message.textContent = t; };
  const brl = v => Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
  async function listar() {
    loading.hidden = false; message.classList.add('d-none');
    try {
      const rows = await envelope(await fetch('/api/previdencia/cargos', { credentials: 'same-origin' }));
      const body = result.querySelector('[data-lista]');
      body.replaceChildren(...rows.map(c => {
        const tr = document.createElement('tr');
        [c.codigoExterno, c.nome, `${c.classe || '—'} / ${c.padrao || '—'} / ${c.nivel || '—'}`, c.modoRemuneracao, brl(c.valorReferencia), c.ativo ? 'Ativo' : 'Inativo'].forEach(v => { const td = document.createElement('td'); td.textContent = v; tr.append(td); });
        return tr;
      }));
      if (!rows.length) body.innerHTML = '<tr><td colspan="6">Nenhum cargo cadastrado ainda.</td></tr>';
      result.hidden = false;
    } catch (e) { notice(e.message); result.hidden = true; }
    finally { loading.hidden = true; }
  }
  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const f = new FormData(form);
    try {
      await envelope(await fetch('/api/previdencia/cargos', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ codigoExterno: f.get('codigoExterno'), nome: f.get('nome'), classe: f.get('classe') || null, padrao: f.get('padrao') || null, nivel: f.get('nivel') || null, modoRemuneracao: f.get('modoRemuneracao'), valorReferencia: Number(f.get('valorReferencia')) }) }));
      notice('Cargo cadastrado.', 'success');
      form.reset();
      await listar();
    } catch (err) { notice(err.message); }
  });
  listar();
})();
</script>
