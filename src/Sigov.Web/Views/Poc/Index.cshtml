@{
    ViewData["Title"] = "POC";
    var roteiro = new[] { "Login", "Minha Central", "Dashboard", "Implantação Guiada", "Usuários", "Perfis/Permissões", "Tenants", "Módulos", "Auditoria", "LGPD", "Health", "Módulos operacionais demonstrativos" };
    var funcionais = new[] { "Login/logout com cookie", "CRUD de usuários quando sigov.usuario está disponível", "CRUD de tenants quando sigov.tenant está disponível", "Health API /api/health/live" };
    var parciais = new[] { "Dashboard com consultas reais e fallback seguro", "Perfis/permissões dependentes das tabelas de vínculo", "Módulos por tenant quando sigov.tenant_modulo_contratado existe", "Parâmetros com auditoria best-effort" };
    var demonstrativos = new[] { "Protocolo operacional", "GED/OCR", "Notificações", "Busca global", "Relatórios avançados" };
    var implantacao = new[] { "Planos com CRUD definitivo", "Onboarding persistido por etapa", "IA governada", "Mobile/Campo sincronizado" };
}
<h1>Roteiro de demonstração / POC</h1>
<p class="text-muted">Página executiva para apresentação comercial honesta do SIGOV PLUS. Nenhum item demonstrativo deve ser apresentado como persistência operacional completa.</p>
<div class="alert alert-info">Cadastros só devem ser considerados salvos quando a tela retornar toast de sucesso após persistência real. Quando o schema não existir, a interface deve exibir limitação honesta.</div>
<div class="row g-3">
  <div class="col-lg-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Funcional</h2><ul>@foreach (var item in funcionais) { <li>@item</li> }</ul></div></div></div>
  <div class="col-lg-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Parcial</h2><ul>@foreach (var item in parciais) { <li>@item</li> }</ul></div></div></div>
  <div class="col-lg-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Demonstrativo</h2><ul>@foreach (var item in demonstrativos) { <li>@item</li> }</ul><span class="badge text-bg-info">Demonstração</span></div></div></div>
  <div class="col-lg-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Em implantação</h2><ul>@foreach (var item in implantacao) { <li>@item</li> }</ul></div></div></div>
</div>
<section class="card mt-3"><div class="card-body"><h2 class="h5">Roteiro sugerido de demonstração</h2><ol>@foreach (var item in roteiro) { <li>@item</li> }</ol></div></section>
<section class="card mt-3"><div class="card-body"><h2 class="h5">Links rápidos e ambiente</h2><a class="btn btn-primary" href="/Dashboard">Dashboard</a> <a class="btn btn-outline-primary" href="/MinhaCentral">Minha Central</a> <a class="btn btn-outline-primary" href="/Seguranca/Usuarios">Usuários</a> <a class="btn btn-outline-primary" href="/Saas/Tenants">Tenants</a> <a class="btn btn-outline-primary" href="/Saas/Modulos">Módulos</a> <a class="btn btn-outline-primary" href="/Operacao/Health">Health</a><p class="mt-3 mb-0"><strong>Usuário de teste:</strong> admin demo conforme seed local. <strong>Evidências:</strong> LGPD nas máscaras e avisos; auditoria em ações críticas quando sigov.auditoria_evento existe.</p></div></section>
