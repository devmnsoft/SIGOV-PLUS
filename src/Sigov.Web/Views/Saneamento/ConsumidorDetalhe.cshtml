@model Sigov.Web.Models.Saneamento.SaneamentoConsumidorFormViewModel
@{ ViewData["Title"] = "Detalhe do Consumidor"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h1 class="h3 mb-0">Detalhe do Consumidor</h1><p class="text-muted mb-0">Módulo Saneamento • dados pessoais mascarados por padrão.</p></div>
  <button class="btn btn-primary" data-permission="saneamento.dashboard.visualizar" id="btn-san-refresh">Atualizar</button>
</div>
<div class="card mb-3"><div class="card-body">
  @Html.AntiForgeryToken()
  <div class="row g-3 saneamento-form" data-endpoint="consumidores">
    <div class="col-md-3"><label class="form-label">Identificador relacionado</label><input class="form-control" name="referenciaId" type="number" min="1"></div>
    <div class="col-md-3"><label class="form-label">Código/Número</label><input class="form-control" name="codigo" maxlength="80"></div>
    <div class="col-md-3"><label class="form-label">Status/Situação</label><input class="form-control" name="situacao" value="ATIVA" maxlength="40"></div>
    <div class="col-md-3"><label class="form-label">Latitude</label><input class="form-control" name="latitude" type="number" step="0.00000001" min="-90" max="90"></div>
    <div class="col-md-3"><label class="form-label">Longitude</label><input class="form-control" name="longitude" type="number" step="0.00000001" min="-180" max="180"></div>
    <div class="col-md-9"><label class="form-label">Descrição/Observação</label><input class="form-control" name="descricao" maxlength="250"></div>
  </div>
  <div class="mt-3"><button class="btn btn-success btn-san-save" type="button">Salvar via Ajax</button><span class="ms-2 text-muted san-loading d-none">Carregando...</span></div>
</div></div>
<div class="card"><div class="card-header">Registros paginados</div><div class="card-body"><div class="table-responsive"><table class="table table-striped align-middle" id="san-grid" data-endpoint="consumidores"><thead><tr><th>ID</th><th>Código/Número</th><th>Situação</th><th>Resumo</th></tr></thead><tbody></tbody></table></div><nav><ul class="pagination" id="san-pagination"></ul></nav></div></div>
@section Scripts { <script src="~/js/modules/saneamento.consumidores.js"></script> }
