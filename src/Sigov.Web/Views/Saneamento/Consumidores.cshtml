@model Sigov.Web.Models.Saneamento.SaneamentoConsumidorFormViewModel
@using Sigov.Application.Saneamento
@using Sigov.Domain.Common
@{
    ViewData["Title"] = "Consumidores — Saneamento";
    var lista = ViewBag.Consumidores as PagedResult<SaneamentoConsumidorResponse>;
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Saneamento">Saneamento</a></li>
    <li class="breadcrumb-item active" aria-current="page">Consumidores</li>
  </ol>
</nav>

<section class="education-hero mb-4" aria-labelledby="consumidor-title">
  <div>
    <span class="badge text-bg-primary mb-2">Saneamento · Cadastro</span>
    <h1 id="consumidor-title">Consumidores</h1>
    <p>Matrícula é única na entidade. Cliente inativo não fatura.</p>
  </div>
</section>

<details class="how-to mb-4" open>
  <summary class="fw-bold">Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Cadastre e consulte consumidores de saneamento. Documentos pessoais são mascarados por padrão. Para acesso completo, solicite permissão <code>saneamento.consumidor.visualizar_dados_completos</code>.</p>
  </div>
</details>

<div class="card mb-4">
  <div class="card-header bg-white fw-bold">Novo Consumidor</div>
  <div class="card-body">
    <form method="post" action="/Saneamento/Consumidores/Criar">
      @Html.AntiForgeryToken()
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="pessoaId">Pessoa (ID)</label>
          <input class="form-control" id="pessoaId" name="PessoaId" type="number" min="1" required />
          <span asp-validation-for="PessoaId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="codigoConsumidor">Código / Matrícula</label>
          <input class="form-control" id="codigoConsumidor" name="CodigoConsumidor" maxlength="30" placeholder="Automático se vazio" />
        </div>
        <div class="col-md-3">
          <label class="form-label" for="tipoConsumidor">Tipo</label>
          <select class="form-select" id="tipoConsumidor" name="TipoConsumidor">
            <option value="PESSOA_FISICA" selected>Pessoa Física</option>
            <option value="PESSOA_JURIDICA">Pessoa Jurídica</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="situacaoCons">Situação</label>
          <select class="form-select" id="situacaoCons" name="Situacao">
            <option value="ATIVO" selected>Ativo</option>
            <option value="INATIVO">Inativo</option>
          </select>
        </div>
      </div>
      <div class="mt-3">
        <button type="submit" class="btn btn-primary">Cadastrar</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
    <span>Consumidores Cadastrados</span>
    <a class="btn btn-sm btn-outline-secondary" href="/Saneamento/Exportar/consumidores">Exportar CSV</a>
  </div>
  <div class="card-body">
    @if (lista is null || !lista.Items.Any())
    {
      <div class="text-center py-4 text-muted">
        <p class="mb-1 fw-bold">Nenhum consumidor cadastrado.</p>
        <p>Utilize o formulário acima para cadastrar o primeiro consumidor.</p>
      </div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead>
            <tr><th>Código</th><th>Nome</th><th>Tipo</th><th>Situação</th><th>Ações</th></tr>
          </thead>
          <tbody>
          @foreach (var c in lista.Items)
          {
            <tr>
              <td>@c.CodigoConsumidor</td>
              <td>@(c.NomePessoa ?? "—")</td>
              <td><span class="badge text-bg-secondary">@c.TipoConsumidor</span></td>
              <td>
                @if (c.Situacao == "ATIVO")
                {
                  <span class="badge text-bg-success">Ativo</span>
                }
                else
                {
                  <span class="badge text-bg-danger">Inativo</span>
                }
              </td>
              <td><a class="btn btn-sm btn-outline-primary" href="/Saneamento/ConsumidorDetalhe?id=@c.Id">Detalhe</a></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
