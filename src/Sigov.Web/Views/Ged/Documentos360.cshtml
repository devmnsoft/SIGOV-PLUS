@model IReadOnlyList<Sigov.Web.Models.Ged360.GedDocumentoListItem>
@{ ViewData["Title"] = "Documentos — GED360"; }
<link rel="stylesheet" href="~/css/ged360.css" asp-append-version="true" />
<header class="ged-hero compact"><div><span class="ged-kicker">Acervo digital</span><h1>Documentos</h1><p>Pesquisa PostgreSQL por conteúdo e classificação, limitada ao tenant ativo.</p></div><a class="btn btn-primary" href="/GED/Documentos/Create">Cadastrar documento</a></header>
<form method="get" class="ged-filters"><div class="grow"><label for="q">Texto ou metadados</label><input id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Busque por conteúdo, título ou termo arquivístico" /></div><div><label for="status">Status</label><select id="status" name="status" class="form-select"><option value="">Todos</option><option>RECEBIDO</option><option>INDEXADO</option><option>ARQUIVADO</option></select></div><div><label for="sigilo">Sigilo</label><select id="sigilo" name="sigilo" class="form-select"><option value="">Todos</option><option>PUBLICO</option><option>INTERNO</option><option>RESTRITO</option><option>SIGILOSO</option></select></div><button type="submit" class="btn btn-primary">Pesquisar</button></form>
<div class="table-responsive ged-table"><table class="table align-middle"><thead><tr><th>Documento</th><th>Tipo / classificação</th><th>Status</th><th>Sigilo</th><th>Cadastro</th><th></th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="6" class="ged-empty"><strong>Nenhum documento encontrado</strong><span>Revise os filtros ou cadastre o primeiro documento do acervo.</span></td></tr>}
@foreach(var d in Model){<tr><td><strong>@d.Titulo</strong><small>#@d.Id</small></td><td>@d.Tipo<small>@d.Classificacao</small></td><td><span class="badge text-bg-primary">@d.Status</span></td><td><span class="badge text-bg-secondary">@d.Confidencialidade</span></td><td>@d.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td><td><a class="btn btn-sm btn-outline-primary" href="/GED/Documentos/Details/@d.Id">Detalhes</a></td></tr>}
</tbody></table></div>
