@{ ViewData["Title"] = "Upload GED"; }
<h1 class="h2 mb-3">Upload/Download de documentos</h1>
<form class="card card-body" enctype="multipart/form-data"><div class="row g-3"><div class="col-md-6"><label class="form-label">Título</label><input class="form-control" placeholder="Contrato, checklist, documento fiscal..." /></div><div class="col-md-3"><label class="form-label">Tipo</label><select class="form-select"><option>GERAL</option><option>CONTRATO</option><option>DOCUMENTO_FISCAL</option><option>CHECKLIST_PRODUCAO</option></select></div><div class="col-md-3"><label class="form-label">Arquivo</label><input type="file" class="form-control" /></div><div class="col-12"><label class="form-label">Metadados JSON</label><textarea class="form-control" rows="3">{"origem":"comercial","contrato":"demo"}</textarea></div></div><button class="btn btn-primary mt-3" type="button">Enviar para GED</button></form>
