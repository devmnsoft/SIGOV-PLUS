@{ ViewData["Title"] = "Assinatura Digital Simulada"; }
<h1 class="h2 mb-3">Assinatura digital de teste</h1>
<form class="card card-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Documento GED</label><input class="form-control" placeholder="ID do documento" /></div><div class="col-md-4"><label class="form-label">Signatário</label><input class="form-control" placeholder="Nome" /></div><div class="col-md-4"><label class="form-label">CPF/CNPJ</label><input class="form-control" /></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" checked /><label class="form-check-label">Aceito gerar assinatura simulada sem certificadora externa.</label></div></div><button class="btn btn-success mt-3" type="button">Assinar simulado</button></form>
