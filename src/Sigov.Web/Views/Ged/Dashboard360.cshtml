@model Sigov.Web.Models.Ged360.GedDashboardViewModel
@{ ViewData["Title"] = "GED360 — Visão documental"; }
<link rel="stylesheet" href="~/css/ged360.css" asp-append-version="true" />
<header class="ged-hero"><div><span class="ged-kicker">InovaGED inteligente</span><h1>Governança documental em 360°</h1><p>Indicadores reais do tenant ativo, da captura à destinação arquivística.</p></div><nav><a class="btn btn-light" href="/GED/Busca">Busca inteligente</a><a class="btn btn-primary" href="/GED/Documentos/Create">Novo documento</a></nav></header>
<form method="get" class="ged-filters" action="/GED/Dashboard"><div><label for="periodo">Período</label><select id="periodo" name="periodo" class="form-select"><option value="30">Últimos 30 dias</option><option value="90">Últimos 90 dias</option></select></div><div><label for="sigilo">Sigilo</label><select id="sigilo" name="sigilo" class="form-select"><option value="">Todos</option><option>PUBLICO</option><option>INTERNO</option><option>RESTRITO</option><option>SIGILOSO</option></select></div><button class="btn btn-outline-primary" type="submit">Aplicar filtros</button></form>
<div class="ged-metrics">
@foreach(var card in new[] { ("Documentos",Model.Documentos,"primary"),("Classificação pendente",Model.PendentesClassificacao,"warning"),("OCR pendente",Model.OcrPendente,"info"),("OCR para revisão",Model.OcrBaixaConfianca,"danger"),("Protocolos em trânsito",Model.ProtocolosTramitacao,"primary"),("Fluxos atrasados",Model.FluxosAtrasados,"danger"),("Assinaturas pendentes",Model.AssinaturasPendentes,"warning"),("Empréstimos vencidos",Model.EmprestimosVencidos,"danger"),("Caixas no acervo",Model.Caixas,"success"),("Temporalidade em 90 dias",Model.TemporalidadeProxima,"info"),("Eliminações para aprovar",Model.EliminacoesPendentes,"warning"),("Acessos sensíveis (7d)",Model.AcessosSensiveis,"dark") }) { <article class="ged-metric"><span class="badge text-bg-@card.Item3">@card.Item1</span><strong>@card.Item2</strong></article> }
</div>
<section class="ged-actions"><h2>Operação documental</h2><div>@foreach(var item in new[]{("Documentos","/GED/Documentos"),("Importações","/GED/Importacoes"),("OCR e revisão","/GED/OCR"),("Classificação","/GED/Classificacao"),("Temporalidade","/GED/Temporalidade"),("Protocolos","/GED/Protocolos"),("Acervo físico","/GED/AcervoFisico"),("Auditoria LGPD","/GED/Auditoria")}) { <a href="@item.Item2">@item.Item1 <span>→</span></a> }</div></section>
