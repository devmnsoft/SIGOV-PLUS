@{ ViewData["Title"] = "Documentos GED"; }
<h1 class="h2 mb-3">Documentos GED</h1>
<div class="card"><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" placeholder="Título, descrição ou metadado" /></div><div class="col-md-2"><select class="form-select"><option>Tipo</option><option>CONTRATO</option><option>DOCUMENTO_FISCAL</option><option>CHECKLIST_PRODUCAO</option></select></div><div class="col-md-2"><select class="form-select"><option>Status</option><option>INDEXADO</option><option>EM_WORKFLOW</option><option>ASSINADO</option></select></div><div class="col-md-2"><input type="date" class="form-control" /></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtrar</button></div></div><p class="text-muted mb-0">Grade preparada para consumir <code>GET /api/ged/documentos</code> com paginação, tenant e filtros avançados.</p></div></div>
