@model Sigov.Web.Models.Processos.ProtocoloFormViewModel
<h1>Novo protocolo</h1><form id="protocolo-form" class="card card-body">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-3"><label asp-for="PessoaId" class="form-label"></label><input asp-for="PessoaId" class="form-control" /></div><div class="col-md-6"><label asp-for="Assunto" class="form-label"></label><input asp-for="Assunto" class="form-control" required /></div><div class="col-md-3"><label asp-for="Canal" class="form-label"></label><select asp-for="Canal" class="form-select"><option>PRESENCIAL</option><option>TELEFONE</option><option>EMAIL</option><option>PORTAL</option><option>WHATSAPP</option><option>OUTROS</option></select></div><div class="col-12"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control"></textarea></div></div><button class="btn btn-primary mt-3" type="submit">Salvar</button></form>
@section Scripts { <script src="~/js/modules/processos.protocolo.js"></script> }
