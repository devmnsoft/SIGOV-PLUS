@model Sigov.Web.Models.Social.SocialDashboardViewModel
@{ ViewData["Title"] = "Assistência Social360"; var indicadores = new[] { "Famílias acompanhadas", "Pessoas cadastradas", "Atendimentos do mês", "Benefícios solicitados", "Benefícios concedidos", "Benefícios negados", "Visitas pendentes", "Visitas realizadas", "Alta vulnerabilidade", "Acolhimentos ativos", "Encaminhamentos pendentes", "CRAS/CREAS ativos" }; }
<div class="container-fluid py-3">
  <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><div><span class="badge text-bg-primary">SUAS · multi-esfera</span><h1 class="h3 mt-2">Assistência Social360</h1><p class="text-muted">Proteção social para administrações municipais, estaduais e federais.</p></div><a class="btn btn-primary" href="/AssistenciaSocial/Familias">Famílias</a></div>
  <section class="alert alert-info border-0" aria-labelledby="como-usar"><h2 id="como-usar" class="h6">Como usar esta tela</h2><p class="mb-0">Aplique os filtros institucionais e territoriais para analisar indicadores agregados. A abertura de dados pessoais exige permissão sensível e gera auditoria.</p></section>
  <form class="card card-body mb-3" method="get"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-2"><div class="col-12 col-md-3"><label class="form-label" for="esfera">Esfera</label><select id="esfera" name="esfera" class="form-select"><option value="">Todas permitidas</option><option value="municipal">Municipal</option><option value="estadual">Estadual</option><option value="federal">Federal</option></select></div><div class="col-12 col-md-3"><label class="form-label" for="periodo">Período</label><input id="periodo" name="periodo" type="month" class="form-control" /></div><div class="col-12 col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary" type="submit">Aplicar filtros</button></div></div></form>
  <div class="row g-3" id="social-cards">@foreach (var item in indicadores) { <div class="col-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="small text-muted">@item</div><div class="h4 mb-0" aria-label="Carregando indicador">—</div></div></div></div> }</div>
</div>
@section Scripts { <script src="~/js/modules/social.dashboard.js"></script> }
