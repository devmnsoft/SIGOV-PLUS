@model Sigov.Application.Habitacao.HabitacaoRegistroRequest
@{ViewData["Title"]=$"Novo - {ViewData["Titulo"]}";}
<h1>@ViewData["Titulo"]</h1><div asp-validation-summary="All" class="alert alert-danger"></div><form method="post" action="/Habitacao/@ViewData["Recurso"]/Salvar">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label">Código</label><input asp-for="Codigo" class="form-control"/></div><div class="mb-3"><label class="form-label">Descrição</label><input asp-for="Descricao" class="form-control" required/></div><div class="mb-3"><label class="form-label">Status</label><input asp-for="Status" class="form-control" required/></div><div class="mb-3"><label class="form-label">Dados complementares (JSON)</label><textarea asp-for="DadosJson" class="form-control" rows="6"></textarea><small class="text-muted">Inclua vínculos, composição, renda, datas, checklist e metadados conforme o recurso. Não envie arquivos.</small></div><div class="mb-3"><label class="form-label">Justificativa</label><textarea asp-for="Justificativa" class="form-control"></textarea></div><button class="btn btn-primary">Salvar</button> <a href="/Habitacao/@ViewData["Recurso"]" class="btn btn-outline-secondary">Cancelar</a></form>
