@{ViewData["Title"]="Relatórios de Habitação";var reports=new[]{"familias","membros","domicilios","programas","inscricoes","classificacao","visitas","regularizacao","nucleos","lotes","unidades","beneficiarios"};}
<partial name="_Nav" /><h1>Relatórios CSV</h1><p class="text-muted">Exportações respeitam tenant e entidade, são auditadas e neutralizam fórmulas.</p><div class="list-group">@foreach(var r in reports){<a class="list-group-item list-group-item-action" asp-controller="Habitacao" asp-action="Csv" asp-route-recurso="@r">Exportar @r</a>}</div>
