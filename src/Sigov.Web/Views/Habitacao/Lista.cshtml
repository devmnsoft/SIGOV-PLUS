@model Sigov.Web.Models.Habitacao.HabitacaoListaViewModel
@{ViewData["Title"]=Model.Titulo;}
<header class="d-flex justify-content-between mb-3"><div><h1>@Model.Titulo</h1><p class="text-muted">Dados oficiais do contexto atual.</p></div><a class="btn btn-primary" href="/Habitacao/@Model.Recurso/Novo">Novo registro</a></header>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}<form method="get" class="row g-2 mb-3"><div class="col"><input class="form-control" name="busca" value="@Model.Filtro.Busca" placeholder="Buscar"/></div><div class="col"><input class="form-control" name="status" value="@Model.Filtro.Status" placeholder="Status"/></div><div class="col-auto"><button class="btn btn-outline-primary">Filtrar</button></div></form><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Criado em</th></tr></thead><tbody>@foreach(var x in Model.Resultado.Itens){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge bg-secondary">@x.Status</span></td><td>@x.CriadoEm.ToLocalTime().ToString("g")</td></tr>}@if(Model.Resultado.Itens.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>}</tbody></table></div>
