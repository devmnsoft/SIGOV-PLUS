@{ ViewData["Title"] = "Alertas Operacionais"; }
<div class="sigov-ops-hero"><div><span class="sigov-eyebrow">Inteligência operacional</span><h1>Alertas operacionais</h1><p>Uma fila única para Educação, RH e Folha, isolada por tenant e ordenada por severidade.</p></div><span class="sigov-risk-badge is-critical">Atenção requerida</span></div>
<div class="sigov-bulk-toolbar"><select class="form-select w-auto"><option>Todos os módulos</option><option>Educação</option><option>RH</option><option>Folha</option></select><button class="btn btn-outline-primary">Atualizar</button></div>
<section class="sigov-operation-grid" id="operational-alerts"><article class="sigov-operation-card"><strong>Carregando alertas…</strong><small>A lista respeita seu contexto organizacional.</small></article></section>
<script>fetch('/api/alertas-operacionais').then(r=>r.json()).then(p=>{const e=document.querySelector('#operational-alerts');const a=p.data||[];e.innerHTML=a.length?a.map(x=>`<article class="sigov-operation-card"><span class="sigov-risk-badge ${x.severity==='CRITICA'?'is-critical':''}">${x.severity}</span><strong>${x.title}</strong><small>${x.description}</small><span>${x.module} · ${new Date(x.createdAt).toLocaleDateString('pt-BR')}</span></article>`).join(''):'<article class="sigov-operation-card"><strong>Nenhum alerta aberto</strong><small>As rotinas internas não encontraram pendências.</small></article>';});</script>
