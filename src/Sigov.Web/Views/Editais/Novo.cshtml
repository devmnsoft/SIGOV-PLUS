@model Sigov.Web.Models.Editais.EditalFormViewModel
@{ ViewData["Title"]="Novo edital"; }
<section class="container py-4"><h1>Novo edital</h1><p class="alert alert-info">O SIGOV só persiste quando a tabela sigov.edital existir. Sem schema, não há simulação de salvamento.</p><form method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Nome</label><input class="form-control" name="Nome" value="@Model.Nome" required /></div><div class="col-md-6"><label class="form-label">Órgão</label><input class="form-control" name="Orgao" value="@Model.Orgao" /></div><div class="col-md-4"><label class="form-label">Município</label><input class="form-control" name="Municipio" /></div><div class="col-md-2"><label class="form-label">UF</label><input class="form-control" name="Uf" maxlength="2" /></div><div class="col-md-3"><label class="form-label">Modalidade</label><input class="form-control" name="Modalidade" /></div><div class="col-md-3"><label class="form-label">Número/Ano</label><input class="form-control" name="Numero" /></div><div class="col-12"><label class="form-label">Objeto</label><textarea class="form-control" name="Objeto"></textarea></div><div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="Status"><option>Rascunho</option><option>Em análise</option><option>Em preparação</option><option>Em POC</option><option>Aprovado</option><option>Reprovado</option><option>Arquivado</option></select></div><div class="col-md-4"><label class="form-label">Responsável interno</label><input class="form-control" name="ResponsavelInterno" /></div><div class="col-md-4"><label class="form-label">Link origem</label><input class="form-control" name="LinkOrigem" /></div><div class="col-12"><button class="btn btn-primary">Salvar com auditoria</button><a class="btn btn-link" href="/Editais">Cancelar</a></div></form></section>
