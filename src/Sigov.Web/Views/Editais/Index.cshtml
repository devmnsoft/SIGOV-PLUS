@model IReadOnlyList<Sigov.Web.Models.Editais.EditalResumoViewModel>
@{ ViewData["Title"]="Editais"; }
<section class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Editais e POC</h1><p class="text-muted">Central profissional para termos de referência, requisitos, evidências e relatórios.</p></div><a class="btn btn-primary" href="/Editais/Novo">Novo edital</a></div><div class="row g-3">@foreach(var e in Model){<div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body"><span class="badge bg-secondary">@e.Status</span><h2 class="h5 mt-2">@e.Nome</h2><p>@e.Objeto</p><p class="small text-muted">@e.Orgao · @e.Municipio/@e.Uf @(e.Persistido ? "· persistido" : "· fallback não persistido")</p><a class="btn btn-outline-primary" href="/Editais/@e.Id">Abrir</a></div></div></div>}</div></section>
