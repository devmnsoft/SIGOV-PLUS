@model Sigov.Web.Models.Editais.RequisitoFormViewModel
@{ ViewData["Title"]="Novo requisito do edital"; }
<section class="container py-4"><h1>Novo requisito</h1><p class="alert alert-warning">Status Atende será bloqueado quando não houver evidência validada. Fallback não simula persistência.</p><form method="post" class="row g-3">
    @Html.AntiForgeryToken()<div class="col-md-3"><label class="form-label">Código</label><input class="form-control" name="Codigo" value="@Model.Codigo" /></div><div class="col-md-3"><label class="form-label">Item</label><input class="form-control" name="Item" value="@Model.Item" /></div><div class="col-md-6"><label class="form-label">Módulo relacionado</label><input class="form-control" name="ModuloRelacionado" value="@Model.ModuloRelacionado" /></div><div class="col-12"><label class="form-label">Descrição</label><textarea class="form-control" name="Descricao">@Model.Descricao</textarea></div><div class="col-md-4"><label class="form-label">Categoria</label><input class="form-control" name="Categoria" value="@Model.Categoria" /></div><div class="col-md-4"><label class="form-label">Criticidade</label><select class="form-select" name="Criticidade"><option>Crítica</option><option>Alta</option><option>Média</option><option>Baixa</option></select></div><div class="col-md-4"><label class="form-label">Status aderência</label><select class="form-select" name="StatusAderencia"><option>Não avaliado</option><option>Não atende</option><option>Parcial</option><option>Em implantação</option><option>Não aplicável</option><option>Atende</option></select></div><div class="col-md-3 form-check ms-2"><input class="form-check-input" type="checkbox" name="Obrigatorio" value="true"/><label class="form-check-label">Obrigatório</label></div><div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" name="Eliminatorio" value="true"/><label class="form-check-label">Eliminatório</label></div><div class="col-12"><label class="form-label">Observação técnica</label><textarea class="form-control" name="ObservacaoTecnica">@Model.ObservacaoTecnica</textarea></div><div class="col-12"><button class="btn btn-primary">Registrar com auditoria</button></div></form></section>
