@model Sigov.Web.Models.Editais.EditalDetalheViewModel
@{ ViewData["Title"] = "Editais e POC"; var d = Model; }
<section class="container-fluid py-4">
  <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Editais e POC</li></ol></nav>
  <div class="p-4 rounded-4 bg-primary text-white shadow-sm mb-4"><div class="d-flex justify-content-between flex-wrap gap-3"><div><h1 class="h2 mb-1">Central de editais, matriz de aderência e POC</h1><p class="mb-0">Gestão estratégica com fallback honesto: nenhum requisito é marcado como atendido sem evidência validada.</p></div><a class="btn btn-light" href="/Editais/Novo">Novo edital</a></div></div>
  @if(!d.SchemaDisponivel){<div class="alert alert-warning"><strong>Fallback honesto:</strong> @d.MensagemFallback</div>}
  <div class="row g-3 mb-4">
    <div class="col-md-2"><div class="card h-100"><div class="card-body"><span class="text-muted">Requisitos</span><h3>@d.Resumo.Total</h3></div></div></div>
    <div class="col-md-2"><div class="card h-100"><div class="card-body"><span class="text-muted">Atende validado</span><h3>@d.Resumo.Atende</h3></div></div></div>
    <div class="col-md-2"><div class="card h-100"><div class="card-body"><span class="text-muted">Críticos pendentes</span><h3>@d.Resumo.CriticosNaoAtendidos</h3></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="text-muted">Aderência</span><div class="progress"><div class="progress-bar" style="width:@d.Resumo.PercentualAderencia%">@d.Resumo.PercentualAderencia%</div></div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="text-muted">Auditoria</span><p class="mb-0">Ações críticas registradas em auditoria/log.</p></div></div></div>
  </div>
  <div class="card shadow-sm mb-4"><div class="card-header d-flex justify-content-between"><strong>@d.Edital.Nome</strong><span class="badge bg-secondary">@d.Edital.Status</span></div><div class="card-body"><p>@d.Edital.Objeto</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-primary btn-sm" href="/Editais/@d.Edital.Id/Requisitos">Requisitos</a><a class="btn btn-outline-primary btn-sm" href="/MatrizAderencia/Edital/@d.Edital.Id">Matriz</a><a class="btn btn-outline-primary btn-sm" href="/Editais/@d.Edital.Id/Evidencias">Evidências</a><a class="btn btn-outline-primary btn-sm" href="/Poc/Editais/@d.Edital.Id/Roteiro">Roteiro POC</a><a class="btn btn-outline-primary btn-sm" href="/Editais/@d.Edital.Id/RelatorioAderencia">Relatório</a><a class="btn btn-outline-primary btn-sm" href="/Editais/@d.Edital.Id/PropostaTecnica">Proposta</a></div></div></div>
  <div class="card shadow-sm"><div class="card-header"><strong>Grade de aderência</strong></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Item</th><th>Requisito</th><th>Módulo</th><th>Criticidade</th><th>Status</th><th>Evidências</th><th>Observação</th></tr></thead><tbody>@foreach(var r in d.Requisitos){<tr><td>@r.Item</td><td><strong>@r.Codigo</strong><br/>@r.Descricao</td><td>@r.Modulo</td><td><span class="badge bg-warning text-dark">@r.Criticidade</span></td><td><span class="badge bg-info text-dark">@r.StatusAderencia</span></td><td>@r.Evidencias</td><td>@r.ObservacaoTecnica</td></tr>}</tbody></table></div></div>
</section>
