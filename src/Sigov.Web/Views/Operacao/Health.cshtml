@model Sigov.Web.Models.PostBuild.HealthVisualViewModel
@{ ViewData["Title"] = "Health visual"; }
<h1 class="h3">Health visual do ambiente</h1>
<p class="text-muted">Versão @Model.Versao • Ambiente @Model.Ambiente • Servidor @Model.ServerTime.ToString("u")</p>
@if (!string.IsNullOrWhiteSpace(Model.MensagemFallback)) { <div class="alert alert-warning">@Model.MensagemFallback</div> }
<div class="row g-3">
@foreach (var item in Model.Itens) { <div class="col-md-4"><div class="card h-100 border-@(item.Online ? "success" : "danger")"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@item.Nome</h2><span class="badge @(item.Online ? "text-bg-success" : "text-bg-danger")">@item.Status</span></div><p class="text-muted mb-0">@item.Detalhe</p></div></div></div> }
</div>
<div class="alert alert-secondary mt-4">API health: <a href="http://localhost:5001/api/health/live" target="_blank">http://localhost:5001/api/health/live</a></div>
