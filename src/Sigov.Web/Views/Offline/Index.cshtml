@{
    ViewData["Title"] = "SIGOV Offline";
}
<section class="container py-4 mobile-first offline-page">
  <div class="card shadow-sm border-warning">
    <div class="card-body text-center">
      <span class="badge bg-warning text-dark mb-3">Modo offline</span>
      <h1 class="h4">Você está sem conexão</h1>
      <p class="text-muted">O SIGOV PWA mantém recursos essenciais em cache. Ações críticas ficam como <strong>SINCRONIZACAO_PENDENTE</strong> até o próximo upload.</p>
      <div class="alert alert-info text-start">Dados sensíveis são mínimos, mascarados quando possível, e o logout limpa cache offline sensível.</div>
      <a class="btn btn-primary btn-lg w-100 mb-2" href="/Mobile/Home">Voltar ao Mobile</a>
      <a class="btn btn-outline-secondary btn-lg w-100" href="/Mobile/Sync">Ver pendências de sync</a>
    </div>
  </div>
</section>
