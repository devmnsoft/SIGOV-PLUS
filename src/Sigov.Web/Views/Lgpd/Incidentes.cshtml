@{
    ViewData["Title"] = "LGPD - Incidentes";
}
<section class="sigov-page-header d-flex justify-content-between align-items-start gap-3 mb-4"><div><span class="badge text-bg-info mb-2">LGPD</span><h1 class="h2">Incidentes</h1><p class="text-muted">Gestão LGPD com prazos, bases legais, consentimentos, incidentes, relatório do titular e auditoria.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#lgpd-modal">Nova ação</button></section>
<div class="row g-3 mb-3"><div class="col-md-3"><div class="card card-body"><small class="text-muted">Solicitações vencendo</small><strong>3</strong></div></div><div class="col-md-3"><div class="card card-body"><small class="text-muted">Incidentes abertos</small><strong>1</strong></div></div><div class="col-md-3"><div class="card card-body"><small class="text-muted">Consentimentos ativos</small><strong>128</strong></div></div><div class="col-md-3"><div class="card card-body"><small class="text-muted">Revogados</small><strong>7</strong></div></div></div>
<div class="card sigov-grid"><table class="table table-hover align-middle mb-0"><thead><tr><th>Número/Titular</th><th>Prazo</th><th>Status</th><th>Base legal</th><th class="text-end">Ações</th></tr></thead><tbody><tr><td>LGPD-2026-0001<br /><small class="text-muted">***.***.***-**</small></td><td>15 dias</td><td><span class="badge text-bg-warning">Em análise</span></td><td>Consentimento / Obrigação legal</td><td class="text-end"><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#lgpd-modal">Responder</button> <button class="btn btn-sm btn-outline-secondary">Gerar relatório</button></td></tr></tbody></table><div class="card-footer d-flex justify-content-between"><small>Consulta e geração de relatório registram acesso a dado pessoal.</small><ul class="pagination pagination-sm mb-0"><li class="page-item active"><span class="page-link">1</span></li></ul></div></div>
<div class="modal fade" id="lgpd-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5 modal-title">Responder / revogar / registrar</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label class="form-label" for="Descricao">Descrição</label><textarea id="Descricao" name="Descricao" class="form-control" required></textarea><label class="form-label mt-3" for="Severidade">Severidade</label><select id="Severidade" name="Severidade" class="form-select"><option>Baixa</option><option>Média</option><option>Alta</option><option>Crítica</option></select></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Confirmar</button></div></form></div></div>
@section Scripts { <script src="~/js/modules/lgpd.incidentes.js"></script> }
