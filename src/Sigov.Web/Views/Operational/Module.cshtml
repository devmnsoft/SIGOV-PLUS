@model Sigov.Web.Models.Operational.OperationalModuleViewModel
@{ ViewData["Title"] = Model.Title + " - " + Model.CurrentScreen; }
@await Html.PartialAsync("_ModuleHeader", Model)
@await Html.PartialAsync("_ModuleHelpBox", Model.HelpText)
@if (Model.ShowLgpdWarning) { <div class="alert alert-warning"><strong>LGPD:</strong> dados pessoais/sensíveis são mascarados em listagens. Consulte detalhes apenas com finalidade administrativa legítima.</div> }
<div class="row g-3 mb-4">@foreach (var kpi in Model.Kpis) { @await Html.PartialAsync("_ModuleDashboardCard", kpi) }</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Ações rápidas</h2>@await Html.PartialAsync("_ModuleQuickActions", Model.Actions)</div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Filtros e exportações - @Model.CurrentScreen</h2><form class="row g-2" method="get"><div class="col-md-3"><input class="form-control" name="q" placeholder="Número, nome, assunto ou status"></div><div class="col-md-2"><select class="form-select" name="status"><option>Status</option><option>Pendente</option><option>Em andamento</option><option>Concluído</option></select></div><div class="col-md-2"><input class="form-control" name="setor" placeholder="Setor"></div><div class="col-md-5 d-flex gap-2"><button class="btn btn-primary">Aplicar filtro</button><a class="btn btn-outline-secondary" href="@Context.Request.Path">Limpar filtro</a><a class="btn btn-outline-success" href="/@Model.ModuleKey/ExportCsv">CSV</a><button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#placeholderExportModal">Excel/PDF/JSON</button></div></form></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Listagem operacional</h2><div class="btn-group"><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#bulkModal">Ativar</button><button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#bulkModal">Inativar/Arquivar</button></div></div>@if (!Model.Records.Any()) { @await Html.PartialAsync("_ModuleEmptyState", "Ajuste os filtros ou cadastre um novo item para iniciar o fluxo.") } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th><input type="checkbox" aria-label="Selecionar todos"></th><th>Código</th><th>Nome</th><th>Documento</th><th>Status</th><th>Responsável</th><th>Atualização</th><th>Ações</th></tr></thead><tbody>@foreach (var r in Model.Records) { <tr><td><input type="checkbox" aria-label="Selecionar @r.Codigo"></td><td>@r.Codigo</td><td>@r.Nome</td><td>@r.Documento</td><td><span class="badge bg-info text-dark">@r.Status</span></td><td>@r.Responsavel</td><td>@r.AtualizadoEm</td><td><a class="btn btn-sm btn-outline-primary" href="/@Model.ModuleKey/Detalhes/@r.Id">Detalhes</a></td></tr> }</tbody></table></div> }</div></div>
<div class="row g-3"><div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Próximos passos</h2><ol>@foreach (var step in Model.NextSteps) { <li>@step</li> }</ol><div class="placeholder-glow"><span class="placeholder col-12"></span><span class="placeholder col-8"></span></div></div></div></div><div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Linha do tempo / auditoria</h2>@await Html.PartialAsync("_ModuleStatusTimeline", Model.Timeline)</div></div></div></div>
<div class="modal fade" id="bulkModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h3 class="modal-title h5">Confirmar ação crítica</h3><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">A operação será registrada na auditoria do tenant.</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-danger" data-bs-dismiss="modal">Confirmar</button></div></div></div></div>
<div class="modal fade" id="placeholderExportModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h3 class="modal-title h5">Exportação em implantação</h3><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">CSV já está disponível. Excel, PDF e JSON estão preparados visualmente para ativação conforme backend do módulo.</div></div></div></div>
