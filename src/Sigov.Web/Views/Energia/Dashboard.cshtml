@model Sigov.Application.Energia.EnergiaDashboard
@{ViewData["Title"]="Energia360";}
<link rel="stylesheet" href="~/css/energia360.css" asp-append-version="true" />
<main class="energia-shell"><partial name="_Nav"/><header class="energia-hero"><div><span class="eyebrow">GESTÃO INTELIGENTE DE ENERGIA</span><h1>Energia360</h1><p>Consumo, contratos, iluminação, geração limpa e eficiência em uma visão auditável.</p></div><div class="pulse">⚡ Operação energética</div></header>
<form method="get" class="energia-filters"><label>Início<input type="date" name="inicio"/></label><label>Fim<input type="date" name="fim"/></label><label>Status<select name="status"><option value="">Todos</option><option>ATIVA</option><option>VENCIDA</option><option>CRITICO</option></select></label><button class="btn-energy">Aplicar filtros</button></form>
<section class="metric-grid"><article><small>Consumo do mês</small><strong>@Model.ConsumoMes.ToString("N0") kWh</strong></article><article><small>Custo do mês</small><strong>@Model.CustoMes.ToString("C")</strong></article><article><small>UCs ativas</small><strong>@Model.UnidadesAtivas</strong></article><article class="danger"><small>Faturas pendentes</small><strong>@Model.FaturasPendentes</strong></article><article><small>Geração distribuída</small><strong>@Model.GeracaoMes.ToString("N0") kWh</strong></article><article class="saving"><small>Créditos disponíveis</small><strong>@Model.CreditosDisponiveis.ToString("N0") kWh</strong></article><article><small>Economia realizada</small><strong>@Model.EconomiaRealizada.ToString("C")</strong></article><article class="saving"><small>Emissões evitadas</small><strong>@Model.EmissoesEvitadas.ToString("N2") tCO₂e</strong></article></section>
<section class="energia-panels"><article><h2>Demanda</h2><p><strong>@Model.DemandaMedida.ToString("N1")</strong> medida / @Model.DemandaContratada.ToString("N1") contratada</p><div class="bar"><i style="--value:@(Model.DemandaContratada > 0 ? Math.Min(100,Model.DemandaMedida/Model.DemandaContratada*100) : 0)%"></i></div><span class="badge critical">@Model.AlertasDemanda alertas de ultrapassagem</span></article><article><h2>Iluminação pública</h2><p><strong>@Model.ChamadosAbertos</strong> chamados abertos</p><span class="badge warning">@Model.PontosInativos pontos inativos</span></article></section>
<section class="data-card"><h2>Maiores consumidores</h2>@if(Model.MaioresConsumidores.Count==0){<div class="empty">Nenhum consumo registrado para a competência atual.</div>}else{<div class="table-responsive"><table><thead><tr><th>UC</th><th>Unidade</th><th>Consumo</th></tr></thead><tbody>@foreach(var x in Model.MaioresConsumidores){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td>@x.Valor.ToString("N0") kWh</td></tr>}</tbody></table></div>}</section></main>
