@model Sigov.Application.Energia.EnergiaRegistro
@{ViewData["Title"]="Detalhes Energia360";}<link rel="stylesheet" href="~/css/energia360.css" asp-append-version="true"/><main class="energia-shell"><partial name="_Nav"/><header class="page-head"><div><span class="eyebrow">REGISTRO AUDITÁVEL</span><h1>@Model.Codigo</h1></div><span class="badge @Model.Status.ToLowerInvariant()">@Model.Status</span></header><section class="data-card details"><dl><dt>Descrição</dt><dd>@Model.Descricao</dd><dt>Data/competência</dt><dd>@Model.Data?.ToString("dd/MM/yyyy")</dd><dt>Valor/consumo</dt><dd>@Model.Valor.ToString("N2")</dd></dl><h2>Linha do tempo</h2><div class="timeline"><p><strong>Registro atual</strong><br/>Dados persistidos no contexto da entidade e disponíveis para auditoria.</p></div></section></main>
