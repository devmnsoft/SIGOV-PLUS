@model Sigov.Application.Energia.EnergiaRegistroRequest
@{var recurso=(string)ViewData["Recurso"]!;var id=ViewData["Id"];var area=recurso switch{"unidades-consumidoras"=>"UnidadesConsumidoras","geracao-distribuida"=>"GeracaoDistribuida",_=>char.ToUpperInvariant(recurso[0])+recurso[1..]};ViewData["Title"]=ViewData["Titulo"];}
<link rel="stylesheet" href="~/css/energia360.css" asp-append-version="true"/><main class="energia-shell"><partial name="_Nav"/><header class="page-head"><h1>@ViewData["Titulo"]</h1></header><form method="post" action="/Energia/@area/Save" class="energy-form"><input type="hidden" name="id" value="@id"/>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation"></div>@if(recurso!="unidades-consumidoras"){<label>Unidade consumidora<select asp-for="UnidadeConsumidoraId" asp-items="ViewBag.Unidades"><option value="">Selecione uma UC ativa</option></select><span asp-validation-for="UnidadeConsumidoraId"></span></label>}else{<label>Concessionária<select asp-for="PessoaJuridicaId" asp-items="ViewBag.Concessionarias"><option value="">Selecione a pessoa jurídica</option></select><span asp-validation-for="PessoaJuridicaId"></span></label><label>Unidade administrativa<select asp-for="UnidadeOrganizacionalId" asp-items="ViewBag.UnidadesOrganizacionais"><option value="">Selecione a unidade</option></select><span asp-validation-for="UnidadeOrganizacionalId"></span></label><label>Contrato real (opcional)<select asp-for="ContratoId" asp-items="ViewBag.Contratos"><option value="">Sem vínculo</option></select><span asp-validation-for="ContratoId"></span></label>}<label>Código / instalação / série<input asp-for="Codigo"/><span asp-validation-for="Codigo"></span></label><label class="wide">Descrição<input asp-for="Descricao"/><span asp-validation-for="Descricao"></span></label><label>Status<select asp-for="Status"><option>ATIVA</option><option>INATIVA</option><option>LANCADA</option><option>CONTESTADA</option><option>CANCELADA</option><option>PLANEJADO</option><option>EM_EXECUCAO</option><option>CONCLUIDO</option></select><span asp-validation-for="Status"></span></label><label>Valor / consumo / potência<input asp-for="Valor" type="number" min="0" step="0.01"/><span asp-validation-for="Valor"></span></label><label>Data / competência<input asp-for="Data" type="date"/><span asp-validation-for="Data"></span></label><label>Latitude<input asp-for="Latitude" type="number" step="any"/><span asp-validation-for="Latitude"></span></label><label>Longitude<input asp-for="Longitude" type="number" step="any"/><span asp-validation-for="Longitude"></span></label><label class="wide">Justificativa<textarea asp-for="Justificativa"></textarea><span asp-validation-for="Justificativa"></span></label><div class="wide actions"><button class="btn-energy">Salvar e auditar</button><a href="/Energia/@area">Cancelar</a></div></form></main>
