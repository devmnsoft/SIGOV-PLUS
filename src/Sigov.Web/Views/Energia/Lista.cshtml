@model IReadOnlyList<Sigov.Application.Energia.EnergiaRegistro>
@{ViewData["Title"]=ViewData["Titulo"];var recurso=(string)ViewData["Recurso"]!;}
<link rel="stylesheet" href="~/css/energia360.css" asp-append-version="true"/><main class="energia-shell"><partial name="_Nav"/><details class="card card-body mb-3 sigov-screen-guide"><summary class="fw-semibold">Como usar esta tela</summary><div class="small text-muted mt-2">Use os filtros para restringir os dados do contexto institucional atual e selecione Exportar CSV. A permissão específica de relatório é obrigatória; alguns registros podem conter dados sensíveis e devem ser tratados conforme a LGPD. Após a solicitação, um arquivo CSV protegido contra fórmulas é gerado somente com os dados autorizados; quando não houver resultados, confira os filtros antes de tentar novamente.</div></details><header class="page-head"><div><span class="eyebrow">ENERGIA360</span><h1>@ViewData["Titulo"]</h1></div><a class="btn-energy" href="@Context.Request.Path/Create">Novo registro</a></header><form method="get" class="energia-filters"><label>Pesquisa<input name="busca" value="@Context.Request.Query["busca"]" placeholder="Número, série ou descrição"/></label><label>Status<input name="status" value="@Context.Request.Query["status"]"/></label><button class="btn-energy">Filtrar</button><a href="@Url.Action("Csv", "Energia", new { recurso, busca = Context.Request.Query["busca"].ToString(), status = Context.Request.Query["status"].ToString() })" class="btn-ghost">Exportar CSV seguro</a></form><section class="data-card"><div class="table-responsive"><table><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Valor/consumo</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge @x.Status.ToLowerInvariant()">@x.Status</span></td><td>@x.Valor.ToString("N2")</td><td><a href="@Context.Request.Path/Details/@x.Id">Detalhes</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">Nenhum registro encontrado. Ajuste os filtros ou inclua o primeiro registro.</td></tr>}</tbody></table></div></section></main>
