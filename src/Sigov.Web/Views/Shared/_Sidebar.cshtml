@inject Sigov.Web.Services.IMenuPermissionService MenuPermissions
@{
  var path = Context.Request.Path.Value ?? string.Empty;
  Func<string, string> active = url => path.StartsWith(url, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty;
  Func<string[], string> opened = urls => urls.Any(url => path.StartsWith(url, StringComparison.OrdinalIgnoreCase)) ? "open" : string.Empty;
  var claims = User.Claims.Where(c => c.Type is "permission" or "permissions" or "scope").SelectMany(c => c.Value.Split(new[]{' ',',',';'}, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
  var canSeeEnterprisePurchasing = User.IsInRole("ADMIN_GERAL") || User.IsInRole("ADMIN_TENANT") || claims.Contains("compras_empresariais.dashboard.visualizar", StringComparer.OrdinalIgnoreCase);
  var canSeeSecurity = MenuPermissions.CanSeeModule(User, "seguranca");
  var canSeeAudit = MenuPermissions.CanSeeModule(User, "auditoria-lgpd");
  var canSeeGovernanca = User.IsInRole("ADMIN_GERAL") || User.IsInRole("ADMIN_TENANT") || User.IsInRole("ADMINISTRADOR_GERAL") || User.IsInRole("AUDITOR") || claims.Any(c => c.StartsWith("governanca.", StringComparison.OrdinalIgnoreCase));
}
