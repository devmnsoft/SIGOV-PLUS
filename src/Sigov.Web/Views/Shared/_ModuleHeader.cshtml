@model Sigov.Web.Models.Operational.OperationalModuleViewModel
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Início</a></li><li class="breadcrumb-item">@Model.Area</li><li class="breadcrumb-item active">@Model.Title</li></ol></nav>
<div class="p-4 rounded-4 bg-white shadow-sm mb-4"><div class="d-flex flex-column flex-lg-row justify-content-between gap-3"><div><span class="badge bg-primary-subtle text-primary">@Model.Status</span><h1 class="mt-2 mb-1">@Model.Title</h1><p class="text-muted mb-2">@Model.Description</p><p class="mb-0"><strong>Para que serve:</strong> @Model.Purpose</p></div><div class="text-lg-end"><a class="btn btn-primary" href="@Model.ManualUrl">Manual do módulo</a><a class="btn btn-outline-secondary" href="/Poc">Roteiro POC</a></div></div></div>
