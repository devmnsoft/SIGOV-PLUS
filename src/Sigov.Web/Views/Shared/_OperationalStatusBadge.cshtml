@model string
@{
    var status = string.IsNullOrWhiteSpace(Model) ? "Em implantação" : Model;
    var css = status switch
    {
        "Funcional" => "success",
        "Parcial" => "primary",
        "Demonstrativo" => "info",
        "Concluído" => "success",
        "Vencido" => "danger",
        "Cancelado" => "danger",
        "Pendente" => "warning",
        "Aguardando" => "warning",
        "Em andamento" => "info",
        "Aberto" => "primary",
        "Arquivado" => "dark",
        "Indisponível" => "danger",
        _ => "secondary"
    };
}
<span class="badge rounded-pill text-bg-@css">@status</span>
