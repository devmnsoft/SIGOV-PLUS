@{
  var usuarioNome = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
  var perfil = User.Claims.FirstOrDefault(c => c.Type == "perfil" || c.Type.EndsWith("/role", StringComparison.OrdinalIgnoreCase))?.Value;
}
<nav class="sigov-topbar" aria-label="Barra superior">
  <div class="sigov-topbar__left">
    <button class="sigov-icon-btn d-lg-none" type="button" data-sigov-sidebar-toggle aria-controls="sigovSidebar" aria-expanded="false" aria-label="Abrir menu" title="Abrir menu">
      <sigov-icon name="menu" size="20" />
    </button>
    <a class="sigov-brand" href="/MinhaCentral" aria-label="Ir para Minha Central">
      <img class="sigov-logo" src="~/img/sigov-logo.svg" alt="" aria-hidden="true" />
      <span class="sigov-brand__text">SIGOV <strong>PLUS</strong></span>
    </a>
  </div>
  <form class="sigov-global-search" method="get" action="/Busca" role="search">
    <label class="visually-hidden" for="sigovGlobalSearch">Busca global</label>
    <input id="sigovGlobalSearch" class="form-control" name="q" type="search" placeholder="Buscar tarefas, protocolos e documentos" autocomplete="off">
    <button class="sigov-icon-btn" type="submit" aria-label="Pesquisar" title="Pesquisar"><sigov-icon name="search" size="20" /></button>
  </form>
  <div class="sigov-topbar__actions">
    <button class="sigov-btn sigov-btn--primary sigov-btn--sm d-none d-sm-inline-flex" type="button" data-sigov-quick-create aria-haspopup="dialog">Novo</button>
    <sigov-icon-button icon="command" label="Abrir paleta de comandos" tooltip="Paleta de comandos (Ctrl+K)" action="command-open" />
    <a class="sigov-icon-btn" href="/Notificacoes" aria-label="Abrir notificações" title="Notificações"><sigov-icon name="notifications" size="20" /></a>
    <a class="sigov-icon-btn d-none d-sm-inline-flex" href="/Ajuda" aria-label="Abrir ajuda" title="Ajuda"><sigov-icon name="help" size="20" /></a>
    <sigov-icon-button icon="theme" label="Alternar tema" action="theme-toggle" />
    @if (!string.IsNullOrWhiteSpace(usuarioNome)) {
      <span class="sigov-user-chip" title="@perfil"><span class="sigov-avatar" aria-hidden="true">@usuarioNome[..1].ToUpperInvariant()</span><span><strong>@usuarioNome</strong>@if (!string.IsNullOrWhiteSpace(perfil)) { <small>@perfil</small> }</span></span>
    }
    <a class="sigov-btn sigov-btn--ghost sigov-btn--sm d-none d-md-inline-flex" href="/Auth/Logout">Sair</a>
  </div>
</nav>
