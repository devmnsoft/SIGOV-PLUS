@model Sigov.Web.Models.Operational.SectorModuleViewModel
<div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#confirmacaoSetorial">@Model.AcaoPrincipalTexto</button>@foreach (var rota in Model.Rotas){<a class="btn btn-outline-secondary" href="@rota">@rota.Replace("/", "")</a>}</div><div class="modal fade" id="confirmacaoSetorial" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirmar ação crítica</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">A gravação real só será permitida quando o schema físico obrigatório existir. Nenhum salvamento será simulado.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><a class="btn btn-primary" href="@Model.AcaoPrincipalUrl">Continuar</a></div></div></div></div>
