<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>sigov</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/css/site.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1">sigov</span>
      <span class="text-white" id="sigov-tenant-status">Tenant atual • Entidade • Exercício</span>
    </div>
  </nav>
  <div class="container-fluid">
    <div class="row">
      <aside class="col-md-3 col-lg-2 sigov-sidebar p-3">
        <div class="fw-bold mb-2">Operação municipal</div>
        <a class="d-block" href="/">Dashboard</a>
        <a class="d-block" data-permission="core.pessoas.visualizar" href="/Pessoas">Pessoas e Endereços</a>
        <a class="d-block" href="#">Segurança</a>
        <a class="d-block" href="#">Auditoria</a>
        <a class="d-block" href="#">LGPD</a>
        <a class="d-block" href="#">Suporte</a>
        <div class="fw-bold mt-3 mb-2" data-module="processos">Processos Digitais</div>
        <a class="d-block" data-permission="processos.processo.visualizar" href="/Processos">Processos</a>
        <a class="d-block" data-permission="processos.protocolo.visualizar" href="/Protocolos">Protocolos</a>
        <a class="d-block" data-permission="processos.ouvidoria.visualizar" href="/Ouvidoria">Ouvidoria</a>
        <a class="d-block" data-permission="processos.diario.visualizar" href="/DiarioOficial">Diário Oficial</a>
        <a class="d-block" href="#">Módulos contratados</a>
        <div class="fw-bold mt-3 mb-2" data-module="financeiro">Financeiro/SIAFIC</div>
        <a class="d-block" data-permission="financeiro.dashboard.visualizar" href="/Financeiro/Dashboard">Dashboard Financeiro</a>
        <a class="d-block" data-permission="financeiro.plano_contas.visualizar" href="/Financeiro/PlanoContas">Plano de Contas</a>
        <a class="d-block" data-permission="financeiro.orcamento.visualizar" href="/Financeiro/FontesRecurso">Fontes de Recurso</a>
        <a class="d-block" data-permission="financeiro.orcamento.visualizar" href="/Financeiro/Programas">Programas</a>
        <a class="d-block" data-permission="financeiro.orcamento.visualizar" href="/Financeiro/Acoes">Ações</a>
        <a class="d-block" data-permission="financeiro.orcamento.visualizar" href="/Financeiro/NaturezasDespesa">Naturezas de Despesa</a>
        <a class="d-block" data-permission="financeiro.receita.visualizar" href="/Financeiro/NaturezasReceita">Naturezas de Receita</a>
        <a class="d-block" data-permission="financeiro.orcamento.visualizar" href="/Financeiro/OrcamentoDespesa">Orçamento da Despesa</a>
        <a class="d-block" data-permission="financeiro.orcamento.visualizar" href="/Financeiro/OrcamentoReceita">Orçamento da Receita</a>
        <a class="d-block" data-permission="financeiro.empenho.visualizar" href="/Financeiro/Empenhos">Empenhos</a>
        <a class="d-block" data-permission="financeiro.liquidacao.visualizar" href="/Financeiro/Liquidacoes">Liquidações</a>
        <a class="d-block" data-permission="financeiro.pagamento.visualizar" href="/Financeiro/Pagamentos">Pagamentos</a>
        <a class="d-block" data-permission="financeiro.receita.visualizar" href="/Financeiro/Receitas">Receitas</a>
        <a class="d-block" data-permission="financeiro.exportar" href="/Financeiro/Index">Prestação de Contas</a>
        <div class="fw-bold mt-3 mb-2" data-module="rh">Recursos Humanos</div>
        <a class="d-block" data-permission="rh.dashboard.visualizar" href="/Rh/Dashboard">Dashboard RH</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Servidores">Servidores</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Cargos">Cargos</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Lotacoes">Lotações</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Vinculos">Vínculos</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Folhas">Folhas</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/FolhaEventos">Eventos da Folha</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/FolhaLancamentos">Lançamentos</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Pontos">Ponto e Frequência</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Ferias">Férias</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Afastamentos">Afastamentos</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/SaudeOcupacional">Saúde Ocupacional</a>
        <a class="d-block" data-permission="rh.registros.visualizar" href="/Rh/Esocial">eSocial Estrutural</a>
        <a class="d-block" data-permission="rh.portal.visualizar" href="/Rh/Portal">Portal do Servidor</a>
        <div class="fw-bold mt-3 mb-2" data-module="educacao">Educação</div>
        <a class="d-block" data-permission="educacao.dashboard.visualizar" href="/Educacao/Dashboard">Dashboard Educação</a>
        <a class="d-block" data-permission="educacao.escola.visualizar" href="/Educacao/Escolas">Escolas</a>
        <a class="d-block" data-permission="educacao.escola.visualizar" href="/Educacao/AnosLetivos">Ano Letivo</a>
        <a class="d-block" data-permission="educacao.turma.visualizar" href="/Educacao/Cursos">Cursos e Séries</a>
        <a class="d-block" data-permission="educacao.turma.visualizar" href="/Educacao/Turmas">Turmas</a>
        <a class="d-block" data-permission="educacao.aluno.visualizar" href="/Educacao/Alunos">Alunos</a>
        <a class="d-block" data-permission="educacao.matricula.visualizar" href="/Educacao/Matriculas">Matrículas</a>
        <a class="d-block" data-permission="educacao.professor.visualizar" href="/Educacao/Professores">Professores</a>
        <a class="d-block" data-permission="educacao.frequencia.visualizar" href="/Educacao/Frequencias">Frequência</a>
        <a class="d-block" data-permission="educacao.avaliacao.visualizar" href="/Educacao/Avaliacoes">Avaliações e Notas</a>
        <a class="d-block" data-permission="educacao.pre_matricula.visualizar" href="/Educacao/PreMatriculas">Pré-Matrícula</a>
        <a class="d-block" data-permission="educacao.educacenso.visualizar" href="/Educacao/Educacenso">Educacenso Estrutural</a>
        <a class="d-block" data-permission="educacao.aluno.visualizar" href="/Educacao/Portal">Portal Pais/Alunos</a>
        <div class="fw-bold mt-3 mb-2" data-module="saude">Saúde</div>
        <a class="d-block" data-permission="saude.dashboard.visualizar" href="/Saude/Dashboard">Dashboard Saúde</a>
        <a class="d-block" data-permission="saude.unidade.visualizar" href="/Saude/Unidades">Unidades de Saúde</a>
        <a class="d-block" data-permission="saude.profissional.visualizar" href="/Saude/Profissionais">Profissionais</a>
        <a class="d-block" data-permission="saude.paciente.visualizar" href="/Saude/Pacientes">Pacientes</a>
        <a class="d-block" data-permission="saude.prontuario.visualizar" href="/Saude/Prontuario">Prontuário</a>
        <a class="d-block" data-permission="saude.atendimento.visualizar" href="/Saude/Atendimentos">Atendimentos</a>
        <a class="d-block" data-permission="saude.agenda.visualizar" href="/Saude/Agenda">Agenda</a>
        <a class="d-block" data-permission="saude.farmacia.visualizar" href="/Saude/Farmacia">Farmácia</a>
        <a class="d-block" data-permission="saude.vacinacao.visualizar" href="/Saude/Vacinacoes">Vacinação</a>
        <a class="d-block" data-permission="saude.laboratorio.visualizar" href="/Saude/Laboratorio">Laboratório</a>
        <a class="d-block" data-permission="saude.regulacao.visualizar" href="/Saude/Regulacao">Regulação</a>
        <div class="fw-bold mt-3 mb-2" data-module="saude" data-feature="saude.acs_offline">ACS</div>
        <a class="d-block" data-permission="saude.acs.visualizar" href="/Saude/AcsMicroareas">Microáreas</a>
        <a class="d-block" data-permission="saude.acs.visualizar" href="/Saude/AcsDomicilios">Domicílios</a>
        <a class="d-block" data-permission="saude.acs.visualizar" href="/Saude/AcsIndividuos">Indivíduos</a>
        <a class="d-block" data-permission="saude.acs.visita" href="/Saude/AcsVisitas">Visitas</a>
        <a class="d-block" data-permission="saude.acs.sync" href="/Saude/AcsSync">Sincronização Offline</a>
        <hr>
        <div class="fw-bold mb-2">SaaS Admin</div>
        <a class="d-block" href="/SaasAdmin/Tenants">Tenants</a>
        <a class="d-block" href="/SaasAdmin/Planos">Planos</a>
        <a class="d-block" href="/SaasAdmin/Modulos">Módulos</a>
        <a class="d-block" href="/SaasAdmin/FeatureFlags">Feature Flags</a>
        <a class="d-block" href="/SaasAdmin/Uso">Uso</a>
        <a class="d-block" href="/SaasAdmin/Operacao">Operação</a>
        <hr>
        <div class="fw-bold mb-2">Administração</div>
        <a class="d-block" href="#">Conformidade/Aderência</a>
      </aside>
      <main class="col-md-9 col-lg-10 p-4">
        <div id="sigov-alerts"></div>
        @RenderBody()
      </main>
    </div>
  </div>
  <footer class="border-top py-3 text-center text-muted">sigov Gestão Pública Municipal SaaS</footer>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
  <script src="~/js/sigov.api.js"></script>
  <script src="~/js/sigov.ui.js"></script>
  <script src="~/js/modules/saas.tenants.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
