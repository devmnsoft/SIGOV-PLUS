<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] ?? "SIGOV PLUS") - SIGOV PLUS</title>
  <link rel="icon" href="~/img/sigov-favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0F172A">
  <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/css/site.css" rel="stylesheet">
</head>
<body class="sigov-app">
  <a class="sigov-skip-link" href="#conteudo-principal">Pular para o conteúdo</a>
  @await Html.PartialAsync("_DemoBanner")
  <div class="sigov-app-shell">
    @await Html.PartialAsync("_Navbar")
    <div class="sigov-workspace">
      @await Html.PartialAsync("_Sidebar")
      <main class="sigov-main" id="conteudo-principal" tabindex="-1">
        @await Html.PartialAsync("_Breadcrumb")
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
      </main>
    </div>
  </div>
  @await Html.PartialAsync("_ConfirmModal")
  @await Html.PartialAsync("_CommandPalette")
  @await Html.PartialAsync("_ToastHost")
  @await Html.PartialAsync("_SigovAssistant")
  @await Html.PartialAsync("_Footer")
  <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
  <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
  <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
  <script src="~/js/sigov.core.js"></script>
  <script src="~/js/sigov-ui.js" asp-append-version="true"></script>
  <script src="~/js/sigov-command-palette.js" asp-append-version="true" defer></script>
  <script src="~/js/sigov.api.js"></script>
  <script src="~/js/sigov.errors.js"></script>
  <script src="~/js/sigov.toast.js"></script>
  <script src="~/js/sigov.ajax.js"></script>
  <script src="~/js/sigov.forms.js"></script>
  <script src="~/js/sigov.validation.js"></script>
  <script src="~/js/sigov.masks.js"></script>
  <script src="~/js/sigov.money.js" asp-append-version="true"></script>
  <script src="~/js/sigov.grid.js"></script>
  <script src="~/js/sigov.modal.js"></script>
  <script src="~/js/sigov.theme.js"></script>
  <script src="~/js/sigov.shortcuts.js"></script>
  <script src="~/js/sigov.saved-filters.js"></script>
  <script src="~/js/sigov.permissions.js"></script>
  <script src="~/js/sigov.modules.js"></script>
  <script src="~/js/sigov.onboarding.js"></script>
  <script src="~/js/sigov-assistant.js" asp-append-version="true"></script>
  <script src="~/js/sigov.tour.js"></script>
  <script src="~/js/sigov.mobile.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
