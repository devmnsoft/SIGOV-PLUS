<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] ?? "sigov") - sigov</title>
  <link rel="icon" href="~/img/sigov-favicon.svg" type="image/svg+xml">
  <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/css/site.css" rel="stylesheet">
  <link href="~/css/sigov-brand.css" rel="stylesheet">
  <link href="~/css/sigov-theme-light.css" rel="stylesheet">
  <link href="~/css/sigov-theme-dark.css" rel="stylesheet">
  <link href="~/css/sigov-layout.css" rel="stylesheet">
  <link href="~/css/sigov-components.css" rel="stylesheet">
  <link href="~/css/sigov-forms.css" rel="stylesheet">
  <link href="~/css/sigov-grids.css" rel="stylesheet">
  <link href="~/css/sigov-dashboard.css" rel="stylesheet">
</head>
<body>
  @await Html.PartialAsync("_DemoBanner")
  <div class="sigov-app-shell">
    @await Html.PartialAsync("_Navbar")
    <div class="container-fluid">
      <div class="row">
        @await Html.PartialAsync("_Sidebar")
        <main class="col-md-9 col-lg-10 sigov-main" id="conteudo-principal" tabindex="-1">
          @await Html.PartialAsync("_Alerts")
          @RenderBody()
        </main>
      </div>
    </div>
  </div>
  @await Html.PartialAsync("_ConfirmModal")
  @await Html.PartialAsync("_ToastContainer")
  @await Html.PartialAsync("_Footer")
  <script src="~/lib/jquery/jquery.min.js"></script>
  <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
  <script src="~/js/sigov.core.js"></script>
  <script src="~/js/sigov.ui.js"></script>
  <script src="~/js/sigov.api.js"></script>
  <script src="~/js/sigov.errors.js"></script>
  <script src="~/js/sigov.toast.js"></script>
  <script src="~/js/sigov.ajax.js"></script>
  <script src="~/js/sigov.forms.js"></script>
  <script src="~/js/sigov.validation.js"></script>
  <script src="~/js/sigov.masks.js"></script>
  <script src="~/js/sigov.grid.js"></script>
  <script src="~/js/sigov.modal.js"></script>
  <script src="~/js/sigov.theme.js"></script>
  <script src="~/js/sigov.shortcuts.js"></script>
  <script src="~/js/sigov.saved-filters.js"></script>
  <script src="~/js/sigov.permissions.js"></script>
  <script src="~/js/sigov.modules.js"></script>
  <script src="~/js/sigov.onboarding.js"></script>
  <script src="~/js/sigov.tour.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
