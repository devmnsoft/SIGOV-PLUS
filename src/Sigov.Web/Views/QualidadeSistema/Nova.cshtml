@model Sigov.Web.Models.QualidadeSistema.QualidadeInconsistenciaInput
@using Sigov.Web.Models.QualidadeSistema
@{ViewData["Title"]="Registrar inconsistência";var pessoas=(IReadOnlyList<QualidadeResponsavelItem>)ViewBag.Responsaveis;}
<div class="qs-shell"><header class="qs-page-head"><div><h1>Registrar inconsistência</h1><p>Informe evidência verificável e atribua a uma pessoa ativa.</p></div></header><form method="post" class="qs-panel qs-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div><label asp-for="Modulo"></label><input asp-for="Modulo" class="form-control" /><span asp-validation-for="Modulo" class="text-danger"></span></div><div><label asp-for="Titulo"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div><div><label asp-for="Severidade"></label><select asp-for="Severidade" class="form-select"><option>BAIXA</option><option>MEDIA</option><option>ALTA</option><option>CRITICA</option></select><span asp-validation-for="Severidade" class="text-danger"></span></div><div><label asp-for="ResponsavelUsuarioId">Responsável</label><select asp-for="ResponsavelUsuarioId" class="form-select"><option value="">Selecione</option>@foreach(var p in pessoas){<option value="@p.Id">@p.Nome</option>}</select><span asp-validation-for="ResponsavelUsuarioId" class="text-danger"></span></div><div><label asp-for="Tela"></label><input asp-for="Tela" class="form-control" /><span asp-validation-for="Tela" class="text-danger"></span></div><div><label asp-for="Rota"></label><input asp-for="Rota" class="form-control" placeholder="/Modulo/Acao" /><span asp-validation-for="Rota" class="text-danger"></span></div><div class="qs-wide"><label asp-for="Evidencia"></label><textarea asp-for="Evidencia" class="form-control" rows="6"></textarea><span asp-validation-for="Evidencia" class="text-danger"></span></div><div class="qs-actions"><a asp-action="Inconsistencias" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary">Registrar</button></div></form></div>
@section Styles { <link rel="stylesheet" href="~/css/qualidade-sistema.css" asp-append-version="true" /> } @section Scripts { <partial name="_ValidationScriptsPartial" /> }
