@model Sigov.Web.Models.QualidadeSistema.QualidadeDashboardViewModel
@{ ViewData["Title"]="Central de Qualidade e Consistência"; }
<div class="qs-shell"><header class="qs-hero"><div><span class="qs-kicker">RC50.82 · Governança operacional</span><h1>Central de Qualidade e Consistência</h1><p>Inconsistências, validações técnicas e evidências em um único fluxo auditável.</p></div><a class="btn btn-primary" asp-action="Nova">Registrar inconsistência</a></header>
<nav class="qs-nav"><a asp-action="Dashboard">Dashboard</a><a asp-action="Checklist">Checklist</a><a asp-action="Inconsistencias">Inconsistências</a><a asp-action="Rotas">Rotas</a><a asp-action="Formularios">Formulários</a><a asp-action="Permissoes">Permissões</a><a asp-action="Sql">SQL</a><a asp-action="Integracoes">Integrações</a></nav>
<section class="qs-metrics"><article><strong>@Model.Abertas</strong><span>Abertas</span></article><article><strong>@Model.EmAnalise</strong><span>Em análise</span></article><article class="qs-critical"><strong>@Model.Criticas</strong><span>Críticas ativas</span></article><article><strong>@Model.Corrigidas30Dias</strong><span>Corrigidas em 30 dias</span></article></section>
<section class="qs-panel"><div class="qs-panel-title"><h2>Atividade recente</h2><a asp-action="Inconsistencias">Ver todas</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Módulo</th><th>Ocorrência</th><th>Severidade</th><th>Status</th><th>Responsável</th></tr></thead><tbody>@if(Model.Recentes.Count==0){<tr><td colspan="5" class="qs-empty">Nenhuma inconsistência registrada neste contexto.</td></tr>}@foreach(var x in Model.Recentes){<tr><td>@x.Modulo</td><td>@x.Titulo</td><td><span class="qs-badge qs-@x.Severidade.ToLowerInvariant()">@x.Severidade</span></td><td>@x.Status.Replace('_',' ')</td><td>@(x.Responsavel??"Não atribuído")</td></tr>}</tbody></table></div></section></div>
@section Styles { <link rel="stylesheet" href="~/css/qualidade-sistema.css" asp-append-version="true" /> }
