@model IReadOnlyList<Sigov.Web.Models.QualidadeSistema.QualidadeInconsistenciaItem>
@using Sigov.Web.Models.QualidadeSistema
@{ViewData["Title"]="Inconsistências";var f=(QualidadeFiltro)ViewBag.Filtro;var pessoas=(IReadOnlyList<QualidadeResponsavelItem>)ViewBag.Responsaveis;}
<div class="qs-shell"><header class="qs-page-head"><div><h1>Inconsistências</h1><p>Fila operacional isolada por tenant e entidade.</p></div><a class="btn btn-primary" asp-action="Nova">Nova inconsistência</a></header>
<form method="get" class="qs-filters"><div><label for="Modulo">Módulo</label><input name="Modulo" value="@f.Modulo" class="form-control" /></div><div><label for="Severidade">Severidade</label><select name="Severidade" class="form-select"><option value="">Todas</option>@foreach(var x in new[]{"BAIXA","MEDIA","ALTA","CRITICA"}){<option selected="@(f.Severidade==x)">@x</option>}</select></div><div><label for="Status">Status</label><select name="Status" class="form-select"><option value="">Todos</option>@foreach(var x in new[]{"ABERTA","EM_ANALISE","CORRIGIDA","IGNORADA_COM_JUSTIFICATIVA"}){<option selected="@(f.Status==x)">@x</option>}</select></div><div><label for="ResponsavelId">Responsável</label><select name="ResponsavelId" class="form-select"><option value="">Todos</option>@foreach(var p in pessoas){<option value="@p.Id" selected="@(f.ResponsavelId==p.Id)">@p.Nome</option>}</select></div><div><label for="De">De</label><input type="date" name="De" value="@f.De?.ToString("yyyy-MM-dd")" class="form-control" /></div><div><label for="Ate">Até</label><input type="date" name="Ate" value="@f.Ate?.ToString("yyyy-MM-dd")" class="form-control" /></div><button class="btn btn-secondary">Filtrar</button><a class="btn btn-outline-secondary" asp-action="Relatorios" asp-all-route-data="@Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString())">CSV seguro</a></form>
<div class="qs-panel table-responsive"><table class="table"><thead><tr><th>Módulo</th><th>Título</th><th>Severidade</th><th>Status</th><th>Responsável</th><th>Tratamento</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="qs-empty">Nenhum resultado para os filtros informados.</td></tr>}@foreach(var x in Model){<tr><td>@x.Modulo</td><td>@x.Titulo</td><td><span class="qs-badge qs-@x.Severidade.ToLowerInvariant()">@x.Severidade</span></td><td>@x.Status</td><td>@x.Responsavel</td><td>@if(x.Status is "ABERTA" or "EM_ANALISE"){<form asp-action="AlterarStatus" asp-route-id="@x.Id" method="post" class="qs-treatment">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><select name="Status" class="form-select" aria-label="Novo status"><option>EM_ANALISE</option><option>CORRIGIDA</option><option>IGNORADA_COM_JUSTIFICATIVA</option></select><input name="Justificativa" class="form-control" minlength="10" required placeholder="Justificativa obrigatória" /><span data-valmsg-for="Status" class="text-danger"></span><span data-valmsg-for="Justificativa" class="text-danger"></span><button class="btn btn-sm btn-primary">Salvar</button></form>}</td></tr>}</tbody></table></div></div>
@section Styles { <link rel="stylesheet" href="~/css/qualidade-sistema.css" asp-append-version="true" /> }
