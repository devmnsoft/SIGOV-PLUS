@model Sigov.Web.Models.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Alterar senha";
    Layout = "_LayoutAuth";
}
<main class="auth-password" aria-labelledby="password-title">
    <section class="auth-password__card">
        <p class="auth-password__eyebrow">Segurança da conta</p>
        <h1 id="password-title">Crie uma senha forte</h1>
        <p>Sua nova senha será protegida com PBKDF2 e todos os acessos atuais serão encerrados.</p>
        <form method="post" data-password-form novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label asp-for="SenhaAtual"></label>
            <input asp-for="SenhaAtual" autocomplete="current-password" />
            <span asp-validation-for="SenhaAtual"></span>
            <label asp-for="NovaSenha"></label>
            <input asp-for="NovaSenha" autocomplete="new-password" aria-describedby="password-rules" data-new-password />
            <span asp-validation-for="NovaSenha"></span>
            <ul id="password-rules" class="password-rules" aria-live="polite">
                <li data-rule="length">12 ou mais caracteres</li><li data-rule="upper">Uma letra maiúscula</li>
                <li data-rule="lower">Uma letra minúscula</li><li data-rule="number">Um número</li><li data-rule="special">Um caractere especial</li>
            </ul>
            <label asp-for="Confirmacao"></label>
            <input asp-for="Confirmacao" autocomplete="new-password" />
            <span asp-validation-for="Confirmacao"></span>
            <button class="btn btn-primary" type="submit">Salvar nova senha</button>
        </form>
    </section>
</main>
@section Scripts { <script src="~/js/sigov-password.js" asp-append-version="true"></script> }
