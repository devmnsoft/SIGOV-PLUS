@model Sigov.Web.Models.Auth.LoginViewModel
@{ Layout = null; var returnUrl = ViewData["ReturnUrl"] as string; }
<!doctype html><html lang="pt-br" data-sigov-theme="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Entrar no SIGOV PLUS</title><link rel="icon" href="~/img/sigov-favicon.svg" type="image/svg+xml"><link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head>
<body class="sigov-login-page">
  <main class="sigov-login-shell" aria-label="Login SIGOV PLUS">
    <section class="sigov-login-benefits">
      <img class="sigov-login-logo" src="~/img/sigov-logo.svg" alt="SIGOV PLUS" />
      <span class="sigov-badge sigov-badge--info">Ambiente seguro</span>
      <h1 class="display-6 fw-bold mt-4">Gestão pública integrada, segura e multi-tenant</h1>
      <p class="lead opacity-75">Uma plataforma SaaS modular para governo, empresas, auditoria, LGPD, implantação e operação monitorada.</p>
      <div class="mt-4">
        <div class="sigov-benefit">✓ Multi-tenant com contexto de entidade e exercício</div>
        <div class="sigov-benefit">✓ Auditoria e LGPD para operações sensíveis</div>
        <div class="sigov-benefit">✓ Implantação guiada com checklist executivo</div>
        <div class="sigov-benefit">✓ Módulos integrados para governo e empresas</div>
        <div class="sigov-benefit">✓ Health e monitoramento operacional</div>
      </div>
    </section>
    <section class="sigov-login-form">
      <img class="sigov-login-logo d-lg-none" src="~/img/sigov-logo.svg" alt="SIGOV PLUS" />
      <span class="sigov-badge sigov-badge--info">SIGOV SaaS</span>
      <h2 class="h1 fw-bold mt-3 mb-2">Entrar no SIGOV PLUS</h2>
      <p class="text-muted mb-4">Gestão pública integrada, segura e multi-tenant.</p>
      @if (!string.IsNullOrWhiteSpace(Model.MensagemErro)) { <div class="alert alert-danger rounded-4" role="alert"><strong>Não foi possível entrar.</strong><br />@Model.MensagemErro</div> }
      <form method="post" asp-action="Login" asp-route-returnUrl="@returnUrl" id="loginForm" class="d-grid gap-3">
        @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div><label asp-for="Login" class="form-label">Login ou e-mail</label><input asp-for="Login" class="form-control form-control-lg" autocomplete="username" autofocus placeholder="admin@suaentidade.gov.br"/><span asp-validation-for="Login" class="text-danger small"></span></div>
        <div><label asp-for="Senha" class="form-label">Senha</label><input asp-for="Senha" class="form-control form-control-lg" autocomplete="current-password" placeholder="Digite sua senha"/><span asp-validation-for="Senha" class="text-danger small"></span></div>
        <button class="sigov-btn sigov-btn--primary w-100" type="submit" id="btnEntrar">Entrar com segurança</button>
        <div class="d-flex justify-content-between gap-3 flex-wrap"><a href="#" aria-disabled="true">Esqueci minha senha</a><span class="text-muted small">Sessão protegida e auditável</span></div>
      </form>
    </section>
  </main>
  <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script><script src="~/js/sigov-ui.js"></script><script>document.getElementById('loginForm').addEventListener('submit',()=>SigovLoading.button(document.getElementById('btnEntrar'),true,'Entrando...'));</script>
</body></html>
