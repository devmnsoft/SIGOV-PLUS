@model Sigov.Web.Models.Integracoes.IntegracaoDashboardViewModel
@{ ViewData["Title"] = "Dashboard Integrações"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-0">Dashboard Integrações</h1><p class="text-muted mb-0">Módulo Integrações • sigov • Bootstrap 5, jQuery/Ajax e antiforgery.</p></div><span class="badge bg-primary">Estrutural</span></div>
<div id="integracoes-toast" class="alert alert-warning d-none"></div>
<div class="row g-3" id="integracoes-dashboard-cards"><div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Sistemas</span><h2 data-field="totalSistemas">0</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Outbox pendentes</span><h2 data-field="outboxPendentes">0</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Webhooks hoje</span><h2 data-field="webhooksRecebidosHoje">0</h2></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Remessas pendentes</span><h2 data-field="remessasPendentes">0</h2></div></div></div></div>
@await Html.PartialAsync("_AuditoriaIntegracoes")
@section Scripts { <script src="~/js/modules/integracoes.dashboard.js" asp-append-version="true"></script> }
