@model Sigov.Web.Models.Integracoes.CertificadoDigitalFormViewModel
<form id="form-certificado" class="card card-body" method="post">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div><div class="col-md-4"><label asp-for="TipoCertificado" class="form-label"></label><input asp-for="TipoCertificado" class="form-control" /></div><div class="col-md-4"><label asp-for="StorageKey" class="form-label"></label><input asp-for="StorageKey" class="form-control" placeholder="referência segura, sem senha" /></div></div><button class="btn btn-primary mt-3" type="submit">Cadastrar metadados</button></form>