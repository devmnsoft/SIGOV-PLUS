@model Sigov.Web.Models.Integracoes.ApiCredentialFormViewModel
<form id="form-api-credential" class="card card-body" method="post">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div><div class="col-md-4"><label asp-for="ClientId" class="form-label"></label><input asp-for="ClientId" class="form-control" /></div><div class="col-md-4"><label asp-for="Scopes" class="form-label"></label><input asp-for="Scopes" class="form-control" /></div></div><button class="btn btn-primary mt-3" type="submit">Gerar API key</button><small class="text-muted d-block mt-2">A chave completa será exibida uma única vez; hashes nunca são exibidos.</small></form>