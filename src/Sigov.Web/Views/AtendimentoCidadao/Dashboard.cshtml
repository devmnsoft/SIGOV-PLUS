@model Sigov.Application.Atendimento.AtendimentoDashboard
@{ViewData["Title"]="Atendimento ao Cidadão";}<h1 class="h3">Atendimento ao Cidadão</h1><p class="text-muted">Ouvidoria, e-SIC, Carta de Serviços e atendimento integrados.</p><partial name="_Nav"/><form class="row g-2 mb-3"><div class="col"><input type="date" name="inicio" class="form-control"/></div><div class="col"><input type="date" name="fim" class="form-control"/></div><div class="col"><input name="status" class="form-control" placeholder="Status"/></div><div class="col"><button class="btn btn-primary">Filtrar</button></div></form><div class="row row-cols-2 row-cols-lg-4 g-3">@foreach(var c in new[]{("Demandas abertas",Model.DemandasAbertas.ToString()),("Em atraso",Model.DemandasAtrasadas.ToString()),("Ouvidoria pendente",Model.OuvidoriaPendentes.ToString()),("e-SIC pendente",Model.EsicPendentes.ToString()),("Agendamentos hoje",Model.AgendamentosHoje.ToString()),("Encaminhamentos",Model.EncaminhamentosPendentes.ToString()),("Satisfação média",Model.SatisfacaoMedia?.ToString("0.0")??"—")}){<div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted small">@c.Item1</div><strong class="fs-3">@c.Item2</strong></div></div></div>}</div><h2 class="h5 mt-4">Serviços mais solicitados</h2><ul class="list-group">@foreach(var s in (Model.ServicosMaisSolicitados??[])){<li class="list-group-item">@s.Descricao</li>}@if((Model.ServicosMaisSolicitados?.Count??0)==0){<li class="list-group-item text-muted">Sem solicitações no período.</li>}</ul>
