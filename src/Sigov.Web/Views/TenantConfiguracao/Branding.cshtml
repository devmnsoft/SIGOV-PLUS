@model Sigov.Application.Saas.WhiteLabel.TenantBrandingResponse
@{ ViewData["Title"] = "Branding do cliente"; }
<link rel="stylesheet" href="~/css/tenant-branding.css" asp-append-version="true" />
<section class="container py-4 branding-page">
    <header class="mb-4"><h1 class="h2">Branding do cliente</h1><p class="text-muted">Personalize a identidade visual do contexto institucional atual.</p></header>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (!Model.PlanoPermiteWhiteLabel) { <div class="alert alert-warning">Atenção: white label depende do plano ou complemento contratado.</div> }
    <details class="card card-body mb-4 sigov-screen-guide"><summary class="fw-semibold">Como usar esta página</summary><p class="small text-muted mt-2 mb-0">Selecione uma imagem institucional sem dados pessoais, ajuste dimensões e encaixe e confira a prévia. PNG, JPG/JPEG e WEBP são aceitos até 2 MB. Imagens grandes são reduzidas no navegador e validadas novamente no servidor. A alteração é limitada ao cliente atual e fica registrada na auditoria.</p></details>
    <form asp-action="Branding" method="post" enctype="multipart/form-data" class="row g-4" id="formTenantBranding">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <div class="col-lg-7">
            <div class="card card-body h-100">
                <div class="mb-3"><label class="form-label" for="NomeExibicao">Nome de exibição</label><input asp-for="NomeExibicao" class="form-control" required maxlength="150" /><span asp-validation-for="NomeExibicao" class="text-danger"></span></div>
                <div class="mb-3"><label class="form-label" for="logo">Logo externa</label><input class="form-control" id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" /><div class="form-text">Máximo de 2 MB. O nome do arquivo é higienizado e o caminho é gerado pelo sistema.</div></div>
                <div class="row g-3">
                    <div class="col-sm-4"><label class="form-label" for="LogoWidthPx">Largura (px)</label><input asp-for="LogoWidthPx" class="form-control" type="number" min="32" max="1200" required /><span asp-validation-for="LogoWidthPx" class="text-danger"></span></div>
                    <div class="col-sm-4"><label class="form-label" for="LogoHeightPx">Altura (px)</label><input asp-for="LogoHeightPx" class="form-control" type="number" min="16" max="600" required /><span asp-validation-for="LogoHeightPx" class="text-danger"></span></div>
                    <div class="col-sm-4"><label class="form-label" for="LogoFit">Encaixe</label><select asp-for="LogoFit" class="form-select"><option value="contain" selected="@(Model.LogoFit == "contain")">Conter</option><option value="cover" selected="@(Model.LogoFit == "cover")">Cobrir</option><option value="fill" selected="@(Model.LogoFit == "fill")">Preencher</option></select><span asp-validation-for="LogoFit" class="text-danger"></span></div>
                </div>
                <button class="btn btn-outline-secondary mt-3" type="button" id="resetLogoSize">Restaurar tamanho recomendado (240 × 80)</button>
                <hr />
                <div class="row g-3"><div class="col-sm-4"><label class="form-label" for="CorPrimaria">Cor primária</label><input class="form-control form-control-color" type="color" id="CorPrimaria" name="CorPrimaria" value="@(Model.CorPrimaria ?? "#0d6efd")" /></div><div class="col-sm-4"><label class="form-label" for="CorSecundaria">Cor secundária</label><input class="form-control form-control-color" type="color" id="CorSecundaria" name="CorSecundaria" value="@(Model.CorSecundaria ?? "#6c757d")" /></div><div class="col-sm-4"><label class="form-label" for="CorAcento">Cor de destaque</label><input class="form-control form-control-color" type="color" id="CorAcento" name="CorAcento" value="@(Model.CorAcento ?? "#198754")" /></div></div>
                <input type="hidden" name="Tema" value="@Model.Tema" /><input type="hidden" name="WhiteLabelAtivo" value="true" /><input type="hidden" name="LogoUrl" value="@Model.LogoUrl" />
                <div class="mt-4"><button class="btn btn-primary" type="submit">Salvar identidade visual</button></div>
            </div>
        </div>
        <div class="col-lg-5"><aside class="card card-body branding-preview-panel"><h2 class="h5">Prévia em tempo real</h2><div id="brandingPreview"><img id="logoPreview" src="@Model.LogoUrl" alt="Prévia da logo" class="@(string.IsNullOrWhiteSpace(Model.LogoUrl) ? "d-none" : "")" /><span id="emptyPreview" class="@(string.IsNullOrWhiteSpace(Model.LogoUrl) ? "" : "d-none")">Selecione uma logo para visualizar.</span></div><p class="small text-muted mt-3 mb-0">A prévia é ilustrativa; confira a legibilidade antes de salvar.</p></aside></div>
    </form>
</section>
<script src="~/js/modules/tenant.branding.js" asp-append-version="true"></script>
