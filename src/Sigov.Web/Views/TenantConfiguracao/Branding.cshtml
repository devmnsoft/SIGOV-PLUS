<section class="container py-4"><h1>Branding do tenant</h1><div class="alert alert-info" id="brandingAviso">White label depende do plano ou addon contratado.</div><form id="formTenantBranding" class="row g-3"><div class="col-md-6"><label class="form-label">Nome de exibição</label><input class="form-control" name="nomeExibicao" required /></div><div class="col-md-6"><label class="form-label">Logo URL</label><input class="form-control" name="logoUrl" /></div><div class="col-md-4"><label class="form-label">Cor primária</label><input class="form-control form-control-color" name="corPrimaria" value="#0d6efd" /></div><div class="col-md-4"><label class="form-label">Cor secundária</label><input class="form-control form-control-color" name="corSecundaria" value="#6c757d" /></div><div class="col-md-4"><label class="form-label">Cor acento</label><input class="form-control form-control-color" name="corAcento" value="#198754" /></div><div class="col-md-6"><label class="form-label">Tema</label><select class="form-select" name="tema"><option>SIGOV</option><option>CLARO</option><option>ESCURO</option><option>CUSTOMIZADO</option></select></div><div class="col-md-6 form-check mt-5"><input class="form-check-input" type="checkbox" name="whiteLabelAtivo" id="whiteLabelAtivo" /><label class="form-check-label" for="whiteLabelAtivo">Ativar white label</label></div><div class="col-12"><label class="form-label">CSS customizado limitado</label><textarea class="form-control" name="cssCustomizado" rows="4" maxlength="4000"></textarea></div><div class="col-12"><button class="btn btn-primary">Salvar</button></div></form><div id="brandingPreview" class="border rounded p-4 mt-4">Preview</div></section><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/js/modules/tenant.branding.js"></script>
