@model Sigov.Web.Models.Transito.TransitoFormViewModel
@{ViewData["Title"]=Model.Titulo;var relationship=new Dictionary<string,string>{["Autos"]="Agentes,Condutores,Veiculos,Infracoes",["Notificacoes"]="Autos",["Recursos"]="Autos,Notificacoes",["Julgamentos"]="Recursos",["Ocorrencias"]="Agentes",["Rotas"]="Linhas,Pontos",["Autorizacoes"]="Veiculos,Linhas",["Vistorias"]="Autorizacoes,Veiculos,Agentes"};var fields=new Dictionary<string,string>{["Agentes"]="cpf,telefone,email,cargo,data_inicio,data_fim,observacao",["Condutores"]="cpf,categoria_cnh,validade_cnh,telefone,email,endereco,observacao",["Veiculos"]="renavam,chassi,marca,ano_fabricacao,cor,proprietario_nome,proprietario_documento,tipo_veiculo,observacao",["Infracoes"]="gravidade,valor_multa,pontos,base_legal",["Autos"]="data_hora_infracao,local_infracao,latitude,longitude,condutor_identificado,justificativa_sem_condutor,justificativa_sem_veiculo,valor_multa,justificativa_cancelamento",["Notificacoes"]="data_emissao,data_vencimento,meio_envio,destinatario_documento,endereco_envio,observacao",["Recursos"]="requerente_documento,data_recurso,fundamento",["Julgamentos"]="data_julgamento,fundamentacao",["Ocorrencias"]="tipo,data_hora,local,latitude,longitude,gravidade,providencias",["Sinalizacao"]="tipo,local,latitude,longitude,estado_conservacao,data_instalacao,data_ultima_vistoria,observacao",["Intervencoes"]="tipo,local,data_inicio,data_fim_prevista,data_fim_real,responsavel,impacto,observacao",["Linhas"]="tipo_transporte,operador,observacao",["Rotas"]="sentido,distancia_km,tempo_estimado_min,observacao",["Pontos"]="endereco,latitude,longitude,acessibilidade,observacao",["Autorizacoes"]="tipo,titular_documento,data_emissao,data_validade,justificativa_cancelamento,observacao",["Vistorias"]="data_vistoria,resultado,itens_verificados,irregularidades,prazo_regularizacao",["Credenciais"]="tipo,beneficiario_documento,data_emissao,data_validade,justificativa_cancelamento,observacao"};}<h1 class="h3">@Model.Titulo — novo registro</h1><partial name="_Nav"/><form method="post" action="/Transito/@Model.Recurso/Salvar" class="card card-body shadow-sm"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Registro.Codigo" class="form-label">Código / número / placa *</label><input asp-for="Registro.Codigo" class="form-control"/><span asp-validation-for="Registro.Codigo" class="text-danger"></span></div><div class="col-md-8"><label asp-for="Registro.Descricao" class="form-label">Nome / descrição *</label><input asp-for="Registro.Descricao" class="form-control"/><span asp-validation-for="Registro.Descricao" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Registro.Status" class="form-label">Status *</label><select asp-for="Registro.Status" class="form-select"><option value="">Selecione...</option>@foreach(var s in new[]{"ATIVO","PENDENTE","EMITIDO","ABERTA","APROVADA","REPROVADA","CANCELADA"}){<option>@s</option>}</select><span asp-validation-for="Registro.Status" class="text-danger"></span></div>@if(relationship.TryGetValue(Model.Recurso,out var rels)){foreach(var rel in rels.Split(',')){var key=rel switch{"Agentes"=>"agente_id","Condutores"=>"condutor_id","Veiculos"=>"veiculo_id","Infracoes"=>"infracao_tipo_id","Autos"=>"auto_infracao_id","Notificacoes"=>"notificacao_id","Recursos"=>"recurso_id","Linhas"=>"linha_id","Pontos"=>"ponto_id","Autorizacoes"=>"autorizacao_id",_=>rel.ToLowerInvariant()+"_id"};<div class="col-md-6"><label class="form-label">@rel</label><select name="Registro.Campos[@key]" class="form-select"><option value="">Selecione...</option>@foreach(var o in Model.Opcoes[rel]){<option value="@o.Id">@o.Rotulo</option>}</select></div>}}@if(fields.TryGetValue(Model.Recurso,out var fs)){foreach(var f in fs.Split(',')){var type=f.Contains("data_hora")?"datetime-local":f.StartsWith("data_")||f.Contains("validade")||f.Contains("prazo")?"date":f.Contains("valor")||f.Contains("latitude")||f.Contains("longitude")||f.Contains("distancia")||f.Contains("pontos")||f.Contains("tempo_")?"number":"text";if(f is "observacao" or "fundamento" or "fundamentacao" or "providencias" or "impacto" or "itens_verificados" or "irregularidades" or "justificativa_cancelamento"){<div class="col-12"><label class="form-label" for="f-@f">@f.Replace('_',' ')</label><textarea id="f-@f" name="Registro.Campos[@f]" class="form-control"></textarea></div>}else if(f is "acessibilidade" or "condutor_identificado"){<div class="col-md-4 form-check mt-5"><input type="checkbox" value="true" id="f-@f" name="Registro.Campos[@f]" class="form-check-input"/><label for="f-@f" class="form-check-label">@f.Replace('_',' ')</label></div>}else{<div class="col-md-4"><label class="form-label" for="f-@f">@f.Replace('_',' ')</label><input id="f-@f" type="@type" step="@(type=="number"?"0.01":null)" name="Registro.Campos[@f]" class="form-control"/></div>}}}</div><div class="mt-4"><button class="btn btn-primary">Salvar e auditar</button><a class="btn btn-link" href="/Transito/@Model.Recurso">Cancelar</a></div></form><partial name="_ValidationScriptsPartial"/>
