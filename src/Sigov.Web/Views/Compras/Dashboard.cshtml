@model Sigov.Application.Compras.ComprasDashboard
@{
    ViewData["Title"] = "Compras Públicas e Licitações";
}
<link rel="stylesheet" href="~/css/compras.css" asp-append-version="true" />

<div class="compras-shell">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active" aria-current="page">Compras Públicas</li>
        </ol>
    </nav>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <header class="compras-hero">
        <div>
            <span class="eyebrow">FUNC03 · Contratações Públicas</span>
            <h1>Compras, Licitações, Contratos e Atas</h1>
            <p>Planejamento, seleção de fornecedores, instrução processual, cotações e recebimento integrado ao estoque.</p>
        </div>
        <div class="quick-actions">
            <a class="btn btn-light fw-semibold" href="/Compras/Processos/Novo">Novo processo</a>
            <a class="btn btn-outline-light" href="/Compras/Solicitacoes/Nova">Nova solicitação</a>
        </div>
    </header>

    <details class="how-to mb-4">
        <summary>Como usar esta tela</summary>
        <div class="mt-2">
            <p>O módulo de Compras Públicas centraliza o ciclo de aquisições governamentais, integrando-se com a Reposição de Almoxarifado e com o Patrimônio:</p>
            <ul>
                <li><strong>Solicitações e Demandas:</strong> Originam-se de secretarias demandantes ou são autogeradas via reposição de estoque em <code>/Almoxarifado/Reposicao</code>.</li>
                <li><strong>Instrução Processual:</strong> Os processos utilizam modalidades e critérios oficiais do catálogo persistido no banco de dados.</li>
                <li><strong>Participação de Fornecedores:</strong> Fornecedores com status <code>INATIVO</code> ou <code>SUSPENSO</code> são estritamente impedidos de cotar ou contratar.</li>
                <li><strong>Recebimento Físico Integrado:</strong> A conferência de entrega é registrada em <code>/Compras/Processos/{id}/Recebimento</code>, incrementando o estoque no Almoxarifado. Materiais permanentes geram pendência no FUNC02 sem tombamento prematuro no Compras.</li>
            </ul>
        </div>
    </details>

    <section class="row g-3 mb-4" aria-label="Indicadores operacionais de compras">
        <div class="col-6 col-lg">
            <div class="metric metric-warning">
                <span>Solicitações pendentes</span>
                <strong>@Model.SolicitacoesPendentes</strong>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="metric metric-info">
                <span>Processos sem 3 cotações</span>
                <strong>@Model.ProcessosSemCotacao</strong>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="metric metric-alert">
                <span>Contratos a vencer (30d)</span>
                <strong>@Model.ContratosVencendo</strong>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="metric metric-alert">
                <span>Atas a vencer (30d)</span>
                <strong>@Model.AtasVencendo</strong>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="metric metric-success">
                <span>Valor estimado em aberto</span>
                <strong>@Model.ValorAberto.ToString("C")</strong>
            </div>
        </div>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="panel h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">Processos recentes</h2>
                    <a class="btn btn-sm btn-outline-primary" href="/Compras/Processos">Ver todos</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Número</th>
                                <th>Objeto</th>
                                <th>Situação</th>
                                <th class="text-end">Valor estimado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Processos)
                            {
                                var badgeClass = x.Status switch {
                                    "CONTRATADO" or "HOMOLOGADO" => "status-ativo",
                                    "ANULADO" or "FRACASSADO" or "DESERTO" or "CANCELADO" => "status-anulado",
                                    "PLANEJAMENTO" => "status-planejamento",
                                    _ => "status-publicado"
                                };
                                <tr>
                                    <td><a class="fw-bold" href="/Compras/Processos/Detalhe/@x.Id">@x.Numero</a></td>
                                    <td>@x.Descricao</td>
                                    <td><span class="status @badgeClass">@x.Status</span></td>
                                    <td class="text-end">@x.Valor.ToString("C")</td>
                                </tr>
                            }
                            @if (Model.Processos.Count == 0)
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="empty">
                                            <strong>Nenhum processo no contexto atual</strong>
                                            <span>Abra um processo ou receba demandas do planejamento de reposição.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="rules-card mb-3">
                <h3>Regras vigentes do módulo</h3>
                <ul>
                    <li><strong>Catálogo persistido:</strong> Modalidades e critérios de julgamento são validados no PostgreSQL.</li>
                    <li><strong>Fornecedor ativo:</strong> Cadastro inativo não participa de cotações nem contratações.</li>
                    <li><strong>Segurança LGPD:</strong> Listagens e CSVs exportam apenas documentos mascarados, com proteção anti-fórmula.</li>
                    <li><strong>Ponte Reposição:</strong> Demanda criada de forma idempotente em <code>/Almoxarifado/Reposicao</code>; segunda geração recusada.</li>
                    <li><strong>Recebimento físico:</strong> Quantidade $\le$ saldo a receber; materiais permanentes geram pendência no Almoxarifado para tombamento em Patrimônio.</li>
                </ul>
            </div>

            <div class="panel">
                <h2>Acesso rápido</h2>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-secondary text-start" href="/Compras/Fornecedores">Fornecedores credenciados</a>
                    <a class="btn btn-outline-secondary text-start" href="/Compras/Solicitacoes">Solicitações de compra</a>
                    <a class="btn btn-outline-secondary text-start" href="/Compras/Processos">Processos licitatórios</a>
                    <a class="btn btn-outline-secondary text-start" href="/Compras/Contratos">Contratos administrativos</a>
                    <a class="btn btn-outline-secondary text-start" href="/Compras/Atas">Atas de registro de preço</a>
                    <a class="btn btn-outline-primary text-start fw-semibold" href="/Compras/LicitaPro">LicitaPro IA (Inteligência Assistida)</a>
                </div>
            </div>
        </div>
    </div>
</div>
