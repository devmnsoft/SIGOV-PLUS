@model Sigov.Application.Compras.ComprasDashboard
@{ViewData["Title"]="Compras Públicas";}
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3">Compras Públicas</h1><p class="text-muted">Solicitações, licitações, contratos e atas do contexto atual.</p></div><div class="btn-group"><a class="btn btn-primary" href="/Compras/Solicitacoes/Nova">Nova solicitação</a><a class="btn btn-outline-primary" href="/Compras/Processos/Novo">Novo processo</a></div></div>
<div class="row g-3">@foreach(var x in new[]{("Solicitações pendentes",Model.SolicitacoesPendentes.ToString()),("Processos sem 3 cotações",Model.ProcessosSemCotacao.ToString()),("Contratos vencendo",Model.ContratosVencendo.ToString()),("Atas vencendo",Model.AtasVencendo.ToString()),("Valor estimado aberto",Model.ValorAberto.ToString("C"))}){<div class="col-6 col-lg"><div class="card h-100"><div class="card-body"><small class="text-muted">@x.Item1</small><div class="fs-4 fw-bold">@x.Item2</div></div></div></div>}</div>
<div class="card mt-3"><div class="card-header fw-semibold">Processos recentes</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Número</th><th>Objeto</th><th>Status</th><th>Valor</th></tr></thead><tbody>@foreach(var x in Model.Processos){<tr><td><a href="/Compras/Processos/Detalhe/@x.Id">@x.Numero</a></td><td>@x.Descricao</td><td><span class="badge bg-primary">@x.Status</span></td><td>@x.Valor.ToString("C")</td></tr>}@if(Model.Processos.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">Nenhum processo no contexto.</td></tr>}</tbody></table></div></div>
<nav class="mt-3 d-flex gap-3 flex-wrap"><a href="/Compras/Fornecedores">Fornecedores</a><a href="/Compras/Solicitacoes">Solicitações</a><a href="/Compras/Processos">Processos</a><a href="/Compras/Contratos">Contratos</a><a href="/Compras/Atas">Atas</a></nav>
