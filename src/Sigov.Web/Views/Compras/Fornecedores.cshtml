@model IReadOnlyList<Sigov.Application.Compras.FornecedorDto>
@{ViewData["Title"]="Fornecedores";}<div class="d-flex justify-content-between"><h1 class="h3">Fornecedores</h1><div><a class="btn btn-outline-secondary" href="/Compras/Fornecedores/Exportar">CSV LGPD</a> <a class="btn btn-primary" href="/Compras/Fornecedores/Novo">Novo</a></div></div><form class="row g-2 my-3"><div class="col-md-5"><input class="form-control" name="busca" placeholder="Nome"></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Todos</option><option>ATIVO</option><option>SUSPENSO</option><option>INATIVO</option></select></div><div class="col"><button class="btn btn-secondary">Filtrar</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Nome</th><th>Tipo</th><th>Documento</th><th>Contato</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nome</td><td>@x.TipoPessoa</td><td>@x.DocumentoMascarado</td><td>@x.Email<br><small>@x.Telefone</small></td><td><span class="badge bg-@(x.Status=="ATIVO"?"success":"warning")">@x.Status</span></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum fornecedor encontrado.</td></tr>}</tbody></table></div>
