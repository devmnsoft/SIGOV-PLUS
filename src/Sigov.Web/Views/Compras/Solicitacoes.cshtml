@model IReadOnlyList<Sigov.Application.Compras.SolicitacaoDto>
@{ViewData["Title"]="Solicitações de compra";}<div class="d-flex justify-content-between"><h1 class="h3">Solicitações de compra</h1><a class="btn btn-primary" href="/Compras/Solicitacoes/Nova">Nova</a></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>#</th><th>Unidade</th><th>Origem</th><th>Prioridade</th><th>Valor</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a href="/Compras/Solicitacoes/Detalhe/@x.Id">@x.Id</a></td><td>@x.UnidadeSolicitante</td><td>@x.Origem</td><td>@x.Prioridade</td><td>@x.ValorEstimado.ToString("C")</td><td><span class="badge bg-secondary">@x.Status</span></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhuma solicitação.</td></tr>}</tbody></table></div>
