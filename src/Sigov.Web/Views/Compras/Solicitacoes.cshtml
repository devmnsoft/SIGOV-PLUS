@model IReadOnlyList<Sigov.Application.Compras.SolicitacaoDto>
@{
    ViewData["Title"] = "Solicitações de Compra";
}
<link rel="stylesheet" href="~/css/compras.css" asp-append-version="true" />

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Compras">Compras</a></li>
        <li class="breadcrumb-item active" aria-current="page">Solicitações</li>
    </ol>
</nav>

<header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Solicitações de Compra</h1>
        <p class="text-muted mb-0">Demandas das unidades administrativas e operacionais requisitando aquisições ou contratações.</p>
    </div>
    <div>
        <a class="btn btn-primary" href="/Compras/Solicitacoes/Nova">
            Nova solicitação
        </a>
    </div>
</header>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<details class="how-to mb-4">
    <summary>Como funcionam as solicitações</summary>
    <div class="mt-2 text-secondary">
        <p>Fluxo preparatório de compras públicas:</p>
        <ul>
            <li><strong>Unidade demandante:</strong> Registra a necessidade fundamentada, itens e estimativa orçamentária preliminar.</li>
            <li><strong>Aprovação:</strong> Solicitações aprovadas pelo setor competente podem ser agregadas em um Processo de Compra oficial.</li>
        </ul>
    </div>
</details>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Unidade Demandante</th>
                <th>Origem</th>
                <th>Prioridade</th>
                <th class="text-end">Valor Estimado</th>
                <th>Status</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td><strong>#@x.Id</strong></td>
                    <td>@x.UnidadeSolicitante</td>
                    <td><span class="badge bg-light text-dark border">@x.Origem</span></td>
                    <td>
                        <span class="badge @(x.Prioridade == "ALTA" ? "bg-danger" : x.Prioridade == "MEDIA" ? "bg-warning text-dark" : "bg-secondary")">
                            @x.Prioridade
                        </span>
                    </td>
                    <td class="text-end fw-semibold">@x.ValorEstimado.ToString("C")</td>
                    <td>
                        <span class="compras-badge @(x.Status == "APROVADA" ? "compras-badge-homol" : x.Status == "PENDENTE" ? "compras-badge-plan" : "compras-badge-danger")">
                            @x.Status
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/Compras/Solicitacoes/Detalhe/@x.Id">
                            Detalhes
                        </a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="compras-empty-state">
                            <p class="mb-0">Nenhuma solicitação de compra encontrada.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/compras.js" asp-append-version="true"></script>
}
