@model Sigov.Application.Compras.ProcessoDetalhe
<h1 class="h3">Processo @Model.Processo.Numero/@Model.Processo.Exercicio</h1><div class="card"><div class="card-header d-flex justify-content-between"><strong>@Model.Processo.Objeto</strong><span class="badge bg-primary">@Model.Processo.Status</span></div><div class="card-body"><p>Modalidade: @Model.Processo.Modalidade · Critério: @Model.Processo.Criterio · Estimado: @Model.Processo.ValorEstimado.ToString("C")</p><a href="/Compras/Processos/@Model.Processo.Id/Cotacoes">Cotações</a> · <a href="/Compras/Processos/@Model.Processo.Id/Julgamento">Julgamento</a></div></div><h2 class="h5 mt-3">Histórico de fases</h2><ul class="list-group">@foreach(var x in Model.Historico){<li class="list-group-item d-flex justify-content-between">@x.Descricao <small>@x.Data.ToString("g")</small></li>}@if(Model.Historico.Count==0){<li class="list-group-item text-muted">Nenhuma mudança de fase.</li>}</ul>
