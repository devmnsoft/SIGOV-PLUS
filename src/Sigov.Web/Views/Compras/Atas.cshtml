@model IReadOnlyList<Sigov.Application.Compras.CompraLinhaDto>
@{ViewData["Title"]="Atas";}<h1 class="h3">Atas</h1><div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Fornecedor</th><th>Objeto</th><th>Vigência</th><th>Valor</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a href="/Compras/Atas/Detalhe/@x.Id">@x.Numero</a></td><td>@x.Fornecedor</td><td>@x.Descricao</td><td>@x.Inicio — @x.Fim</td><td>@x.Valor.ToString("C")</td><td><span class="badge bg-secondary">@x.Status</span></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum registro.</td></tr>}</tbody></table></div>
