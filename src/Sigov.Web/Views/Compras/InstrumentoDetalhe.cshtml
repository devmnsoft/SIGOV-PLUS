@model Sigov.Application.Compras.CompraLinhaDto
@{
    ViewData["Title"] = $"Instrumento {Model.Numero}";
}
<link rel="stylesheet" href="~/css/compras.css" asp-append-version="true" />

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Compras">Compras</a></li>
        <li class="breadcrumb-item"><a href="/Compras/Contratos">Instrumentos</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Numero</li>
    </ol>
</nav>

<header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 mb-0">Instrumento @Model.Numero</h1>
            <span class="compras-badge @(Model.Status == "VIGENTE" ? "compras-badge-homol" : "compras-badge-plan")">
                @Model.Status
            </span>
        </div>
        <p class="text-muted mb-0">Fornecedor: <strong>@(Model.Fornecedor ?? "Não informado")</strong></p>
    </div>
    <div>
        <a class="btn btn-outline-secondary" href="javascript:history.back()">
            Voltar
        </a>
    </div>
</header>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h2 class="h6 mb-0">Objeto e Dados Financeiros</h2>
    </div>
    <div class="card-body">
        <p class="fs-5 mb-4">@Model.Descricao</p>
        <div class="row g-3 pt-3 border-top">
            <div class="col-sm-4">
                <span class="text-muted small d-block">Valor Global</span>
                <strong class="fs-4 text-primary">@Model.Valor.ToString("C")</strong>
            </div>
            <div class="col-sm-4">
                <span class="text-muted small d-block">Data de Início</span>
                <strong>@(Model.Inicio?.ToString("dd/MM/yyyy") ?? "—")</strong>
            </div>
            <div class="col-sm-4">
                <span class="text-muted small d-block">Data de Término</span>
                <strong>@(Model.Fim?.ToString("dd/MM/yyyy") ?? "—")</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/compras.js" asp-append-version="true"></script>
}
