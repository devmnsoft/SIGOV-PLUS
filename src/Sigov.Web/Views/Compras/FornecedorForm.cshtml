@model Sigov.Application.Compras.FornecedorInput
@{ViewData["Title"]="Novo fornecedor";}<h1 class="h3">Novo fornecedor</h1><form method="post" class="card">
    @Html.AntiForgeryToken()<div class="card-body row g-3"><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-8"><label class="form-label">Razão social / nome</label><input asp-for="Nome" class="form-control" required></div><div class="col-md-4"><label class="form-label">Tipo</label><select asp-for="TipoPessoa" class="form-select"><option>JURIDICA</option><option>FISICA</option></select></div><div class="col-md-4"><label class="form-label">CPF/CNPJ</label><input asp-for="Documento" class="form-control" required></div><div class="col-md-4"><label class="form-label">E-mail</label><input asp-for="Email" class="form-control" type="email"></div><div class="col-md-4"><label class="form-label">Telefone</label><input asp-for="Telefone" class="form-control"></div><div class="col-12"><label class="form-label">Endereço resumido</label><input asp-for="Endereco" class="form-control"></div><div class="col-12"><label class="form-label">Observações</label><textarea asp-for="Observacoes" class="form-control"></textarea></div></div><div class="card-footer"><button class="btn btn-primary">Salvar</button></div></form>
