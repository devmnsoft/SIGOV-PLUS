@model IReadOnlyList<Sigov.Application.Compras.ProcessoDto>
@{ViewData["Title"]="Processos de compra";}<div class="d-flex justify-content-between"><h1 class="h3">Processos de compra</h1><a class="btn btn-primary" href="/Compras/Processos/Novo">Novo</a></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Número</th><th>Modalidade</th><th>Objeto</th><th>Prazo</th><th>Valor</th><th>Fase</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a href="/Compras/Processos/Detalhe/@x.Id">@x.Numero/@x.Exercicio</a></td><td>@x.Modalidade</td><td>@x.Objeto</td><td>@x.DataLimite</td><td>@x.ValorEstimado.ToString("C")</td><td><span class="badge bg-primary">@x.Status</span></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum processo encontrado.</td></tr>}</tbody></table></div>
