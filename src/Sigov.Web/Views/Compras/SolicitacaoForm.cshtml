@{ViewData["Title"]="Nova solicitação";}<h1 class="h3">Nova solicitação</h1><form method="post" class="card"><div class="card-body row g-3"><div class="col-md-6"><label>Unidade solicitante</label><input name="unidadeSolicitante" class="form-control" required></div><div class="col-md-3"><label>Prioridade</label><select name="prioridade" class="form-select"><option>NORMAL</option><option>BAIXA</option><option>ALTA</option><option>URGENTE</option></select></div><div class="col-md-3"><label>Origem</label><select name="origem" class="form-select"><option>MANUAL</option><option>ALMOXARIFADO</option><option>PATRIMONIO</option></select></div><div class="col-12"><label>Justificativa</label><textarea name="justificativa" class="form-control" required></textarea></div><div class="col-md-5"><label>Descrição do item</label><input name="descricao" class="form-control" required></div><div class="col-md-2"><label>Quantidade</label><input name="quantidade" type="number" step=".0001" min=".0001" class="form-control" required></div><div class="col-md-2"><label>Unidade</label><input name="unidade" class="form-control" value="UN" required></div><div class="col-md-2"><label>Tipo</label><select name="tipo" class="form-select"><option>CONSUMO</option><option>PERMANENTE</option><option>SERVICO</option></select></div><div class="col-md-1"><label>Valor</label><input name="valorEstimado" type="number" step=".01" min="0" class="form-control"></div></div><div class="card-footer"><button class="btn btn-primary">Salvar</button></div></form>
