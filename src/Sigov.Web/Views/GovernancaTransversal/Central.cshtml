@model Sigov.Web.Models.Governanca.CentralTransversalViewModel
@{ ViewData["Title"] = Model.Titulo; var isQuality = Model.Tipo == "qualidade"; var isPending = Model.Tipo == "pendencia"; }
<header class="sigov-page-hero"><div><span class="sigov-eyebrow">Governança transversal</span><h1>@Model.Titulo</h1><p>@Model.Descricao</p></div></header>

<div class="alert @(Model.ContextoSelecionado ? "alert-info" : "alert-warning") mt-4" role="status" aria-live="polite">
  <strong>Contexto:</strong> @(Model.ContextoSelecionado ? Model.ContextoNome : "nenhum contexto operacional selecionado")
</div>

@if (!Model.ContextoSelecionado && (isPending || isQuality))
{
  <section class="central-panel central-panel--wide" aria-labelledby="context-required-title">
    <h2 id="context-required-title" class="h4">Selecione um cliente autorizado</h2>
    <p>O contexto define a barreira de isolamento dos dados. Esta tela não executa consultas nem interpreta a ausência de contexto como resultado vazio.</p>
    <a class="sigov-btn sigov-btn--primary" href="/SaasConfiguracao/ContextoGlobal">Selecionar contexto operacional</a>
  </section>
}
else
{
  @if (isPending || isQuality)
  {
    <details class="central-panel central-panel--wide mb-3">
      <summary><strong>Como usar esta tela</strong></summary>
      <div class="mt-3">
        <p><strong>Para que serve:</strong> @(isPending ? "organizar trabalhos exigidos pelos módulos de origem" : "explicar inconsistências verificadas nos dados de origem").</p>
        <p><strong>Como funciona:</strong> os filtros e a paginação são aplicados dentro do contexto ativo. Uma pendência representa trabalho ainda exigido; um problema de qualidade representa uma regra de dados violada.</p>
        <p><strong>Pré-requisitos:</strong> contexto ativo, vínculo vigente e permissão. Uma ação pode estar indisponível quando não há rota segura ou quando o estado mudou.</p>
        <p><strong>Regras importantes:</strong> corrija no módulo de origem. @(isQuality ? "Depois, revalide consultando os dados reais; abrir a ação não marca a ocorrência como corrigida." : "Abrir ou ler um item não o resolve automaticamente.")</p>
        <p><strong>Próximo passo:</strong> filtre, abra a ação permitida e retorne para conferir o estado atualizado.</p>
      </div>
    </details>
    <form method="get" class="central-panel central-panel--wide mb-3" aria-label="Filtros da listagem">
      <div class="row g-3 align-items-end">
        @if(isPending){<div class="col-md-4"><label class="form-label" for="filter-view">Fila</label><select id="filter-view" class="form-select" name="visao">@foreach(var option in new[]{("MINHAS","Minhas pendências"),("NAO_ATRIBUIDAS","Não atribuídas"),("TODAS","Todas autorizadas"),("ENCERRADAS","Encerradas")}){<option value="@option.Item1" selected="@(Model.Visao==option.Item1)">@option.Item2</option>}</select></div>}
        <div class="col-md-4"><label class="form-label" for="filter-module">Módulo</label><input id="filter-module" class="form-control" name="modulo" value="@Model.Modulo" maxlength="80" /></div>
        <div class="col-md-4"><label class="form-label" for="filter-classification">@(isQuality ? "Severidade" : "Classificação")</label><select id="filter-classification" class="form-select" name="@(isQuality ? "severidade" : "gravidade")"><option value="">Todas</option>@foreach(var value in new[]{"CRITICA","ALTA","MEDIA","BAIXA"}){<option value="@value" selected="@(Model.Classificacao == value)">@value</option>}</select></div>
        @if(isPending){<div class="col-md-3"><label class="form-label" for="filter-status">Situação</label><select id="filter-status" class="form-select" name="situacao"><option value="">Todas</option>@foreach(var value in new[]{"ABERTA","EM_TRATAMENTO","RESOLVIDA","CANCELADA"}){<option value="@value" selected="@(Model.Situacao==value)">@value.Replace('_',' ')</option>}</select></div><div class="col-md-3"><label class="form-label" for="filter-deadline">Prazo</label><select id="filter-deadline" class="form-select" name="prazo"><option value="">Todos</option><option value="VENCIDAS" selected="@(Model.Prazo=="VENCIDAS")">Vencidas</option><option value="FUTURO" selected="@(Model.Prazo=="FUTURO")">Prazo futuro</option><option value="SEM_PRAZO" selected="@(Model.Prazo=="SEM_PRAZO")">Sem prazo</option></select></div><div class="col-md-3"><label class="form-label" for="filter-open-from">Abertura de</label><input id="filter-open-from" type="date" class="form-control" name="aberturaDe" value="@Model.AberturaDe?.ToString("yyyy-MM-dd")" /></div><div class="col-md-3"><label class="form-label" for="filter-open-to">Abertura até</label><input id="filter-open-to" type="date" class="form-control" name="aberturaAte" value="@Model.AberturaAte?.ToString("yyyy-MM-dd")" /></div>}
        <div class="col-md-2"><label class="form-label" for="filter-size">Itens</label><select id="filter-size" class="form-select" name="tamanho">@foreach(var size in new[]{25,50,100}){<option value="@size" selected="@(Model.Tamanho == size)">@size</option>}</select></div>
        <div class="col-md-2"><button class="sigov-btn sigov-btn--primary w-100" type="submit">Aplicar</button></div>
      </div>
    </form>
  }
  @if(isPending && Model.Indicadores is { } totals){<section class="row g-2 mb-3" aria-label="Indicadores do conjunto autorizado e filtrado"><div class="col-6 col-lg"><div class="central-panel"><strong>@totals.TotalFiltrado</strong><div>Total filtrado</div></div></div><div class="col-6 col-lg"><div class="central-panel"><strong>@totals.Vencidas</strong><div>Vencidas</div></div></div><div class="col-6 col-lg"><div class="central-panel"><strong>@totals.PrazoFuturo</strong><div>Prazo futuro</div></div></div><div class="col-6 col-lg"><div class="central-panel"><strong>@totals.SemPrazo</strong><div>Sem prazo</div></div></div><div class="col-6 col-lg"><div class="central-panel"><strong>@totals.NaoAtribuidas</strong><div>Não atribuídas</div></div></div></section>}
  <section class="central-panel central-panel--wide">
    <div class="d-flex justify-content-between align-items-center mb-3"><span>Conjunto autorizado @(isPending ? "e filtrado" : "nesta requisição")</span><span class="sigov-status-pill sigov-status-pill--info">@(isPending ? Model.Total : Model.Itens.Count) item(ns)</span></div>
    @if (Model.Itens.Count == 0)
    {
      <div class="sigov-empty-state-premium"><sigov-icon name="success" size="34" /><strong>Nenhum resultado para os filtros</strong><span>A consulta foi executada no contexto ativo. Ajuste os filtros ou atualize a página.</span></div>
    }
    else
    {
      <div class="table-responsive"><table class="table"><thead><tr><th>Módulo/origem</th><th>Ocorrência e motivo</th><th>Classificação</th><th>Status</th>@if(isPending){<th>Responsável / prazo</th>}<th>Ação</th></tr></thead><tbody>
      @foreach (var item in Model.Itens) { var vencida=isPending && item.Prazo.HasValue && item.Prazo.Value < DateTimeOffset.UtcNow && item.Status is "ABERTA" or "EM_TRATAMENTO"; <tr><td>@item.Modulo</td><td><strong>@item.Titulo</strong>@if(!string.IsNullOrWhiteSpace(item.Motivo)){<div class="small text-muted">@item.Motivo</div>}@if(item.Abertura.HasValue){<div class="small">Aberta em @item.Abertura.Value.ToLocalTime().ToString("g")</div>}@if(item.VerificadoEm.HasValue){<div class="small">Última verificação: @item.VerificadoEm.Value.ToLocalTime().ToString("g")</div>}</td><td>@item.Classificacao</td><td><span class="sigov-status-pill sigov-status-pill--info">@item.Status.Replace('_',' ')</span></td>@if(isPending){<td><strong>@item.Responsavel</strong><br/><small class="@(vencida ? "text-danger fw-bold" : "")">@(item.Prazo?.ToLocalTime().ToString("g") ?? "Sem prazo definido") @(vencida ? "— vencida" : "")</small></td>}<td>@if ((isPending || isQuality) && item.Id > 0) { <a class="sigov-btn sigov-btn--primary sigov-btn--sm" asp-action="Detalhe" asp-route-tipo="@Model.Tipo" asp-route-id="@item.Id" asp-route-retorno="@Context.Request.Path@Context.Request.QueryString">@(item.Status is "RESOLVIDA" or "CANCELADA" ? "Consultar histórico" : "Acompanhar")</a> } else if (!string.IsNullOrWhiteSpace(item.Rota)) { <a class="sigov-btn sigov-btn--ghost sigov-btn--sm" href="@item.Rota">Abrir ação</a> } else { <span title="Não existe ação autorizada configurada para esta ocorrência">Sem ação aplicável</span> }</td></tr> }
      </tbody></table></div>
      <nav class="d-flex justify-content-between mt-3" aria-label="Paginação"><a class="sigov-btn sigov-btn--ghost @(Model.Pagina <= 1 ? "disabled" : "")" aria-disabled="@(Model.Pagina <= 1)" href="?visao=@Model.Visao&modulo=@Uri.EscapeDataString(Model.Modulo ?? "")&@(isQuality ? "severidade" : "gravidade")=@Uri.EscapeDataString(Model.Classificacao ?? "")&situacao=@Model.Situacao&prazo=@Model.Prazo&pagina=@(Math.Max(1,Model.Pagina-1))&tamanho=@Model.Tamanho">Anterior</a><span>Página @Model.Pagina</span><a class="sigov-btn sigov-btn--ghost @(!(isPending ? Model.TemProximaPagina : Model.Itens.Count >= Model.Tamanho) ? "disabled" : "")" aria-disabled="@(!(isPending ? Model.TemProximaPagina : Model.Itens.Count >= Model.Tamanho))" href="?visao=@Model.Visao&modulo=@Uri.EscapeDataString(Model.Modulo ?? "")&@(isQuality ? "severidade" : "gravidade")=@Uri.EscapeDataString(Model.Classificacao ?? "")&situacao=@Model.Situacao&prazo=@Model.Prazo&pagina=@(Model.Pagina+1)&tamanho=@Model.Tamanho">Próxima</a></nav>
    }
  </section>
}
