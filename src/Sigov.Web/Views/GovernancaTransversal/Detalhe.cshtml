@model Sigov.Web.Models.Governanca.GovernancaOcorrenciaViewModel
@{ ViewData["Title"] = "Tratar ocorrência"; var o = Model.Ocorrencia; }
<header class="sigov-page-hero"><div><span class="sigov-eyebrow">Governança transversal</span><h1>@o.Titulo</h1><p>Entenda a condição, atribua o trabalho, corrija na origem e revalide o resultado.</p></div></header>
<nav aria-label="Breadcrumb" class="mt-3"><a href="@(Model.Retorno ?? (o.Tipo == "qualidade" ? "/Governanca/QualidadeDados" : "/Pendencias"))">← Voltar à listagem</a></nav>

<details class="central-panel central-panel--wide my-3" open>
 <summary><strong>Como funciona esta jornada</strong></summary>
 <div class="mt-3"><p><strong>Para que serve:</strong> coordenar a correção sem substituir o cadastro de origem.</p><p><strong>Pré-requisitos:</strong> contexto ativo e permissões de visualização, atribuição e, quando aplicável, revalidação.</p><p><strong>Regras importantes:</strong> atribuir não concede acesso ao registro. “Corrigir na origem” apenas navega; somente uma verificação nova da fonte pode concluir a ocorrência. Falha ou bloqueio não significa condição corrigida. Recorrência cria novo episódio e preserva o histórico anterior.</p><p><strong>Próximo passo:</strong> atribua, use a rota validada da origem e volte para revalidar.</p></div>
</details>

@if (TempData["Toast"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if(Model.Conflito){<div class="alert alert-warning" role="alert" tabindex="-1"><strong>Revisão obrigatória:</strong> o registro foi alterado depois do envio. O estado atual está exibido abaixo; confira responsável, situação e versão antes de decidir por uma nova tentativa.</div>}

<div class="row g-3">
 <section class="col-lg-8"><div class="central-panel h-100"><h2 class="h4">Ocorrência</h2><dl class="row">
  <dt class="col-sm-4">Módulo</dt><dd class="col-sm-8">@o.Modulo</dd><dt class="col-sm-4">Registro de origem</dt><dd class="col-sm-8">@o.Entidade #@o.EntidadeId</dd>
  <dt class="col-sm-4">Regra ou motivo</dt><dd class="col-sm-8">@o.RegraOuMotivo</dd><dt class="col-sm-4">Evidência autorizada</dt><dd class="col-sm-8">@o.Descricao</dd>
  <dt class="col-sm-4">Situação</dt><dd class="col-sm-8">@o.Status — @(o.UltimoResultado ?? "Ainda não verificada")</dd><dt class="col-sm-4">Prazo</dt><dd class="col-sm-8">@(o.Prazo?.ToLocalTime().ToString("g") ?? "Sem prazo definido")</dd>
  <dt class="col-sm-4">Responsável</dt><dd class="col-sm-8">@(o.ResponsavelNome ?? "Não atribuído")</dd><dt class="col-sm-4">Abertura</dt><dd class="col-sm-8">@o.DetectadaEm.ToLocalTime().ToString("g")</dd><dt class="col-sm-4">Último evento</dt><dd class="col-sm-8">@(o.Historico.FirstOrDefault()?.OcorridoEm.ToLocalTime().ToString("g") ?? "Sem evento de tratamento")</dd><dt class="col-sm-4">Encerramento</dt><dd class="col-sm-8">@(o.Status is "RESOLVIDA" or "CANCELADA" ? (o.Historico.FirstOrDefault()?.OcorridoEm.ToLocalTime().ToString("g") ?? "Data não disponível no histórico legado") : "Em aberto")</dd><dt class="col-sm-4">Última verificação</dt><dd class="col-sm-8">@(o.VerificadaEm?.ToLocalTime().ToString("g") ?? "Não verificada")</dd>
 </dl>@if (!string.IsNullOrWhiteSpace(o.RotaOrigem)) { <a class="sigov-btn sigov-btn--primary" href="@o.RotaOrigem">Corrigir na origem</a> } else { <p class="alert alert-warning">O módulo não publicou uma rota de correção segura.</p> }</div></section>
 <aside class="col-lg-4"><div class="central-panel"><h2 class="h4">Responsabilidade</h2>@if(Model.PodeAtribuir && (o.Status is "ABERTA" or "EM_TRATAMENTO" or "EM_CORRECAO")){<form method="get" asp-action="Detalhe" asp-route-tipo="@o.Tipo" asp-route-id="@o.Id" class="mb-3" role="search"><input type="hidden" name="retorno" value="@Model.Retorno"/><label class="form-label" for="buscaResponsavel">Pesquisar pessoa ou login</label><div class="input-group"><input class="form-control" id="buscaResponsavel" name="buscaResponsavel" value="@Model.BuscaResponsavel" maxlength="120"/><button class="sigov-btn sigov-btn--ghost" type="submit">Buscar</button></div></form><form asp-action="Atribuir" asp-route-tipo="@o.Tipo" asp-route-id="@o.Id" method="post" data-prevent-double-submit>
  <input type="hidden" name="versao" value="@o.Versao"/><input type="hidden" name="retorno" value="@Model.Retorno"/>
  <div class="mb-3"><label class="form-label" for="responsavelUsuarioId">Pessoa responsável <span aria-label="obrigatório">*</span></label><select class="form-select" id="responsavelUsuarioId" name="responsavelUsuarioId" required><option value="">Selecione pelo nome</option>@foreach(var pessoa in Model.Responsaveis){<option value="@pessoa.UsuarioId" selected="@(pessoa.UsuarioId == (Model.ResponsavelInformado ?? o.ResponsavelUsuarioId))">@pessoa.Nome@(string.IsNullOrWhiteSpace(pessoa.Unidade) ? "" : $" — {pessoa.Unidade}") — @pessoa.Situacao</option>}</select><div class="form-text">Somente vínculos ativos e elegíveis no contexto são exibidos e a elegibilidade será revalidada no envio.</div>@if(!Model.ResponsavelInformadoElegivel){<div class="alert alert-warning mt-2">A pessoa selecionada perdeu a elegibilidade neste contexto. A justificativa foi preservada; selecione outra pessoa para continuar.</div>}</div>
  @if(Model.PaginaResponsavel > 1 || Model.TemProximaPaginaResponsavel){<nav class="d-flex justify-content-between mb-3" aria-label="Páginas de responsáveis"><a class="sigov-btn sigov-btn--ghost sigov-btn--sm @(Model.PaginaResponsavel <= 1 ? "disabled" : "")" aria-disabled="@(Model.PaginaResponsavel <= 1)" asp-action="Detalhe" asp-route-tipo="@o.Tipo" asp-route-id="@o.Id" asp-route-retorno="@Model.Retorno" asp-route-buscaResponsavel="@Model.BuscaResponsavel" asp-route-paginaResponsavel="@(Math.Max(1, Model.PaginaResponsavel - 1))">Anterior</a><span>Página @Model.PaginaResponsavel</span><a class="sigov-btn sigov-btn--ghost sigov-btn--sm @(!Model.TemProximaPaginaResponsavel ? "disabled" : "")" aria-disabled="@(!Model.TemProximaPaginaResponsavel)" asp-action="Detalhe" asp-route-tipo="@o.Tipo" asp-route-id="@o.Id" asp-route-retorno="@Model.Retorno" asp-route-buscaResponsavel="@Model.BuscaResponsavel" asp-route-paginaResponsavel="@(Model.PaginaResponsavel + 1)">Próxima</a></nav>}
  <div class="mb-3"><label class="form-label" for="justificativa">Justificativa <span aria-label="obrigatório">*</span></label><textarea class="form-control" id="justificativa" name="justificativa" maxlength="1000" required data-draft-key="@Model.DraftKey">@Model.JustificativaInformada</textarea></div>@if(Model.Conflito){<div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="confirmarRevisao" required/><label class="form-check-label" for="confirmarRevisao">Revisei o estado atual e quero formular uma nova tentativa.</label></div>}<button class="sigov-btn sigov-btn--primary w-100" type="submit" disabled="@(!Model.ResponsavelInformadoElegivel)">Atribuir ou redistribuir</button>
 </form>}else{<p class="alert alert-info">Atribuição indisponível para seu perfil ou para a situação atual. A leitura não concede permissão de alteração.</p>}
 @if(o.Tipo == "qualidade") { <hr/><p class="alert alert-warning">Verificação automática indisponível para esta regra. A correção deve ocorrer na origem e o estado não será alterado sem um verificador tipado.</p> }
 </div></aside>
</div>
<section class="central-panel central-panel--wide mt-3"><h2 class="h4">Histórico de negócio</h2>@if(o.Historico.Count == 0){<p>Nenhum evento de tratamento registrado; autor e data não são inferidos para dados legados.</p>}else{<ol>@foreach(var h in o.Historico){<li class="mb-2"><strong>@h.Evento.Replace('_',' ')</strong> — @h.OcorridoEm.ToLocalTime().ToString("g") @if(!string.IsNullOrWhiteSpace(h.UsuarioNome)){<span>por @h.UsuarioNome</span>}@if(!string.IsNullOrWhiteSpace(h.Justificativa)){<div>@h.Justificativa</div>}</li>}</ol>}</section>
<script nonce="@Context.Items["CspNonce"]">(()=>{const field=document.querySelector('[data-draft-key]');if(!field)return;const key=field.dataset.draftKey;if(@(TempData["Toast"] is string ? "true" : "false")){sessionStorage.removeItem(key);return;}if(!field.value)field.value=sessionStorage.getItem(key)||'';field.addEventListener('input',()=>sessionStorage.setItem(key,field.value));field.form?.addEventListener('submit',()=>sessionStorage.setItem(key,field.value));})();</script>
