@{ ViewData["Title"] = "Tipos de cadastro tributário"; }
<section class="container-fluid py-3"><h1 class="h3">Tipos de cadastro</h1><p class="text-muted">Cadastros parametrizáveis: Contribuinte, Imóvel e Econômico.</p><div id="loading"><span class="spinner-border spinner-border-sm"></span> Carregando...</div><div id="alerta" class="alert d-none"></div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Código</th><th>Nome</th><th>Descrição</th><th>Status</th></tr></thead><tbody id="rows"></tbody></table></div></section>
@section Scripts{<script>(async()=>{const a=alerta;function show(t,m){a.className='alert alert-'+t;a.textContent=m;}try{const r=await fetch('/api/tributario/tipos-cadastro'); if(!r.ok) throw new Error('API indisponível'); const j=await r.json(); rows.innerHTML=(j.data||[]).map(x=>`<tr><td>${x.codigo}</td><td>${x.nome}</td><td>${x.descricao||''}</td><td>${x.ativo?'Ativo':'Inativo'}</td></tr>`).join('');}catch(e){show('danger',e.message);}finally{loading.classList.add('d-none');}})();</script>}
