@{ ViewData["Title"] = "Relatórios Fiscais"; }
<partial name="~/Views/Shared/_Breadcrumb.cshtml" />
<div class="d-flex justify-content-between align-items-center mb-3" data-module="tributario" data-permission="tributario.livro_eletronico.visualizar">
  <div>
    <h1>Relatórios Fiscais</h1>
    <p class="text-muted mb-0">Relatórios consolidados paginados e filtráveis com versão e histórico.</p>
  </div>
  <span class="badge text-bg-primary">Pós-Build 08</span>
</div>
<section class="row g-3 mb-3">
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="text-muted">Relatórios</span><h3>0</h3></div></div></div>
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="text-muted">Filtros</span><h3>0</h3></div></div></div>
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="text-muted">Versões</span><h3>0</h3></div></div></div>
  <div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="text-muted">Auditoria</span><h3>0</h3></div></div></div>
</section>
<section class="card shadow-sm mb-3">
  <div class="card-body">
    <form class="row g-3 sigov-form" data-api="/api/tributario/livro-eletronico" data-tenant-required="true">
      @Html.AntiForgeryToken()
      <div class="col-md-3"><label class="form-label">Busca</label><input class="form-control" name="busca" placeholder="Inscrição, número ou contribuinte" /></div>
      <div class="col-md-2"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">Todos</option><option>ABERTO</option><option>EMITIDO</option><option>PAGA</option><option>SIMULADA</option></select></div>
      <div class="col-md-2"><label class="form-label">Página</label><input class="form-control" name="page" type="number" value="1" min="1" /></div>
      <div class="col-md-2"><label class="form-label">Itens</label><input class="form-control" name="pageSize" type="number" value="20" min="1" max="100" /></div>
      <div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Filtrar</button><button class="btn btn-outline-secondary" type="button" data-action="exportar">Exportar relatório</button></div>
    </form>
  </div>
</section>
<section class="card shadow-sm">
  <div class="card-body">
    <h2 class="h5">Registros paginados e auditáveis</h2>
    <p class="text-muted">Todas as operações aplicam tenant_id, permissões declaradas, LGPD para dados pessoais, correlationId e histórico fiscal.</p>
    <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Identificador</th><th>Descrição</th><th>Status</th><th>Vencimento/Competência</th><th>Valor</th></tr></thead><tbody><tr><td colspan="5" class="text-muted">Dados carregados via /api/tributario/livro-eletronico.</td></tr></tbody></table></div>
  </div>
</section>
@section Scripts { <script src="~/js/modules/tributario.avancado.js"></script> }
