@model Sigov.Application.Tributario.ReceitaMunicipal.TributarioLinha
@{ViewData["Title"]="Validar certidão";}<h1 class="h3">Validação de certidão tributária</h1><form method="get" class="row g-2"><div class="col-md-4"><label class="form-label">Tenant</label><input class="form-control" name="tenantId" value="@Context.Request.Query["tenantId"]" required /></div><div class="col-md-4"><label class="form-label">Entidade</label><input class="form-control" name="entidadeId" value="@Context.Request.Query["entidadeId"]" required /></div><div class="col-md-4"><label class="form-label">Código interno</label><input class="form-control" name="codigo" value="@Context.Request.Query["codigo"]" required /></div><div><button class="btn btn-primary">Validar</button></div></form>@if(Context.Request.Query.ContainsKey("codigo")){if(Model is null){<div class="alert alert-danger mt-3">Certidão não localizada neste contexto.</div>}else{<div class="alert alert-success mt-3"><strong>@Model.Status</strong> — tipo @Model.Descricao, emitida em @Model.CriadoEm.ToString("g").</div>}}
