@{ ViewData["Title"] = "Econômicos"; }
<section class="container-fluid py-3"><h1 class="h3">Econômicos</h1><p class="text-muted">Cadastro econômico/mobiliário base por tenant.</p><div id="alerta" class="alert d-none"></div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Inscrição</th><th>Nome fantasia</th><th>Atividade</th><th>Status</th></tr></thead><tbody id="rows"></tbody></table></div></section>
@section Scripts{<script>(async()=>{const alerta=document.getElementById('alerta');try{const r=await fetch('/api/tributario/economicos'); if(!r.ok) throw new Error('API indisponível'); const j=await r.json(); rows.innerHTML=(j.data||[]).map(x=>`<tr><td>${x.inscricao}</td><td>${x.nome_fantasia||''}</td><td>${x.atividade_principal||''}</td><td>${x.ativo?'Ativo':'Inativo'}</td></tr>`).join('');}catch(e){alerta.className='alert alert-danger';alerta.textContent=e.message;}})();</script>}
