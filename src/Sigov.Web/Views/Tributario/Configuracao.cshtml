@{ ViewData["Title"] = "Configuração Tributária"; }
<section class="container-fluid py-3"><h1 class="h3">Configuração Tributária</h1><p class="text-muted">Máscaras e integrações iniciais do módulo tributário parametrizável.</p><div id="alerta" class="alert d-none"></div><div class="card"><div class="card-body row g-3"><div class="col-md-6"><label class="form-label">Máscara inscrição imobiliária</label><input id="imob" class="form-control"></div><div class="col-md-6"><label class="form-label">Máscara inscrição mobiliária</label><input id="mob" class="form-control"></div><div class="col-md-4 form-check ms-2"><input id="geo" class="form-check-input" type="checkbox"><label class="form-check-label">Usa georreferenciamento</label></div><div class="col-md-4 form-check"><input id="nfse" class="form-check-input" type="checkbox"><label class="form-check-label">Usa integração NFS-e</label></div><div class="col-md-3 form-check"><input id="protesto" class="form-check-input" type="checkbox"><label class="form-check-label">Usa protesto</label></div><div class="col-12"><button id="salvar" class="btn btn-primary">Salvar</button></div></div></div></section>
@section Scripts{<script>(async()=>{const alerta=document.getElementById('alerta'); function show(t,m){alerta.className='alert alert-'+t; alerta.textContent=m;} try{const r=await fetch('/api/tributario/configuracao'); if(r.ok){const d=(await r.json()).data; imob.value=d.inscricao_imobiliaria_mascara||''; mob.value=d.inscricao_mobiliaria_mascara||''; geo.checked=d.usa_georreferenciamento; nfse.checked=d.usa_integracao_nfse; protesto.checked=d.usa_protesto;}}catch(e){show('danger','Não foi possível carregar a configuração. Tente novamente.');} salvar.onclick=async()=>{try{const body={inscricaoImobiliariaMascara:imob.value,inscricaoMobiliariaMascara:mob.value,usaGeorreferenciamento:geo.checked,usaIntegracaoNfse:nfse.checked,usaProtesto:protesto.checked}; const r=await fetch('/api/tributario/configuracao',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); if(!r.ok) throw new Error('falha ao salvar'); show('success','Configuração salva.');}catch(e){show('danger',e.message);}};})();</script>}
