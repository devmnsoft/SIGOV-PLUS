@model Sigov.Web.Models.Tributario.ContribuinteFormViewModel
<form id="tributario-contribuinte-form" class="card card-body sigov-form" method="post" data-api="/api/tributario/contribuintes">
  @Html.AntiForgeryToken()
  <input asp-for="Id" type="hidden" />
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="row g-3">
    <div class="col-md-4"><label asp-for="PessoaId" class="form-label"></label><input asp-for="PessoaId" class="form-control" required /><span asp-validation-for="PessoaId" class="text-danger"></span><div class="form-text">Documento e nome completo ficam mascarados por padrão.</div></div>
    <div class="col-md-4"><label asp-for="InscricaoMunicipal" class="form-label"></label><input asp-for="InscricaoMunicipal" class="form-control" maxlength="40" required /><span asp-validation-for="InscricaoMunicipal" class="text-danger"></span></div>
    <div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label"></label></div></div>
    <div class="col-12"><label asp-for="Observacoes" class="form-label"></label><textarea asp-for="Observacoes" class="form-control" rows="3"></textarea></div>
  </div>
  <partial name="~/Views/Shared/Forms/_FormActions.cshtml" />
</form>
