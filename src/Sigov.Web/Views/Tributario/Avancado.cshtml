@{ ViewData["Title"] = $"{ViewData["Modulo"]} — {ViewData["Pagina"]}"; }
<section class="tax-advanced-shell" data-module="tributario-avancado">
 <header class="tax-premium-header"><div><span class="lgpd-badge">LGPD · acesso auditado</span><h1>@ViewData["Modulo"]</h1><p>@ViewData["Pagina"] · operação multi-tenant com persistência real e integrações externas preparatórias.</p></div><button class="btn btn-primary" type="button" data-sigov-toast="Filtros atualizados">Atualizar painel</button></header>
 <div class="tax-kpi-grid" aria-label="Indicadores"><article class="tax-dashboard-card"><small>Total operacional</small><strong data-tax-kpi="total">—</strong><span>registros do tenant</span></article><article class="tax-dashboard-card"><small>Pendentes</small><strong data-tax-kpi="pending">—</strong><span>exigem acompanhamento</span></article><article class="tax-dashboard-card"><small>Concluídos</small><strong data-tax-kpi="done">—</strong><span>com trilha de auditoria</span></article><article class="tax-dashboard-card"><small>Alertas</small><strong data-tax-kpi="alerts">—</strong><span>prazos e divergências</span></article></div>
 <div class="filter-bar"><label>Busca segura<input class="form-control" type="search" placeholder="Código ou referência (sem documento completo)" /></label><label>Status<select class="form-select"><option>Todos</option><option>Pendente</option><option>Concluído</option></select></label><button class="btn btn-outline-primary" type="button">Filtrar</button></div>
 <div class="responsive-data-table"><table class="table"><thead><tr><th>Código</th><th>Tipo</th><th>Status</th><th>Atualização</th><th>Ações</th></tr></thead><tbody><tr class="empty-state"><td colspan="5"><strong>Nenhum registro para os filtros atuais.</strong><br/><span>Crie ou importe um registro para iniciar o fluxo real.</span></td></tr></tbody></table></div>
 <aside class="audit-timeline"><strong>Governança da operação</strong><ol><li>Tenant e entidade validados</li><li>Dados sensíveis mascarados nas listagens</li><li>CorrelationId e auditoria registrados nas mutações</li></ol></aside>
</section>
