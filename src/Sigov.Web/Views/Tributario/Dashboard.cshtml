@model Sigov.Application.Tributario.ReceitaMunicipal.TributarioDashboard
@{ViewData["Title"]="Dashboard Tributário";var cards=new[]{("Contribuintes ativos",Model.ContribuintesAtivos.ToString()),("Imóveis",Model.Imoveis.ToString()),("Empresas/autônomos",Model.Mobiliarios.ToString()),("Lançamentos do exercício",Model.LancamentosExercicio.ToString()),("Guias emitidas",Model.GuiasEmitidas.ToString()),("Valor lançado",Model.ValorLancado.ToString("C")),("Valor arrecadado",Model.ValorArrecadado.ToString("C")),("Inadimplência",Model.Inadimplencia.ToString("C")),("Dívida ativa",Model.DividaAtiva.ToString("C")),("Parcelamentos ativos",Model.ParcelamentosAtivos.ToString()),("Fiscalizações abertas",Model.FiscalizacoesAbertas.ToString()),("Certidões emitidas",Model.CertidoesEmitidas.ToString())};}
<h1 class="h3">Tributário e Receita Municipal</h1><p class="text-muted">Indicadores calculados em tempo real no PostgreSQL.</p><div class="row g-3 mb-4">@foreach(var c in cards){<div class="col-sm-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted">@c.Item1</div><strong class="fs-4">@c.Item2</strong></div></div></div>}</div>
<h2 class="h5">Alertas operacionais</h2>@if(Model.Alertas.Count==0){<div class="alert alert-success">Não há vencimentos próximos nem inconsistências cadastrais detectadas.</div>}else{<ul class="list-group mb-4">@foreach(var a in Model.Alertas){<li class="list-group-item list-group-item-warning">@a</li>}</ul>}
<div class="d-flex flex-wrap gap-2">@foreach(var x in new[]{("Contribuintes","/Tributario/Contribuintes"),("Imóveis","/Tributario/Imoveis"),("Mobiliário","/Tributario/Mobiliario"),("Lançamentos","/Tributario/Lancamentos"),("Guias","/Tributario/Guias"),("Arrecadação","/Tributario/Arrecadacao"),("Dívida ativa","/Tributario/DividaAtiva"),("Fiscalização","/Tributario/Fiscalizacao"),("Relatórios","/Tributario/Relatorios")}){<a class="btn btn-outline-primary" href="@x.Item2">@x.Item1</a>}</div>
