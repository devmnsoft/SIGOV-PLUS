@{ViewData["Title"]="Relatórios Tributários";var reports=new[]{("Contribuintes","contribuintes"),("Imóveis","imoveis"),("Cadastro mobiliário","mobiliario"),("Lançamentos","lancamentos"),("Guias emitidas","guias"),("Pagamentos/arrecadação","pagamentos"),("Inadimplência (lançamentos)","lancamentos"),("Dívida ativa","divida-ativa"),("Parcelamentos","parcelamentos"),("Fiscalizações","fiscalizacoes"),("Certidões emitidas","certidoes")};}<h1 class="h3">Relatórios CSV</h1><p class="text-muted">Exportações consultam o PostgreSQL no momento da solicitação e são registradas na auditoria.</p><div class="list-group">@foreach(var r in reports){<a class="list-group-item list-group-item-action d-flex justify-content-between" href="/Tributario/Relatorios/@r.Item2.csv"><span>@r.Item1</span><span>Baixar CSV</span></a>}</div>
