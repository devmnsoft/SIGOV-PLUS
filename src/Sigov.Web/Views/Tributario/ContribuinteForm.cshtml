@model Sigov.Application.Tributario.ReceitaMunicipal.ContribuinteRequest
@{ViewData["Title"]="Novo contribuinte";}
<h1 class="h3">Novo contribuinte</h1><p class="text-muted">Os dados pessoais são utilizados exclusivamente para administração tributária, com acesso auditado.</p><form method="post" novalidate><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-3"><label class="form-label" for="TipoPessoa">Tipo</label><select class="form-select" asp-for="TipoPessoa" required><option value="F">Pessoa física</option><option value="J">Pessoa jurídica</option></select></div><div class="col-md-4"><label class="form-label" for="Documento">CPF/CNPJ</label><input class="form-control" asp-for="Documento" maxlength="18" required /></div><div class="col-md-5"><label class="form-label" for="NomeRazaoSocial">Nome/Razão social</label><input class="form-control" asp-for="NomeRazaoSocial" maxlength="250" required /></div><div class="col-md-4"><label class="form-label" for="NomeFantasia">Nome fantasia</label><input class="form-control" asp-for="NomeFantasia" maxlength="180" /></div><div class="col-md-4"><label class="form-label" for="InscricaoMunicipal">Inscrição municipal</label><input class="form-control" asp-for="InscricaoMunicipal" maxlength="40" /></div><div class="col-md-4"><label class="form-label" for="Situacao">Situação</label><select class="form-select" asp-for="Situacao"><option>ATIVO</option><option>SUSPENSO</option><option>BAIXADO</option></select></div><div class="col-md-6"><label class="form-label" for="Email">E-mail</label><input class="form-control" type="email" asp-for="Email" /></div><div class="col-md-6"><label class="form-label" for="Telefone">Telefone</label><input class="form-control" asp-for="Telefone" /></div><div class="col-md-6"><label class="form-label" for="Logradouro">Logradouro</label><input class="form-control" asp-for="Logradouro" /></div><div class="col-md-2"><label class="form-label" for="Numero">Número</label><input class="form-control" asp-for="Numero" /></div><div class="col-md-4"><label class="form-label" for="Bairro">Bairro</label><input class="form-control" asp-for="Bairro" /></div></div><div class="mt-4"><button class="btn btn-primary" type="submit">Salvar contribuinte</button><a class="btn btn-link" href="/Tributario/Contribuintes">Cancelar</a></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
