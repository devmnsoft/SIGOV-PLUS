@{ ViewData["Title"] = "Imóveis"; }
<section class="container-fluid py-3"><h1 class="h3">Imóveis</h1><p class="text-muted">Cadastro imobiliário base por tenant.</p><div id="alerta" class="alert d-none"></div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Inscrição</th><th>Área terreno</th><th>Área construída</th><th>Status</th></tr></thead><tbody id="rows"></tbody></table></div></section>
@section Scripts{<script>(async()=>{const alerta=document.getElementById('alerta');try{const r=await fetch('/api/tributario/imoveis'); if(!r.ok) throw new Error('API indisponível'); const j=await r.json(); rows.innerHTML=(j.data||[]).map(x=>`<tr><td>${x.inscricao}</td><td>${x.area_terreno??''}</td><td>${x.area_construida??''}</td><td>${x.ativo?'Ativo':'Inativo'}</td></tr>`).join('');}catch(e){alerta.className='alert alert-danger';alerta.textContent=e.message;}})();</script>}
