@{ ViewData["Title"] = "Campos dinâmicos tributários"; }
<section class="container-fluid py-3"><h1 class="h3">Campos dinâmicos</h1><p class="text-muted">Campos parametrizáveis por tipo de cadastro.</p><div id="alerta" class="alert d-none"></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Tipo</th><th>Código</th><th>Nome</th><th>Formato</th><th>Obrigatório</th><th>Ordem</th></tr></thead><tbody id="rows"></tbody></table></div></section>
@section Scripts{<script>(async()=>{const alerta=document.getElementById('alerta');function show(t,m){alerta.className='alert alert-'+t;alerta.textContent=m;}try{const r=await fetch('/api/tributario/campos-dinamicos'); if(!r.ok) throw new Error('API indisponível'); const j=await r.json(); rows.innerHTML=(j.data||[]).map(x=>`<tr><td>${x.tipo_cadastro_codigo}</td><td>${x.codigo}</td><td>${x.nome}</td><td>${x.tipo}</td><td>${x.obrigatorio?'Sim':'Não'}</td><td>${x.ordem}</td></tr>`).join('');}catch(e){show('danger',e.message);}})();</script>}
