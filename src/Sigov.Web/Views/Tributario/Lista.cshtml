@model Sigov.Application.Tributario.ReceitaMunicipal.TributarioPagina
@{ var titulo=(string?)ViewData["Title"]??"Tributário"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3">@titulo</h1><p class="text-muted">Dados oficiais do cadastro tributário municipal.</p></div>@if(Model.Recurso=="contribuintes"){<a class="btn btn-primary" href="/Tributario/Contribuintes/Novo">Novo contribuinte</a>}</div>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><label class="form-label" for="busca">Busca</label><input class="form-control" id="busca" name="busca" value="@Context.Request.Query["busca"]" /></div><div class="col-md-3"><label class="form-label" for="status">Situação</label><input class="form-control" id="status" name="status" value="@Context.Request.Query["status"]" /></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Filtrar</button></div></form>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th class="text-end">Valor</th><th>Cadastro</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge text-bg-secondary">@x.Status</span></td><td class="text-end">@(x.Valor?.ToString("C")??"—")</td><td>@x.CriadoEm.ToLocalTime().ToString("g")</td></tr>}@if(Model.Items.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum registro encontrado para os filtros informados.</td></tr>}</tbody></table></div>
<nav aria-label="Paginação"><span class="text-muted">Página @Model.Pagina · @Model.Total registro(s)</span>@if(Model.Pagina>1){<a class="btn btn-sm btn-outline-secondary ms-2" href="?pagina=@(Model.Pagina-1)">Anterior</a>}@if(Model.Pagina*Model.Tamanho<Model.Total){<a class="btn btn-sm btn-outline-secondary ms-2" href="?pagina=@(Model.Pagina+1)">Próxima</a>}</nav>
