@{
    ViewData["Title"] = "SaaS Admin - Planos";
}
<section class="sigov-page-header d-flex justify-content-between align-items-start gap-3 mb-4" data-sigov-role="SIGOV_ADMIN">
  <div><span class="badge text-bg-warning mb-2">SaaS Admin</span><h1 class="h2">Planos</h1><p class="text-muted">Painel global exclusivo para SIGOV_ADMIN com auditoria, tenant isolation e bloqueio de tenant suspenso/cancelado.</p></div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#saas-modal">Nova ação</button>
</section>
<div class="row g-3 mb-3"><div class="col-md-3"><div class="card card-body"><small class="text-muted">Ativos</small><strong>24</strong></div></div><div class="col-md-3"><div class="card card-body"><small class="text-muted">Suspensos</small><strong>2</strong></div></div><div class="col-md-3"><div class="card card-body"><small class="text-muted">Homologação</small><strong>5</strong></div></div><div class="col-md-3"><div class="card card-body"><small class="text-muted">Uso mensal</small><strong>Isolado</strong></div></div></div>
<div class="card sigov-grid"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Tenant/Plano</th><th>Domínio</th><th>Status</th><th>Módulos/Features</th><th class="text-end">Ações</th></tr></thead><tbody><tr><td>Município Comercial</td><td>municipio.sigov.local <span class="badge text-bg-info">Verificado</span></td><td><span class="badge text-bg-success">Ativo</span> <span class="badge text-bg-secondary">Implantação</span></td><td><span class="badge text-bg-primary">Core</span> <span class="badge text-bg-primary">Segurança</span> <span class="badge text-bg-primary">LGPD</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/SaasAdmin/TenantDetalhe">Detalhar</a> <button class="btn btn-sm btn-outline-warning">Suspender</button></td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between"><small>Uso mensal nunca mistura tenants; plano, módulos e flags auditam antes/depois.</small><ul class="pagination pagination-sm mb-0"><li class="page-item active"><span class="page-link">1</span></li></ul></div></div>
<div class="modal fade" id="saas-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5 modal-title">Ação SaaS Admin</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label class="form-label" for="Justificativa">Justificativa</label><textarea id="Justificativa" name="Justificativa" class="form-control" required></textarea></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Confirmar</button></div></form></div></div>
@section Scripts { <script src="~/js/modules/saas.planos.js"></script> }
