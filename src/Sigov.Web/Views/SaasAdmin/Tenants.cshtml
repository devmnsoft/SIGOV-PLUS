@model Sigov.Application.Saas.SuperAdmin.SaasTenantListPage
@{
    ViewData["Title"] = "SaaS Admin - Organizações";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var esfera = ViewBag.Esfera as string;
}
<section class="sigov-page-header d-flex justify-content-between align-items-start gap-3 mb-4" data-sigov-role="SIGOV_ADMIN">
  <div>
    <span class="badge text-bg-warning mb-2">SaaS Admin</span>
    <h1 class="h2">Organizações</h1>
    <p class="text-muted">Lista canônica de tenants com status, esfera, entidades, usuários ativos, módulos contratados e última atividade.</p>
  </div>
</section>
@if (TempData["SaasAdminError"] is string listError)
{
  <div class="alert alert-danger" role="alert">@listError</div>
}
@if (TempData["SaasAdminSuccess"] is string listSuccess)
{
  <div class="alert alert-success" role="alert">@listSuccess</div>
}
<form method="get" class="card card-body mb-3" aria-label="Filtro de organizações">
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <label class="form-label" for="search">Busca</label>
      <input id="search" name="search" class="form-control" value="@search" placeholder="Nome ou slug" />
    </div>
    <div class="col-md-3">
      <label class="form-label" for="status">Status</label>
      <input id="status" name="status" class="form-control" value="@status" placeholder="ATIVO, SUSPENSO..." />
    </div>
    <div class="col-md-3">
      <label class="form-label" for="esfera">Esfera</label>
      <input id="esfera" name="esfera" class="form-control" value="@esfera" placeholder="municipal, estadual, federal" />
    </div>
    <div class="col-md-2">
      <button class="btn btn-primary w-100" type="submit">Filtrar</button>
    </div>
  </div>
</form>
@if (Model.Total == 0)
{
  <div class="alert alert-info" role="status">Nenhuma organização encontrada para os filtros informados.</div>
}
else
{
  <div class="card sigov-grid">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Organização</th>
            <th>Status</th>
            <th>Esfera</th>
            <th>Entidades</th>
            <th>Usuários ativos</th>
            <th>Módulos</th>
            <th>Última atividade</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var tenant in Model.Items)
        {
          <tr>
            <td>
              <strong>@tenant.Name</strong>
              @if (!string.IsNullOrWhiteSpace(tenant.Plan)) { <div class="small text-muted">@tenant.Plan</div> }
            </td>
            <td><span class="badge text-bg-secondary">@tenant.Status</span></td>
            <td>@tenant.Esfera</td>
            <td>@tenant.Entities</td>
            <td>@tenant.ActiveUsers</td>
            <td>@tenant.Modules</td>
            <td>@(tenant.LastActivityUtc?.ToString("g") ?? "Sem registro")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/SaasAdmin/TenantDetalhe?id=@tenant.Id">Abrir</a></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <small>@Model.Total organizações · página @Model.Page</small>
      <ul class="pagination pagination-sm mb-0">
        @if (Model.Page > 1)
        {
          <li class="page-item"><a class="page-link" href="/SaasAdmin/Tenants?search=@search&amp;status=@status&amp;esfera=@esfera&amp;page=@(Model.Page - 1)">Anterior</a></li>
        }
        <li class="page-item active"><span class="page-link">@Model.Page</span></li>
        @if (Model.Page * Model.PageSize < Model.Total)
        {
          <li class="page-item"><a class="page-link" href="/SaasAdmin/Tenants?search=@search&amp;status=@status&amp;esfera=@esfera&amp;page=@(Model.Page + 1)">Próxima</a></li>
        }
      </ul>
    </div>
  </div>
}
