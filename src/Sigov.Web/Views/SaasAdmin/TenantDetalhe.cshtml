@model Sigov.Application.Saas.SuperAdmin.SaasTenantDetail
@{
    ViewData["Title"] = "SaaS Admin - " + Model.Name;
    var canManage = ViewBag.CanManageContracts as bool? == true;
}
<section class="sigov-page-header d-flex justify-content-between align-items-start gap-3 mb-4" data-sigov-role="SIGOV_ADMIN">
  <div>
    <span class="badge text-bg-warning mb-2">SaaS Admin</span>
    <h1 class="h2">@Model.Name</h1>
    <p class="text-muted">Entidades, usuários, perfis e contratos vigentes. Catálogo e preço global permanecem exclusivos do SuperAdmin.</p>
  <div class="d-flex gap-2">
    @if (canManage)
    {
      <form method="post" action="/SaasAdmin/Tenants/@Model.Id/AlternarContexto" class="d-inline">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-primary" type="submit" title="Assumir o contexto deste cliente para testes autorizados">
          Alternar Contexto
        </button>
      </form>
      @if (Model.Status == "BLOQUEADO")
      {
        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalDesbloquearTenant">
          Desbloquear Cliente
        </button>
      }
      else
      {
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalBloquearTenant">
          Bloquear Cliente
        </button>
      }
    }
    <a class="btn btn-outline-secondary" href="/SaasAdmin/Tenants">Voltar</a>
  </div>
</section>
@if (TempData["SaasAdminError"] is string error)
{
  <div class="alert alert-danger" role="alert">@error</div>
}
@if (TempData["SaasAdminSuccess"] is string success)
{
  <div class="alert alert-success" role="alert">@success</div>
}
<div class="row g-3 mb-3">
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Status</small><strong>@Model.Status</strong></div></div>
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Esfera</small><strong>@Model.Esfera</strong></div></div>
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Plano</small><strong>@(Model.Plan ?? "Não contratado")</strong></div></div>
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Última atividade</small><strong>@(Model.LastActivityUtc?.ToString("g") ?? "Sem registro")</strong></div></div>
</div>
<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-entidades" role="tab">Entidades</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-usuarios" role="tab">Usuários e perfis</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-contratos" role="tab">Contratos</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-assinatura" role="tab">Assinatura</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-auditoria" role="tab">Auditoria</a></li>
</ul>
<div class="tab-content">
  <div class="tab-pane fade show active" id="tab-entidades" role="tabpanel">
    @if (Model.Entities.Count == 0)
    {
      <div class="alert alert-info" role="status">Nenhuma entidade vinculada.</div>
    }
    else
    {
      <div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Entidade</th><th>Tipo</th><th>Esfera</th></tr></thead><tbody>
      @foreach (var entity in Model.Entities)
      {
        <tr><td>@entity.Name</td><td>@(entity.Type ?? "—")</td><td>@(entity.Esfera ?? "nao_informada")</td></tr>
      }
      </tbody></table></div></div>
    }
  </div>
  <div class="tab-pane fade" id="tab-usuarios" role="tabpanel">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="h5 mb-0">Usuários vinculados</h3>
      @if (canManage)
      {
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovoUsuario">
          + Novo Usuário
        </button>
      }
    </div>
    @if (Model.Users.Count == 0)
    {
      <div class="alert alert-info" role="status">Nenhum usuário neste tenant.</div>
    }
    else
    {
      <div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Usuário</th><th>E-mail</th><th>Perfis</th><th>Status</th>@if (canManage) { <th>Ações</th> }</tr></thead><tbody>
      @foreach (var user in Model.Users)
      {
        <tr>
          <td><strong>@user.Name</strong></td>
          <td>@user.Email</td>
          <td>@(user.Profiles.Count == 0 ? "—" : string.Join(", ", user.Profiles))</td>
          <td>
            @if (user.Blocked)
            {
              <span class="badge bg-danger">Bloqueado</span>
            }
            else if (user.Active)
            {
              <span class="badge bg-success">Ativo</span>
            }
            else
            {
              <span class="badge bg-secondary">Inativo</span>
            }
          </td>
          @if (canManage)
          {
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                @if (user.Blocked)
                {
                  <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Usuarios/@user.Id/Desbloquear" class="d-inline" onsubmit="return confirm('Desbloquear o acesso do usuário @user.Name?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="justification" value="Desbloqueio efetuado pelo SuperAdmin" />
                    <button class="btn btn-outline-success btn-sm" type="submit">Desbloquear</button>
                  </form>
                }
                else
                {
                  <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Usuarios/@user.Id/Bloquear" class="d-inline" onsubmit="return confirm('Bloquear temporariamente o acesso do usuário @user.Name?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="justification" value="Bloqueio administrativo pelo SuperAdmin" />
                    <button class="btn btn-outline-warning btn-sm" type="submit">Bloquear</button>
                  </form>
                }
                @if (user.Active)
                {
                  <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Usuarios/@user.Id/Inativar" class="d-inline ms-1" onsubmit="return confirm('Inativar o cadastro do usuário @user.Name?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="justification" value="Inativação administrativa pelo SuperAdmin" />
                    <button class="btn btn-outline-secondary btn-sm" type="submit">Inativar</button>
                  </form>
                }
              </div>
            </td>
          }
        </tr>
      }
      </tbody></table></div></div>
    }
  </div>
  <div class="tab-pane fade" id="tab-contratos" role="tabpanel">
    @if (Model.Contracts.Count == 0)
    {
      <div class="alert alert-info" role="status">Nenhum contrato de módulo registrado.</div>
    }
    else
    {
      <div class="card mb-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Módulo</th><th>Status</th><th>Vigência</th><th>Plano</th><th>Valor</th><th>Motivo</th>@if (canManage) { <th></th> }</tr></thead><tbody>
      @foreach (var contract in Model.Contracts)
      {
        <tr>
          <td>@contract.ModuleName <span class="text-muted">(@contract.ModuleCode)</span></td>
          <td>@contract.Status</td>
          <td>@(contract.EffectiveFrom?.ToString("d") ?? "—") – @(contract.EffectiveUntil?.ToString("d") ?? "aberta")</td>
          <td>@(contract.PlanCode ?? "—")</td>
          <td>@(contract.ContractedValue?.ToString("N2") ?? "—")</td>
          <td>@(contract.Reason ?? "—")</td>
          @if (canManage)
          {
            <td class="text-end">
              <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Suspender" class="d-inline" onsubmit="return confirm('Suspender @contract.ModuleName para @Model.Name? Novos acessos serão bloqueados imediatamente; a vigência e os dados operacionais serão preservados.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="moduleCode" value="@contract.ModuleCode" />
                <input type="hidden" name="expectedUpdatedAt" value="@contract.UpdatedAt?.ToString("o")" />
                <label class="visually-hidden" for="suspender-@contract.Id">Justificativa para suspender @contract.ModuleName</label>
                <input id="suspender-@contract.Id" name="justification" class="form-control form-control-sm mb-1" required minlength="8" placeholder="Justificativa" />
                <button class="btn btn-sm btn-outline-warning" type="submit">Suspender</button>
              </form>
              <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Reativar" class="d-inline" onsubmit="return confirm('Reativar @contract.ModuleName para @Model.Name agora? A vigência original será preservada e nenhuma cobrança será quitada ou renovada automaticamente.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="moduleCode" value="@contract.ModuleCode" />
                <input type="hidden" name="expectedUpdatedAt" value="@contract.UpdatedAt?.ToString("o")" />
                <label class="visually-hidden" for="reativar-@contract.Id">Justificativa para reativar @contract.ModuleName</label>
                <input id="reativar-@contract.Id" name="justification" class="form-control form-control-sm mb-1" required minlength="8" placeholder="Justificativa" />
                <button class="btn btn-sm btn-outline-success" type="submit">Reativar</button>
              </form>
            </td>
          }
        </tr>
      }
      </tbody></table></div></div>
    }
    @if (canManage)
    {
      <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Contratar" class="card card-body" onsubmit="return confirm('Confirmar a contratação selecionada para @Model.Name? A ativação produz efeito na data informada e depende das permissões de cada usuário.');">
        @Html.AntiForgeryToken()
        <h2 class="h5">Contratar módulo</h2>
        <p class="text-muted">Revise módulo, dependências e vigência. A contratação não concede permissão ao usuário e não inclui dependências silenciosamente.</p>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="moduleCode">Módulo</label>
            <select id="moduleCode" name="moduleCode" class="form-select" required>
              @foreach (var option in Model.Catalog)
              {
                <option value="@option.Code">@option.Name (@option.Code)</option>
              }
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label" for="effectiveFrom">Início</label>
            <input id="effectiveFrom" name="effectiveFrom" type="date" class="form-control" />
          </div>
          <div class="col-md-2">
            <label class="form-label" for="effectiveUntil">Fim</label>
            <input id="effectiveUntil" name="effectiveUntil" type="date" class="form-control" />
          </div>
          <div class="col-md-4">
            <label class="form-label" for="justification">Justificativa</label>
            <textarea id="justification" name="justification" class="form-control" required minlength="8"></textarea>
          </div>
        </div>
        <div class="mt-3"><button class="btn btn-primary" type="submit">Contratar</button></div>
      </form>
    }
  </div>
  <div class="tab-pane fade" id="tab-assinatura" role="tabpanel">
    <div class="card card-body">
      <p class="mb-0">Plano atual: <strong>@(Model.Plan ?? "sem assinatura vigente")</strong>. Alteração de catálogo/preço global é exclusiva do SuperAdmin.</p>
    </div>
  </div>
  <div class="tab-pane fade" id="tab-auditoria" role="tabpanel">
    <div class="card card-body">
      <p class="mb-0">Cada contratação, suspensão, bloqueio e reativação grava auditoria antes/depois, usuário e correlation id. O histórico imutável permanece em tenant_modulo_contratado_historico e sigov.auditoria_evento.</p>
    </div>
  </div>
</div>

@if (canManage)
{
  <div class="modal fade" id="modalBloquearTenant" tabindex="-1" aria-labelledby="lblBloquearTenant" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Bloquear">
          @Html.AntiForgeryToken()
          <div class="modal-header">
            <h5 class="modal-title" id="lblBloquearTenant">Bloquear Cliente</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <p>O bloqueio impede o acesso de todos os usuários deste cliente. A vigência dos contratos e os dados persistidos serão mantidos intactos.</p>
            <div class="mb-3">
              <label for="justBloqueio" class="form-label">Justificativa obrigatória</label>
              <textarea id="justBloqueio" name="justification" class="form-control" required minlength="5" placeholder="Motivo administrativo do bloqueio"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-danger">Confirmar Bloqueio</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalDesbloquearTenant" tabindex="-1" aria-labelledby="lblDesbloquearTenant" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Desbloquear">
          @Html.AntiForgeryToken()
          <div class="modal-header">
            <h5 class="modal-title" id="lblDesbloquearTenant">Desbloquear Cliente</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <p>O desbloqueio reativa o acesso normal para todos os usuários autorizados deste cliente.</p>
            <div class="mb-3">
              <label for="justDesbloqueio" class="form-label">Justificativa</label>
              <textarea id="justDesbloqueio" name="justification" class="form-control" required minlength="5" placeholder="Motivo do desbloqueio"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success">Confirmar Desbloqueio</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalNovoUsuario" tabindex="-1" aria-labelledby="lblNovoUsuario" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="post" action="/SaasAdmin/Tenants/@Model.Id/Usuarios/Criar">
          @Html.AntiForgeryToken()
          <div class="modal-header">
            <h5 class="modal-title" id="lblNovoUsuario">Criar Usuário no Cliente</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label for="novoNome" class="form-label">Nome Completo</label>
              <input id="novoNome" name="name" class="form-control" required maxlength="150" />
            </div>
            <div class="mb-3">
              <label for="novoEmail" class="form-label">E-mail Institucional</label>
              <input id="novoEmail" name="email" type="email" class="form-control" required maxlength="250" />
            </div>
            <div class="mb-3">
              <label for="novoLogin" class="form-label">Login (opcional, padrão: e-mail)</label>
              <input id="novoLogin" name="login" class="form-control" maxlength="100" />
            </div>
            <div class="mb-3">
              <label for="novoPerfil" class="form-label">Código do Perfil Inicial (opcional)</label>
              <input id="novoPerfil" name="perfilCodigo" class="form-control" placeholder="Ex: ADMIN_TENANT, OPERADOR" />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Cadastrar Usuário</button>
          </div>
        </form>
      </div>
    </div>
  </div>
}
