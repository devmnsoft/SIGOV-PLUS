@model Sigov.Application.Saas.SuperAdmin.SuperAdminOperationalDashboard
@{ ViewData["Title"] = "Operação SuperAdmin"; var filter = (Sigov.Application.Saas.SuperAdmin.SuperAdminDashboardFilter)ViewBag.Filter; }
<div class="container-fluid py-3">
 <details class="alert alert-info border-0 shadow-sm mb-3">
  <summary class="fw-semibold">Como usar esta tela</summary>
  <div class="small mt-2">Acompanhe a operação nacional, filtre por período, módulo e status e exporte somente quando sua permissão autorizar. Os indicadores abrangem todos os clientes, mas eventos administrativos e dados de contexto são sensíveis e não devem ser compartilhados fora da MNSOFT.</div>
 </details>
 <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div><h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2"></i>Operação SuperAdmin</h1><small class="text-muted">@ViewBag.Environment · build @ViewBag.Version · check @Model.CheckedAtUtc.ToLocalTime().ToString("g")</small></div>
  <div class="btn-group"><a class="btn btn-outline-secondary" href="/SystemHealth"><i class="bi bi-heart-pulse"></i> Health</a><a class="btn btn-primary" href="@Context.Request.Path@Context.Request.QueryString"><i class="bi bi-arrow-clockwise"></i> Atualizar</a></div>
 </div>
 <form method="get" class="card card-body shadow-sm mb-3"><div class="row g-2 align-items-end">
  <div class="col-6 col-lg-2"><label class="form-label">Tenant</label><input class="form-control" name="tenantId" type="number" min="1" value="@filter.TenantId" /></div>
  <div class="col-6 col-lg-2"><label class="form-label">De</label><input class="form-control" name="from" type="date" value="@filter.FromUtc.ToString("yyyy-MM-dd")" /></div>
  <div class="col-6 col-lg-2"><label class="form-label">Até</label><input class="form-control" name="to" type="date" value="@filter.ToUtc.ToString("yyyy-MM-dd")" /></div>
  <div class="col-6 col-lg-2"><label class="form-label">Módulo</label><input class="form-control" name="module" value="@filter.Module" /></div>
  <div class="col-6 col-lg-2"><label class="form-label">Status</label><input class="form-control" name="status" value="@filter.Status" /></div>
  <div class="col-6 col-lg-2"><button class="btn btn-dark w-100"><i class="bi bi-funnel"></i> Filtrar</button></div>
 </div></form>
 <div class="row g-3 mb-3">
  <div class="col-6 col-xl-2"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><small>Aplicação</small><div class="fw-bold text-success">Operante</div></div></div></div>
  <div class="col-6 col-xl-2"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><small>PostgreSQL</small><div class="fw-bold">@Model.DatabaseStatus</div></div></div></div>
  @foreach(var kpi in Model.Kpis){<div class="col-6 col-xl-2"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><small>@kpi.Label</small><div class="display-6 fw-semibold">@kpi.Value</div><span class="badge text-bg-light">@kpi.Status</span></div></div></div>}
 </div>
 @foreach(var alert in Model.Alerts){<div class="alert alert-@alert.Severity py-2"><i class="bi bi-exclamation-triangle me-2"></i>@alert.Message</div>}
 <div class="row g-3">
  <div class="col-xl-7"><div class="card shadow-sm"><div class="card-header fw-semibold"><i class="bi bi-buildings"></i> Multi-tenant e contexto</div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Tenant</th><th>Status</th><th>Plano</th><th>Módulos</th><th>Domínios</th><th>Contexto</th></tr></thead><tbody>@foreach(var x in Model.Tenants){<tr><td>@x.Id · @x.Name</td><td><span class="badge text-bg-secondary">@x.Status</span></td><td>@(x.Plan??"Não configurado")</td><td>@x.Modules</td><td>@x.Domains</td><td><span class="badge text-bg-@(x.ContextComplete?"success":"warning")">@(x.ContextComplete?"Completo":"Pendente")</span></td></tr>}@if(Model.Tenants.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Nenhum dado disponível.</td></tr>}</tbody></table></div></div></div>
  <div class="col-xl-5"><div class="card shadow-sm"><div class="card-header fw-semibold"><i class="bi bi-activity"></i> Operação técnica</div><ul class="list-group list-group-flush">@foreach(var x in Model.Operations){<li class="list-group-item d-flex justify-content-between"><span>@x.Area <small class="text-muted">@x.Status</small></span><strong>@x.Count</strong></li>}@if(Model.Operations.Count==0){<li class="list-group-item text-muted">Não configurado.</li>}</ul></div></div>
  <div class="col-xl-6"><div class="card shadow-sm"><div class="card-header fw-semibold"><i class="bi bi-shield-check"></i> Autorizações recentes</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Data</th><th>Recurso</th><th>Decisão</th><th>Motivo</th></tr></thead><tbody>@foreach(var x in Model.Authorizations){<tr><td>@x.AtUtc.ToLocalTime().ToString("g")</td><td>@x.Resource · @x.Action</td><td><span class="badge text-bg-@(x.Allowed?"success":"danger")">@(x.Allowed?"Permitir":"Negar")</span></td><td>@x.Reason</td></tr>}@if(Model.Authorizations.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">Sem decisões no período ou schema indisponível.</td></tr>}</tbody></table></div></div></div>
  <div class="col-xl-6"><div class="card shadow-sm"><div class="card-header fw-semibold"><i class="bi bi-arrow-left-right"></i> Trocas de contexto</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Data</th><th>Tenant</th><th>Resultado</th><th>Motivo</th></tr></thead><tbody>@foreach(var x in Model.ContextEvents){<tr><td>@x.AtUtc.ToLocalTime().ToString("g")</td><td>@x.TenantId</td><td>@x.Result</td><td>@x.Reason</td></tr>}@if(Model.ContextEvents.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">Sem eventos no período ou schema indisponível.</td></tr>}</tbody></table></div></div></div>
 </div>
 <div class="d-flex flex-wrap gap-2 mt-3"><a class="btn btn-outline-success" href="@Url.Action("Export",new {format="csv",filter.TenantId,from=filter.FromUtc,to=filter.ToUtc,filter.Module,filter.Status})"><i class="bi bi-filetype-csv"></i> CSV protegido</a><a class="btn btn-outline-primary" href="@Url.Action("Export",new {format="json",filter.TenantId,from=filter.FromUtc,to=filter.ToUtc,filter.Module,filter.Status})">JSON protegido</a><a class="btn btn-link" href="/Seguranca/Permissoes">Segurança</a><a class="btn btn-link" href="/Auditoria">Auditoria</a><a class="btn btn-link" href="/SaasAdmin/Tenants">SaaS Admin</a></div>
</div>
