@using Microsoft.AspNetCore.Authorization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Auth
@{
 var p=Context.Request.Path.Value??"";
 bool Ativo(int grupo,string prefixo,bool raiz)=>raiz?p.TrimEnd('/').Equals("/ComprasEmpresariais",StringComparison.OrdinalIgnoreCase):p.StartsWith(prefixo,StringComparison.OrdinalIgnoreCase);
 var links=new (string Rotulo,string Roteiro,string Politica,string Prefixo,int Grupo,bool Raiz)[]
 {
  ("Visão geral","/ComprasEmpresariais","compras_empresariais.dashboard.visualizar","/ComprasEmpresariais",0,true),
  ("Fornecedores","/ComprasEmpresariais/Fornecedores","compras_empresariais.fornecedores.visualizar","/ComprasEmpresariais/Fornecedores",1,false),
  ("Requisições","/ComprasEmpresariais/Requisicoes","compras_empresariais.requisicoes.visualizar","/ComprasEmpresariais/Requisicoes",2,false),
  ("Aprovações","/ComprasEmpresariais/Aprovacoes","compras_empresariais.aprovacoes.visualizar","/ComprasEmpresariais/Aprovacoes",2,false),
  ("Cotações","/ComprasEmpresariais/Cotacoes","compras_empresariais.cotacoes.visualizar","/ComprasEmpresariais/Cotacoes",3,false),
  ("Pedidos","/ComprasEmpresariais/Pedidos","compras_empresariais.pedidos.visualizar","/ComprasEmpresariais/Pedidos",3,false),
  ("Recebimentos","/ComprasEmpresariais/Recebimentos","compras_empresariais.recebimentos.visualizar","/ComprasEmpresariais/Recebimentos",3,false),
  ("Divergências","/ComprasEmpresariais/Divergencias","compras_empresariais.divergencias.visualizar","/ComprasEmpresariais/Divergencias",3,false),
  ("Faturas","/ComprasEmpresariais/Faturas","compras_empresariais.faturas.visualizar","/ComprasEmpresariais/Faturas",3,false),
  ("Devoluções","/ComprasEmpresariais/Devolucoes","compras_empresariais.devolucoes.visualizar","/ComprasEmpresariais/Devolucoes",3,false),
  ("Avaliações","/ComprasEmpresariais/Avaliacoes","compras_empresariais.avaliacoes.gerenciar","/ComprasEmpresariais/Avaliacoes",4,false),
  ("Relatórios","/ComprasEmpresariais/Relatorios","compras_empresariais.relatorios.visualizar","/ComprasEmpresariais/Relatorios",4,false),
  ("Configurações","/ComprasEmpresariais/Configuracao","compras_empresariais.configuracao.gerenciar","/ComprasEmpresariais/Configuracao",4,false)
 };
 var itens=new List<(string Rotulo,string Roteiro,bool Ativo)>();
 var seps=new List<int>();
 var grupoAtual=-1;
 foreach(var l in links)
 {
  if(!(await Auth.AuthorizeAsync(User,l.Politica)).Succeeded)continue;
  if(itens.Count>0&&l.Grupo!=grupoAtual)seps.Add(itens.Count);
  itens.Add((l.Rotulo,l.Roteiro,Ativo(l.Grupo,l.Prefixo,l.Raiz)));
  grupoAtual=l.Grupo;
 }
}
<nav class="compras-nav" aria-label="Compras Empresariais">@for(var i=0;i<itens.Count;i++)
{
@if(seps.Contains(i))
{
<span class="compras-nav-sep" aria-hidden="true"></span>}
var l=itens[i];<a href="@l.Roteiro" aria-current="@(l.Ativo?"page":null)">@l.Rotulo</a>}
</nav>
