@using Sigov.Application.Common
@using Sigov.Application.ComprasEmpresariais
@model PagedResult<AprovacaoRelatorioLinha>
@{
    ViewData["Title"] = "Relatório de aprovações";
    var totalPages = Math.Max(1, Model.TotalPages);
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">RELATÓRIO DE DECISÕES</span><h1>Relatório de aprovações</h1><p>Etapa por etapa dos ciclos de alçada do contexto autorizado: situação, aprovador, status da requisição, valor e motivos registrados.</p></div><a class="btn btn-outline-primary" asp-action="RelatorioAprovacoesCsv">Exportar CSV</a></header>
<details class="panel mb-3"><summary class="fw-semibold">Ajuda da jornada</summary><div class="mt-3"><p><strong>Para que serve:</strong> auditar as decisões por alçada registradas pela jornada procure-to-pay, em qualquer esfera de governo.</p><p><strong>O que aparece:</strong> uma linha por etapa de ciclo criada no envio, com a alçada do nível, o aprovador designado (ou ausência), a situação da etapa e o motivo registrado quando houver rejeição ou devolução.</p><p><strong>Como exportar:</strong> use Exportar CSV; a exportação cobre o conjunto completo dentro do limite explícito de 50.000 registros e neutraliza fórmulas de planilha.</p></div></details>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Número</th><th>Ciclo</th><th>Etapa</th><th>Alçada</th><th>Situação</th><th>Aprovador</th><th>Status da requisição</th><th>Total</th><th>Criada em</th><th>Decidida em</th><th>Motivo</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Numero</td><td>@x.Ciclo</td><td>@x.Etapa</td><td>@x.Alcada.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@x.SituacaoEtapa.Replace('_',' ')</td><td>@(x.AprovadorSub??"—")</td><td>@x.StatusRequisicao.Replace('_',' ')</td><td>@x.Total.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@x.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(x.DecididaEm is null?"—":x.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td><td><small>@(x.Motivo??"—")</small></td></tr>}</tbody></table></div>@if(Model.Items.Count==0){<div class="empty-state"><h3 class="h5">Nenhuma etapa registrada</h3><p>Ainda não há etapas de ciclo de aprovação neste contexto; nenhum dado fictício é exibido.</p></div>}@if(Model.TotalPages>1){<nav aria-label="Paginação do relatório"><ul class="pagination mt-3 mb-2">@if(Model.HasPreviousPage){<li class="page-item"><a class="page-link" href="?pagina=@(Model.Page-1)&tamanho=@Model.PageSize">Anterior</a></li>}@for(var p=1;p<=totalPages;p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" href="?pagina=@p&tamanho=@Model.PageSize">@p</a></li>}@if(Model.HasNextPage){<li class="page-item"><a class="page-link" href="?pagina=@(Model.Page+1)&tamanho=@Model.PageSize">Próxima</a></li>}</ul></nav>}<p class="form-text mt-1 mb-0">Mostrando @Model.Items.Count de @Model.TotalItems registro(s) dos filtros aplicados (página @Model.Page); a exportação CSV cobre o conjunto completo dentro do limite explícito de 50.000 registros.</p></section>
