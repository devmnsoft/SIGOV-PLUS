@model Sigov.Application.Common.PagedResult<Sigov.Application.ComprasEmpresariais.RequisicaoResumo>
@{ViewData["Title"]="Requisições";}<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" /><header class="compras-header"><div><h1>Requisições</h1><p>Necessidades, aprovações e rastreabilidade.</p></div><a class="btn btn-primary" href="/ComprasEmpresariais/Requisicoes/Nova">Nova requisição</a></header><div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Status</th><th>Itens</th><th>Total</th><th>Data necessária</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Numero</td><td>@x.Status</td><td>@x.Itens</td><td>@x.ValorEstimado.ToString("C")</td><td>@x.DataNecessaria</td></tr>}</tbody></table></div>
