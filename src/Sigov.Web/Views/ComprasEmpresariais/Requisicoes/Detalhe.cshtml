@model Sigov.Application.ComprasEmpresariais.RequisicaoDetalhe
@{ViewData["Title"]=$"Requisição {Model.Numero}";}<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" /><header class="compras-header"><div><span class="eyebrow">REQUISIÇÃO DE MATERIAL</span><h1>@Model.Numero</h1><p>@Model.Justificativa</p></div><span class="badge text-bg-info">@Model.Status.Replace('_',' ')</span></header>
<section class="panel"><div class="section-title"><h2>Resumo</h2>@if(Model.Status=="RASCUNHO"){<button type="button" class="btn btn-primary" data-enviar data-id="@Model.Id" data-version="@Model.Version">Enviar para aprovação</button>}</div><dl class="row"><dt class="col-sm-3">Setor</dt><dd class="col-sm-9">@(Model.Setor ?? "Não informado")</dd><dt class="col-sm-3">Urgência</dt><dd class="col-sm-9">@Model.Urgencia</dd><dt class="col-sm-3">Necessidade</dt><dd class="col-sm-9">@(Model.DataNecessaria?.ToString("dd/MM/yyyy") ?? "Não informada")</dd><dt class="col-sm-3">Total estimado</dt><dd class="col-sm-9">@Model.ValorEstimado.ToString("C")</dd></dl><p class="form-feedback" role="status" aria-live="polite"></p></section>
<section class="panel"><h2>Itens (@Model.Itens.Count)</h2><div class="table-responsive"><table class="table"><thead><tr><th>#</th><th>Material/serviço</th><th>Unidade</th><th>Quantidade</th><th>Valor estimado</th><th>Conferência</th></tr></thead><tbody>@foreach(var item in Model.Itens){<tr><td>@item.Ordem</td><td><strong>@item.Descricao</strong><br/><small>@item.Especificacao</small></td><td>@item.Unidade</td><td>@item.Quantidade</td><td>@item.ValorEstimado.ToString("C")</td><td>@(item.ExigeInspecao ? "Inspeção obrigatória" : "Aceite no recebimento")</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>Histórico</h2><ol>@foreach(var evento in Model.Historico){<li><strong>@evento.Acao.Replace('_',' ')</strong> — <time datetime="@evento.CriadoEm.ToString("O")">@evento.CriadoEm.ToLocalTime().ToString("g")</time></li>}</ol></section><aside class="alert alert-info"><strong>Como usar:</strong> confira itens, unidade, quantidade e data. O envio bloqueia alterações diretas e registra a versão analisada. Se não houver política de aprovação configurada, a decisão permanece impedida — nunca é aprovada automaticamente.</aside><script type="module" src="~/js/compras/compras-requisicao-detalhe.js"></script>
