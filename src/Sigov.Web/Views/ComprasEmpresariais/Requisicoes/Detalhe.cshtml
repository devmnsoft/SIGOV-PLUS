@using Microsoft.AspNetCore.Authorization
@model Sigov.Application.ComprasEmpresariais.RequisicaoDetalhe
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = $"Requisição {Model.Numero}";
    var canSend = Model.Status == "RASCUNHO" && (await Authorization.AuthorizeAsync(User, "compras_empresariais.requisicoes.enviar")).Succeeded;
    var canEdit = Model.Status == "RASCUNHO" && (await Authorization.AuthorizeAsync(User, "compras_empresariais.requisicoes.editar")).Succeeded;
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="../Shared/_ComprasNav" />
<a class="btn btn-sm btn-outline-secondary mt-3" href="@ViewData["ReturnUrl"]">Voltar à listagem</a>
<header class="compras-header"><div><span class="eyebrow">REQUISIÇÃO DE COMPRA</span><h1>@Model.Numero</h1><p>@Model.Justificativa</p></div><span class="status-badge">@Model.Status.Replace('_',' ')</span></header>
<section class="panel"><div class="section-title"><h2 class="h5">Resumo</h2><div class="form-actions">@if(canEdit){<a class="btn btn-outline-primary" href="@Url.Action("EditarRequisicao",new{id=Model.Id})">Editar rascunho</a>}@if(canSend){<button type="button" class="btn btn-primary" data-enviar data-id="@Model.Id" data-version="@Model.Version">Enviar para aprovação</button>}</div></div><dl class="row"><dt class="col-sm-3">Setor</dt><dd class="col-sm-9">@(Model.Setor ?? "Não informado")</dd><dt class="col-sm-3">Urgência</dt><dd class="col-sm-9">@Model.Urgencia</dd><dt class="col-sm-3">Necessidade</dt><dd class="col-sm-9">@(Model.DataNecessaria?.ToString("dd/MM/yyyy") ?? "Não informada")</dd><dt class="col-sm-3">Estimativa</dt><dd class="col-sm-9">@(Model.ValorEstimado > 0 ? Model.ValorEstimado.ToString("C") : "Não informada")</dd></dl><p class="form-feedback" role="status" aria-live="polite"></p></section>
<section class="panel mt-3"><h2 class="h5">Itens (@Model.Itens.Count)</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">#</th><th scope="col">Material/serviço</th><th scope="col">Unidade</th><th scope="col">Quantidade</th><th scope="col">Estimativa</th><th scope="col">Conferência</th></tr></thead><tbody>@foreach(var item in Model.Itens){<tr><td>@item.Ordem</td><td><strong>@item.Descricao</strong>@if(!string.IsNullOrWhiteSpace(item.Especificacao)){<br/><small>@item.Especificacao</small>}</td><td>@item.Unidade</td><td>@item.Quantidade</td><td>@(item.ValorEstimado > 0 ? item.ValorEstimado.ToString("C") : "Não informada")</td><td>@(item.ExigeInspecao ? "Inspeção obrigatória" : "Aceite no recebimento")</td></tr>}</tbody></table></div></section>
<section class="panel mt-3"><h2 class="h5">Documentos relacionados</h2><p class="text-muted mb-0">Nenhum documento relacionado foi registrado nesta requisição.</p></section>
<section class="panel mt-3"><h2 class="h5">Histórico</h2>@if(Model.Historico.Count>0){<ol>@foreach(var evento in Model.Historico){<li><strong>@evento.Acao.Replace('_',' ')</strong> — <time datetime="@evento.CriadoEm.ToString("O")">@evento.CriadoEm.ToLocalTime().ToString("g")</time></li>}</ol>}else{<p class="text-muted mb-0">Nenhum evento registrado.</p>}</section>
@if(Model.Status=="RASCUNHO"&&!canSend){<aside class="alert alert-warning mt-3"><strong>Ação indisponível:</strong> você não possui permissão para enviar esta requisição.</aside>}else if(Model.Status=="PENDENTE_APROVACAO"){<aside class="alert alert-info mt-3"><strong>Próxima etapa:</strong> a requisição aguarda decisão conforme a política de aprovação configurada.</aside>}
<aside class="alert alert-info mt-3"><strong>Como usar:</strong> confira itens, unidade, quantidade e data. O envio bloqueia alterações diretas e registra a versão analisada. Sem política de aprovação configurada, a decisão permanece impedida — nunca é aprovada automaticamente.</aside>
<script type="module" src="~/js/compras/compras-requisicao-detalhe.js"></script>
