@{ViewData["Title"]="Nova requisição";}<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" /><header class="compras-header"><div><h1>Nova requisição</h1><p>Adicione materiais, serviços, ativos ou peças de OS.</p></div></header><form id="requisicao-form" class="compras-form"><label>Setor<input class="form-control" name="setor" /></label><label>Urgência<select class="form-select" name="urgencia"><option>NORMAL</option><option>ALTA</option><option>CRITICA</option></select></label><label class="wide">Justificativa<textarea class="form-control" name="justificativa" required></textarea></label><section class="wide"><div class="section-title"><h2>Itens</h2><button type="button" class="btn btn-outline-primary" data-add-item>Adicionar item</button></div><div data-items></div></section><div class="form-actions"><button class="btn btn-primary">Salvar rascunho</button><a class="btn btn-outline-secondary" href="/ComprasEmpresariais/Requisicoes">Cancelar</a></div><p class="form-feedback" role="status" aria-live="polite"></p></form><template id="item-template"><div class="item-row"><select class="form-select" data-field="tipo"><option>MATERIAL</option><option>SERVICO</option><option>ATIVO</option><option>PECA_OS</option></select><input class="form-control" data-field="descricao" placeholder="Descrição" required /><input class="form-control" data-field="unidade" value="UN" aria-label="Unidade" /><input class="form-control" data-field="quantidade" type="number" min="0.0001" step="0.0001" value="1" aria-label="Quantidade" /><input class="form-control" data-field="valorEstimado" type="number" min="0" step="0.01" value="0" aria-label="Valor" /><button class="btn btn-outline-danger" type="button" data-remove>Remover</button></div></template><script type="module" src="~/js/compras/compras-requisicao-editor.js"></script>
