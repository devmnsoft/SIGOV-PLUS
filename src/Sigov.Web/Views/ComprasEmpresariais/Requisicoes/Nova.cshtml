@model Sigov.Application.ComprasEmpresariais.RequisicaoDetalhe?
@using System.Text.Json
@{
    var editing = Model is not null;
    ViewData["Title"] = editing ? $"Editar requisição {Model!.Numero}" : "Nova requisição";
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="../Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">@(editing ? "RASCUNHO" : "NOVA NECESSIDADE")</span><h1>@(editing ? $"Editar {Model!.Numero}" : "Nova requisição")</h1><p>Registre a justificativa, a data de necessidade e os itens antes de enviar para aprovação.</p></div></header>
<form id="requisicao-form" class="compras-form" data-id="@(editing ? Model!.Id : null)" data-version="@(editing ? Model!.Version : null)" novalidate>
    @Html.AntiForgeryToken()
    <div class="wide alert alert-danger validation-summary" role="alert" tabindex="-1" data-validation-summary hidden></div>
    <div><label class="form-label" for="setor">Setor solicitante</label><input id="setor" class="form-control" name="setor" value="@(editing ? Model!.Setor : null)" autocomplete="organization-title" /></div>
    <div><label class="form-label" for="urgencia">Urgência <span aria-hidden="true">*</span></label><select id="urgencia" class="form-select" name="urgencia" required aria-describedby="urgencia-help">@foreach(var urgency in new[]{"NORMAL","ALTA","CRITICA"}){<option selected="@(editing && Model!.Urgencia==urgency)">@urgency</option>}</select><small id="urgencia-help" class="form-text">A prioridade não substitui a alçada de aprovação.</small></div>
    <div><label class="form-label" for="dataNecessaria">Data de necessidade</label><input id="dataNecessaria" class="form-control" name="dataNecessaria" type="date" value="@(editing ? Model!.DataNecessaria?.ToString("yyyy-MM-dd") : null)" /></div>
    <div class="wide"><label class="form-label" for="justificativa">Justificativa <span aria-hidden="true">*</span></label><textarea id="justificativa" class="form-control" name="justificativa" required minlength="10" maxlength="2000" aria-describedby="justificativa-help">@(editing ? Model!.Justificativa : null)</textarea><small id="justificativa-help" class="form-text">Explique a finalidade da aquisição em pelo menos 10 caracteres.</small></div>
    <fieldset class="wide compras-fieldset"><legend class="h5">Itens da requisição</legend><div class="section-title"><p class="text-muted mb-0">Informe nome, unidade e quantidade. Itens repetidos devem ser consolidados.</p><button type="button" class="btn btn-outline-primary" data-add-item>Adicionar item</button></div><div data-items></div></fieldset>
    <div class="form-actions"><button class="btn btn-primary" type="submit">@(editing ? "Salvar alterações" : "Salvar rascunho")</button><a class="btn btn-outline-secondary" href="@(editing ? Url.Action("Requisicao", new { id=Model!.Id }) : Url.Action("Requisicoes"))">Cancelar</a></div>
    <p class="form-feedback" role="status" aria-live="polite" tabindex="-1"></p>
</form>
<template id="item-template"><div class="item-row"><select class="form-select" data-field="tipo" aria-label="Tipo do item"><option>MATERIAL</option><option>SERVICO</option><option>ATIVO</option><option>PECA_OS</option></select><input class="form-control" data-field="descricao" placeholder="Nome ou descrição" aria-label="Nome ou descrição do item" required maxlength="300" /><input class="form-control" data-field="unidade" value="UN" aria-label="Unidade de medida" required maxlength="20" /><input class="form-control" data-field="quantidade" type="number" min="0.0001" step="0.0001" value="1" aria-label="Quantidade" required /><input class="form-control" data-field="valorEstimado" type="number" min="0" step="0.01" placeholder="Estimativa opcional" aria-label="Valor estimado unitário" /><button class="btn btn-outline-danger" type="button" data-remove>Remover</button></div></template>
@if(editing){<script id="requisicao-items" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model!.Itens, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>}
<script type="module" src="~/js/compras/compras-requisicao-editor.js"></script>
