@model Sigov.Application.ComprasEmpresariais.RequisicaoDetalhe?
@using System.Text.Json
@{
    var editing = Model is not null;
    ViewData["Title"] = editing ? $"Editar requisição {Model!.Numero}" : "Nova requisição";
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="../Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">@(editing ? "RASCUNHO" : "NOVA NECESSIDADE")</span><h1>@(editing ? $"Editar {Model!.Numero}" : "Nova requisição")</h1><p>Registre a justificativa, a data de necessidade e os itens antes de enviar para aprovação.</p></div></header>
<form id="requisicao-form" class="compras-form" data-id="@(editing ? Model!.Id : null)" data-version="@(editing ? Model!.Version : null)">
    <label>Setor<input class="form-control" name="setor" value="@(editing ? Model!.Setor : null)" /></label>
    <label>Urgência<select class="form-select" name="urgencia">@foreach(var urgency in new[]{"NORMAL","ALTA","CRITICA"}){<option selected="@(editing && Model!.Urgencia==urgency)">@urgency</option>}</select></label>
    <label>Data de necessidade<input class="form-control" name="dataNecessaria" type="date" value="@(editing ? Model!.DataNecessaria?.ToString("yyyy-MM-dd") : null)" /></label>
    <label class="wide">Justificativa<textarea class="form-control" name="justificativa" required>@(editing ? Model!.Justificativa : null)</textarea></label>
    <section class="wide"><div class="section-title"><h2 class="h5">Itens</h2><button type="button" class="btn btn-outline-primary" data-add-item>Adicionar item</button></div><p class="text-muted">Descreva o produto, material ou serviço por nome. Itens repetidos devem ser consolidados antes de salvar.</p><div data-items></div></section>
    <div class="form-actions"><button class="btn btn-primary" type="submit">@(editing ? "Salvar alterações" : "Salvar rascunho")</button><a class="btn btn-outline-secondary" href="@(editing ? Url.Action("Requisicao", new { id=Model!.Id }) : Url.Action("Requisicoes"))">Cancelar</a></div>
    <p class="form-feedback" role="status" aria-live="polite"></p>
</form>
<template id="item-template"><div class="item-row"><select class="form-select" data-field="tipo" aria-label="Tipo do item"><option>MATERIAL</option><option>SERVICO</option><option>ATIVO</option><option>PECA_OS</option></select><input class="form-control" data-field="descricao" placeholder="Nome ou descrição" aria-label="Nome ou descrição" required /><input class="form-control" data-field="unidade" value="UN" aria-label="Unidade" required /><input class="form-control" data-field="quantidade" type="number" min="0.0001" step="0.0001" value="1" aria-label="Quantidade" required /><input class="form-control" data-field="valorEstimado" type="number" min="0" step="0.01" placeholder="Estimativa opcional" aria-label="Valor estimado" /><button class="btn btn-outline-danger" type="button" data-remove>Remover</button></div></template>
@if(editing){<script id="requisicao-items" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model!.Itens, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>}
<script type="module" src="~/js/compras/compras-requisicao-editor.js"></script>
