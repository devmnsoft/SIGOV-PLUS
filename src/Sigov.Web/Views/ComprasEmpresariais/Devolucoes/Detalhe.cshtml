@using Sigov.Application.ComprasEmpresariais
@model DevolucaoDetalhe
@{ViewData["Title"]=$"Devolução #{Model.Id}";var key=Guid.NewGuid().ToString("N");}
<link rel="stylesheet" href="~/css/compras-empresariais.css"/><partial name="../Shared/_ComprasNav"/>
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Devolucoes">Devoluções</a></li><li class="breadcrumb-item"><a asp-action="Recebimento" asp-route-id="@Model.RecebimentoId">Recebimento @Model.DocumentoRecebimento</a></li><li class="breadcrumb-item active">Devolução #@Model.Id</li></ol></nav>
<header class="compras-header">
 <div>
  <span class="eyebrow">DEVOLUÇÃO FÍSICA · OPERAÇÃO INDEPENDENTE DO TRATAMENTO ADMINISTRATIVO</span>
  <h1>Devolução #@Model.Id · @Model.DocumentoRecebimento</h1>
  <p>Fornecedor: <strong>@Model.Fornecedor</strong> · Rota: <strong>@Model.OrigemFisica → @Model.Destino</strong></p>
 </div>
 <div class="d-flex align-items-center gap-2">
  @if(Model.Situacao=="RASCUNHO"){
   <a class="btn btn-outline-primary" asp-action="EditarDevolucao" asp-route-id="@Model.Id">Editar rascunho</a>
  }
  <span class="status-badge">@Model.Situacao</span>
 </div>
</header>

@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
@if(TempData["Conflict"] is string conflict){<div class="alert alert-warning" role="alert" tabindex="-1">@conflict</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}

<details class="panel mb-3" open><summary class="fw-semibold">Para que serve e regras operacionais</summary><div class="mt-3">
<p><strong>Para que serve:</strong> gerenciar a custódia e execução da saída e entrega física de itens recusados na inspeção.</p>
<p><strong>Regras importantes:</strong> a expedição não baixa estoque disponível de venda ou consumo; a entrega comprova o retorno da mercadoria ao fornecedor com protocolo formal, mas não gera efeito fiscal ou financeiro automático.</p>
<p><strong>Próximo passo:</strong> no rascunho, confirme a saída física ou cancele a preparação; quando expedida, confirme a entrega ao fornecedor com protocolo.</p>
</div></details>

<section class="panel mb-3">
 <h2 class="h5 border-bottom pb-2">Informações da operação</h2>
 <dl class="row mb-0">
  <dt class="col-sm-3">Origem</dt>
  <dd class="col-sm-9"><a asp-action="Recebimento" asp-route-id="@Model.RecebimentoId">Recebimento @Model.DocumentoRecebimento (Pedido @Model.PedidoNumero)</a></dd>
  <dt class="col-sm-3">Motivo fundamentado</dt>
  <dd class="col-sm-9">@Model.Motivo</dd>
  <dt class="col-sm-3">Responsável operacional</dt>
  <dd class="col-sm-9"><strong>@(Model.ResponsavelNome ?? Model.ResponsavelId.ToString())</strong></dd>
  <dt class="col-sm-3">Contexto institucional</dt>
  <dd class="col-sm-9">@Model.EsferaGoverno.ToUpperInvariant() · @Model.TipoEntidade · @Model.UnidadeGestora · @Model.UnidadeExecutora (@Model.AbrangenciaTerritorial)</dd>
  <dt class="col-sm-3">Instantes operacionais</dt>
  <dd class="col-sm-9">
   Criada: @Model.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · 
   Expedição: @(Model.ExpedidaEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Pendente") · 
   Entrega: @(Model.EntregueEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Pendente")
   @if(Model.CanceladaEm.HasValue){<span class="text-danger"> · Cancelada em @Model.CanceladaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>}
  </dd>
  @if(!string.IsNullOrWhiteSpace(Model.DocumentoProtocolo)){
   <dt class="col-sm-3">Protocolo de entrega</dt>
   <dd class="col-sm-9"><strong>@Model.DocumentoProtocolo</strong> (Recebedor: @Model.RecebedorOuReferencia)</dd>
  }
 </dl>
</section>

<section class="panel mb-3">
 <h2 class="h5 border-bottom pb-2">Itens abrangidos nesta devolução</h2>
 <div class="table-responsive">
  <table class="table align-middle">
   <thead class="table-light">
    <tr>
     <th>Produto</th>
     <th>Unidade</th>
     <th class="text-end">Rejeitado na inspeção</th>
     <th class="text-end">Reservado neste rascunho</th>
     <th class="text-end">Expedido em transporte</th>
     <th class="text-end">Entregue comprovado</th>
     <th class="text-end text-primary">Saldo remanescente</th>
    </tr>
   </thead>
   <tbody>
    @foreach(var x in Model.Itens){
     <tr>
      <td><strong>@x.Produto</strong></td>
      <td>@x.Unidade</td>
      <td class="text-end">@x.QuantidadeRejeitada.ToString("0.####")</td>
      <td class="text-end fw-semibold">@x.QuantidadeReservada.ToString("0.####")</td>
      <td class="text-end">@x.QuantidadeExpedida.ToString("0.####")</td>
      <td class="text-end">@x.QuantidadeEntregue.ToString("0.####")</td>
      <td class="text-end text-primary fw-bold">@x.SaldoElegivel.ToString("0.####")</td>
     </tr>
    }
   </tbody>
  </table>
 </div>
</section>

@if(Model.Situacao=="RASCUNHO"){
 <section class="row g-3 mt-1 mb-3">
  <div class="col-lg-8">
   <form asp-action="ExpedirDevolucao" asp-route-id="@Model.Id" method="post" class="panel" data-confirm="Confirmar a saída física dos itens rejeitados da custódia?">
    @Html.AntiForgeryToken()
    <h2 class="h5 border-bottom pb-2">Confirmar expedição física</h2>
    <input type="hidden" name="Version" value="@Model.Version"/>
    <input type="hidden" name="IdempotencyKey" value="@key-expedir"/>
    <div class="row g-2">
     <div class="col-md-6">
      <label class="form-label fw-semibold">Data/hora da saída real</label>
      <input name="SaidaEm" type="datetime-local" required class="form-control" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"/>
      <small class="text-muted">A data não pode ser futura.</small>
     </div>
     <div class="col-md-6">
      <label class="form-label fw-semibold">Modalidade de transporte</label>
      <select name="Modalidade" class="form-select">
       <option value="ENTREGA_DIRETA">Entrega direta pelo órgão/entidade</option>
       <option value="TRANSPORTADORA">Coleta por transportadora</option>
       <option value="RETIRADA_FORNECEDOR">Retirada pelo próprio fornecedor</option>
      </select>
     </div>
     <div class="col-md-6">
      <label class="form-label fw-semibold">Transportadora / Responsável pela coleta</label>
      <input name="Transportadora" class="form-control" placeholder="Opcional se retirada direta"/>
     </div>
     <div class="col-md-6">
      <label class="form-label fw-semibold">Conhecimento de frete / CTE / Referência</label>
      <input name="ReferenciaTransporte" class="form-control" placeholder="Número de rastreio ou minuta"/>
     </div>
    </div>
    <button class="btn btn-warning mt-3" type="submit">Confirmar saída física</button>
   </form>
  </div>
  <div class="col-lg-4">
   <form asp-action="CancelarDevolucao" asp-route-id="@Model.Id" method="post" class="panel" data-confirm="Cancelar este rascunho de devolução e liberar as reservas?">
    @Html.AntiForgeryToken()
    <h2 class="h5 border-bottom pb-2 text-danger">Cancelar preparação</h2>
    <input type="hidden" name="Version" value="@Model.Version"/>
    <input type="hidden" name="IdempotencyKey" value="@key-cancelar"/>
    <label class="form-label fw-semibold">Justificativa do cancelamento</label>
    <textarea name="Justificativa" minlength="10" maxlength="1000" required class="form-control" rows="4" placeholder="Explique por que este rascunho está sendo cancelado..."></textarea>
    <button class="btn btn-outline-danger mt-3" type="submit">Cancelar rascunho</button>
   </form>
  </div>
 </section>
}

@if(Model.Situacao=="EXPEDIDA"){
 <form asp-action="EntregarDevolucao" asp-route-id="@Model.Id" method="post" class="panel mt-3 mb-3 border-success" data-confirm="Confirmar a entrega física ao fornecedor com este protocolo?">
  @Html.AntiForgeryToken()
  <h2 class="h5 border-bottom pb-2 text-success">Confirmar entrega ao fornecedor</h2>
  <input type="hidden" name="Version" value="@Model.Version"/>
  <input type="hidden" name="IdempotencyKey" value="@key-entregar"/>
  <div class="row g-3">
   <div class="col-md-3">
    <label class="form-label fw-semibold">Data/hora da entrega</label>
    <input name="EntregueEm" type="datetime-local" required class="form-control" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"/>
    <small class="text-muted">Não pode anteceder a expedição nem ser futura.</small>
   </div>
   <div class="col-md-3">
    <label class="form-label fw-semibold">Recebedor no fornecedor</label>
    <input name="RecebedorOuReferencia" required maxlength="150" class="form-control" placeholder="Nome / Matrícula de quem recebeu"/>
   </div>
   <div class="col-md-3">
    <label class="form-label fw-semibold">Documento de protocolo / Canhoto</label>
    <input name="DocumentoProtocolo" required maxlength="100" class="form-control" placeholder="Nº do protocolo ou recibo"/>
   </div>
   <div class="col-md-3">
    <label class="form-label fw-semibold">Observações complementares</label>
    <input name="Observacao" maxlength="500" class="form-control" placeholder="Detalhes do recebimento"/>
   </div>
  </div>
  <button class="btn btn-success mt-3" type="submit">Confirmar entrega física comprovada</button>
 </form>
}

<section class="panel mt-3">
 <h2 class="h5 border-bottom pb-2">Histórico legível da operação</h2>
 @if(Model.Historico.Count==0){
  <p class="text-muted">Nenhum evento registrado.</p>
 }else{
  <ol class="timeline list-unstyled">
   @foreach(var e in Model.Historico){
    <li class="mb-3 border-start border-3 ps-3">
     <div class="d-flex justify-content-between align-items-center">
      <strong>@e.Tipo.Replace('_',' ')</strong>
      <span class="small text-muted">@e.OcorridoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
     </div>
     <div>
      <span>Responsável/Autor: <strong>@(e.AutorNome ?? e.UsuarioId.ToString())</strong></span>
      @if(!string.IsNullOrWhiteSpace(e.EstadoAnterior)){
       <span> · Transição: <span class="badge bg-light text-dark">@e.EstadoAnterior</span> → <span class="badge bg-secondary">@e.EstadoNovo</span></span>
      }
     </div>
     <details class="mt-1 small">
      <summary class="text-muted">Ver detalhes técnicos do evento</summary>
      <div class="p-2 bg-light rounded mt-1">
       <div><strong>Correlação:</strong> @e.CorrelationId</div>
       <div><strong>Dados estruturados:</strong> <pre class="m-0 text-wrap">@e.Detalhes</pre></div>
      </div>
     </details>
    </li>
   }
  </ol>
 }
</section>

<div class="action-bar mt-3 d-flex justify-content-between">
 <a class="btn btn-outline-secondary" asp-action="Devolucoes">Voltar à central de devoluções</a>
 <a class="btn btn-outline-primary" asp-action="Recebimento" asp-route-id="@Model.RecebimentoId">Ver recebimento de origem</a>
</div>

<script>
document.querySelectorAll('form[data-confirm]').forEach(f => {
 f.addEventListener('submit', function(e) {
  if (!confirm(this.dataset.confirm)) {
   e.preventDefault();
   return;
  }
  const btn = this.querySelector('button[type=submit]');
  if (btn) {
   btn.disabled = true;
   btn.setAttribute('aria-disabled', 'true');
   btn.textContent = 'Processando…';
  }
 });
});
document.querySelector('[role=alert]')?.focus();
</script>
