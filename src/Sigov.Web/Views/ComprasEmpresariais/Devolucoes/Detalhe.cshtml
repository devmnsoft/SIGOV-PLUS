@using Sigov.Application.ComprasEmpresariais
@model DevolucaoDetalhe
@{ViewData["Title"]=$"Devolução {Model.Id}";var key=Guid.NewGuid().ToString("N");}
<link rel="stylesheet" href="~/css/compras-empresariais.css"/><partial name="../Shared/_ComprasNav"/>
<header class="compras-header"><div><span class="eyebrow">DEVOLUÇÃO FÍSICA · INDEPENDENTE DO TRATAMENTO ADMINISTRATIVO</span><h1>@Model.DocumentoRecebimento · @Model.Fornecedor</h1><p>@Model.OrigemFisica → @Model.Destino</p></div><span class="status-badge">@Model.Situacao</span></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}@if(TempData["Conflict"] is string conflict){<div class="alert alert-warning" role="alert" tabindex="-1">@conflict</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}
<details class="panel mb-3" open><summary>Para que serve e próximos passos</summary><p><strong>Pré-requisitos:</strong> saldo rejeitado reservado e versão atual. <strong>Como usar:</strong> confira produtos/unidades e execute apenas a próxima ação disponível.</p><p><strong>Regras:</strong> expedição registra saída real da custódia, não baixa estoque disponível; entrega prova recebimento pelo fornecedor, mas não cria crédito, aceite fiscal, reposição ou quitação.</p><p><strong>Próximo passo:</strong> em rascunho, expedir ou cancelar; expedida, confirmar entrega; estados finais permanecem auditáveis.</p></details>
<section class="panel"><h2 class="h5">Contexto</h2><dl class="row"><dt class="col-sm-3">Motivo</dt><dd class="col-sm-9">@Model.Motivo</dd><dt class="col-sm-3">Contexto institucional</dt><dd class="col-sm-9">@Model.EsferaGoverno · @Model.TipoEntidade · @Model.UnidadeGestora · @Model.UnidadeExecutora · @Model.AbrangenciaTerritorial</dd><dt class="col-sm-3">Datas operacionais</dt><dd class="col-sm-9">Expedição @(Model.ExpedidaEm?.ToString("dd/MM/yyyy HH:mm zzz")??"não realizada") · entrega @(Model.EntregueEm?.ToString("dd/MM/yyyy HH:mm zzz")??"não confirmada")</dd></dl></section>
<section class="panel mt-3"><h2 class="h5">Quantidades por produto e unidade</h2><div class="table-responsive"><table class="table"><thead><tr><th>Produto</th><th>Unidade</th><th>Rejeitado</th><th>Reservado</th><th>Expedido</th><th>Entregue</th><th>Saldo elegível</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.Produto</td><td>@x.Unidade</td><td>@x.QuantidadeRejeitada</td><td>@x.QuantidadeReservada</td><td>@x.QuantidadeExpedida</td><td>@x.QuantidadeEntregue</td><td>@x.SaldoElegivel</td></tr>}</tbody></table></div></section>
@if(Model.Situacao=="RASCUNHO"){<section class="row g-3 mt-1"><div class="col-lg-8"><form asp-action="ExpedirDevolucao" asp-route-id="@Model.Id" method="post" class="panel" data-confirm="Confirmar que a mercadoria saiu fisicamente da custódia?">@Html.AntiForgeryToken()<h2 class="h5">Confirmar expedição</h2><input type="hidden" name="Version" value="@Model.Version"/><input type="hidden" name="IdempotencyKey" value="@key-expedir"/><label>Data/hora da saída</label><input name="SaidaEm" type="datetime-local" required class="form-control"/><label class="mt-2">Modalidade</label><select name="Modalidade" class="form-select"><option value="ENTREGA_DIRETA">Entrega direta</option><option value="TRANSPORTADORA">Transportadora</option></select><label class="mt-2">Transportadora (quando aplicável)</label><input name="Transportadora" class="form-control"/><label class="mt-2">Referência de transporte</label><input name="ReferenciaTransporte" class="form-control"/><button class="btn btn-warning mt-3">Confirmar saída física</button></form></div><div class="col-lg-4"><form asp-action="CancelarDevolucao" asp-route-id="@Model.Id" method="post" class="panel" data-confirm="Cancelar o rascunho e liberar sua reserva?">@Html.AntiForgeryToken()<h2 class="h5">Cancelar preparação</h2><input type="hidden" name="Version" value="@Model.Version"/><input type="hidden" name="IdempotencyKey" value="@key-cancelar"/><label>Justificativa</label><textarea name="Justificativa" minlength="10" required class="form-control"></textarea><button class="btn btn-outline-danger mt-3">Cancelar rascunho</button></form></div></section>}
@if(Model.Situacao=="EXPEDIDA"){<form asp-action="EntregarDevolucao" asp-route-id="@Model.Id" method="post" class="panel mt-3" data-confirm="Confirmar a entrega física ao fornecedor com estas evidências?">@Html.AntiForgeryToken()<h2 class="h5">Confirmar entrega</h2><input type="hidden" name="Version" value="@Model.Version"/><input type="hidden" name="IdempotencyKey" value="@key-entregar"/><div class="row g-2"><div class="col-md-3"><label>Data/hora</label><input name="EntregueEm" type="datetime-local" required class="form-control"/></div><div class="col-md-3"><label>Recebedor ou referência</label><input name="RecebedorOuReferencia" required class="form-control"/></div><div class="col-md-3"><label>Documento/protocolo</label><input name="DocumentoProtocolo" required class="form-control"/></div><div class="col-md-3"><label>Observação</label><input name="Observacao" class="form-control"/></div></div><button class="btn btn-success mt-3">Confirmar entrega física</button></form>}
<section class="panel mt-3"><h2 class="h5">Histórico auditável</h2>@if(Model.Historico.Count==0){<p>Nenhum evento encontrado.</p>}else{<ol class="timeline">@foreach(var e in Model.Historico){<li><strong>@e.Tipo</strong> · @e.EstadoAnterior → @e.EstadoNovo · @e.OcorridoEm.ToString("dd/MM/yyyy HH:mm:ss zzz")<br/><small>Ator @e.UsuarioId · correlação @e.CorrelationId</small><pre class="small text-wrap">@e.Detalhes</pre></li>}</ol>}</section>
<div class="action-bar"><a class="btn btn-outline-secondary" asp-action="Devolucoes">Voltar à central</a></div>
<script>document.querySelectorAll('form[data-confirm]').forEach(f=>f.addEventListener('submit',e=>{if(!confirm(f.dataset.confirm)){e.preventDefault();return}const b=e.submitter;if(b){b.disabled=true;b.textContent='Processando…'}}));document.querySelector('[role=alert]')?.focus();</script>
