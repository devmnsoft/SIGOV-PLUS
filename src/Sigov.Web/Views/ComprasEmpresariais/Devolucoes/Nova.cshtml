@using Sigov.Application.ComprasEmpresariais
@model OrigemDevolucao
@{ViewData["Title"]="Preparar devolução";var key=(string)ViewData["IdempotencyKey"]!;}
<link rel="stylesheet" href="~/css/compras-empresariais.css"/><partial name="../Shared/_ComprasNav"/>
<header class="compras-header"><div><span class="eyebrow">PREPARAÇÃO</span><h1>Nova devolução</h1><p>@Model.Documento · @Model.Fornecedor</p></div></header>
<details class="panel mb-3" open><summary>Para que serve</summary><p><strong>Pré-requisito:</strong> selecione somente saldo rejeitado. <strong>Efeito:</strong> salvar reserva as quantidades, sem saída física e sem estoque disponível.</p><p><strong>Como usar:</strong> informe contexto institucional, origem, destino, motivo e quantidades. <strong>Próximo passo:</strong> revise o rascunho e confirme a expedição.</p></details>
<form method="post" asp-action="CriarDevolucao" class="panel" data-single-submit>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><input type="hidden" name="RecebimentoId" value="@Model.RecebimentoId"/><input type="hidden" name="IdempotencyKey" value="@key"/>
<div class="row g-3"><div class="col-md-6"><label for="motivo">Motivo</label><textarea id="motivo" name="Motivo" required maxlength="2000" class="form-control"></textarea></div><div class="col-md-3"><label for="origem">Origem física</label><input id="origem" name="OrigemFisica" required class="form-control"/></div><div class="col-md-3"><label for="destino">Destino no fornecedor</label><input id="destino" name="Destino" required class="form-control"/></div><div class="col-md-3"><label for="responsavel">Responsável (identidade autorizada)</label><input id="responsavel" name="ResponsavelId" type="text" required class="form-control" aria-describedby="resp-help"/><small id="resp-help">Selecione via pesquisa nominal disponibilizada pela organização.</small></div><div class="col-md-3"><label>Esfera</label><select name="EsferaGoverno" class="form-select" required><option value="municipal">Municipal</option><option value="estadual">Estadual</option><option value="federal">Federal</option></select></div>@foreach(var n in new[]{"TipoEntidade","UnidadeGestora","UnidadeExecutora","HierarquiaAdministrativa","AbrangenciaTerritorial"}){<div class="col-md-3"><label>@n</label><input name="@n" required class="form-control"/></div>}</div>
<h2 class="h5 mt-4">Itens elegíveis</h2>@for(var i=0;i<Model.Itens.Count;i++){var x=Model.Itens[i];<div class="row align-items-end border-top py-2"><input type="hidden" name="Itens[@i].RecebimentoItemId" value="@x.RecebimentoItemId"/><div class="col"><strong>@x.Produto</strong> (@x.Unidade)<br/><small>Rejeitado @x.QuantidadeRejeitada · reservado @x.QuantidadeReservada · expedido @x.QuantidadeExpedida · entregue @x.QuantidadeEntregue · elegível @x.SaldoElegivel</small></div><div class="col-md-3"><label for="q-@i">Quantidade</label><input id="q-@i" name="Itens[@i].Quantidade" type="number" min="0" max="@x.SaldoElegivel" step="0.0001" value="0" class="form-control"/></div></div>}<button class="btn btn-primary mt-3">Salvar rascunho</button></form>
<script>document.querySelector('[data-single-submit]')?.addEventListener('submit',e=>{const b=e.submitter;if(b){b.disabled=true;b.textContent='Salvando…'}});document.querySelector('.validation-summary-errors')?.focus();</script>
