@using Sigov.Web.Models
@model DevolucaoFormViewModel
@{ViewData["Title"]=$"Editar devolução #{Model.DevolucaoId}";var ctx=Model.ContextoInstitucional;}
<link rel="stylesheet" href="~/css/compras-empresariais.css"/><partial name="../Shared/_ComprasNav"/>
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Devolucoes">Devoluções</a></li><li class="breadcrumb-item"><a asp-action="Devolucao" asp-route-id="@Model.DevolucaoId">Devolução #@Model.DevolucaoId</a></li><li class="breadcrumb-item active">Editar rascunho</li></ol></nav>
<header class="compras-header"><div><span class="eyebrow">EDIÇÃO DE RASCUNHO</span><h1>Devolução #@Model.DevolucaoId</h1><p>Recebimento: <strong>@Model.DocumentoRecebimento</strong> · Fornecedor: <strong>@Model.Fornecedor</strong></p></div><span class="status-badge">RASCUNHO</span></header>

@if(Model.Conflito){
<section class="alert alert-warning mb-3" role="alert" tabindex="-1">
 <h2 class="h5">Conflito de concorrência detectado</h2>
 <p>@Model.MensagemConflito</p>
 <p>A sua alteração baseou-se na versão <strong>@Model.Version</strong>, enquanto o estado persistido está na versão <strong>@Model.VersaoAtual</strong>. Os valores digitados foram mantidos para revisão antes de uma nova tentativa.</p>
 <a class="btn btn-sm btn-warning" asp-action="Devolucao" asp-route-id="@Model.DevolucaoId">Revisar estado atual persistido</a>
</section>
}

<details class="panel mb-3" open><summary class="fw-semibold">Para que serve e regras de edição</summary><div class="mt-3">
<p><strong>Para que serve:</strong> ajustar quantidades, itens selecionados, motivo, responsável e locais de custódia enquanto a devolução estiver em preparação.</p>
<p><strong>Regras importantes:</strong> a edição recalcula as reservas atomicamente. Reduzir ou desmarcar um item libera sua reserva; aumentar exige saldo elegível disponível (descontando outras operações ativas, sem duplicar a contagem deste rascunho).</p>
<p><strong>Conflito:</strong> caso outro usuário tenha alterado ou cancelado o rascunho concomitantemente, a alteração é rejeitada com segurança.</p>
</div></details>

<form method="post" asp-action="SalvarEdicaoDevolucao" asp-route-id="@Model.DevolucaoId" class="panel" data-single-submit>
@Html.AntiForgeryToken()
<input asp-for="DevolucaoId" type="hidden"/>
<input asp-for="Version" type="hidden"/>
<input asp-for="RecebimentoId" type="hidden"/>
<input asp-for="DocumentoRecebimento" type="hidden"/>
<input asp-for="Fornecedor" type="hidden"/>
<input asp-for="IdempotencyKey" type="hidden"/>
<input asp-for="ReturnUrl" type="hidden"/>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div>

<section class="mb-4">
<h2 class="h5 border-bottom pb-2">1. Dados da operação</h2>
<div class="row g-3">
 <div class="col-md-6">
  <label asp-for="Motivo" class="form-label fw-semibold">Motivo da devolução</label>
  <textarea asp-for="Motivo" rows="3" required maxlength="2000" class="form-control"></textarea>
  <span asp-validation-for="Motivo" class="text-danger small"></span>
 </div>
 <div class="col-md-6">
  <label asp-for="ResponsavelId" class="form-label fw-semibold">Responsável operacional nominal</label>
  <select asp-for="ResponsavelId" class="form-select" required>
   <option value="">Selecione pelo nome do responsável ativo</option>
   @foreach(var r in Model.Responsaveis){
    <option value="@r.UsuarioId" selected="@(r.UsuarioId == Model.ResponsavelId)">@r.Nome @(string.IsNullOrWhiteSpace(r.Vinculo) ? "" : $"— {r.Vinculo}") @(string.IsNullOrWhiteSpace(r.Unidade) ? "" : $"({r.Unidade})")</option>
   }
  </select>
  <span asp-validation-for="ResponsavelId" class="text-danger small d-block"></span>
 </div>
 <div class="col-md-6">
  <label asp-for="OrigemFisica" class="form-label fw-semibold">Origem física</label>
  <input asp-for="OrigemFisica" required maxlength="200" class="form-control"/>
  <span asp-validation-for="OrigemFisica" class="text-danger small"></span>
 </div>
 <div class="col-md-6">
  <label asp-for="Destino" class="form-label fw-semibold">Destino no fornecedor</label>
  <input asp-for="Destino" required maxlength="200" class="form-control"/>
  <span asp-validation-for="Destino" class="text-danger small"></span>
 </div>
</div>
</section>

@if(ctx is not null){
<section class="mb-4 p-3 bg-light rounded border">
 <h2 class="h6 text-primary fw-bold mb-2">Contexto institucional autorizado</h2>
 <div class="row g-2 small text-muted">
  <div class="col-md-3"><strong>Esfera:</strong> @ctx.EsferaGoverno.ToUpperInvariant()</div>
  <div class="col-md-3"><strong>Entidade:</strong> @ctx.TipoEntidade</div>
  <div class="col-md-3"><strong>Unidade Gestora:</strong> @ctx.UnidadeGestora</div>
  <div class="col-md-3"><strong>Unidade Executora:</strong> @ctx.UnidadeExecutora</div>
 </div>
</section>
}

<section class="mb-4">
 <h2 class="h5 border-bottom pb-2">2. Itens do rascunho e quantidades</h2>
 <p class="small text-muted">Desmarcar um item removerá sua reserva ao salvar. Aumentar a quantidade requer saldo elegível disponível.</p>
 
 <div class="table-responsive">
  <table class="table align-middle">
   <thead class="table-light">
    <tr>
     <th style="width: 50px;">Manter?</th>
     <th>Produto</th>
     <th>Unidade</th>
     <th class="text-end">Rejeitado total</th>
     <th class="text-end text-primary">Disponível p/ edição</th>
     <th style="width: 200px;" class="text-end">Quantidade a devolver</th>
    </tr>
   </thead>
   <tbody>
    @for(var i=0; i<Model.Itens.Count; i++){
     var item = Model.Itens[i];
     <tr>
      <td class="text-center">
       <input type="hidden" asp-for="Itens[i].RecebimentoItemId"/>
       <input type="hidden" asp-for="Itens[i].Produto"/>
       <input type="hidden" asp-for="Itens[i].Unidade"/>
       <input type="hidden" asp-for="Itens[i].QuantidadeRejeitada"/>
       <input type="hidden" asp-for="Itens[i].QuantidadeReservada"/>
       <input type="hidden" asp-for="Itens[i].QuantidadeExpedida"/>
       <input type="hidden" asp-for="Itens[i].QuantidadeEntregue"/>
       <input type="hidden" asp-for="Itens[i].SaldoElegivel"/>
       <input type="checkbox" asp-for="Itens[i].Selecionado" class="form-check-input item-checkbox" aria-label="Manter @item.Produto na devolução"/>
      </td>
      <td><strong>@item.Produto</strong></td>
      <td>@item.Unidade</td>
      <td class="text-end">@item.QuantidadeRejeitada.ToString("0.####")</td>
      <td class="text-end text-primary fw-bold">@item.SaldoElegivel.ToString("0.####")</td>
      <td>
       <div class="input-group input-group-sm">
        <input asp-for="Itens[i].QuantidadeDevolver" class="form-control text-end item-qty" inputmode="decimal" pattern="[0-9]+([,.][0-9]{1,4})?" placeholder="0,0000" aria-label="Quantidade a devolver de @item.Produto"/>
       </div>
       <span asp-validation-for="Itens[i].QuantidadeDevolver" class="text-danger small d-block"></span>
      </td>
     </tr>
    }
   </tbody>
  </table>
 </div>
</section>

<div class="action-bar d-flex justify-content-between">
 <a class="btn btn-outline-secondary" asp-action="Devolucao" asp-route-id="@Model.DevolucaoId">Cancelar alterações</a>
 <button class="btn btn-primary" type="submit">Salvar alterações do rascunho</button>
</div>
</form>

<script>
document.querySelector('[data-single-submit]')?.addEventListener('submit', function(e) {
 const btn = this.querySelector('button[type=submit]');
 if (btn && !btn.disabled) {
  btn.disabled = true;
  btn.setAttribute('aria-disabled', 'true');
  btn.textContent = 'Salvando alterações…';
 }
});
document.querySelector('.validation-summary-errors, [role=alert]')?.focus();
</script>
