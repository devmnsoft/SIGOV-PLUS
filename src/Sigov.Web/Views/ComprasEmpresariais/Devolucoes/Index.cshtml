@using Sigov.Application.Common
@using Sigov.Application.ComprasEmpresariais
@model PagedResult<DevolucaoResumo>
@{ViewData["Title"]="Devoluções físicas";var f=(DevolucaoFiltro)ViewData["Filtro"]!;}
<link rel="stylesheet" href="~/css/compras-empresariais.css"/><partial name="../Shared/_ComprasNav"/>
<header class="compras-header"><div><span class="eyebrow">CUSTÓDIA DE ITENS REJEITADOS</span><h1>Devoluções físicas</h1><p>Prepare, confirme a saída e acompanhe a entrega ao fornecedor sem alterar estoque disponível ou efeitos financeiros.</p></div></header>
<details class="panel mb-3" open><summary>Como usar e regras importantes</summary><p><strong>Pré-requisito:</strong> recebimento inspecionado com quantidade rejeitada e permissão persistida.</p><p><strong>Como usar:</strong> filtre a central ou inicie pelo recebimento/divergência; rascunhos reservam saldo. Expedir comprova saída; entregar exige protocolo.</p><p><strong>Efeito e próximo passo:</strong> a jornada física é independente do tratamento administrativo. Após expedir, acompanhe até a confirmação da entrega.</p></details>
<form method="get" class="panel row g-2" role="search"><div class="col-md-3"><label for="fornecedor">Fornecedor</label><input id="fornecedor" name="fornecedor" value="@f.Fornecedor" class="form-control"/></div><div class="col-md-3"><label for="documento">Documento</label><input id="documento" name="documentoRecebimento" value="@f.DocumentoRecebimento" class="form-control"/></div><div class="col-md-2"><label for="situacao">Situação</label><select id="situacao" name="situacao" class="form-select"><option value="">Todas</option>@foreach(var s in new[]{"RASCUNHO","EXPEDIDA","ENTREGUE","CANCELADA"}){<option selected="@(f.Situacao==s)">@s</option>}</select></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Filtrar</button></div><div class="col-md-2 align-self-end"><a class="btn btn-outline-secondary" asp-action="ExportarDevolucoes" asp-route-fornecedor="@f.Fornecedor" asp-route-situacao="@f.Situacao">CSV</a></div></form>
<section class="panel mt-3" aria-live="polite">@if(Model.Items.Count==0){<div class="text-center p-4"><h2 class="h5">Nenhuma devolução encontrada</h2><p>Selecione um recebimento inspecionado para preparar a primeira operação.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Origem</th><th>Fornecedor</th><th>Situação</th><th>Datas</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.DocumentoRecebimento</td><td>@x.Fornecedor</td><td><span class="status-badge">@x.Situacao</span></td><td>Aberta @x.CriadaEm.ToString("dd/MM/yyyy HH:mm")<br/>Expedição @(x.ExpedidaEm?.ToString("dd/MM/yyyy HH:mm")??"—")<br/>Entrega @(x.EntregueEm?.ToString("dd/MM/yyyy HH:mm")??"—")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Devolucao" asp-route-id="@x.Id">Detalhar</a></td></tr>}</tbody></table></div>}</section>
