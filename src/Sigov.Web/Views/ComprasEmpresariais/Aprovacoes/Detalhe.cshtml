@using Sigov.Application.ComprasEmpresariais
@using System.Text.Json
@model AprovacaoEtapaDetalhe
@{
    ViewData["Title"] = $"Etapa Nível {Model.Nivel} — Requisição {Model.Numero}";
    var podeDecidir = Model.StatusEtapa == "PENDENTE" && Model.DecisivelPorMim && !Model.Bloqueada;
    var chaveA = Guid.NewGuid().ToString("N");
    var chaveR = Guid.NewGuid().ToString("N");
    var chaveD = Guid.NewGuid().ToString("N");
    var chaveReav = Guid.NewGuid().ToString("N");

    string? politicaNome = null;
    long? versaoSnapshot = null;
    decimal? totalSnapshot = null;
    if (!string.IsNullOrWhiteSpace(Model.RegraSnapshot))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.RegraSnapshot);
            if (doc.RootElement.TryGetProperty("politica_nome", out var pn) && pn.ValueKind == JsonValueKind.String) politicaNome = pn.GetString();
            if (doc.RootElement.TryGetProperty("versao_requisicao", out var vr) && vr.TryGetInt64(out var v)) versaoSnapshot = v;
            if (doc.RootElement.TryGetProperty("total_requisicao", out var tr) && tr.TryGetDecimal(out var t)) totalSnapshot = tr.GetDecimal();
        }
        catch { }
    }
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="Shared/_ComprasNav" />

<nav aria-label="breadcrumb" class="my-2">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><a asp-action="Index">Compras</a></li>
    <li class="breadcrumb-item"><a asp-action="Aprovacoes">Aprovações</a></li>
    <li class="breadcrumb-item active" aria-current="page">@Model.Numero · Nível @Model.Nivel</li>
  </ol>
</nav>

<header class="compras-header mb-3">
  <div>
    <span class="eyebrow">APROVAÇÃO POR ALÇADA · CICLO @Model.Ciclo</span>
    <h1 class="h3">@Model.Numero · Nível @Model.Nivel</h1>
    <p class="text-muted mb-0">Alçada da etapa: @Model.Limite.ToString("C") · Total da requisição: @Model.Total.ToString("C")</p>
  </div>
  <a class="btn btn-outline-secondary" asp-action="Aprovacoes">Voltar para a fila</a>
</header>

@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
@if(TempData["Conflict"] is string conflict){<div class="alert alert-warning" role="alert" tabindex="-1">@conflict</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}

@if(Model.Bloqueada)
{
  <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" role="alert" tabindex="-1">
    <div>
      <strong>Etapa bloqueada:</strong> Esta etapa aguarda designação institucional de aprovador com alçada suficiente (@Model.Limite.ToString("C")).
    </div>
    <form method="post" asp-controller="ComprasEmpresariais" asp-action="ReavaliarEncaminhamento" asp-route-requisicaoId="@Model.RequisicaoId">
      @Html.AntiForgeryToken()
      <input type="hidden" name="motivo" value="Reavaliação solicitada no detalhe da etapa bloqueada." />
      <input type="hidden" name="Idempotency-Key" value="@chaveReav" />
      <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
      <button type="submit" class="btn btn-warning">Reavaliar encaminhamento</button>
    </form>
  </div>
}

<details class="card mb-3" open>
  <summary class="card-header fw-semibold" style="cursor:pointer">Ajuda contextual da etapa</summary>
  <div class="card-body">
    <p class="mb-1"><strong>Para que serve:</strong> Avaliar e registrar a decisão colegiada de cada nível hierárquico antes do prosseguimento da contratação.</p>
    <p class="mb-1"><strong>Quem decide:</strong> Servidor ou autoridade com delegação de competência e alçada orçamentária compatível. O próprio solicitante está impedido de autoaprovação.</p>
    <p class="mb-1"><strong>Regra de sequência:</strong> Níveis anteriores devem ser aprovados antes da liberação do nível subsequente. A requisição torna-se <em>APROVADA</em> somente após a conclusão do último nível exigido.</p>
    <p class="mb-0"><strong>Regra de quorum:</strong> Havendo mais de um aprovador habilitado no mesmo nível, a decisão do primeiro conclui o nível para os demais.</p>
  </div>
</details>

<section class="panel mb-3">
  <div class="section-title d-flex justify-content-between align-items-center">
    <h2 class="h5 mb-0">Informações da solicitação</h2>
    <span class="badge text-bg-@(Model.StatusEtapa=="PENDENTE"?"info":(Model.StatusEtapa=="APROVADO"?"success":(Model.StatusEtapa=="REJEITADA"?"danger":"secondary")))" role="status">
      Etapa: @Model.StatusEtapa.Replace('_',' ')
    </span>
  </div>
  <dl class="row mt-3 mb-0">
    <dt class="col-sm-3">Situação da requisição</dt>
    <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.StatusRequisicao.Replace('_',' ')</span> · urgência @Model.Urgencia</dd>
    <dt class="col-sm-3">Total estimado</dt>
    <dd class="col-sm-9"><strong>@Model.Total.ToString("C")</strong></dd>
    <dt class="col-sm-3">Aprovador da etapa</dt>
    <dd class="col-sm-9">
      @if(Model.AprovadorId is null){
        <span class="badge text-bg-warning">Aprovador não designado (bloqueada)</span>
      }else{
        <span>@(Model.AprovadorNome ?? Model.AprovadorId.ToString())</span>
      }
    </dd>
    <dt class="col-sm-3">Solicitante</dt>
    <dd class="col-sm-9">@Model.SolicitanteNome@(Model.Setor is null ? "" : $" · Setor: {Model.Setor}")</dd>
    <dt class="col-sm-3">Data da solicitação</dt>
    <dd class="col-sm-9">@Model.SolicitadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    @if(Model.DecididaEm is not null){
      <dt class="col-sm-3">Decidida em</dt>
      <dd class="col-sm-9">@Model.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    }
    @if(!string.IsNullOrWhiteSpace(Model.Motivo)){
      <dt class="col-sm-3">Motivo registrado</dt>
      <dd class="col-sm-9 text-danger">@Model.Motivo</dd>
    }
  </dl>
</section>

@if(!string.IsNullOrWhiteSpace(Model.RegraSnapshot))
{
  <section class="panel mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h5 mb-0">Snapshot da regra aplicada no envio (Ciclo @Model.Ciclo)</h2>
      <span class="badge text-bg-@(Model.ClassificacaoSnapshot == "COMPLETO" ? "success" : (Model.ClassificacaoSnapshot == "PARCIAL" ? "warning" : "secondary")) fs-6">
        Snapshot: @Model.ClassificacaoSnapshot
      </span>
    </div>
    @if(!string.IsNullOrWhiteSpace(Model.SnapshotDiagnostico))
    {
      <div class="alert alert-@(Model.ClassificacaoSnapshot == "PARCIAL" ? "warning" : "info") py-2 mb-2">
        <strong>Diagnóstico do Snapshot:</strong> @Model.SnapshotDiagnostico
      </div>
    }
    <div class="row g-2 mt-1">
      <div class="col-md-4">
        <div class="p-2 border rounded bg-light">
          <small class="text-muted d-block">Política institucional</small>
          <strong>@(politicaNome ?? "Política padrão por alçada")</strong>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-2 border rounded bg-light">
          <small class="text-muted d-block">Alçada exigida nesta etapa</small>
          <strong>@Model.Limite.ToString("C")</strong>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-2 border rounded bg-light">
          <small class="text-muted d-block">Versão da requisição congelada</small>
          <strong>@(versaoSnapshot.HasValue ? $"v{versaoSnapshot}" : $"v{Model.VersionEtapa}")</strong>
        </div>
      </div>
    </div>
    <details class="mt-2">
      <summary class="small text-muted" style="cursor:pointer">Ver evidência técnica (JSON de auditoria)</summary>
      <pre class="compras-snapshot mt-2 mb-0">@Model.RegraSnapshot</pre>
    </details>
  </section>
}

@if(Model.Itens.Count > 0)
{
  <section class="panel mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h5 mb-0">
        @if (Model.ClassificacaoSnapshot == "COMPLETO")
        {
          <span>Itens congelados no envio (Snapshot Histórico · Ciclo @Model.Ciclo)</span>
        }
        else if (Model.ClassificacaoSnapshot == "PARCIAL")
        {
          <span>Itens da aprovação (Snapshot Parcial · Ciclo @Model.Ciclo)</span>
        }
        else
        {
          <span class="text-secondary">Itens atuais da requisição (Consulta de Referência)</span>
        }
      </h2>
      <span class="badge text-bg-light">@Model.Itens.Count item(ns)</span>
    </div>
    @if (Model.ClassificacaoSnapshot == "INDISPONIVEL")
    {
      <div class="alert alert-secondary py-2 mb-3">
        <small><strong>Aviso de Referência:</strong> Esta etapa foi submetida antes da captura congelada de itens. Os dados exibidos abaixo refletem o cadastro atual da requisição consultado como referência e não representam snapshot auditado da época.</small>
      </div>
    }
    <div class="table-responsive">
      <table class="table align-middle table-sm">
        <thead>
          <tr>
            <th>#</th>
            <th>Descrição e especificação</th>
            <th>Unidade</th>
            <th class="text-end">Quantidade</th>
            <th class="text-end">Valor unitário</th>
            <th class="text-end">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          @foreach(var i in Model.Itens)
          {
            var sub = i.Quantidade * i.ValorEstimado;
            <tr>
              <td>@i.Ordem</td>
              <td>
                <strong>@i.Descricao</strong>
                @if(!string.IsNullOrWhiteSpace(i.Especificacao)){<br/><small class="text-muted">@i.Especificacao</small>}
              </td>
              <td>@i.Unidade</td>
              <td class="text-end">@i.Quantidade.ToString("N2")</td>
              <td class="text-end">@i.ValorEstimado.ToString("C")</td>
              <td class="text-end"><strong>@sub.ToString("C")</strong></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

<section class="panel mb-3">
  <h2 class="h5">Fluxo de aprovação do ciclo @Model.Ciclo</h2>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Nível</th>
          <th>Alçada mínima</th>
          <th>Situação</th>
          <th>Aprovador</th>
          <th>Decidida em</th>
          <th>Motivo</th>
        </tr>
      </thead>
      <tbody>
        @foreach(var e in Model.EtapasCiclo)
        {
          var isAtual = e.EtapaId == Model.EtapaId;
          <tr class="@(isAtual ? "table-primary fw-semibold" : "")">
            <td>Nível @e.Nivel @(isAtual ? " (Esta etapa)" : "")</td>
            <td>@e.Limite.ToString("C")</td>
            <td>
              <span class="badge text-bg-@(e.Status=="APROVADO"?"success":(e.Status=="PENDENTE"?"info":(e.Status=="REJEITADA"?"danger":"secondary")))">
                @e.Status.Replace('_',' ')
              </span>
            </td>
            <td>@(e.AprovadorNome ?? "Aguardando designação")</td>
            <td>@(e.DecididaEm.HasValue ? e.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
            <td><small>@(e.Motivo ?? "—")</small></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if(Model.ProximaEtapa is { } prox)
  {
    <div class="alert alert-info mb-0" role="note">
      <strong>Próxima etapa:</strong> Nível @prox.Nivel@(prox.AprovadorNome is null ? " (aguardando configuração de alçada)" : $" — Aprovador: {prox.AprovadorNome}").
    </div>
  }
</section>

@if(podeDecidir)
{
  <section class="panel mb-3 border-primary">
    <h2 class="h5 text-primary">Decisão da autoridade para o Nível @Model.Nivel</h2>
    <p class="text-muted small">
      Ao aprovar, esta etapa é concluída e a requisição avança para a próxima etapa (ou conclui o ciclo se este for o último nível).
      Rejeições ou devoluções exigem justificativa mínima de 10 caracteres e encerram o ciclo atual.
    </p>
    <div class="row g-3">
      <div class="col-md-4">
        <form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@Model.EtapaId" class="card h-100 p-3">
          @Html.AntiForgeryToken()
          <input type="hidden" name="version" value="@Model.VersionEtapa"/>
          <input type="hidden" name="Idempotency-Key" value="@chaveA"/>
          <h3 class="h6 text-success">Aprovar solicitação</h3>
          <p class="small text-muted flex-grow-1">Confirma conformidade da despesa com os limites da alçada deste nível.</p>
          <button type="submit" name="decisao" value="APROVAR" class="btn btn-success w-100">Confirmar aprovação</button>
        </form>
      </div>
      <div class="col-md-4">
        <form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@Model.EtapaId" class="card h-100 p-3">
          @Html.AntiForgeryToken()
          <input type="hidden" name="version" value="@Model.VersionEtapa"/>
          <input type="hidden" name="Idempotency-Key" value="@chaveD"/>
          <h3 class="h6 text-warning">Devolver para correção</h3>
          <textarea name="motivo" class="form-control mb-2" rows="2" minlength="10" required placeholder="Motivo da devolução ao requisitante (mínimo 10 caracteres)"></textarea>
          <button type="submit" name="decisao" value="DEVOLVER" class="btn btn-outline-warning w-100">Devolver requisição</button>
        </form>
      </div>
      <div class="col-md-4">
        <form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@Model.EtapaId" class="card h-100 p-3">
          @Html.AntiForgeryToken()
          <input type="hidden" name="version" value="@Model.VersionEtapa"/>
          <input type="hidden" name="Idempotency-Key" value="@chaveR"/>
          <h3 class="h6 text-danger">Rejeitar integralmente</h3>
          <textarea name="motivo" class="form-control mb-2" rows="2" minlength="10" required placeholder="Motivo formal da rejeição (mínimo 10 caracteres)"></textarea>
          <button type="submit" name="decisao" value="REJEITAR" class="btn btn-danger w-100">Rejeitar solicitação</button>
        </form>
      </div>
    </div>
  </section>
}

@if(Model.Historico.Count > 0)
{
  <section class="panel">
    <h2 class="h5">Trilha de auditoria da requisição</h2>
    <ol class="timeline list-unstyled mb-0" reversed>
      @foreach(var h in Model.Historico)
      {
        <li class="mb-2 pb-2 border-bottom">
          <strong>@h.Acao.Replace('_',' ')</strong> · <time>@h.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
          @if(!string.IsNullOrWhiteSpace(h.Detalhes)){<br/><small class="text-muted">@h.Detalhes</small>}
        </li>
      }
    </ol>
  </section>
}
