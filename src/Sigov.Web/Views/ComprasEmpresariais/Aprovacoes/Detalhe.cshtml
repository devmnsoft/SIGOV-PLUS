@using Sigov.Application.ComprasEmpresariais
@model AprovacaoEtapaDetalhe
@{
    ViewData["Title"] = "Detalhe da etapa de aprovação";
    var podeDecidir = Model.StatusEtapa == "PENDENTE" && Model.DecisivelPorMim && !Model.Bloqueada;
    var chaveA = Guid.NewGuid().ToString("N");
    var chaveR = Guid.NewGuid().ToString("N");
    var chaveD = Guid.NewGuid().ToString("N");
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">DECISÃO POR ALÇADA</span><h1>Detalhe da etapa</h1><p>@Model.Numero · ciclo @Model.Ciclo · nível @Model.Nivel · alçada até @Model.Limite.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</p></div><a class="btn btn-outline-secondary" asp-action="Aprovacoes">Voltar para a fila</a></header>
@if(Model.Bloqueada){<div class="alert alert-warning" role="alert" tabindex="-1">Esta etapa está bloqueada e aguarda configuração institucional antes de qualquer decisão.</div>}
@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
@if(TempData["Conflict"] is string conflict){<div class="alert alert-warning" role="alert" tabindex="-1">@conflict</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}
<section class="panel mb-3"><div class="section-title"><h2 class="h5">Informações da etapa</h2><span class="badge text-bg-@(Model.StatusEtapa=="PENDENTE"?"info":(Model.StatusEtapa=="APROVADO"?"success":(Model.StatusEtapa=="REJEITADA"?"danger":"secondary")))" role="status">Etapa: @Model.StatusEtapa.Replace('_',' ')</span></div><dl class="row mb-0"><dt class="col-sm-4">Status da requisição</dt><dd class="col-sm-8">@Model.StatusRequisicao.Replace('_',' ') · urgência @Model.Urgencia</dd><dt class="col-sm-4">Total estimado</dt><dd class="col-sm-8">@Model.Total.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</dd><dt class="col-sm-4">Aprovador</dt><dd class="col-sm-8">@if(Model.AprovadorId is null){<span class="badge text-bg-warning">aprovador não designado</span>}else{<span>@Model.AprovadorNome??"aprovador designado (nome indisponível)"</span>}</dd><dt class="col-sm-4">Solicitante</dt><dd class="col-sm-8">@Model.SolicitanteNome@(Model.Setor is null?"":$" · setor {Model.Setor}")</dd><dt class="col-sm-4">Solicitada em</dt><dd class="col-sm-8">@Model.SolicitadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>@if(Model.DecididaEm is not null){<dt class="col-sm-4">Decidida em</dt><dd class="col-sm-8">@Model.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>}@if(Model.Motivo is not null){<dt class="col-sm-4">Motivo registrado</dt><dd class="col-sm-8">@Model.Motivo</dd>}</dl></section>
@if(Model.RegraSnapshot is not null){<section class="panel mb-3"><h2 class="h5">Snapshot da regra aplicada no envio</h2><pre class="compras-snapshot mb-0">@Model.RegraSnapshot</pre></section>}
@if(Model.Itens.Count>0){<section class="panel mb-3"><h2 class="h5">Itens da requisição</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Ordem</th><th>Descrição</th><th>Unidade</th><th>Quantidade</th><th>Valor unitário</th><th>Subtotal</th></tr></thead><tbody>@foreach(var i in Model.Itens){var sub=i.Quantidade*i.ValorEstimado;<tr><td>@i.Ordem</td><td>@i.Descricao@(i.Especificacao is null?"":$"<br/><small>{i.Especificacao}</small>")</td><td>@i.Unidade</td><td>@i.Quantidade.ToString(System.Globalization.CultureInfo.InvariantCulture)</td><td>@i.ValorEstimado.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@sub.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td></tr>}</tbody></table></div></section>}
<section class="panel mb-3"><h2 class="h5">Etapas do ciclo @Model.Ciclo</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nível</th><th>Alçada</th><th>Status</th><th>Aprovador</th><th>Decidida em</th><th>Motivo</th></tr></thead><tbody>@foreach(var e in Model.EtapasCiclo){<tr class="@(e.EtapaId==Model.EtapaId?"table-primary":"")"><td>Nível @e.Nivel</td><td>@e.Limite.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@e.Status.Replace('_',' ')</td><td>@(e.AprovadorNome??"—")</td><td>@(e.DecididaEm is null?"—":e.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td><td><small>@(e.Motivo??"—")</small></td></tr>}</tbody></table></div>@if(Model.ProximaEtapa is { } prox){<div class="alert alert-info mb-0" role="note">Próxima etapa do ciclo: nível @prox.Nivel@(prox.AprovadorNome is null?" (aguardando configuração institucional)":" — aprovador: "+prox.AprovadorNome). Nenhuma ação é necessária enquanto esta etapa não for concluída.</div>}</section>
@if(podeDecidir){<section class="panel mb-3"><h2 class="h5">Decisão desta etapa</h2><details class="mb-3"><summary class="fw-semibold">Ajuda da jornada</summary><div class="mt-3"><p><strong>Como executar:</strong> escolha uma única ação; rejeitar ou devolver exige motivo com pelo menos 10 caracteres.</p><p><strong>Efeito:</strong> aprovar encerra apenas esta etapa e libera a próxima; o ciclo só conclui com a aprovação do último nível. Rejeitar ou devolver encerra o ciclo atual e devolve a requisição para correção quando aplicável.</p></div></details><div class="fila-decisoes d-grid gap-2 d-md-block"><form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@Model.EtapaId" class="fila-decisao"><input type="hidden" name="version" value="@Model.VersionEtapa"/><input type="hidden" name="Idempotency-Key" value="@chaveA"/><button type="submit" name="decisao" value="APROVAR" class="btn btn-success">Aprovar</button></form><form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@Model.EtapaId" class="fila-decisao"><input type="hidden" name="version" value="@Model.VersionEtapa"/><input type="hidden" name="Idempotency-Key" value="@chaveR"/><textarea name="motivo" class="form-control mb-2" rows="2" minlength="10" required placeholder="Motivo da rejeição (mínimo 10 caracteres)"></textarea><button type="submit" name="decisao" value="REJEITAR" class="btn btn-danger">Rejeitar</button></form><form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@Model.EtapaId" class="fila-decisao"><input type="hidden" name="version" value="@Model.VersionEtapa"/><input type="hidden" name="Idempotency-Key" value="@chaveD"/><textarea name="motivo" class="form-control mb-2" rows="2" minlength="10" required placeholder="Motivo da devolução (mínimo 10 caracteres)"></textarea><button type="submit" name="decisao" value="DEVOLVER" class="btn btn-outline-primary">Devolver para correção</button></form></div></section>}
@if(Model.Historico.Count>0){<section class="panel"><h2 class="h5">Histórico recente</h2><ol class="timeline list-unstyled mb-0" reversed>@foreach(var h in Model.Historico){<li><strong>@h.Acao.Replace('_',' ')</strong> · @h.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(h.Detalhes is null?"":$"<br/><small>{h.Detalhes}</small>")</li>}</ol></section>}
