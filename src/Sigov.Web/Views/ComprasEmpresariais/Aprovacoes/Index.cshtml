@using Sigov.Application.Common
@using Sigov.Application.ComprasEmpresariais
@using Sigov.Web.Controllers
@model AprovacoesCentralViewModel
@{
    ViewData["Title"] = "Fila de aprovações";
    var fila = Model.Fila;
    var totalPages = Math.Max(1, fila.TotalPages);
    var busca = ViewData["Busca"]?.ToString() ?? "";
    var urgencia = ViewData["Urgencia"]?.ToString() ?? "";
    string FiltroQs() => (string.IsNullOrWhiteSpace(busca) ? "" : "busca=" + Uri.EscapeDataString(busca) + "&") + (string.IsNullOrWhiteSpace(urgencia) ? "" : "urgencia=" + Uri.EscapeDataString(urgencia) + "&");
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">DECISÃO POR ALÇADA</span><h1>Fila de aprovações</h1><p>Aprove, rejeite ou devolva requisições pendentes conforme as alçadas definidas na política institucional.</p></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="RelatorioAprovacoes">Relatório de aprovações</a><a class="btn btn-outline-primary" asp-action="RelatorioAprovacoesCsv">Exportar CSV</a></div></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
@if(TempData["Conflict"] is string conflict){<div class="alert alert-warning" role="alert" tabindex="-1">@conflict</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}
<details class="panel mb-3" open><summary class="fw-semibold">Ajuda da jornada</summary><div class="mt-3"><p><strong>Para que serve:</strong> centralizar as decisões de aprovação por alçada do fluxo procure-to-pay, em qualquer esfera de governo.</p><p><strong>Quando usar:</strong> após o envio de um rascunho; cada nível da política gera uma etapa nesta fila.</p><p><strong>Como executar:</strong> escolha a ação na linha correspondente; rejeitar ou devolver exige motivo com pelo menos 10 caracteres.</p><p><strong>Regras e efeito:</strong> somente o aprovador designado decide uma etapa; etapas bloqueadas aguardam configuração institucional e permanecem visíveis enquanto existe pendência aberta; a aprovação do último nível conclui a requisição como APROVADA; rejeitar ou devolver encerra o ciclo atual.</p><p><strong>Segurança:</strong> cada decisão é gravada com chave de idempotência e versão; repetir a mesma submissão reapresenta o resultado persistido sem gerar novo ciclo ou novo efeito.</p></div></details>
<section class="panel mb-3"><div class="section-title"><h2 class="h5">Pendências de decisão</h2><span role="status">@fila.TotalItems etapa(s) na fila autorizada</span></div><form method="get" asp-controller="ComprasEmpresariais" asp-action="Aprovacoes" class="requisicao-filtros mb-3"><div class="filter-search"><label for="fila-busca" class="form-label">Buscar</label><input id="fila-busca" name="busca" value="@busca" class="form-control" placeholder="Número, solicitante ou setor"/></div><div><label for="fila-urgencia" class="form-label">Urgência</label><select id="fila-urgencia" name="urgencia" class="form-select"><option value="">Todas</option>@foreach(var u in new[]{"NORMAL","ALTA","CRITICA"}){<option value="@u" selected="@(u==urgencia)">@u</option>}</select></div><div class="filter-actions"><button type="submit" class="btn btn-primary">Aplicar</button><a class="btn btn-outline-secondary" asp-action="Aprovacoes">Limpar</a></div></form>@if(fila.Items.Count==0){<div class="empty-state"><h3 class="h5">Nenhuma etapa pendente</h3><p>Não há aprovações pendentes para o seu contexto neste momento; nenhum dado fictício é exibido.</p></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Requisição</th><th>Solicitante</th><th>Solicitada em</th><th>Total</th><th>Alçada da etapa</th><th>Etapa</th><th>Situação</th><th>Próxima ação</th><th>Aprovar</th><th>Rejeitar</th><th>Devolver</th></tr></thead><tbody>@foreach(var d in fila.Items){var chaveA=Guid.NewGuid().ToString("N");var chaveR=Guid.NewGuid().ToString("N");var chaveD=Guid.NewGuid().ToString("N");var decidivel=d.DecisivelPorMim&&!d.Bloqueada;<tr><td><a asp-action="DetalheAprovacao" asp-route-etapaId="@d.EtapaId">@d.Numero</a><br/><small>@d.StatusRequisicao.Replace('_',' ') · urgência @d.Urgencia</small></td><td>@(d.SolicitanteNome??"—")@(d.Setor is null?"":$"<br/><small>{d.Setor}</small>")</td><td>@d.SolicitadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@d.Total.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@d.Limite.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>Nível @d.Nivel</td><td>@Html.Raw(d.Bloqueada?"<span class=\"badge text-bg-warning\">Aguarda configuração</span>":(d.DecisivelPorMim?"<span class=\"badge text-bg-info\">Decisão sua</span>":"<span class=\"badge text-bg-secondary\">Outro aprovador designado</span>"))</td><td><small>@(d.ProximaAcao??"—")</small>@if(d.Bloqueada){<div class="mt-1"><form method="post" asp-controller="ComprasEmpresariais" asp-action="ReavaliarEncaminhamento" asp-route-requisicaoId="@d.RequisicaoId" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="motivo" value="Reavaliação de encaminhamento solicitada pela fila central" /><button type="submit" class="btn btn-sm btn-outline-warning" title="Reavaliar encaminhamento para resolver pendência de aprovador">Reavaliar</button></form></div>}</td><td><form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@d.EtapaId" class="fila-decisao">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@d.Version"/><input type="hidden" name="Idempotency-Key" value="@chaveA"/><button type="submit" name="decisao" value="APROVAR" class="btn btn-sm btn-success" @(!decidivel?"disabled":"")>Aprovar</button></form></td><td><form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@d.EtapaId" class="fila-decisao">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@d.Version"/><input type="hidden" name="Idempotency-Key" value="@chaveR"/><button type="submit" name="decisao" value="REJEITAR" class="btn btn-sm btn-danger" @(!decidivel?"disabled":"")>Rejeitar</button></form></td><td><form method="post" asp-controller="ComprasEmpresariais" asp-action="DecidirAprovacao" asp-route-etapaId="@d.EtapaId" class="fila-decisao">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@d.Version"/><input type="hidden" name="Idempotency-Key" value="@chaveD"/><button type="submit" name="decisao" value="DEVOLVER" class="btn btn-sm btn-outline-primary" @(!decidivel?"disabled":"")>Devolver</button></form></td></tr>}</tbody></table></div>}@if(fila.TotalPages>1){<nav aria-label="Paginação da fila"><ul class="pagination mt-3 mb-0">@if(fila.HasPreviousPage){<li class="page-item"><a class="page-link" href="?@FiltroQs()pagina=@(fila.Page-1)&tamanho=@fila.PageSize">Anterior</a></li>}@for(var p=1;p<=totalPages;p++){<li class="page-item @(p==fila.Page?"active":"")"><a class="page-link" href="?@FiltroQs()pagina=@p&tamanho=@fila.PageSize">@p</a></li>}@if(fila.HasNextPage){<li class="page-item"><a class="page-link" href="?@FiltroQs()pagina=@(fila.Page+1)&tamanho=@fila.PageSize">Próxima</a></li>}</ul></nav>}</section>
<section class="panel mb-3"><div class="section-title"><h2 class="h5">Devolvidas para correção</h2><span role="status">prévia dos últimos @Model.Devolvidas.Items.Count registro(s)</span></div>@if(Model.Devolvidas.Items.Count==0){<div class="empty-state"><h3 class="h5">Nenhuma requisição devolvida</h3><p>Não há requisições devolvidas para correção no seu contexto neste momento.</p></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Requisição</th><th>Solicitada em</th><th>Total</th><th>Devolvida em</th><th>Motivo da devolução</th><th>Ação</th></tr></thead><tbody>@foreach(var x in Model.Devolvidas.Items){<tr><td>@x.Numero<br/><small>urgência @(x.Urgencia??"—")</small></td><td>@x.SolicitadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@x.Total.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@(x.DecididaEm is null?"—":x.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td><td><small>@(x.MotivoFinal??"—")</small></td><td><a class="btn btn-sm btn-outline-primary" asp-action="EditarRequisicao" asp-route-id="@x.RequisicaoId">Corrigir requisição devolvida</a></td></tr>}</tbody></table></div>}</section>
<section class="panel"><div class="section-title"><h2 class="h5">Concluídas recentemente</h2><span role="status">prévia dos últimos @Model.Concluidas.Items.Count registro(s)</span></div>@if(Model.Concluidas.Items.Count==0){<div class="empty-state"><h3 class="h5">Nenhuma requisição concluída</h3><p>Ainda não há aprovações concluídas (aprovadas ou rejeitadas) visíveis para o seu contexto.</p></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Requisição</th><th>Total</th><th>Status</th><th>Decidida em</th><th>Motivo final</th><th>Ação</th></tr></thead><tbody>@foreach(var x in Model.Concluidas.Items){<tr><td>@x.Numero<br/><small>urgência @(x.Urgencia??"—")</small></td><td>@x.Total.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td><span class="badge text-bg-@(x.StatusRequisicao=="APROVADA"?"success":"danger")">@x.StatusRequisicao.Replace('_',' ')</span></td><td>@(x.DecididaEm is null?"—":x.DecididaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td><td><small>@(x.MotivoFinal??"—")</small></td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Requisicao" asp-route-id="@x.RequisicaoId">Ver requisição</a></td></tr>}</tbody></table></div>}</section>
