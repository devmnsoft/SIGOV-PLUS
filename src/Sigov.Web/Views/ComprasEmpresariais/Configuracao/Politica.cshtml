@using System.Globalization
@using Sigov.Application.ComprasEmpresariais
@model PoliticaAtivaResumo?
@{
    ViewData["Title"] = "Política de aprovação";
    var nomes = Model?.Niveis ?? Array.Empty<NivelPoliticaResumo>();
    var limites = ViewData["Limites"] as decimal[];
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">CONFIGURAÇÃO INSTITUCIONAL</span><h1>Política de aprovação</h1><p>Defina as alçadas aplicadas ao envio de requisições neste contexto empresarial multi-esfera.</p></div><a class="btn btn-outline-primary" asp-action="Aprovacoes">Ver fila de aprovações</a></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
@if(TempData["Conflict"] is string conflict){<div class="alert alert-warning" role="alert" tabindex="-1">@conflict</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}
@if(Model is not null){<section class="panel mb-3"><h2 class="h5">Política ativa</h2><p class="mb-1"><strong>@Model.Nome</strong> · esfera @Model.EsferaGoverno · tipo de entidade @Model.TipoEntidade</p><small>Unidade gestora: @(Model.UnidadeGestora??"—") · Unidade executora: @(Model.UnidadeExecutora??"—") · Atualizada em: @Model.AtualizadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><ul class="mb-0">@foreach(var n in Model.Niveis)
{
<li>Nível @n.Ordem: etapa criada quando o total atingir este patamar (alçada acumulada) — aprovação até @n.Limite.ToString("0.00",CultureInfo.InvariantCulture)</li>
}</ul></section>}else{<section class="panel mb-3"><h2 class="h5">Nenhuma política ativa</h2><p class="mb-0">Sem política registrada, o envio permanece executável, mas as requisições entram com etapa única bloqueada e pendência visível até a primeira alçada ser salva aqui.</p></section>}
<section class="panel"><h2 class="h5">Salvar política de aprovação</h2><details class="mb-3"><summary class="fw-semibold">Ajuda da configuração</summary><div class="mt-3"><p><strong>Para que serve:</strong> estabelecer os limites de alçada, por nível, usados quando um rascunho é enviado para aprovação.</p><p><strong>Como funciona:</strong> no envio, o total é recalculado no servidor; as etapas são criadas cumulativamente para cada nível até (e incluindo) o primeiro cujo limite cubra o total; se o total excede todos os limites, todas as etapas entram na fila, e níveis sem aprovador elegível ficam bloqueados com pendência visível.</p><p><strong>Efeito:</strong> substitui a política anterior deste contexto; não altera requisições já enviadas, que mantêm as etapas do ciclo em andamento.</p></div></details><form method="post" asp-controller="ComprasEmpresariais" asp-action="SalvarConfiguracao"><input type="hidden" name="IdempotencyKey" value="@(ViewData["IdempotencyKey"]?.ToString() ?? Guid.NewGuid().ToString("N"))"/><div class="mb-3"><label for="nome" class="form-label">Nome da política</label><input id="nome" name="Nome" class="form-control" required minlength="3" maxlength="120" value="@(ViewData["Nome"]?.ToString() ?? Model?.Nome)" placeholder="Ex.: Alçada padrão de compras"/></div><div class="row g-2 mb-3">@for(var i=0;i<10;i++)
{
var valor=limites is not null&&i<limites.Length?limites[i]:(i<nomes.Count?nomes[i].Limite:(decimal?)null);
<div class="col-md-6 col-lg-4"><label for="nivel@(i+1)" class="form-label">Nível @(i+1) (aprova até)</label><input id="nivel@(i+1)" name="Niveis" type="number" step="0.01" min="0.01" class="form-control" value="@(valor?.ToString("0.00",CultureInfo.InvariantCulture) ?? "")" placeholder="Valor máximo aprovado neste nível"/></div>
}</div><p class="form-text">Informe de 1 a 10 níveis com valores positivos, em ordem crescente de responsabilidade. Níveis em branco encerram a escala. O contexto institucional (esfera, tipo de entidade e unidades) vem da configuração do órgão e não pode ser alterado aqui.</p><button type="submit" class="btn btn-primary">Salvar política</button></form></section>
