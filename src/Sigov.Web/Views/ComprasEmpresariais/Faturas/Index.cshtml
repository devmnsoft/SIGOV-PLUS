@using Sigov.Application.Common
@using Sigov.Application.ComprasEmpresariais
@model PagedResult<FaturaResumo>
@{
    ViewData["Title"] = "Conferência de faturas";
    var filtro = (FaturaFiltro?)ViewData["Filtro"] ?? new FaturaFiltro();
    var first = Model.TotalItems == 0 ? 0L : ((long)Model.Page - 1) * Model.PageSize + 1;
    var last = Model.TotalItems == 0 ? 0L : Math.Min((long)Model.Page * Model.PageSize, Model.TotalItems);
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="Shared/_ComprasNav" />

<header class="compras-header">
    <div>
        <span class="eyebrow">CONFERÊNCIA DOCUMENTAL E LIQUIDAÇÃO</span>
        <h1>Faturas e notas fiscais de compras</h1>
        <p>Conciliação trilateral entre pedidos homologados, entregas aceitas no almoxarifado e documentos de cobrança dos fornecedores.</p>
    </div>
    <div class="compras-header-actions">
        <a class="btn btn-primary" href="@Url.Action("NovaFatura")">Nova conferência de fatura</a>
    </div>
</header>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["Conflict"] is not null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Conflict"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<details class="panel mb-3" open>
    <summary class="h6">Instruções operacionais da conferência de faturas</summary>
    <div class="mt-2 text-muted small">
        <div class="row g-3">
            <div class="col-md-3">
                <strong class="text-dark d-block mb-1">Para que serve:</strong>
                Audita o faturamento de compras mercantis antes de qualquer liquidação financeira, confrontando itens e valores cobrados com o pedido de compra homologado e o recebimento físico inspecionado no almoxarifado (3-way match).
            </div>
            <div class="col-md-3">
                <strong class="text-dark d-block mb-1">Como usar:</strong>
                Localize e consulte faturas pelos filtros por número, fornecedor, pedido ou situação. Para iniciar uma conferência, clique em "Nova conferência de fatura" e selecione o pedido correspondente.
            </div>
            <div class="col-md-3">
                <strong class="text-dark d-block mb-1">Quem pode executar:</strong>
                Equipe de suprimentos, fiscal de contrato ou conferente com permissão de visualização (<code>compras_empresariais.faturas.visualizar</code>) ou criação (<code>compras_empresariais.faturas.criar</code>). A decisão formal requer perfil decisor (<code>compras_empresariais.faturas.decidir</code>).
            </div>
            <div class="col-md-3">
                <strong class="text-dark d-block mb-1">O que acontece depois:</strong>
                Ao registrar, o sistema calcula os saldos disponíveis, reserva as quantidades elegíveis e gera o diagnóstico. Uma vez aprovada sem divergências, o saldo é formalizado para posterior etapa de liquidação (sem geração automática de pagamento).
            </div>
        </div>
    </div>
</details>

<section class="panel" aria-labelledby="filtros-title">
    <h2 id="filtros-title" class="h5">Filtros de pesquisa</h2>
    <form method="get" class="requisicao-filtros">
        <div>
            <label class="form-label" for="busca">Buscar</label>
            <input class="form-control" id="busca" name="busca" value="@filtro.Busca" placeholder="Número, série, chave NF-e, fornecedor ou pedido" autocomplete="off" />
        </div>
        <div>
            <label class="form-label" for="status">Situação</label>
            <select class="form-select" id="status" name="status">
                <option value="">Todas as situações</option>
                <option value="CONFORME" selected="@(filtro.Status == "CONFORME")">Conforme</option>
                <option value="COM_DIVERGENCIA" selected="@(filtro.Status == "COM_DIVERGENCIA")">Com divergência</option>
                <option value="EM_CONFERENCIA" selected="@(filtro.Status == "EM_CONFERENCIA")">Em conferência</option>
                <option value="APROVADA" selected="@(filtro.Status == "APROVADA")">Aprovada</option>
                <option value="REJEITADA" selected="@(filtro.Status == "REJEITADA")">Rejeitada</option>
                <option value="CANCELADA" selected="@(filtro.Status == "CANCELADA")">Cancelada</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Aplicar filtros</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Faturas")">Limpar filtros</a>
        </div>
    </form>
</section>

<section class="panel requisicoes-lista" aria-labelledby="resultado-title">
    <div class="section-title">
        <div>
            <h2 id="resultado-title" class="h5 mb-1">Faturas registradas</h2>
            <p class="text-muted mb-0" role="status">Exibindo @first–@last de @Model.TotalItems registros</p>
        </div>
    </div>
    @if (Model.Items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Número / Série</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Pedido</th>
                        <th scope="col">Fornecedor</th>
                        <th scope="col">Itens</th>
                        <th scope="col" class="text-end">Total Itens</th>
                        <th scope="col" class="text-end">Valor Líquido</th>
                        <th scope="col">Confronto</th>
                        <th scope="col">Situação</th>
                        <th scope="col">Emissão</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Items)
                    {
                        var badgeMatch = f.ResultadoMatch switch
                        {
                            "MATCH_TOTAL" => "badge bg-success",
                            "DIVERGENCIA_QUANTIDADE" => "badge bg-warning text-dark",
                            "DIVERGENCIA_VALOR" => "badge bg-warning text-dark",
                            "DIVERGENCIA_MISTA" => "badge bg-danger",
                            _ => "badge bg-secondary"
                        };
                        var matchText = f.ResultadoMatch switch
                        {
                            "MATCH_TOTAL" => "Conforme",
                            "DIVERGENCIA_QUANTIDADE" => "Divergência de quantidade",
                            "DIVERGENCIA_VALOR" => "Divergência de valor",
                            "DIVERGENCIA_MISTA" => "Divergência mista",
                            _ => f.ResultadoMatch
                        };
                        var badgeStatus = f.Status switch
                        {
                            "CONFORME" => "badge bg-info text-dark",
                            "APROVADA" => "badge bg-success",
                            "COM_DIVERGENCIA" => "badge bg-warning text-dark",
                            "REJEITADA" => "badge bg-danger",
                            "CANCELADA" => "badge bg-secondary",
                            _ => "badge bg-primary"
                        };
                        var statusText = f.Status switch
                        {
                            "CONFORME" => "Conforme",
                            "APROVADA" => "Aprovada",
                            "COM_DIVERGENCIA" => "Com divergência",
                            "REJEITADA" => "Rejeitada",
                            "CANCELADA" => "Cancelada",
                            "EM_CONFERENCIA" => "Em conferência",
                            _ => f.Status
                        };
                        <tr>
                            <td>
                                <strong>@f.Numero</strong>
                                @if (!string.IsNullOrWhiteSpace(f.Serie))
                                {
                                    <span class="text-muted">/ @f.Serie</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark">@f.TipoDocumento</span></td>
                            <td><a href="@Url.Action("Pedido", new { id = f.PedidoId })">@f.PedidoNumero</a></td>
                            <td>@f.FornecedorNome</td>
                            <td>@f.ItensCount item(ns)</td>
                            <td class="text-end">@f.Total.ToString("C2")</td>
                            <td class="text-end"><strong>@f.ValorLiquido.ToString("C2")</strong></td>
                            <td><span class="@badgeMatch">@matchText</span></td>
                            <td><span class="@badgeStatus">@statusText</span></td>
                            <td>@(f.DataEmissao?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("DetalheFatura", new { id = f.Id })">Conferir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state text-center p-4">
            <p class="text-muted mb-2">Nenhuma fatura encontrada com os critérios informados.</p>
            <a class="btn btn-outline-primary" href="@Url.Action("NovaFatura")">Iniciar conferência de fatura</a>
        </div>
    }
</section>
