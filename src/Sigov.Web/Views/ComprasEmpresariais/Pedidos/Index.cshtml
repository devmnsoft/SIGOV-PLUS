@using Sigov.Application.Common
@using Sigov.Application.ComprasEmpresariais
@model PagedResult<PedidoResumo>
@{
    ViewData["Title"] = "Pedidos de compra";
    var filtro = (PedidoFiltro?)ViewData["Filtro"] ?? new PedidoFiltro();
    var first = Model.TotalItems == 0 ? 0L : ((long)Model.Page - 1) * Model.PageSize + 1;
    var last = Model.TotalItems == 0 ? 0L : Math.Min((long)Model.Page * Model.PageSize, Model.TotalItems);
    var hasFilters = !string.IsNullOrWhiteSpace(filtro.Status) || !string.IsNullOrWhiteSpace(filtro.Busca);
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="Shared/_ComprasNav" />

<header class="compras-header">
    <div>
        <span class="eyebrow">CONTRATAÇÃO DIRETA</span>
        <h1>Pedidos de compra</h1>
        <p>Acompanhe os pedidos gerados pelas seleções de cotação e abra o detalhe para dar sequência ao recebimento no almoxarifado.</p>
    </div>
</header>

<details class="panel mb-3">
    <summary class="h6">Ajuda: pedidos e recebimento</summary>
    <p>O pedido nasce confirmado a partir da seleção registrada na cotação, com um pedido por fornecedor vencedor e valores calculados pela fórmula do comparativo. A previsão de entrega considera o maior prazo informado nas propostas. O recebimento segue o fluxo existente de almoxarifado: nenhum estoque é baixado e nenhuma obrigação financeira é criada automaticamente pelo sistema nesta etapa.</p>
</details>

<section class="panel" aria-labelledby="filtros-title">
    <h2 id="filtros-title" class="h5">Filtros</h2>
    <form method="get" class="requisicao-filtros" data-filter-form>
        <div>
            <label class="form-label" for="busca">Buscar</label>
            <input class="form-control" id="busca" name="busca" value="@filtro.Busca" placeholder="Número do pedido ou fornecedor" autocomplete="off" />
        </div>
        <div>
            <label class="form-label" for="status">Situação</label>
            <select class="form-select" id="status" name="status">
                <option value="">Todas</option>
                @foreach (var status in new[] { "CONFIRMADO", "PARCIALMENTE_RECEBIDO", "RECEBIDO", "ENCERRADO", "CANCELADO" })
                {
                    <option value="@status" selected="@(filtro.Status == status)">@status.Replace('_', ' ')</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Aplicar filtros</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Pedidos")">Limpar filtros</a>
        </div>
    </form>
</section>

<section class="panel requisicoes-lista" aria-labelledby="resultado-title" aria-busy="false">
    <div class="section-title">
        <div>
            <h2 id="resultado-title" class="h5 mb-1">Resultado</h2>
            <p class="text-muted mb-0" role="status">Exibindo @first–@last de @Model.TotalItems pedidos</p>
        </div>
    </div>
    @if (Model.Items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Pedido</th><th scope="col">Fornecedor</th><th scope="col">Situação</th><th scope="col" class="text-end">Valor total</th><th scope="col">Previsão</th><th scope="col">Itens</th><th scope="col" class="text-end">Ações</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><strong>@item.Numero</strong><br /><small class="text-muted">criado em @item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td>
                            @(item.FornecedorNome ?? "-")
                            @if (item.CotacaoId.HasValue)
                            {
                                <text> · <a href="@Url.Action("Comparativo", new { id = item.CotacaoId.Value })">cotação vinculada</a></text>
                            }
                        </td>
                        <td><span class="status-badge">@item.Status.Replace('_', ' ')</span></td>
                        <td class="text-end">@item.ValorTotal.ToString("N2")</td>
                        <td>@(item.Previsao?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@item.Itens item(ns)</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Pedido", new { id = item.Id })" aria-label="Abrir pedido @item.Numero">Detalhe</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3 class="h5">@(hasFilters ? "Nenhum resultado para os filtros" : "Nenhum pedido gerado")</h3>
            <p class="text-muted">@(hasFilters ? "Revise os critérios ou limpe os filtros para consultar todos os pedidos." : "Pedidos são gerados automaticamente quando uma cotação recebe a seleção final.")</p>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Paginação dos pedidos">
            <ul class="pagination justify-content-center flex-wrap mb-0">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Pedidos", new { filtro.Busca, filtro.Status, pagina = Model.Page - 1, tamanho = Model.PageSize })">Anterior</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link" aria-disabled="true">Anterior</span></li>
                }
                @for (var pageNumber = Math.Max(1, Model.Page - 2); pageNumber <= Math.Min(Model.TotalPages, Model.Page + 2); pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : null)" aria-current="@(pageNumber == Model.Page ? "page" : null)"><a class="page-link" href="@Url.Action("Pedidos", new { filtro.Busca, filtro.Status, pagina = pageNumber, tamanho = Model.PageSize })">@pageNumber</a></li>
                }
                @if (Model.HasNextPage)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Pedidos", new { filtro.Busca, filtro.Status, pagina = Model.Page + 1, tamanho = Model.PageSize })">Próxima</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link" aria-disabled="true">Próxima</span></li>
                }
            </ul>
        </nav>
    }
</section>
