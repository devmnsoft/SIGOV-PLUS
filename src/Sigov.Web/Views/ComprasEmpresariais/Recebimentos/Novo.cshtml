@using Sigov.Application.ComprasEmpresariais
@model PedidoParaRecebimento
@{
    var div = ViewData["Divergencia"] as DivergenciaDetalhe;
    var ehReposicao = div is not null;
    ViewData["Title"] = ehReposicao ? $"Receber reposição - Pedido {Model.Numero}" : $"Receber pedido {Model.Numero}";
    var key = (string?)ViewData["IdempotencyKey"];
}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="Shared/_ComprasNav" />
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Recebimentos">Recebimentos</a></li><li class="breadcrumb-item active">@Model.Numero</li></ol></nav>
<header class="compras-header">
    <div>
        <span class="eyebrow">@(ehReposicao ? $"RECEBIMENTO DE REPOSIÇÃO (DIVERGÊNCIA #{div!.Id})" : "RECEBIMENTO FÍSICO")</span>
        <h1>Pedido @Model.Numero</h1>
        <p>Fornecedor: <strong>@Model.Fornecedor</strong>. A confirmação revalida o saldo e movimenta somente itens liberados de inspeção.</p>
    </div>
</header>

@if (ehReposicao)
{
    <div class="alert alert-primary mb-3">
        <h5 class="alert-heading h6 mb-1"><strong>Recebimento de Reposição Autorizada — Divergência #@div!.Id</strong></h5>
        <p class="mb-0">
            Produto: <strong>@div.Produto</strong> | Saldo autorizado pendente: <strong>@div.SaldoReposicaoPendente.ToString("0.####") @div.Unidade</strong><br />
            <small class="text-muted">Justificativa da autorização: @(div.ReposicaoJustificativa ?? "Reposição pactuada")</small>
        </p>
    </div>
}

<details class="panel mb-3"><summary class="fw-semibold">Para que serve e como funciona</summary><div class="mt-3"><h2 class="h6">Para que serve</h2><p>Registrar a entrega física, inclusive parcial ou de reposição autorizada, vinculada ao pedido.</p><h2 class="h6">Como funciona</h2><p>Escolha o destino, informe o documento e ajuste somente os itens efetivamente entregues.</p><h2 class="h6">Antes de começar</h2><p>Confirme documento, destino, quantidades e dados de lote, validade ou série quando aplicáveis.</p><h2 class="h6">Regras importantes</h2><p>O servidor recalcula o saldo pendente sob bloqueio; reenvios não duplicam estoque. Itens sujeitos a inspeção ficam indisponíveis.</p><h2 class="h6">Próximo passo</h2><p>O detalhe persistido será aberto. Se houver inspeção, um usuário autorizado deverá concluir a conferência.</p></div></details>
<form method="post" class="panel" data-recebimento-form>
@Html.AntiForgeryToken()<input type="hidden" name="pedidoVersion" value="@Model.Version" /><input type="hidden" name="idempotencyKey" value="@key" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" tabindex="-1"></div>
<div class="recebimento-cabecalho"><div><label for="almoxarifadoId" class="form-label">Destino <span aria-label="obrigatório">*</span></label><select id="almoxarifadoId" name="almoxarifadoId" class="form-select" required><option value="">Selecione o almoxarifado</option>@foreach(var a in Model.Almoxarifados){<option value="@a.Id">@a.Nome</option>}</select></div><div><label for="documento" class="form-label">Documento <span aria-label="obrigatório">*</span></label><input id="documento" name="documento" class="form-control" maxlength="100" required placeholder="Nota Fiscal / Comprovante" /></div><div><label for="dataOperacao" class="form-label">Data da operação <span aria-label="obrigatório">*</span></label><input id="dataOperacao" name="dataOperacao" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required /></div></div>
<div class="table-responsive recebimento-itens">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Receber</th>
                <th>Produto</th>
                <th>Pedido</th>
                <th>Cancelado</th>
                <th>Físico</th>
                <th>Aceito</th>
                <th>Conferência</th>
                <th>Pendente</th>
                <th>Quantidade</th>
                <th>Rastreio</th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Itens.Count; i++)
        {
            var item = Model.Itens[i];
            var itemEhReposicao = ehReposicao && item.Produto == div!.Produto;
            var selecionadoPadrao = ehReposicao ? itemEhReposicao : (item.QuantidadePendente > 0);
            var maxQtd = itemEhReposicao ? div!.SaldoReposicaoPendente : item.QuantidadePendente;
            var valQtd = itemEhReposicao ? div!.SaldoReposicaoPendente : item.QuantidadePendente;
            <tr>
                <td>
                    <input class="form-check-input item-toggle" type="checkbox" @(selecionadoPadrao ? "checked" : "") aria-label="Selecionar @item.Produto" />
                </td>
                <td>
                    <strong>@item.Produto</strong>
                    <input type="hidden" name="itens[@i].PedidoItemId" value="@item.Id" />
                    @if (itemEhReposicao)
                    {
                        <input type="hidden" name="itens[@i].DivergenciaOrigemId" value="@div!.Id" />
                        <div><span class="badge text-bg-primary">Reposição Div #@div!.Id</span></div>
                    }
                </td>
                <td>@item.QuantidadePedida @item.Unidade</td>
                <td>@item.QuantidadeCancelada</td>
                <td>@item.QuantidadeFisica</td>
                <td>@item.QuantidadeAceita</td>
                <td>@item.QuantidadeEmConferencia</td>
                <td>
                    @if (itemEhReposicao)
                    {
                        <span class="text-primary fw-bold">@div!.SaldoReposicaoPendente (rep.)</span>
                    }
                    else
                    {
                        <strong>@item.QuantidadePendente</strong>
                    }
                </td>
                <td>
                    <div class="input-group">
                        <input name="itens[@i].Quantidade" type="number" min="0.0001" max="@maxQtd" step="0.0001" value="@valQtd" class="form-control item-value" @(!selecionadoPadrao ? "disabled" : "") required />
                        <span class="input-group-text">@item.Unidade</span>
                    </div>
                    @if (item.ExigeInspecao)
                    {
                        <small class="text-warning-emphasis">Exige conferência antes de ficar disponível.</small>
                    }
                </td>
                <td>
                    <input name="itens[@i].Lote" class="form-control form-control-sm mb-1" placeholder="Lote (se aplicável)" />
                    <input name="itens[@i].Validade" type="date" class="form-control form-control-sm mb-1" aria-label="Validade de @item.Produto" />
                    <input name="itens[@i].NumeroSerie" class="form-control form-control-sm" placeholder="Série (se aplicável)" />
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div><label for="observacoes" class="form-label">Observações</label><textarea id="observacoes" name="observacoes" class="form-control" rows="3" placeholder="Informações adicionais da entrega..."></textarea></div>
<aside class="alert alert-info mt-3"><strong>Como usar:</strong> desmarque itens não entregues e ajuste as quantidades. Não há tolerância automática: o sistema bloqueia qualquer valor acima do saldo pendente ou autorizado.</aside>
<div class="action-bar"><a class="btn btn-outline-secondary" asp-action="Recebimentos">Cancelar</a><button type="submit" class="btn btn-primary" data-submit>Revisar e confirmar recebimento</button></div></form>
<script nonce="@Context.Items["CspNonce"]">document.querySelectorAll('.item-toggle').forEach(c=>c.addEventListener('change',()=>{const input=c.closest('tr').querySelector('.item-value');input.disabled=!c.checked;input.required=c.checked;}));document.querySelector('[data-recebimento-form]')?.addEventListener('submit',e=>{const b=e.currentTarget.querySelector('[data-submit]');if(b.disabled){e.preventDefault();return;}b.disabled=true;b.textContent='Confirmando…';});if(document.querySelector('.validation-summary-errors'))document.querySelector('.validation-summary-errors').focus();</script>
