@using Sigov.Application.ComprasEmpresariais
@model CentralRecebimentos
@{ViewData["Title"]="Relatório de recebimentos";var f=(RecebimentoFiltro?)ViewData["Filtro"]??new();}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">RELATÓRIO OPERACIONAL</span><h1>Recebimentos e conferências</h1><p>Totais e registros do tenant corrente, conforme os filtros aplicados. Cancelados não existem nesta jornada; divergências permanecem visíveis.</p></div><a class="btn btn-primary" href="@Url.Action("ExportarRecebimentos",new{f.Fornecedor,f.Pedido,f.Status,f.DataInicial,f.DataFinal})">Exportar CSV</a></header>
<details class="panel mb-3"><summary class="fw-semibold">Para que serve e como funciona</summary><p class="mt-3">Use os mesmos filtros da central para conferir volumes e abrir os registros que formam os totais. A exportação respeita tenant e permissão, limita-se a 100 linhas e neutraliza fórmulas de planilha.</p></details>
<section class="recebimento-totais" aria-label="Totais filtrados"><article><strong>@Model.Totais.EmConferencia</strong><span>Em conferência</span></article><article><strong>@Model.Totais.Concluidos</strong><span>Concluídos</span></article><article><strong>@Model.Totais.Divergencias</strong><span>Com divergência</span></article></section>
<section class="panel"><form method="get" class="recebimento-filtros"><div><label for="pedido" class="form-label">Pedido</label><input id="pedido" name="pedido" value="@f.Pedido" class="form-control"/></div><div><label for="fornecedor" class="form-label">Fornecedor</label><input id="fornecedor" name="fornecedor" value="@f.Fornecedor" class="form-control"/></div><div><label for="status" class="form-label">Situação</label><select id="status" name="status" class="form-select"><option value="">Todas</option>@foreach(var s in new[]{"EM_CONFERENCIA","CONCLUIDO","COM_DIVERGENCIA"}){<option value="@s" selected="@(f.Status==s)">@s.Replace('_',' ')</option>}</select></div><div class="filter-actions"><button class="btn btn-primary">Aplicar</button><a class="btn btn-outline-secondary" asp-action="Relatorios">Limpar</a></div></form></section>
<section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Pedido</th><th>Fornecedor</th><th>Documento</th><th>Situação</th><th>Data</th></tr></thead><tbody>@foreach(var item in Model.Resultado.Items){<tr><td><a asp-action="Recebimento" asp-route-id="@item.Id">@item.PedidoNumero</a></td><td>@item.FornecedorNome</td><td>@item.Documento</td><td>@item.Status.Replace('_',' ')</td><td>@item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div>@if(Model.Resultado.Items.Count==0){<div class="empty-state">Nenhum registro corresponde aos filtros.</div>}</section>
