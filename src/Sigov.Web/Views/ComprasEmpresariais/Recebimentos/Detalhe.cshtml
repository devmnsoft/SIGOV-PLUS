@using Sigov.Web.Models
@model InspecaoRecebimentoViewModel
@{var r=Model.Recebimento;ViewData["Title"]=$"Recebimento {r.Documento}";var emConferencia=r.Status=="EM_CONFERENCIA";}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" />
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Recebimentos">Recebimentos</a></li><li class="breadcrumb-item active">@r.Documento</li></ol></nav>
<header class="compras-header"><div><span class="eyebrow">RECEBIMENTO E TRATAMENTO</span><h1>@r.Documento</h1><p>Pedido <strong>@r.PedidoNumero</strong> · @r.Fornecedor · destino @r.Almoxarifado</p></div><span class="status-badge">@r.Status.Replace('_',' ')</span></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
<details class="panel mb-3" open><summary class="fw-semibold">Para que serve e como executar</summary><div class="mt-3"><p><strong>Para que serve:</strong> classificar a conferência física e acompanhar rejeições sem alterar a decisão original.</p><p><strong>Quando usar e pré-requisitos:</strong> use durante a conferência, com permissão e versão atual.</p><p><strong>Como executar:</strong> distribua integralmente cada quantidade entre aceita e rejeitada; rejeição exige motivo.</p><p><strong>Efeito:</strong> somente o aceito entra no estoque. Encerramento posterior é administrativo e não comprova devolução, reposição, pagamento ou correção contratual.</p><p><strong>Próximo passo:</strong> trate cada divergência na central até a conclusão da pendência agregada.</p></div></details>
@if(Model.Conflito){<section class="alert alert-warning" role="alert" tabindex="-1"><h2 class="h5">Conflito concorrente</h2><p>@Model.MensagemConflito</p><p>Decisão tentada: versão @Model.Version. Estado atual: versão @Model.VersaoAtual, situação @r.Status. Seus valores permanecem abaixo.</p><a class="btn btn-warning" asp-action="Recebimento" asp-route-id="@r.Id">Revisar estado e iniciar nova tentativa</a></section>}
<section class="panel"><h2 class="h5">Físico e decisão da inspeção</h2><form asp-action="ConcluirInspecao" asp-route-id="@r.Id" method="post" data-single-submit>@Html.AntiForgeryToken()<input asp-for="Version" type="hidden"/><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger" tabindex="-1"></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Produto</th><th>Físico</th><th>Aceito</th><th>Rejeitado</th><th>Ainda em conferência</th><th>Rastreio</th></tr></thead><tbody>@for(var i=0;i<r.Itens.Count;i++){var item=r.Itens[i];var decision=Model.Itens.FindIndex(x=>x.RecebimentoItemId==item.Id);<tr><td><strong>@item.Produto</strong></td><td>@item.QuantidadeFisica @item.Unidade</td><td>@if(emConferencia&&decision>=0){<input asp-for="Itens[decision].RecebimentoItemId" type="hidden"/><input asp-for="Itens[decision].QuantidadeAceita" class="form-control" inputmode="decimal" pattern="[0-9]+([,.][0-9]{1,4})?" aria-describedby="aceito-@decision"/><span asp-validation-for="Itens[decision].QuantidadeAceita" id="aceito-@decision" class="text-danger"></span>}else{@item.QuantidadeAceita}</td><td>@if(emConferencia&&decision>=0){<input asp-for="Itens[decision].QuantidadeRejeitada" class="form-control" inputmode="decimal" pattern="[0-9]+([,.][0-9]{1,4})?" aria-describedby="rejeitado-@decision"/><span asp-validation-for="Itens[decision].QuantidadeRejeitada" id="rejeitado-@decision" class="text-danger"></span>}else{@item.QuantidadeRejeitada}</td><td>@item.QuantidadeConferencia</td><td><small>Lote: @(item.Lote??"—")<br/>Validade: @(item.Validade?.ToString("dd/MM/yyyy")??"—")<br/>Série: @(item.NumeroSerie??"—")</small></td></tr>}</tbody></table></div>
@if(emConferencia){<label asp-for="Justificativa" class="form-label">Justificativa da rejeição</label><textarea asp-for="Justificativa" maxlength="1000" rows="3" class="form-control"></textarea><span asp-validation-for="Justificativa" class="text-danger"></span><div class="action-bar"><a class="btn btn-outline-secondary" asp-action="Recebimentos">Voltar</a><button class="btn btn-primary" type="submit">Concluir conferência</button></div>}</form></section>
<section class="panel mt-3"><div class="section-title"><h2 class="h5">Situação do tratamento</h2><a asp-action="Divergencias" asp-route-recebimentoId="@r.Id">Abrir central</a></div><p>Resultado do recebimento: <strong>@r.ResultadoInspecao.Replace('_',' ')</strong>. O tratamento administrativo é exibido separadamente.</p>@if(Model.Divergencias.Count==0){<p class="text-muted">Nenhuma divergência vinculada.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Produto</th><th>Rejeitado</th><th>Situação</th><th>Responsável</th><th>Próxima ação</th></tr></thead><tbody>@foreach(var d in Model.Divergencias){<tr><td>@d.Produto</td><td>@d.QuantidadeRejeitada @d.Unidade</td><td>@d.Situacao.Replace('_',' ')</td><td>@(d.ResponsavelNome??"Não atribuída")</td><td><a asp-action="Divergencia" asp-route-id="@d.Id" asp-route-returnUrl="@Context.Request.Path">@(d.Situacao=="ENCERRADA"?"Consultar":"Tratar")</a></td></tr>}</tbody></table></div>}</section>
<section class="panel mt-3"><h2 class="h5">Histórico do recebimento</h2><ol>@foreach(var e in r.Historico){<li><strong>@e.Tipo.Replace('_',' ')</strong> · @e.OcorridoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>}</ol></section>
<script>document.querySelector('[data-single-submit]')?.addEventListener('submit',e=>{const b=e.currentTarget.querySelector('button[type=submit]');if(b?.disabled){e.preventDefault();return}if(b){b.disabled=true;b.setAttribute('aria-disabled','true');b.textContent='Salvando…'}});document.querySelector('.validation-summary-errors,.alert-warning')?.focus();</script>
