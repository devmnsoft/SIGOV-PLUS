@using Sigov.Application.ComprasEmpresariais
@model RecebimentoDetalhe
@{ViewData["Title"]=$"Recebimento {Model.Documento}";var emConferencia=Model.Status=="EM_CONFERENCIA";var indiceDecisao=0;var versaoSubmetida=ViewData["SubmittedVersion"] as long? ?? Model.Version;var justificativaInformada=ViewData["JustificativaInformada"] as string;}
<link rel="stylesheet" href="~/css/compras-empresariais.css" />
<partial name="../Shared/_ComprasNav" />
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Recebimentos">Recebimentos</a></li><li class="breadcrumb-item active" aria-current="page">@Model.Documento</li></ol></nav>
<header class="compras-header"><div><span class="eyebrow">CONFERÊNCIA DE RECEBIMENTO</span><h1>@Model.Documento</h1><p>Pedido <strong>@Model.PedidoNumero</strong> · @Model.Fornecedor · destino @Model.Almoxarifado</p></div><span class="status-badge" role="status">@Model.Status.Replace('_',' ')</span></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
<details class="panel mb-3" open><summary class="fw-semibold">Para que serve e como funciona</summary><div class="mt-3"><h2 class="h6">Para que serve</h2><p>Confirma a inspeção dos itens retidos e libera no estoque somente a quantidade aceita.</p><h2 class="h6">Como funciona</h2><p>Classifique integralmente cada quantidade em conferência entre aceita e rejeitada. A conclusão é atômica e fica no histórico.</p><h2 class="h6">Antes de começar</h2><p>Confira documento, lote, validade, série, produto e destino. É necessária a permissão de inspeção.</p><h2 class="h6">Regras importantes</h2><p>Os totais não podem ser alterados; rejeição exige justificativa. Uma versão desatualizada é recusada sem gravação parcial.</p><h2 class="h6">Próximo passo</h2><p>Itens aceitos entram no saldo. Rejeições deixam o recebimento com divergência para consulta e relatório; não geram entrada.</p></div></details>
<section class="panel"><div class="section-title"><h2 class="h5">Itens e decisão</h2><p>Operação em @Model.DataOperacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>
<form asp-action="ConcluirInspecao" asp-route-id="@Model.Id" method="post" data-recebimento-form>@Html.AntiForgeryToken()<input type="hidden" name="version" value="@versaoSubmetida"/><div asp-validation-summary="ModelOnly" class="alert alert-danger" tabindex="-1"></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Produto</th><th>Físico</th><th>Aceito</th><th>Rejeitado</th><th>Em conferência</th><th>Rastreio</th></tr></thead><tbody>@foreach(var item in Model.Itens){var campo=$"itens[{indiceDecisao}]";<tr><td><strong>@item.Produto</strong>@if(emConferencia&&item.QuantidadeConferencia>0){<input type="hidden" name="@(campo).RecebimentoItemId" value="@item.Id"/>}</td><td>@item.QuantidadeFisica @item.Unidade</td><td>@if(emConferencia&&item.QuantidadeConferencia>0){<input class="form-control" name="@(campo).QuantidadeAceita" type="number" min="0" max="@item.QuantidadeConferencia.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.0001" value="@item.QuantidadeConferencia.ToString(System.Globalization.CultureInfo.InvariantCulture)" inputmode="decimal" required/><span class="text-danger" data-valmsg-for="@(campo).QuantidadeAceita"></span>}else{@item.QuantidadeAceita}</td><td>@if(emConferencia&&item.QuantidadeConferencia>0){<input class="form-control" name="@(campo).QuantidadeRejeitada" type="number" min="0" max="@item.QuantidadeConferencia.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.0001" value="0" inputmode="decimal" required/><span class="text-danger" data-valmsg-for="@(campo).QuantidadeRejeitada"></span>}else{@item.QuantidadeRejeitada}</td><td>@item.QuantidadeConferencia</td><td><small>Lote: @(item.Lote??"—")<br/>Validade: @(item.Validade?.ToString("dd/MM/yyyy")??"—")<br/>Série: @(item.NumeroSerie??"—")</small></td></tr>@if(emConferencia&&item.QuantidadeConferencia>0){indiceDecisao++;}}</tbody></table></div>
@if(emConferencia){<div class="mb-3"><label for="justificativa" class="form-label">Justificativa da rejeição</label><textarea id="justificativa" name="justificativa" maxlength="1000" rows="3" class="form-control" aria-describedby="justificativa-ajuda">@justificativaInformada</textarea><small id="justificativa-ajuda">Obrigatória se qualquer quantidade for rejeitada.</small></div><div class="alert alert-info">Em caso de conflito, revise o estado atual. A versão originalmente enviada é preservada e o comando não será reaplicado automaticamente.</div><div class="action-bar"><a class="btn btn-outline-secondary" asp-action="Recebimentos">Voltar</a><button class="btn btn-primary" type="submit" data-submit>Concluir conferência</button></div>}else{<a class="btn btn-outline-secondary" asp-action="Recebimentos">Voltar à central</a>}</form></section>
<section class="panel mt-3"><h2 class="h5">Histórico</h2>@if(Model.Historico.Count==0){<p class="text-muted">Nenhum evento registrado.</p>}else{<ol>@foreach(var evento in Model.Historico){<li><strong>@evento.Tipo.Replace('_',' ')</strong> · @evento.OcorridoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>}</ol>}</section>
<script>document.querySelector('[data-recebimento-form]')?.addEventListener('submit',e=>{const b=e.currentTarget.querySelector('[data-submit]');if(b?.disabled){e.preventDefault();return;}if(b){b.disabled=true;b.textContent='Concluindo…';}});document.querySelector('.validation-summary-errors')?.focus();</script>
