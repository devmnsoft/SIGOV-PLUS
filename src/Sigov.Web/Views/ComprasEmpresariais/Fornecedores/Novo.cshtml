@{ViewData["Title"]="Novo fornecedor";}
<link rel="stylesheet" href="~/css/compras-empresariais.css" asp-append-version="true" /><partial name="../Shared/_ComprasNav" />
<header class="compras-header"><div><h1>Novo fornecedor</h1><p>Os dados fiscais são protegidos e mascarados após o cadastro.</p></div></header>
<form id="fornecedor-form" class="compras-form"><label>Tipo<select name="tipoPessoa" class="form-select" required><option value="J">Pessoa jurídica</option><option value="F">Pessoa física</option></select></label><label>CPF/CNPJ<input name="documento" class="form-control" required /></label><label>Razão social<input name="razaoSocial" class="form-control" required /></label><label>Nome fantasia<input name="nomeFantasia" class="form-control" /></label><label>Categoria<input name="categoria" class="form-control" /></label><label>Condição de pagamento<input name="condicaoPagamento" class="form-control" /></label><div class="form-actions"><button class="btn btn-primary" type="submit">Salvar fornecedor</button><a class="btn btn-outline-secondary" href="/ComprasEmpresariais/Fornecedores">Cancelar</a></div><p class="form-feedback" role="status" aria-live="polite"></p></form>
<script type="module" src="~/js/compras/compras-fornecedores.js" asp-append-version="true"></script>
