@using Sigov.Application.ComprasEmpresariais
@model CentralDivergencias
@{ViewData["Title"]="Central de divergências";var f=(DivergenciaFiltro?)ViewData["Filtro"]??new();var current=Context.Request.Path+Context.Request.QueryString;}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" />
<header class="compras-header"><div><span class="eyebrow">TRATAMENTO DE RECEBIMENTOS</span><h1>Central de divergências</h1><p>Atribua, registre providências e encerre ocorrências com histórico auditável.</p></div><a class="btn btn-outline-primary" asp-action="ExportarDivergencias" asp-all-route-data="@Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString())">Exportar CSV completo</a></header><p class="form-text">A exportação percorre todas as páginas filtradas, com limite explícito de 50.000 ocorrências; acima disso, refine os filtros e nenhum arquivo parcial será entregue.</p>
<details class="panel mb-3" open><summary class="fw-semibold">Ajuda da jornada</summary><div class="mt-3"><p><strong>Para que serve:</strong> acompanhar itens rejeitados desde a abertura até o encerramento administrativo.</p><p><strong>Quando usar:</strong> após uma inspeção com divergência. <strong>Pré-requisitos:</strong> contexto empresarial válido e permissões específicas.</p><p><strong>Como executar:</strong> filtre, abra a ocorrência, atribua um responsável elegível, registre andamentos e encerre com resultado.</p><p><strong>Regras e efeito:</strong> o tratamento não altera quantidades, estoque, pagamento nem comprova devolução/reposição.</p><p><strong>Próximo passo:</strong> quando a última ocorrência for encerrada, a pendência agregada é concluída com histórico.</p></div></details>
<section class="recebimento-totais" aria-label="Contadores filtrados"><article><strong>@Model.Totais.Total</strong><span>Ocorrências</span></article><article><strong>@Model.Totais.Abertas</strong><span>Abertas</span></article><article><strong>@Model.Totais.EmTratamento</strong><span>Em tratamento</span></article><article><strong>@Model.Totais.Encerradas</strong><span>Encerradas</span></article></section>
<section class="panel"><h2 class="h5">Filtros</h2><form method="get" class="divergencia-filtros"><div><label for="fornecedor">Fornecedor</label><input id="fornecedor" name="fornecedor" value="@f.Fornecedor" class="form-control"/></div><div><label for="produto">Produto</label><input id="produto" name="produto" value="@f.Produto" class="form-control"/></div><div><label for="situacao">Situação</label><select id="situacao" name="situacao" class="form-select"><option value="">Todas</option>@foreach(var s in new[]{"ABERTA","EM_TRATAMENTO","ENCERRADA"}){<option selected="@(f.Situacao==s)" value="@s">@s.Replace('_',' ')</option>}</select></div><div><label for="responsavelId">Responsável (UUID)</label><input id="responsavelId" name="responsavelId" value="@f.ResponsavelId" class="form-control"/></div><div class="form-check"><input id="naoAtribuidas" name="naoAtribuidas" value="true" checked="@f.NaoAtribuidas" type="checkbox" class="form-check-input"/><label for="naoAtribuidas">Somente não atribuídas</label></div><div><label for="aberturaInicial">Abertura de</label><input id="aberturaInicial" name="aberturaInicial" type="date" value="@f.AberturaInicial?.ToString("yyyy-MM-dd")" class="form-control"/></div><div><label for="aberturaFinal">Abertura até</label><input id="aberturaFinal" name="aberturaFinal" type="date" value="@f.AberturaFinal?.ToString("yyyy-MM-dd")" class="form-control"/></div><div><label for="encerramentoInicial">Encerramento de</label><input id="encerramentoInicial" name="encerramentoInicial" type="date" value="@f.EncerramentoInicial?.ToString("yyyy-MM-dd")" class="form-control"/></div><div><label for="encerramentoFinal">Encerramento até</label><input id="encerramentoFinal" name="encerramentoFinal" type="date" value="@f.EncerramentoFinal?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="filter-actions"><button class="btn btn-primary">Aplicar</button><a class="btn btn-outline-secondary" asp-action="Divergencias">Limpar</a></div></form></section>
<section class="panel mt-3"><div class="section-title"><h2 class="h5">Ocorrências</h2><span role="status">@Model.Resultado.TotalItems registro(s); @Model.Totais.NaoAtribuidas sem responsável</span></div>@if(Model.Resultado.Items.Count==0){<div class="empty-state"><h3 class="h5">Nenhuma divergência encontrada</h3><p>Não há ocorrências no conjunto autorizado com estes filtros.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Documento/pedido</th><th>Fornecedor</th><th>Produto/unidade</th><th>Quantidade</th><th>Motivo</th><th>Situação</th><th>Responsável</th><th>Abertura/encerramento</th><th>Providência</th><th></th></tr></thead><tbody>@foreach(var d in Model.Resultado.Items){<tr><td>@d.Documento<br/><small>@d.PedidoNumero</small></td><td>@d.Fornecedor</td><td>@d.Produto / @d.Unidade</td><td>@d.QuantidadeRejeitada</td><td>@d.Motivo</td><td>@d.Situacao.Replace('_',' ')</td><td>@(d.ResponsavelNome??"Não atribuída")</td><td>@d.AbertaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br/>@(d.EncerradaEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</td><td>@(d.Providencia??"—")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Divergencia" asp-route-id="@d.Id" asp-route-returnUrl="@current">@(d.Situacao=="ENCERRADA"?"Consultar":"Tratar")</a></td></tr>}</tbody></table></div>}</section>
