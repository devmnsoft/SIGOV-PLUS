@using Sigov.Web.Models
@model DivergenciaDetalheViewModel
@{var d=Model.Divergencia;ViewData["Title"]=$"Divergência {d.Id}";}
<link rel="stylesheet" href="~/css/compras-empresariais.css" /><partial name="../Shared/_ComprasNav" />
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="@(Model.ReturnUrl??Url.Action("Divergencias"))">Divergências</a></li><li class="breadcrumb-item active">Ocorrência @d.Id</li></ol></nav>
<header class="compras-header"><div><span class="eyebrow">TRATAMENTO ADMINISTRATIVO</span><h1>@d.Produto</h1><p>@d.Documento · pedido @d.PedidoNumero · @d.Fornecedor</p></div><span class="status-badge">@d.Situacao.Replace('_',' ')</span></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert" tabindex="-1">@error</div>}
<details class="panel mb-3" open><summary class="fw-semibold">Para que serve e regras</summary><div class="mt-3"><p><strong>Para que serve:</strong> preservar responsáveis, andamentos e resultado da rejeição.</p><p><strong>Pré-requisitos e execução:</strong> atribua pessoa ativa no vínculo canônico; depois registre andamento e encerre com justificativa.</p><p><strong>Efeito:</strong> o encerramento é exclusivamente administrativo. Não aceita mercadoria, não movimenta estoque, não comprova devolução/reposição e não libera pagamento.</p><p><strong>Próximo passo:</strong> consulte o histórico; a última divergência encerra a pendência agregada.</p></div></details>
<section class="panel"><h2 class="h5">Decisão original (imutável)</h2><dl class="row"><dt class="col-sm-3">Quantidade rejeitada</dt><dd class="col-sm-9">@d.QuantidadeRejeitada @d.Unidade</dd><dt class="col-sm-3">Motivo</dt><dd class="col-sm-9">@d.Motivo</dd><dt class="col-sm-3">Resultado do recebimento</dt><dd class="col-sm-9">Com divergência</dd><dt class="col-sm-3">Situação do tratamento</dt><dd class="col-sm-9">@d.Situacao.Replace('_',' ')</dd></dl></section>
@if(d.Situacao!="ENCERRADA"){
<section class="divergencia-acoes mt-3" aria-label="Ações permitidas"><form class="panel" asp-action="AtribuirDivergencia" asp-route-id="@d.Id" method="post" data-single-submit>@Html.AntiForgeryToken()<h2 class="h5">Atribuir ou redistribuir</h2><input name="version" value="@d.Version" type="hidden"/><input name="idempotencyKey" value="@Model.IdempotencyKey-atribuir" type="hidden"/><input name="returnUrl" value="@Model.ReturnUrl" type="hidden"/><label for="responsavelId">Responsável ativo</label><select id="responsavelId" name="responsavelId" class="form-select" required><option value="">Selecione pelo nome</option>@foreach(var p in Model.Responsaveis){<option value="@p.UsuarioId" selected="@(p.UsuarioId==d.ResponsavelId)">@p.Nome — @(p.Unidade??p.Vinculo??"vínculo ativo")</option>}</select><span class="form-text">A atribuição não concede acesso ao recebimento.</span><button class="btn btn-primary mt-3">Salvar responsável</button></form>
@if(d.Situacao=="EM_TRATAMENTO"){<form class="panel" asp-action="AndamentoDivergencia" asp-route-id="@d.Id" method="post" data-single-submit>@Html.AntiForgeryToken()<h2 class="h5">Registrar andamento</h2><input name="version" value="@d.Version" type="hidden"/><input name="idempotencyKey" value="@Model.IdempotencyKey-andamento" type="hidden"/><input name="returnUrl" value="@Model.ReturnUrl" type="hidden"/><label for="descricao">Descrição</label><textarea id="descricao" name="descricao" minlength="3" maxlength="2000" required class="form-control"></textarea><label for="providencia" class="mt-2">Providência administrativa registrada</label><input id="providencia" name="providencia" maxlength="40" class="form-control" aria-describedby="providencia-help"/><small id="providencia-help">Descreva somente ação efetivamente realizada; não informe devolução ou reposição sem operação canônica.</small><button class="btn btn-primary mt-3">Adicionar ao histórico</button></form>
<form class="panel border-warning" asp-action="EncerrarDivergencia" asp-route-id="@d.Id" method="post" data-single-submit data-confirm-close>@Html.AntiForgeryToken()<h2 class="h5">Encerrar tratamento</h2><input name="version" value="@d.Version" type="hidden"/><input name="idempotencyKey" value="@Model.IdempotencyKey-encerrar" type="hidden"/><input name="returnUrl" value="@Model.ReturnUrl" type="hidden"/><label for="resultado">Resultado administrativo</label><textarea id="resultado" name="resultado" minlength="3" maxlength="2000" required class="form-control"></textarea><label for="justificativa" class="mt-2">Justificativa do encerramento</label><textarea id="justificativa" name="justificativa" minlength="10" maxlength="2000" required class="form-control"></textarea><div class="alert alert-warning mt-3">Confirme: a decisão original e o estoque não serão alterados. Esta ação apenas encerra o acompanhamento administrativo.</div><button class="btn btn-warning">Confirmar encerramento</button></form>}</section>}
<section class="panel mt-3"><h2 class="h5">Histórico confiável</h2>@if(d.Historico.Count==0){<p class="text-danger">Inconsistência: nenhum evento de abertura foi localizado; não há autoria histórica presumida.</p>}else{<ol class="timeline">@foreach(var e in d.Historico){<li><strong>@e.Tipo.Replace('_',' ')</strong> · @e.OcorridoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")<br/><span>@e.Autor</span>@if(e.Descricao is not null){<p>@e.Descricao</p>}@if(e.Providencia is not null){<p>Providência: @e.Providencia</p>}<small>Correlação: @(e.CorrelationId??"não informada")</small></li>}</ol>}</section>
<div class="action-bar"><a class="btn btn-outline-secondary" href="@(Model.ReturnUrl??Url.Action("Divergencias"))">Voltar preservando filtros</a></div>
<script>document.querySelectorAll('[data-single-submit]').forEach(f=>f.addEventListener('submit',e=>{const b=f.querySelector('button[type=submit],button:not([type])');if(b?.disabled){e.preventDefault();return}if(f.hasAttribute('data-confirm-close')&&!confirm('Encerrar somente o acompanhamento administrativo desta divergência?')){e.preventDefault();return}if(b){b.disabled=true;b.setAttribute('aria-disabled','true');b.textContent='Salvando…'}}));document.querySelector('[role=alert]')?.focus();</script>
