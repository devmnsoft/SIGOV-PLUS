@model long
<h1>Publicação do Diário Oficial</h1><input id="diario-id" value="@Model" type="hidden" /><div id="diario-detalhe" class="card card-body">Carregando...</div><form id="ato-form" class="card card-body mt-3">@Html.AntiForgeryToken()<h2>Adicionar ato oficial</h2><input name="tipoAto" class="form-control mb-2" placeholder="Tipo do ato" required /><input name="titulo" class="form-control mb-2" placeholder="Título" required /><textarea name="texto" class="form-control" required></textarea><button class="btn btn-primary mt-2" type="submit">Adicionar ato</button></form><button id="publicar-diario" class="btn btn-success mt-3">Publicar edição</button>
@section Scripts { <script src="~/js/modules/processos.diario-oficial.js"></script> }
