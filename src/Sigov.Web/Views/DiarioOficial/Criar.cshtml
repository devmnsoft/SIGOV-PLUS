@model Sigov.Web.Models.Processos.DiarioPublicacaoFormViewModel
<h1>Nova publicação</h1><form id="diario-form" class="card card-body">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-3"><label asp-for="NumeroEdicao" class="form-label"></label><input asp-for="NumeroEdicao" class="form-control" required /></div><div class="col-md-3"><label asp-for="DataPublicacao" class="form-label"></label><input asp-for="DataPublicacao" type="date" class="form-control" required /></div><div class="col-md-6"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" required /></div><div class="col-12"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control"></textarea></div></div><button class="btn btn-primary mt-3" type="submit">Salvar</button></form>
@section Scripts { <script src="~/js/modules/processos.diario-oficial.js"></script> }
