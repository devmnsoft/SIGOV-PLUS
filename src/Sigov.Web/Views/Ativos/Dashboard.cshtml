@model Sigov.Web.Models.Ativos.AtivosDashboardViewModel
@{ ViewData["Title"] = "Ativos360"; long S(string key) => Model.Patrimonio.PorSituacao.GetValueOrDefault(key); }
<link rel="stylesheet" href="~/css/ativos360.css" asp-append-version="true" />
<main class="ativos-shell">
 <header class="ativos-hero"><div><span class="ativos-kicker">GESTÃO INTEGRADA</span><h1>Ativos360</h1><p>Patrimônio, almoxarifado e frota com rastreabilidade operacional.</p></div><a class="btn btn-light" href="/Ativos/Relatorios">Exportar relatórios</a></header>
 <form method="get" class="ativos-filter" aria-label="Filtros do dashboard"><div><label for="status">Status</label><select id="status" name="status" class="form-select"><option value="">Todos</option><option>ATIVO</option><option>MANUTENCAO</option><option>BAIXADO</option></select></div><div><label for="inicio">Início</label><input id="inicio" name="inicio" type="date" value="@Model.Inicio?.ToString("yyyy-MM-dd")" class="form-control" /></div><div><label for="fim">Fim</label><input id="fim" name="fim" type="date" value="@Model.Fim?.ToString("yyyy-MM-dd")" class="form-control" /></div><button class="btn btn-primary">Aplicar filtros</button></form>
 <section class="ativos-grid" aria-label="Indicadores principais">
  @foreach(var card in new[]{("Bens patrimoniais",Model.Patrimonio.TotalBens,"patrimonio"),("Bens ativos",S("ATIVO"),"success"),("Em manutenção",S("MANUTENCAO"),"warning"),("Cedidos",S("CEDIDO"),"info"),("Transferidos",S("TRANSFERIDO"),"info"),("Baixados",S("BAIXADO"),"muted"),("Estoque crítico",Model.Almoxarifado.AbaixoMinimo,"danger"),("Requisições pendentes",Model.Almoxarifado.RequisicoesPendentes,"warning"),("Veículos ativos",Model.Frotas.VeiculosAtivos,"success"),("Veículos em manutenção",Model.Frotas.VeiculosEmManutencao,"warning"),("Abastecimentos no mês",Model.Frotas.AbastecimentosMes,"info"),("Manutenções abertas",Model.Frotas.ManutencoesAbertas,"danger"),("Inventários em andamento",Model.Patrimonio.InventariosAbertos,"patrimonio"))){<article class="ativo-card @card.Item3"><span>@card.Item1</span><strong>@card.Item2.ToString("N0")</strong></article>}
 </section>
 <section class="row g-3 mt-1"><div class="col-lg-7"><article class="ativos-panel"><div class="panel-title"><h2>Estoque crítico</h2><a href="/Ativos/Estoque">Ver estoque</a></div>@if(Model.Almoxarifado.BaixoEstoque.Count==0){<div class="empty-state">Nenhum item abaixo do estoque mínimo.</div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Produto</th><th>Almoxarifado</th><th>Saldo</th><th>Mínimo</th></tr></thead><tbody>@foreach(var x in Model.Almoxarifado.BaixoEstoque.Take(8)){<tr><td>@x.MaterialCodigo — @x.MaterialDescricao</td><td>@x.LocalNome</td><td><span class="badge text-bg-danger">@x.Quantidade</span></td><td>@x.EstoqueMinimo</td></tr>}</tbody></table></div>}</article></div><div class="col-lg-5"><article class="ativos-panel"><div class="panel-title"><h2>Frota e alertas</h2><a href="/Ativos/Frotas">Abrir frota</a></div><ul class="alert-list"><li><span>Documentos vencidos</span><b class="badge text-bg-danger">@Model.Frotas.DocumentosVencidos</b></li><li><span>Documentos próximos</span><b class="badge text-bg-warning">@Model.Frotas.DocumentosAVencer</b></li><li><span>Custo no mês</span><b>@Model.Frotas.CustoMensal.ToString("C")</b></li><li><span>Divergências de inventário</span><b class="badge text-bg-warning">@Model.Patrimonio.DivergenciasPendentes</b></li></ul></article></div></section>
 <nav class="ativos-shortcuts" aria-label="Áreas do Ativos360"><a href="/Ativos/Almoxarifados">Almoxarifados</a><a href="/Ativos/Requisicoes">Requisições</a><a href="/Ativos/Patrimonio">Patrimônio</a><a href="/Ativos/Inventarios">Inventários</a><a href="/Ativos/Frotas">Frotas</a><a href="/Ativos/Alertas">Alertas</a></nav>
</main>
