<div class="modal fade" id="modalPagar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form id="form-modal-pagar" class="modal-content" novalidate onsubmit="return false">
      <div class="modal-header">
        <h5 class="modal-title">Efetuar pagamento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="fin-pag-liquidacao-id" name="liquidacaoId" value="0">
        <p class="form-text mb-2" id="hint-saldo-pagar"></p>
        <div class="mb-2">
          <label class="form-label">Data do pagamento</label>
          <input type="date" class="form-control" name="dataPagamento" required>
        </div>
        <div class="mb-2">
          <label class="form-label">Forma de pagamento</label>
          <select class="form-select" name="formaPagamento">
            <option value="TRANSFERENCIA">Transferência</option>
            <option value="DEBITO">Débito</option>
            <option value="CHEQUE">Cheque</option>
            <option value="DINHEIRO">Dinheiro</option>
            <option value="CARTAO">Cartão</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label">Conta bancária (opcional)</label>
          <input type="text" class="form-control" name="contaBancaria">
        </div>
        <div class="mb-2">
          <label class="form-label">Valor a pagar</label>
          <input type="number" id="pag-valor" name="valor" class="form-control" min="0.01" step="0.01" required>
        </div>
        <div class="mb-2">
          <label class="form-label">Histórico</label>
          <textarea class="form-control" name="historico" rows="2" required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Efetuar pagamento</button>
      </div>
    </form>
  </div>
</div>
