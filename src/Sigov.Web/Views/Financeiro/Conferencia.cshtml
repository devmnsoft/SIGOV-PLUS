@model Sigov.Web.Models.Financeiro.ConferenciaViewModel
@{
    ViewData["Title"] = "Financeiro — Conferência financeira";
}
<div data-fin-tela="conferencia">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Conferência financeira</h1>
            <p class="text-muted mb-0">Comparativo entre os acumuladores registrados e os totais calculados pelos documentos (empenhos, liquidações, pagamentos e arrecadações).</p>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card sigov-dashboard-card financeiro-kpi h-100">
                <span>Soma das divergências (R$) · escopo filtrado</span>
                <strong id="cf-total-diferenca">—</strong>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card sigov-dashboard-card financeiro-kpi h-100">
                <span>Documentos divergentes · escopo filtrado</span>
                <strong id="cf-qtd-divergentes">—</strong>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card sigov-dashboard-card financeiro-kpi h-100">
                <span>Último cálculo</span>
                <strong id="cf-atualizado" class="placeholder-glow">—</strong>
            </div>
        </div>
    </div>

    <details class="card card-body mb-3 sigov-screen-guide" open>
        <summary class="fw-semibold">Como corrigir uma divergência</summary>
        <ol class="mb-0 mt-2 small text-muted">
            <li>Identifique o <strong>documento</strong> com diferença e a <strong>origem da divergência</strong> indicada pela conferência (acumulador divergente vs total calculado pelos documentos).</li>
            <li>Use <strong>Ajustar</strong>: a prévia mostra os valores atualizados; informe a justificativa (obrigatória) e confirme. O valor exato é sempre <strong>recalculado no servidor</strong> e aplicado em transação única, com registro completo em auditoria. Se o documento mudar entre a prévia e a confirmação, o sistema pede para refazer a prévia.</li>
            <li>O ajuste requer a permissão <code>financeiro.conferencia.ajustar</code>; a visualização usa <code>financeiro.conferencia.visualizar</code>.</li>
        </ol>
    </details>

    <details class="card card-body mb-3 sigov-screen-guide">
        <summary class="fw-semibold">Anular, cancelar ou estornar? Qual ação evitar a divergência</summary>
        <ul class="mb-0 mt-2 small text-muted">
            <li><strong>Anular</strong> um empenho ou liquidação reverte o valor <strong>integral</strong> do documento e devolve o saldo acumulado. Exige justificativa e permissão própria; não pode anular empenho com liquidação vigente nem liquidação com pagamento vigente.</li>
            <li><strong>Cancelar</strong> um pagamento, lançamento ou arrecadação reverte apenas aquela movimentação, respeitando as regras do pai (ex.: lançamento com arrecadação vigente não é cancelado silenciosamente — cancele as arrecadações primeiro).</li>
            <li><strong>Estornar</strong> uma movimentação de orçamento (reserva/estorno/redução) desfaz o efeito daquela operação específica no saldo disponível.</li>
            <li>A conferência compara o que ficou registrado nos acumuladores com a soma dos documentos vigentes: quando uma reversão parcial deixa saldo "no meio", o ajuste de conferência é a ferramenta de sincronização final — sempre auditada, nunca manual em banco.</li>
        </ul>
    </details>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-4">
                    <label class="form-label">Tipo de documento</label>
                    <select class="form-select" id="cf-tipo">
                        <option value="">Todos</option>
                        <option value="EMPENHO">Empenho (dotação)</option>
                        <option value="LIQUIDACAO">Liquidação (dotação)</option>
                        <option value="PAGAMENTO">Pagamento (dotação)</option>
                        <option value="LANCAMENTO">Lançamento de receita (previsão)</option>
                        <option value="ARRECADACAO">Arrecadação (previsão)</option>
                        <option value="LIQUIDACAO_EMPENHO">Liquidações no empenho</option>
                        <option value="PAGAMENTO_EMPENHO">Pagamentos no empenho</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Situação</label>
                    <select class="form-select" id="cf-situacao">
                        <option value="">Todas</option>
                        <option value="DIVERGENTE">Somente divergentes</option>
                        <option value="OK">Somente conferidos</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button type="button" class="btn btn-sm btn-primary" id="btn-cf-filtrar">Filtrar</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-cf-limpar">Limpar</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Tipo</th><th>Documento</th>
                            <th class="text-end">Registrado</th><th class="text-end">Calculado</th><th class="text-end">Diferença</th>
                            <th>Origem da divergência</th><th>Ação</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-conferencia"><tr><td colspan="7" class="text-muted py-3">Executando conferência…</td></tr></tbody>
                </table>
            </div>
            <div id="pager-conferencia"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/financeiro.core.js"></script>
    <script src="~/js/modules/financeiro.conferencia.js"></script>
}
