@{
    ViewData["Title"] = "Contas a Receber";
}
<section class="container py-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <p class="text-uppercase text-primary fw-semibold mb-1">SIGOV PLUS • Financeiro Comercial Inicial</p>
            <h1 class="display-6">Contas a Receber</h1>
            <p class="lead">Títulos gerados por vendas a prazo e pedidos faturados, com tenant_id, LGPD, auditoria e integração futura ao financeiro completo.</p>
        </div>
        <span class="badge bg-success">Permissão: financeiro.contas_receber.visualizar</span>
    </div>
    <div class="alert alert-info" role="alert">Carregando dados de /api/financeiro/contas-receber...</div>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Abertas</span><h2>0</h2></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Recebidas</span><h2>0</h2></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Vencidas</span><h2>0</h2></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">LGPD</span><h2>OK</h2></div></div></div>
    </div>
    <button class="btn btn-primary" onclick="confirm('Confirmar baixa manual de título selecionado?')">Receber selecionado</button>
</section>
