@model Sigov.Web.Models.Financeiro.LiquidacaoFormViewModel
@{
    ViewData["Title"] = "Financeiro — Liquidações";
}
<div data-fin-tela="liquidacoes">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Liquidações</h1>
            <p class="text-muted mb-0">Confirmação da despesa executada sobre empenhos ativos. A anulação (estorno) recomputa os saldos do empenho no servidor.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary btn-export-csv" data-resource="liquidacoes">CSV</button>
            <button type="button" class="btn btn-outline-secondary btn-export-json" data-resource="liquidacoes">JSON</button>
        </div>
    </div>

    <details class="card card-body mb-3 sigov-screen-guide">
        <summary class="fw-semibold">Como funciona a liquidação</summary>
        <ul class="mb-0 mt-2 small text-muted">
            <li>Cada empenho é liquidado em partes ou por inteiro no próprio <a href="/Financeiro/Empenhos">detalhe do empenho</a>; aqui você acompanha e estorna.</li>
            <li><strong>Anular liquidação</strong> (estorno) exige justificativa; o saldo a liquidar/pagar do empenho e os acumuladores do orçamento são recompostos, e o vínculo origem↔reversão fica registrado na auditoria.</li>
        </ul>
    </details>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-3">
                    <label class="form-label">Número</label>
                    <input type="text" class="form-control" id="fil-numero" placeholder="Nº da liquidação">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Empenho</label>
                    <div><input type="text" class="form-control w-100" id="fil-empenho" placeholder="Buscar empenho por número…"></div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" id="fil-status">
                        <option value="">Todos</option>
                        <option value="LIQUIDADA">Liquidada</option>
                        <option value="ANULADA">Anulada</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button type="button" class="btn btn-sm btn-primary" id="btn-fil-filtrar">Filtrar</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-fil-limpar">Limpar</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Nº</th><th>Empenho</th><th>Data</th><th>Doc. fiscal</th><th>Histórico</th>
                            <th class="text-end">Valor</th><th>Status</th><th>Ação</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-liquidacoes-lista"><tr><td colspan="8" class="text-muted py-3">Carregando…</td></tr></tbody>
                </table>
            </div>
            <div id="pager-liquidacoes"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/financeiro.core.js"></script>
    <script src="~/js/modules/financeiro.liquidacoes.js"></script>
    <script src="~/js/modules/financeiro.exportacao.js"></script>
}
