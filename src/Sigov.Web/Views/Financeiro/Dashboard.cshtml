@model Sigov.Web.Models.Financeiro.FinanceiroDashboardViewModel
@{ ViewData["Title"] = "Painel do exercício financeiro"; }
<section class="container-fluid py-4 financeiro-dashboard financeiro-exercicio" data-module="financeiro">
  <header class="financeiro-hero mb-4">
    <div>
      <span class="financeiro-eyebrow">Financeiro • SIAFIC</span>
      <h1>Painel do exercício</h1>
      <p>Este painel resume a execução orçamentária do exercício selecionado e destaca saldos que precisam de acompanhamento.</p>
    </div>
    <div class="financeiro-actions" aria-label="Atalhos do exercício">
      <a class="btn btn-light" href="/Financeiro/OrcamentoDespesa">Consultar dotações</a>
      <a class="btn btn-outline-light" href="/Financeiro/Empenhos">Ver empenhos</a>
    </div>
  </header>

  <div id="financeiro-dashboard-status" class="visually-hidden" role="status" aria-live="polite">Carregando dados reais do exercício.</div>
  <div class="financeiro-kpis" aria-label="Indicadores da execução orçamentária">
    @foreach (var card in new[] { ("Orçamento autorizado", "dotação vigente"), ("Empenhado", "compromissos emitidos"), ("Liquidado", "despesas reconhecidas"), ("Pago", "desembolso realizado"), ("Saldo disponível", "recurso ainda utilizável") })
    {
      <article class="sigov-dashboard-card financeiro-kpi"><span>@card.Item1</span><strong class="valor placeholder-glow">—</strong><small>@card.Item2</small></article>
    }
  </div>

  <div class="row g-4 mt-1">
    <div class="col-12 col-xl-8">
      <section class="sigov-dashboard-card p-4 h-100" aria-labelledby="execucao-title">
        <div class="d-flex justify-content-between align-items-start gap-3"><div><h2 id="execucao-title" class="h5">Execução da despesa</h2><p class="text-muted">Compare as etapas do gasto público com o orçamento autorizado.</p></div><a href="/Financeiro/Pagamentos" class="btn btn-sm btn-outline-primary">Investigar pagamentos</a></div>
        <div class="financeiro-bars" aria-label="Gráfico da execução"><div data-bar="empenhado"><span>Empenhado</span><i></i></div><div data-bar="liquidado"><span>Liquidado</span><i></i></div><div data-bar="pago"><span>Pago</span><i></i></div></div>
      </section>
    </div>
    <div class="col-12 col-xl-4">
      <aside class="sigov-dashboard-card p-4 h-100" aria-labelledby="alertas-title"><h2 id="alertas-title" class="h5">Pontos de atenção</h2><div id="financeiro-alertas" class="text-muted">Os alertas serão calculados com os dados disponíveis.</div></aside>
    </div>
  </div>
  <nav class="financeiro-links mt-4" aria-label="Entidades relacionadas"><a href="/Financeiro/OrcamentoDespesa">Dotações</a><a href="/Financeiro/Empenhos">Empenhos</a><a href="/Financeiro/Liquidacoes">Liquidações</a><a href="/Financeiro/Pagamentos">Pagamentos</a><a href="/Financeiro/FontesRecurso">Fontes de recurso</a></nav>
</section>
