@model Sigov.Web.Models.Financeiro.ReceitaLancamentoFormViewModel
@{
    ViewData["Title"] = "Financeiro — Receitas";
}
<div data-fin-tela="receitas">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Receitas</h1>
            <p class="text-muted mb-0">Lançamentos sobre previsões de receita e arrecadações parciais até o total, com cancelamento e estorno.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-primary" id="btn-novo-lancamento">+ Novo lançamento</button>
            <button type="button" class="btn btn-outline-secondary btn-export-csv" data-resource="receitas">CSV</button>
            <button type="button" class="btn btn-outline-secondary btn-export-json" data-resource="receitas">JSON</button>
        </div>
    </div>

    <details class="card card-body mb-3 sigov-screen-guide">
        <summary class="fw-semibold">Como funciona a receita</summary>
        <ul class="mb-0 mt-2 small text-muted">
            <li><strong>Lançamento:</strong> abre o valor a receber sobre uma previsão de receita (natureza + fonte).</li>
            <li><strong>Arrecadação:</strong> valores recebidos em partes ou por inteiro, até o total do lançamento; o servidor rejeita excesso e recalcula status (LANCADA → PARCIALMENTE_ARRECADADA → ARRECADADA).</li>
            <li><strong>Cancelar lançamento / Estornar arrecadação:</strong> reversões com justificativa obrigatória; o saldo a arrecadar e os acumuladores do orçamento são recompostos no servidor.</li>
        </ul>
    </details>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-3">
                    <label class="form-label">Número</label>
                    <input type="text" class="form-control" id="rec-numero" placeholder="Nº do lançamento">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contribuinte</label>
                    <div><input type="text" class="form-control w-100" id="rec-contribuinte" placeholder="Buscar contribuinte por nome…"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" id="rec-status">
                        <option value="">Todos</option>
                        <option value="LANCADA">Lançada</option>
                        <option value="PARCIALMENTE_ARRECADADA">Arrecadação parcial</option>
                        <option value="ARRECADADA">Arrecadada</option>
                        <option value="CANCELADA">Cancelada</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button type="button" class="btn btn-sm btn-primary" id="btn-rec-filtrar">Filtrar</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-rec-limpar">Limpar</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Nº</th><th>Data</th><th>Previsão</th><th>Contribuinte</th><th>Histórico</th>
                            <th class="text-end">Valor</th><th class="text-end">Arrecadado</th><th class="text-end">Saldo a arrecadar</th><th>Status</th><th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-lancamentos"><tr><td colspan="10" class="text-muted py-3">Carregando…</td></tr></tbody>
                </table>
            </div>
            <div id="pager-lancamentos"></div>
        </div>
    </div>
</div>

<!-- ===================== MODAL NOVO LANÇAMENTO ===================== -->
<div class="modal fade" id="modalNovoLancamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form id="form-novo-lancamento" class="modal-content" novalidate onsubmit="return false">
            <div class="modal-header">
                <h5 class="modal-title">Novo lançamento de receita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label">Previsão de receita</label>
                    <div><input type="text" class="form-control w-100" id="novo-dotacao" placeholder="Buscar previsão por nome…"></div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Data do lançamento</label>
                    <input type="date" class="form-control" id="novo-data" name="dataLancamento" required>
                </div>
                <div class="mb-2">
                    <label class="form-label">Contribuinte (opcional)</label>
                    <div><input type="text" class="form-control w-100" id="novo-contribuinte" placeholder="Busque por nome…"></div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Histórico (obrigatório)</label>
                    <textarea class="form-control" name="historico" rows="2" required></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label">Valor</label>
                    <input type="number" name="valor" class="form-control" min="0.01" step="0.01" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Registrar lançamento</button>
            </div>
        </form>
    </div>
</div>

<!-- ===================== MODAL ARRECADAR ===================== -->
<div class="modal fade" id="modalArrecadar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form id="form-arrecadar" class="modal-content" novalidate onsubmit="return false">
            <div class="modal-header">
                <h5 class="modal-title">Registrar arrecadação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="arr-lanc-id" value="0">
                <p class="form-text mb-2" id="hint-saldo-arrecadar"></p>
                <div class="mb-2">
                    <label class="form-label">Data da arrecadação</label>
                    <input type="date" class="form-control" id="arr-data" name="dataArrecadacao" required>
                </div>
                <div class="mb-2">
                    <label class="form-label">Forma de arrecadação</label>
                    <select class="form-select" name="formaArrecadacao">
                        <option value="PIX">PIX</option>
                        <option value="TED">TED</option>
                        <option value="CHEQUE">Cheque</option>
                        <option value="DINHEIRO">Dinheiro</option>
                        <option value="OUTRO">Outro</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Valor arrecadado</label>
                    <input type="number" id="arr-valor" name="valor" class="form-control" min="0.01" step="0.01" required>
                </div>
                <div class="mb-2">
                    <label class="form-label">Histórico (obrigatório)</label>
                    <textarea class="form-control" name="historico" rows="2" required></textarea>
                </div>
                <p class="form-text">Arrecadações parciais são permitidas até o total do lançamento; o servidor recalcula o status e os acumuladores.</p>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Registrar arrecadação</button>
            </div>
        </form>
    </div>
</div>

<!-- ===================== MODAL DETALHE DO LANÇAMENTO ===================== -->
<div class="modal fade" id="modalDetalheLancamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalhe do lançamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="ldet-resumo"></div>
                <div class="table-responsive mt-2">
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>Nº</th><th>Data</th><th>Forma</th><th>Histórico</th><th class="text-end">Valor</th><th>Status</th><th>Ações</th></tr></thead>
                        <tbody id="tbody-arrecadacoes"><tr><td colspan="7" class="text-muted py-3">Carregando…</td></tr></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/financeiro.core.js"></script>
    <script src="~/js/modules/financeiro.receitas.js"></script>
    <script src="~/js/modules/financeiro.exportacao.js"></script>
}
