@model long
@{ ViewData["Title"] = "Detalhe do Empenho"; }
<h1>Empenho @Model</h1>
<ul class="nav nav-tabs" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#dados">Dados gerais</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#itens">Itens</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#liq">Liquidações</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#pag">Pagamentos</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#aud">Auditoria</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#evt">Eventos</button></li></ul>
<div class="tab-content border border-top-0 p-3"><div id="dados" class="tab-pane fade show active">Dados carregados via Ajax.</div><div id="itens" class="tab-pane fade">Itens</div><div id="liq" class="tab-pane fade"><partial name="_ModalLiquidar" /></div><div id="pag" class="tab-pane fade"><partial name="_ModalPagar" /></div><div id="aud" class="tab-pane fade"><partial name="_AuditoriaFinanceira" /></div><div id="evt" class="tab-pane fade">Eventos outbox</div></div>
<div class="mt-3"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalLiquidar">Liquidar</button> <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalAnularEmpenho">Anular</button> <a class="btn btn-secondary" href="/Financeiro/Empenhos">Voltar</a></div><partial name="_ModalAnularEmpenho" />
@section Scripts { <script src="~/js/modules/financeiro.empenhos.js"></script> }
