@model Sigov.Application.Empresarial.EmpresarialDashboardDto
@{ ViewData["Title"] = ViewData["Module"] ?? "Empresarial SaaS"; }
<section class="enterprise-hero"><div><span class="lgpd-badge">LGPD • acesso auditado</span><h1>@ViewData["Title"]</h1><p>Operação empresarial integrada, isolada por tenant e rastreada por CorrelationId.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#enterpriseConfirm">Nova operação</button></section>
<div class="enterprise-kpis"><article><span>Total</span><strong>@Model.Total</strong></article><article><span>Em andamento</span><strong>@Model.Abertos</strong></article><article><span>Alertas</span><strong>@Model.Alertas</strong></article><article><span>Concluídos</span><strong>@Model.Concluidos</strong></article></div>
<section class="enterprise-panel"><div class="filter-bar"><input class="form-control" type="search" placeholder="Filtrar código, título ou status"/><span class="status-chip">PostgreSQL • dados reais</span></div><div class="table-responsive"><table class="table responsive-data-table"><thead><tr><th>Código</th><th>Título</th><th>Status</th><th>Atualização</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Model.Recentes){<tr><td>@(item.Codigo??$"#{item.Id}")</td><td>@item.Titulo</td><td><span class="status-chip">@item.Status</span></td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><button class="btn btn-sm btn-outline-primary">Detalhar</button></td></tr>}@if(Model.Recentes.Count==0){<tr><td colspan="5"><div class="empty-state"><strong>Nenhuma operação encontrada</strong><span>Cadastre o primeiro item deste módulo.</span></div></td></tr>}</tbody></table></div></section>
<div class="modal fade" id="enterpriseConfirm" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Confirmar operação</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">A ação será auditada e vinculada ao tenant atual.</div></div></div></div>
