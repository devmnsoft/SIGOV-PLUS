@model IReadOnlyList<Sigov.Application.Workflows.WorkflowTarefaDto>
@{ ViewData["Title"]="Minhas tarefas"; }
<main class="sigov-workspace">
 <header class="sigov-page-header"><div><span class="sigov-eyebrow">CAIXA DE APROVAÇÕES</span><h1>Minhas tarefas</h1><p>Prioridades, prazos e decisões operacionais em um único lugar.</p></div><span class="lgpd-badge">Dados protegidos</span></header>
 @if(Model.Count==0){<section class="sigov-empty"><h2>Nenhuma tarefa pendente</h2><p>Novas aprovações atribuídas a você aparecerão aqui.</p></section>}
 else {<section class="task-inbox">@foreach(var item in Model){<article class="approval-card"><div><span class="status-chip">@item.Status</span><span class="risk-badge risk-badge--@item.Prioridade.ToLowerInvariant()">@item.Prioridade</span></div><h2>@item.TipoFluxo.Replace("_"," ")</h2><p>@item.Modulo · @item.ReferenciaTipo #@item.ReferenciaId</p><footer><span>@(item.Prazo?.ToString("dd/MM/yyyy HH:mm")??"Sem prazo")</span><a class="btn btn-primary" href="/Workflows/Detalhe/@item.InstanciaId">Analisar</a></footer></article>}</section>}
</main>
