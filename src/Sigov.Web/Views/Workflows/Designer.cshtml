@using System.Text.Json
@model Sigov.Web.Models.Workflows.WorkflowDesignerViewModel
@{ ViewData["Title"]=$"Designer — {Model.Workflow.Nome}"; var readOnly=Model.Workflow.Status=="PUBLICADO"; }
<link rel="stylesheet" href="~/css/sigov.rc49.css" asp-append-version="true" />
<main class="rc49-page rc49-designer" data-workflow-id="@Model.Workflow.Id" data-readonly="@readOnly.ToString().ToLowerInvariant()">
 <header class="rc49-hero"><div><a href="/Workflows" class="rc49-back">Workflows</a><h1>@Model.Workflow.Nome</h1><p>@Model.Workflow.Modulo.Replace("_"," ") · versão @Model.Workflow.Versao</p></div><div class="rc49-actions"><span class="rc49-badge rc49-badge--@Model.Workflow.Status.ToLowerInvariant()">@Model.Workflow.Status</span>@if(!readOnly){<button type="button" class="btn btn-outline-primary" data-add-step>Adicionar etapa</button><button type="button" class="btn btn-primary" data-save>Salvar desenho</button><form method="post" action="/Workflows/Publicar/@Model.Workflow.Id">@Html.AntiForgeryToken()<button class="btn btn-success" type="submit">Publicar</button></form>}</div></header>
 <div class="rc49-designer__layout"><section class="rc49-canvas" aria-label="Etapas do workflow" data-canvas>
 @foreach(var step in Model.Etapas){<article class="rc49-step" tabindex="0" data-step data-id="@step.Id" data-name="@step.Nome" data-type="@step.Tipo" data-initial="@step.Inicial.ToString().ToLowerInvariant()" data-final="@step.Final.ToString().ToLowerInvariant()"><div class="rc49-step__number">@step.Ordem</div><div><span>@step.Tipo</span><h2>@step.Nome</h2><p>@(step.Descricao??"Sem descrição")</p></div>@if(step.Inicial){<b>Inicial</b>}@if(step.Final){<b>Final</b>}</article>}
 @if(Model.Etapas.Count==0){<div class="rc49-empty rc49-empty--canvas"><h2>Canvas pronto para configurar</h2><p>Adicione as etapas inicial, de análise e final. Nenhum fluxo será executado antes da publicação.</p></div>}
 </section><aside class="rc49-drawer" aria-label="Propriedades da etapa" data-drawer><h2>Propriedades</h2><p>Selecione uma etapa para configurar nome, tipo, SLA e requisitos.</p><div data-properties hidden><label>Nome<input data-field="name" maxlength="100" /></label><label>Tipo<select data-field="type"><option>ANALISE</option><option>APROVACAO</option><option>REVISAO</option><option>CONCLUSAO</option></select></label><label><input type="checkbox" data-field="initial" /> Etapa inicial</label><label><input type="checkbox" data-field="final" /> Etapa final</label></div></aside></div>
</main>
<script src="~/js/sigov.workflow-designer.js" asp-append-version="true"></script>
