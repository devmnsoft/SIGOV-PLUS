@model Sigov.Web.Models.Workflows.CreateWorkflowInput
@{ ViewData["Title"]="Novo workflow"; }
<link rel="stylesheet" href="~/css/sigov.rc49.css" asp-append-version="true" />
<main class="rc49-page rc49-page--narrow"><header class="rc49-hero"><div><span class="rc49-eyebrow">NOVA AUTOMAÇÃO</span><h1>Desenhe uma jornada</h1><p>O workflow começa como rascunho e só entra em operação após publicação.</p></div></header>
<form method="post" class="rc49-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly"></div><label asp-for="Nome"></label><input asp-for="Nome" autocomplete="off" /><span asp-validation-for="Nome"></span><label asp-for="Modulo">Módulo</label><select asp-for="Modulo"><option value="PROTOCOLO">Protocolo</option><option value="GED">GED</option><option value="TAREFA">Tarefa</option><option value="SOLICITACAO_EXTERNA">Solicitação externa</option><option value="COMPRA_CONTRATO">Compra/Contrato</option></select><label asp-for="Descricao">Descrição</label><textarea asp-for="Descricao" rows="4"></textarea><div class="rc49-actions"><a href="/Workflows">Cancelar</a><button class="btn btn-primary" type="submit">Criar e abrir designer</button></div></form></main>
