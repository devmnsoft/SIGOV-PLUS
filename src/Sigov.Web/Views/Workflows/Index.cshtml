@model IReadOnlyList<Sigov.Web.Models.Workflows.WorkflowSummary>
@{ ViewData["Title"]="Workflows configuráveis"; }
<link rel="stylesheet" href="~/css/sigov.rc49.css" asp-append-version="true" />
<main class="rc49-page">
 <header class="rc49-hero"><div><span class="rc49-eyebrow">AUTOMAÇÃO OPERACIONAL</span><h1>Workflows configuráveis</h1><p>Modele jornadas de Protocolo, GED, Tarefas e Portal com governança por versão.</p></div><a class="btn btn-primary" href="/Workflows/Novo">Novo workflow</a></header>
 @if(Model.Count==0){<section class="rc49-empty"><svg aria-hidden="true"><use href="#icon-workflow"/></svg><h2>Comece pela primeira jornada</h2><p>Crie etapas, defina transições e publique somente depois da validação.</p><a class="btn btn-primary" href="/Workflows/Novo">Criar workflow</a></section>}
 else {<section class="rc49-grid">@foreach(var item in Model){<article class="rc49-card"><div class="rc49-card__top"><span class="rc49-badge rc49-badge--@item.Status.ToLowerInvariant()">@item.Status</span><span>v@item.Versao</span></div><h2>@item.Nome</h2><p>@item.Modulo.Replace("_"," ")</p><footer><time>@item.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time><a href="/Workflows/Designer/@item.Id">Abrir designer</a></footer></article>}</section>}
</main>
