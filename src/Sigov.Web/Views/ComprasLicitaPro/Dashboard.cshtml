@model Sigov.Application.Compras.LicitaProDashboard
@{ ViewData["Title"] = "LicitaPro IA"; }
<link rel="stylesheet" href="~/css/licitapro.css" asp-append-version="true" />
<partial name="_Nav" />
<header class="lp-hero">
    <div><span>FUNC03 · inteligência assistida</span><h1>LicitaPro IA</h1><p>Radar, habilitação, proposta e contratos com decisões humanas e dados persistidos.</p></div>
    <a class="btn btn-primary" href="/Compras/LicitaPro/Oportunidades/Nova">Registrar oportunidade</a>
</header>
<section class="lp-cards" aria-label="Indicadores do LicitaPro">
@foreach (var card in new[] { (Model.Abertas.ToString(), "Abertas"), (Model.Vencendo.ToString(), "Vencendo"), (Model.Vencidas.ToString(), "Vencidas"), (Model.Vinculadas.ToString(), "Vinculadas"), (Model.FornecedoresDocumentoVencido.ToString(), "Fornecedores com documento vencido"), (Model.ChecklistsPendentes.ToString(), "Checklists pendentes"), (Model.PropostasPreparacao.ToString(), "Propostas em preparação"), (Model.ContratosConquistados.ToString(), "Contratos conquistados"), ($"{Model.AderenciaMedia:N1}%", "Aderência média explicável") })
{ <article><strong>@card.Item1</strong><span>@card.Item2</span></article> }
</section>
