@model Sigov.Application.Compras.LicitaProWorkspace
@{ ViewData["Title"]=Model.Titulo; var isDocs=Model.Titulo.StartsWith("Certidões"); var isAgenda=Model.Titulo.StartsWith("Agenda"); }
<link rel="stylesheet" href="~/css/licitapro.css" /><partial name="_Nav" />@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}<header class="lp-hero"><div><span>FUNC03 · LicitaPro IA</span><h1>@Model.Titulo</h1><p>@Model.Descricao</p></div></header>
@if(isDocs){<form method="post" action="/Compras/LicitaPro/Documentos/Novo" class="lp-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label>Fornecedor<select name="FornecedorId" class="form-select" required><option value="">Selecione o fornecedor</option>@foreach(var x in Model.Fornecedores??[]){<option value="@x.Id">@x.Texto</option>}</select></label><label>Tipo<input name="Tipo" class="form-control" required/></label><label>Título<input name="Titulo" class="form-control" required/></label><label>Validade<input name="Validade" type="date" class="form-control"/></label><label class="wide">Referência documental<input name="ReferenciaDocumental" class="form-control"/><span class="form-text">Informe a referência segura do documento; não envie credenciais.</span></label><button class="btn btn-primary" type="submit">Salvar documento</button></form>}
@if(isAgenda){<form method="post" action="/Compras/LicitaPro/Agenda/Nova" class="lp-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label>Oportunidade<select name="OportunidadeId" class="form-select" required><option value="">Selecione a oportunidade</option>@foreach(var x in Model.Oportunidades??[]){<option value="@x.Id">@x.Texto</option>}</select></label><label>Processo<select name="ProcessoId" class="form-select" required><option value="">Selecione o processo</option>@foreach(var x in Model.Processos??[]){<option value="@x.Id">@x.Texto</option>}</select></label><label>Fornecedor<select name="FornecedorId" class="form-select" required><option value="">Selecione o fornecedor</option>@foreach(var x in Model.Fornecedores??[]){<option value="@x.Id">@x.Texto</option>}</select></label><label>Título<input name="Titulo" class="form-control" required/></label><label>Prazo<input name="PrazoAt" type="datetime-local" class="form-control" required/></label><button class="btn btn-primary" type="submit">Agendar proposta</button></form>}
<div class="table-responsive lp-panel"><table class="table"><thead><tr><th>Registro</th><th>Contexto</th><th>Status</th><th>Prazo</th></tr></thead><tbody>@foreach(var x in Model.Linhas){<tr><td>@x.Titulo</td><td>@x.Contexto</td><td><span class="lp-badge">@x.Status</span></td><td>@x.Prazo?.ToString("g")</td></tr>}@if(Model.Linhas.Count==0){<tr><td colspan="4" class="lp-empty">Nenhum registro persistido para os filtros atuais.</td></tr>}</tbody></table></div>
