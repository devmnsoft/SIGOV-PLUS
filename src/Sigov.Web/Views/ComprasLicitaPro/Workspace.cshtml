@model Sigov.Application.Compras.LicitaProWorkspace
@{ ViewData["Title"] = Model.Titulo; var isDocs = Model.Area == "Documentos"; var isAgenda = Model.Area == "Agenda"; }
<link rel="stylesheet" href="~/css/licitapro.css" asp-append-version="true" />
<partial name="_Nav" /><details class="card card-body mb-3 sigov-screen-guide"><summary class="fw-semibold">Como usar esta tela</summary><div class="small text-muted mt-2">Use os filtros para restringir os dados do contexto institucional atual e selecione Exportar CSV. A permissão específica de relatório é obrigatória; alguns registros podem conter dados sensíveis e devem ser tratados conforme a LGPD. Após a solicitação, um arquivo CSV protegido contra fórmulas é gerado somente com os dados autorizados; quando não houver resultados, confira os filtros antes de tentar novamente.</div></details>
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
<header class="lp-hero"><div><span>FUNC03 · LicitaPro IA</span><h1>@Model.Titulo</h1><p>@Model.Descricao</p></div>@if (new[] { "Documentos", "Checklists", "Agenda", "Auditoria" }.Contains(Model.Area)) { <a class="btn btn-outline-light" href="@Url.Action("Csv", "ComprasLicitaPro", new { area = Model.Area.ToLowerInvariant(), Busca = Model.Filtro.Busca, Status = Model.Filtro.Status, De = Model.Filtro.De, Ate = Model.Filtro.Ate })">Exportar CSV</a> }</header>
<form method="get" class="lp-filter"><input name="Busca" value="@Model.Filtro.Busca" class="form-control" placeholder="Buscar nos registros" aria-label="Busca" /><input name="Status" value="@Model.Filtro.Status" class="form-control" placeholder="Status" aria-label="Status" /><input name="De" value="@Model.Filtro.De?.ToString("yyyy-MM-dd")" type="date" class="form-control" aria-label="Data inicial" /><input name="Ate" value="@Model.Filtro.Ate?.ToString("yyyy-MM-dd")" type="date" class="form-control" aria-label="Data final" /><button class="btn btn-secondary">Filtrar</button></form>
@if (isDocs && Model.Documento is not null)
{
<form method="post" action="/Compras/LicitaPro/Documentos/Novo" class="lp-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger wide"></div>
    <label asp-for="Documento.FornecedorId">Fornecedor<select asp-for="Documento.FornecedorId" class="form-select"><option value="">Selecione o fornecedor</option>@foreach (var x in Model.Fornecedores ?? []) { <option value="@x.Id">@x.Texto</option> }</select><span asp-validation-for="Documento.FornecedorId"></span></label>
    <label asp-for="Documento.Tipo">Tipo<input asp-for="Documento.Tipo" class="form-control" /><span asp-validation-for="Documento.Tipo"></span></label>
    <label asp-for="Documento.Titulo">Título<input asp-for="Documento.Titulo" class="form-control" /><span asp-validation-for="Documento.Titulo"></span></label>
    <label asp-for="Documento.Status">Situação<select asp-for="Documento.Status" class="form-select"><option value="PENDENTE">Pendente</option><option value="EM_ANALISE">Em análise</option><option value="APROVADO">Aprovado</option><option value="REPROVADO">Reprovado</option></select><span asp-validation-for="Documento.Status"></span></label>
    <label asp-for="Documento.Validade">Validade<input asp-for="Documento.Validade" type="date" class="form-control" /><span asp-validation-for="Documento.Validade"></span></label>
    <label asp-for="Documento.ReferenciaDocumental" class="wide">Referência documental<input asp-for="Documento.ReferenciaDocumental" class="form-control" /><span asp-validation-for="Documento.ReferenciaDocumental"></span><small>Use uma referência segura; nunca informe credenciais.</small></label>
    <div class="wide lp-actions"><button class="btn btn-primary" type="submit">Salvar documento</button></div>
</form>
}
@if (isAgenda && Model.Agenda is not null)
{
<form method="post" action="/Compras/LicitaPro/Agenda/Nova" class="lp-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger wide"></div>
    <label asp-for="Agenda.OportunidadeId">Oportunidade<select asp-for="Agenda.OportunidadeId" class="form-select"><option value="">Selecione uma oportunidade vigente</option>@foreach (var x in Model.Oportunidades ?? []) { <option value="@x.Id">@x.Texto</option> }</select><span asp-validation-for="Agenda.OportunidadeId"></span></label>
    <label asp-for="Agenda.ProcessoId">Processo<select asp-for="Agenda.ProcessoId" class="form-select"><option value="">Selecione o processo</option>@foreach (var x in Model.Processos ?? []) { <option value="@x.Id">@x.Texto</option> }</select><span asp-validation-for="Agenda.ProcessoId"></span></label>
    <label asp-for="Agenda.FornecedorId">Fornecedor<select asp-for="Agenda.FornecedorId" class="form-select"><option value="">Selecione o fornecedor</option>@foreach (var x in Model.Fornecedores ?? []) { <option value="@x.Id">@x.Texto</option> }</select><span asp-validation-for="Agenda.FornecedorId"></span></label>
    <label asp-for="Agenda.ContratoId">Contrato (opcional)<select asp-for="Agenda.ContratoId" class="form-select"><option value="">Sem contrato</option>@foreach (var x in Model.Contratos ?? []) { <option value="@x.Id">@x.Texto</option> }</select><span asp-validation-for="Agenda.ContratoId"></span></label>
    <label asp-for="Agenda.Titulo">Título<input asp-for="Agenda.Titulo" class="form-control" /><span asp-validation-for="Agenda.Titulo"></span></label>
    <label asp-for="Agenda.PrazoAt">Prazo<input asp-for="Agenda.PrazoAt" type="datetime-local" class="form-control" /><span asp-validation-for="Agenda.PrazoAt"></span></label>
    <div class="wide lp-actions"><button class="btn btn-primary" type="submit">Agendar proposta</button></div>
</form>
}
<div class="table-responsive lp-panel"><table class="table align-middle"><thead><tr><th>Registro</th><th>Contexto</th><th>Status</th><th>Prazo</th></tr></thead><tbody>
@foreach (var x in Model.Linhas) { <tr><td>@x.Titulo</td><td>@x.Contexto</td><td><span class="lp-badge">@x.Status</span></td><td>@x.Prazo?.ToString("g")</td></tr> }
@if (Model.Linhas.Count == 0) { <tr><td colspan="4" class="lp-empty"><strong>Nenhum registro encontrado</strong><span>Não há dados persistidos para os filtros atuais.</span></td></tr> }
</tbody></table></div>
<partial name="_ValidationScriptsPartial" />
