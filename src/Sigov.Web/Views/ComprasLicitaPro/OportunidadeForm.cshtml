@model Sigov.Application.Compras.OportunidadeInput
@using Sigov.Application.Compras
@{ ViewData["Title"] = "Registrar oportunidade"; var fontes = (IReadOnlyList<LicitaProFonte>)(ViewBag.Fontes ?? Array.Empty<LicitaProFonte>()); }
<link rel="stylesheet" href="~/css/licitapro.css" asp-append-version="true" />
<partial name="_Nav" />
<header class="lp-hero"><div><span>Origem rastreável</span><h1>Registrar oportunidade</h1><p>Cadastre dados publicados por uma fonte oficial.</p></div></header>
<form method="post" class="lp-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger wide"></div>
    <label asp-for="FonteId">Fonte oficial<select asp-for="FonteId" class="form-select"><option value="">Selecione uma fonte</option>@foreach (var x in fontes) { <option value="@x.Id">@x.Nome — @x.Estado</option> }</select><span asp-validation-for="FonteId"></span></label>
    <label asp-for="IdentificadorExterno">Identificador publicado pela fonte<input asp-for="IdentificadorExterno" class="form-control" /><span asp-validation-for="IdentificadorExterno"></span></label>
    <label asp-for="Numero">Número público<input asp-for="Numero" class="form-control" /><span asp-validation-for="Numero"></span></label>
    <label asp-for="Modalidade">Modalidade<input asp-for="Modalidade" class="form-control" /><span asp-validation-for="Modalidade"></span></label>
    <label asp-for="Objeto" class="wide">Objeto<textarea asp-for="Objeto" class="form-control" rows="4"></textarea><span asp-validation-for="Objeto"></span></label>
    <label asp-for="DataPublicacao">Publicação<input asp-for="DataPublicacao" type="date" class="form-control" /><span asp-validation-for="DataPublicacao"></span></label>
    <label asp-for="DataLimite">Data limite<input asp-for="DataLimite" type="date" class="form-control" /><span asp-validation-for="DataLimite"></span></label>
    <div class="wide lp-actions"><a class="btn btn-outline-secondary" href="/Compras/LicitaPro/Oportunidades">Cancelar</a><button class="btn btn-primary" type="submit">Salvar oportunidade</button></div>
</form>
<partial name="_ValidationScriptsPartial" />
