@model Sigov.Application.Compras.OportunidadeInput
@{ ViewData["Title"]="Registrar oportunidade"; var fontes=ViewBag.Fontes as IReadOnlyList<Sigov.Application.Compras.LicitaProFonte>??[]; }
<link rel="stylesheet" href="~/css/licitapro.css" /><partial name="_Nav" /><header class="lp-hero"><div><span>Origem rastreável</span><h1>Registrar oportunidade</h1></div></header>
<form method="post" class="lp-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label>Fonte oficial<select asp-for="FonteId" class="form-select"><option value="">Selecione uma fonte</option>@foreach(var x in fontes){<option value="@x.Id">@x.Nome — @x.Estado</option>}</select><span asp-validation-for="FonteId"></span></label><label>Identificador externo<input asp-for="IdentificadorExterno" class="form-control"/><span asp-validation-for="IdentificadorExterno"></span></label><label>Número<input asp-for="Numero" class="form-control"/><span asp-validation-for="Numero"></span></label><label>Modalidade<input asp-for="Modalidade" class="form-control"/><span asp-validation-for="Modalidade"></span></label><label class="wide">Objeto<textarea asp-for="Objeto" class="form-control"></textarea><span asp-validation-for="Objeto"></span></label><label>Publicação<input asp-for="DataPublicacao" type="date" class="form-control"/><span asp-validation-for="DataPublicacao"></span></label><label>Data limite<input asp-for="DataLimite" type="date" class="form-control"/><span asp-validation-for="DataLimite"></span></label><div class="wide"><button class="btn btn-primary" type="submit">Salvar oportunidade</button></div></form>
