@model IReadOnlyList<Sigov.Application.Compras.LicitaProOportunidade>
@{ ViewData["Title"]="Oportunidades"; }
<link rel="stylesheet" href="~/css/licitapro.css" /><partial name="_Nav" /><header class="lp-hero"><div><span>Radar de oportunidades</span><h1>Oportunidades</h1><p>Publicações oficiais importadas ou registradas com origem identificada.</p></div><div><a class="btn btn-outline-light" href="/Compras/LicitaPro/Relatorios/oportunidades.csv">CSV</a> <a class="btn btn-primary" href="/Compras/LicitaPro/Oportunidades/Nova">Nova</a></div></header>
<form method="get" class="lp-filter"><input name="Busca" class="form-control" placeholder="Número ou objeto"/><select name="Status" class="form-select"><option value="">Todos os status</option><option>ABERTA</option><option>VINCULADA</option><option>VENCIDA</option><option>CANCELADA</option><option>INDISPONIVEL</option></select><button class="btn btn-secondary">Filtrar</button></form>
<div class="table-responsive lp-panel"><table class="table"><thead><tr><th>Número</th><th>Objeto</th><th>Fonte</th><th>Modalidade</th><th>Limite</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a href="/Compras/LicitaPro/Oportunidades/@x.Id">@x.Numero</a></td><td>@x.Objeto</td><td>@x.Fonte</td><td>@x.Modalidade</td><td>@x.DataLimite</td><td><span class="lp-badge">@x.Status</span></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="lp-empty">Nenhuma oportunidade para os filtros atuais.</td></tr>}</tbody></table></div>
