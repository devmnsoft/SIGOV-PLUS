@model IReadOnlyList<Sigov.Application.Compras.LicitaProOportunidade>
@{ ViewData["Title"] = "Oportunidades"; }
<link rel="stylesheet" href="~/css/licitapro.css" asp-append-version="true" />
<partial name="_Nav" />
<header class="lp-hero"><div><span>Radar de oportunidades</span><h1>Oportunidades</h1><p>Publicações oficiais com origem identificada.</p></div><div class="lp-actions"><a class="btn btn-outline-light" href="/Compras/LicitaPro/Relatorios/oportunidades.csv">Exportar CSV</a><a class="btn btn-primary" href="/Compras/LicitaPro/Oportunidades/Nova">Nova</a></div></header>
<form method="get" class="lp-filter"><input name="Busca" value="@Context.Request.Query["Busca"]" class="form-control" aria-label="Busca" placeholder="Número ou objeto" /><select name="Status" class="form-select" aria-label="Status"><option value="">Todos os status</option>@foreach (var status in new[] { "ABERTA", "VINCULADA", "VENCIDA", "CANCELADA", "INDISPONIVEL" }) { <option selected="@(Context.Request.Query["Status"] == status)">@status</option> }</select><button class="btn btn-secondary">Filtrar</button></form>
<div class="table-responsive lp-panel"><table class="table align-middle"><thead><tr><th>Número</th><th>Objeto</th><th>Fonte</th><th>Modalidade</th><th>Limite</th><th>Status</th></tr></thead><tbody>
@foreach (var x in Model) { <tr><td><a href="/Compras/LicitaPro/Oportunidades/@x.Id">@x.Numero</a></td><td>@x.Objeto</td><td>@x.Fonte</td><td>@x.Modalidade</td><td>@x.DataLimite?.ToString("dd/MM/yyyy")</td><td><span class="lp-badge">@x.Status</span></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="lp-empty"><strong>Nenhuma oportunidade</strong><span>Revise os filtros ou registre uma publicação oficial.</span></td></tr> }
</tbody></table></div>
