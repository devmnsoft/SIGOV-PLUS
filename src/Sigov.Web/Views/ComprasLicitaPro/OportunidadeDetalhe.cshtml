@model Sigov.Application.Compras.LicitaProOportunidade
@{ ViewData["Title"]="Detalhe da oportunidade"; var processos=ViewBag.Processos as IReadOnlyList<Sigov.Application.Compras.LicitaProOpcao>??[]; }
<link rel="stylesheet" href="~/css/licitapro.css" /><partial name="_Nav" />@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}<header class="lp-hero"><div><span>@Model.Fonte · @Model.Modalidade</span><h1>@Model.Numero</h1><p>@Model.Objeto</p></div><span class="lp-badge">@Model.Status</span></header><section class="lp-panel"><dl><dt>Publicação</dt><dd>@Model.DataPublicacao</dd><dt>Data limite</dt><dd>@(Model.DataLimite?.ToString()??"Não informada")</dd></dl><h2>Vincular ao processo licitatório existente</h2><form method="post" action="/Compras/LicitaPro/Oportunidades/@Model.Id/Vincular">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label>Processo<select name="ProcessoId" class="form-select" required><option value="">Pesquise e selecione um processo</option>@foreach(var x in processos){<option value="@x.Id">@x.Texto</option>}</select></label><button class="btn btn-primary mt-3">Vincular</button></form></section>
