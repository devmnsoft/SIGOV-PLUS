@model Sigov.Application.Compras.LicitaProOportunidade
@using Sigov.Application.Compras
@{
    ViewData["Title"] = $"Oportunidade {Model.Numero}";
    var processos = (IReadOnlyList<LicitaProOpcao>)(ViewBag.Processos ?? Array.Empty<LicitaProOpcao>());
}
<link rel="stylesheet" href="~/css/licitapro.css" asp-append-version="true" />
<partial name="_Nav" />
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
<header class="lp-hero">
    <div><span>@Model.Fonte · @Model.Modalidade</span><h1>@Model.Numero</h1><p>@Model.Objeto</p></div>
    <span class="lp-badge">@Model.Status</span>
</header>
<section class="lp-panel">
    <dl class="lp-details">
        <div><dt>Publicação</dt><dd>@Model.DataPublicacao.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>Data limite</dt><dd>@(Model.DataLimite?.ToString("dd/MM/yyyy") ?? "Não informada")</dd></div>
    </dl>
    <h2>Vincular ao processo licitatório</h2>
    <p>Selecione um processo persistido do FUNC03; identificadores técnicos não são solicitados.</p>
    <form method="post" asp-action="Vincular" asp-route-id="@Model.Id">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label for="ProcessoId">Processo</label>
        <select id="ProcessoId" name="ProcessoId" class="form-select" required>
            <option value="">Pesquise e selecione um processo</option>
            @foreach (var x in processos) { <option value="@x.Id">@x.Texto</option> }
        </select>
        <button class="btn btn-primary mt-3" type="submit">Vincular processo</button>
    </form>
</section>
<partial name="_ValidationScriptsPartial" />
