@model Sigov.Application.Relatorios.RelatorioExecutivoDashboardDto
@{ ViewData["Title"] = ViewBag.Titulo ?? "Relatórios Executivos"; var filtro=(Sigov.Application.Relatorios.RelatorioExecutivoFiltro)ViewBag.Filtro; }
<section class="executive-hero">
 <div><span class="executive-eyebrow">RC50.36 · Gestão baseada em dados</span><h1>@ViewData["Title"]</h1><p>Indicadores consolidados em tempo real, com isolamento por tenant, drill-down auditável e proteção LGPD.</p></div>
 <div class="export-toolbar"><a class="btn btn-light" href="/api/relatorios-executivos/exportar-csv">Exportar CSV</a><a class="btn btn-outline-light" href="/api/relatorios-executivos/exportar-json">Exportar JSON</a></div>
</section>
<form method="get" class="executive-filter-bar" aria-label="Filtros executivos"><label>Início<input class="form-control" type="date" name="Inicio" value="@filtro.Inicio" /></label><label>Fim<input class="form-control" type="date" name="Fim" value="@filtro.Fim" /></label><label>Entidade<input class="form-control" type="number" name="EntidadeId" value="@filtro.EntidadeId" /></label><label>Exercício<input class="form-control" type="number" name="ExercicioId" value="@filtro.ExercicioId" /></label><button class="btn btn-primary">Aplicar filtros</button></form>
<div class="executive-kpis">
 <article class="executive-widget"><span>Orçamento atualizado</span><strong>@Model.Financeiro.Atualizado.ToString("C")</strong><small>Saldo @Model.Financeiro.Saldo.ToString("C")</small></article>
 <article class="executive-widget"><span>Empenhado</span><strong>@Model.Financeiro.Empenhado.ToString("C")</strong><small>Liquidado @Model.Financeiro.Liquidado.ToString("C")</small></article>
 <article class="executive-widget"><span>Arrecadação</span><strong>@Model.Tributario.Arrecadado.ToString("C")</strong><small>Lançado @Model.Tributario.Lancado.ToString("C")</small></article>
 <article class="executive-widget executive-widget--alert"><span>Dívida ativa</span><strong>@Model.Tributario.DividaAtiva.ToString("C")</strong><small>Alerta preparatório</small></article>
</div>
<div class="executive-grid"><section class="central-panel"><div class="central-panel__heading"><div><span class="executive-eyebrow">Execução orçamentária</span><h2>Previsto → empenhado → liquidado → pago</h2></div><span class="status-chip">Atualizado @Model.AtualizadoEm.ToLocalTime().ToString("HH:mm")</span></div><div class="executive-flow"><span>Previsto <b>@Model.Financeiro.Previsto.ToString("C")</b></span><span>Empenhado <b>@Model.Financeiro.Empenhado.ToString("C")</b></span><span>Liquidado <b>@Model.Financeiro.Liquidado.ToString("C")</b></span><span>Pago <b>@Model.Financeiro.Pago.ToString("C")</b></span></div></section><aside class="central-panel"><span class="lgpd-badge">LGPD · dados agregados</span><h2>Privacidade por padrão</h2><p>@Model.AvisoLgpd</p><small>CorrelationId e exportações ficam disponíveis para auditoria operacional.</small></aside></div>
<section class="central-panel"><div class="central-panel__heading"><div><span class="executive-eyebrow">Drill-down</span><h2>Widgets gerenciais</h2></div></div><div class="executive-kpis">@foreach(var widget in Model.Widgets){<a class="executive-widget executive-widget--link" href="@widget.DrillDownUrl"><span>@widget.Modulo</span><strong>@widget.Valor</strong><small>@widget.Titulo · @widget.Tendencia</small></a>}</div></section>
