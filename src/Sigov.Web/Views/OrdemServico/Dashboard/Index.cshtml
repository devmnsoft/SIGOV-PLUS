@{ViewData["Title"]="Operação de campo";}<main class="container-fluid py-3"><h1>Operação de campo</h1><div class="row g-3" data-os-dashboard aria-live="polite"></div></main><script type="module">import {api} from '/js/ordem-servico/api.js';const x=await api('/api/ordens-servico/dashboard');document.querySelector('[data-os-dashboard]').innerHTML=Object.entries(x).map(([k,v])=>`<div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><span>${k}</span><strong class="d-block fs-2">${v}</strong></div></div></div>`).join('');</script>
