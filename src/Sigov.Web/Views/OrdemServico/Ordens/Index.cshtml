@{ ViewData["Title"]="Ordens de Serviço"; }
<link rel="stylesheet" href="~/css/ordem-servico/ordem-servico.css" />
<main class="container-fluid py-3" data-os-list><header class="d-flex flex-wrap justify-content-between gap-2"><div><h1>Ordens de Serviço</h1><p class="text-secondary">Triagem, despacho e execução em campo</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#novaOs">Nova OS</button></header><form class="row g-2 my-3" data-filter><div class="col-md-5"><label class="form-label" for="busca">Busca</label><input id="busca" class="form-control" name="busca" /></div><div class="col-md-3"><label class="form-label" for="status">Status</label><select id="status" class="form-select" name="status"><option value="">Todos</option><option>EM_TRIAGEM</option><option>AGENDADA</option><option>EM_EXECUCAO</option><option>PAUSADA</option></select></div></form><div class="os-grid" data-results aria-live="polite"><div class="placeholder-glow"><span class="placeholder col-12"></span></div></div></main>
<div class="modal fade" id="novaOs" tabindex="-1"><div class="modal-dialog"><form class="modal-content" data-create><div class="modal-header"><h2 class="modal-title fs-5">Nova ordem</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label class="form-label">Cliente</label><input name="clienteId" class="form-control" type="text" required/><label class="form-label mt-2">Descrição</label><textarea name="descricao" class="form-control" required></textarea><label class="form-label mt-2">Prioridade</label><select name="prioridade" class="form-select"><option>NORMAL</option><option>ALTA</option><option>URGENTE</option><option>CRITICA</option></select></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Criar OS</button></div></form></div></div>
<script type="module" src="~/js/ordem-servico/listagem.js"></script>
