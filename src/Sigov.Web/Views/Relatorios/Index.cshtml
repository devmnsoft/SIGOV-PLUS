@{ ViewData["Title"] = "Relatórios"; var grupos = new Dictionary<string,string[]> { ["Administração"] = new[]{"Usuários ativos","Módulos ativos por tenant"}, ["Governo"] = new[]{"Processos por status","Documentos GED por status","Contratos a vencer","Empenhos","Pagamentos","Receitas","Compras","Licitações","Almoxarifado","Patrimônio","Frotas","Obras","Transparência"}, ["Empresas"] = new[]{"Recebimentos e pagamentos","Funil comercial"}, ["Operação"] = new[]{"Integrações com falha","Ordens de serviço por SLA"}, ["Auditoria/LGPD"] = new[]{"Auditorias recentes","Acessos a dados sensíveis"} }; }
@await Html.PartialAsync("_ModuleHelpBox", "Selecione filtros, gere relatórios demonstráveis e acompanhe quais relatórios estão em implantação.")
<h1>Relatórios SIGOV PLUS</h1><p class="text-muted">Relatórios agrupados para administração pública integrada, empresas e operação.</p>
<div class="alert alert-warning">PDF/Excel avançados estão em implantação. CSVs abaixo são gerados apenas quando a tabela real existe, com dados pessoais mascarados.</div>
<div class="mb-3 d-flex gap-2 flex-wrap"><a class="btn btn-sm btn-outline-primary" href="/Relatorios/UsuariosCsv">Usuários CSV</a><a class="btn btn-sm btn-outline-primary" href="/Relatorios/TenantsCsv">Tenants CSV</a><a class="btn btn-sm btn-outline-primary" href="/Relatorios/ModulosCsv">Módulos CSV</a><a class="btn btn-sm btn-outline-primary" href="/Relatorios/AuditoriasCsv">Auditorias CSV</a><a class="btn btn-sm btn-outline-primary" href="/Relatorios/ParametrosCsv">Parâmetros CSV</a><a class="btn btn-sm btn-outline-success" href="/Siafic/ExportCsv">SIAFIC CSV</a><a class="btn btn-sm btn-outline-success" href="/Compras/ExportCsv">Compras CSV</a><a class="btn btn-sm btn-outline-success" href="/Licitacoes/ExportCsv">Licitações CSV</a><a class="btn btn-sm btn-outline-success" href="/Patrimonio/BensCsv">Patrimônio CSV</a><a class="btn btn-sm btn-outline-success" href="/Obras/ObrasCsv">Obras CSV</a><a class="btn btn-sm btn-outline-primary" href="/Editais/1/RelatorioAderencia/Csv">Matriz aderência CSV</a><a class="btn btn-sm btn-outline-primary" href="/Editais/1/RelatorioAderencia/Json">Matriz aderência JSON</a></div>
@foreach (var grupo in grupos) { <section class="card border-0 shadow-sm mb-3"><div class="card-body"><h2 class="h5">@grupo.Key</h2><div class="row g-3">@foreach (var r in grupo.Value) { <div class="col-md-6 col-xl-4"><div class="border rounded-3 p-3 h-100"><strong>@r</strong><p class="small text-muted">Filtros por período, tenant, módulo e status. Geração segura com fallback visual.</p><input class="form-control form-control-sm mb-2" placeholder="Filtro"><button class="btn btn-sm btn-primary">Gerar</button> <span class="badge bg-info text-dark">Demonstrável</span></div></div> }</div></div></section> }
