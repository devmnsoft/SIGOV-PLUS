@{ ViewData["Title"] = "Notificações"; var itens = new[]{"Implantação pendente","Módulo aguardando configuração","Auditoria crítica","Contrato a vencer","Processo pendente"}; }
<h1>Notificações</h1><p class="text-muted">Central de avisos operacionais com filtros e marcação visual de leitura.</p><div class="row g-3 mb-3"><div class="col-md-3"><div class="card"><div class="card-body"><span class="text-muted">Não lidas</span><div class="display-6">5</div></div></div></div></div><form class="d-flex gap-2 mb-3"><select class="form-select w-auto" name="status"><option>Todas</option><option>Não lidas</option><option>Lidas</option></select><button class="btn btn-primary">Filtrar</button><a class="btn btn-outline-secondary" href="/Notificacoes">Limpar</a></form><div class="list-group">@foreach (var item in itens) { <div class="list-group-item d-flex justify-content-between"><div><strong>@item</strong><div class="small text-muted">Notificação demonstrativa para POC com ponto de auditoria.</div></div><button class="btn btn-sm btn-outline-success">Marcar como lida</button></div> }</div>
