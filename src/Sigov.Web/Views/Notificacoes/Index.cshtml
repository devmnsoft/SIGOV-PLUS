@model Sigov.Web.Models.PostBuild.SaasNotificationsViewModel
@{ ViewData["Title"]="Notificações"; ViewData["PageTitle"]="Notificações"; ViewData["PageDescription"]="Alertas reais quando há tabela; recomendações derivadas quando não há persistência."; }
@await Html.PartialAsync("_PageIntro")
@if (!string.IsNullOrWhiteSpace(Model?.MensagemFallback)) { <div class="alert alert-info">@Model.MensagemFallback</div> }
<div class="list-group">@foreach (var n in Model?.Notificacoes ?? Array.Empty<Sigov.Web.Models.PostBuild.SaasNotificationViewModel>()) { <div class="list-group-item"><div class="d-flex justify-content-between"><strong>@n.Titulo</strong><span class="badge bg-@(n.Persistida ? "success" : "secondary")">@(n.Persistida ? "Real" : "Recomendação")</span></div><p class="mb-1">@n.Descricao</p><small>@n.Tipo • @n.Status • @n.Data?.ToString("dd/MM/yyyy HH:mm")</small></div> }</div>
