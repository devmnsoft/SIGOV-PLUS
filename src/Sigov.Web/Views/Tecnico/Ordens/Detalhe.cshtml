@model Guid
@{ ViewData["Title"] = "Execução da ordem"; }
<link rel="stylesheet" href="~/css/ordem-servico/ordem-servico.css" />
<main class="container py-3 pb-5" data-tecnico-execucao data-id="@Model">
 <div class="alert alert-warning d-none" data-offline role="status">Offline: consulte os dados exibidos. Para evitar perda de evidências, as ações estão temporariamente bloqueadas.</div>
 <nav aria-label="Navegação estrutural"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="/OrdemServico/Ordens">Ordens de serviço</a></li><li class="breadcrumb-item active" aria-current="page">Execução</li></ol></nav>
 <header class="sticky-top bg-body py-2 border-bottom"><div class="d-flex justify-content-between gap-3"><h1 class="h4 mb-0" data-numero>Ordem</h1><span class="badge text-bg-primary align-self-start" data-status><span aria-hidden="true">●</span> Carregando</span></div><div class="small text-secondary" data-cliente></div></header>
 <aside class="alert alert-info my-3"><strong>Como usar:</strong> confira a ordem, inicie a execução, salve cada resposta e somente então envie a conclusão. Salvar checklist não conclui a ordem.</aside>
 <section class="my-3"><h2 class="h5">Atendimento</h2><p data-descricao></p><div class="d-grid gap-2"><button class="btn btn-primary btn-lg" data-action="iniciar-deslocamento">Iniciar deslocamento</button><button class="btn btn-success btn-lg" data-action="iniciar">Iniciar execução</button><button class="btn btn-warning btn-lg" data-action="pausar">Pausar</button><button class="btn btn-outline-primary btn-lg" data-action="retomar">Retomar</button></div></section>
 <section class="my-4" aria-labelledby="checklist-title"><div class="d-flex justify-content-between align-items-center"><h2 class="h5" id="checklist-title">Checklist</h2><span class="small text-secondary" data-progress>0 de 0 respondidos</span></div><form class="vstack gap-3" data-checklist></form><p class="small text-secondary mt-2" data-save-state role="status">Nenhuma alteração pendente.</p></section>
 <section class="my-4" aria-labelledby="history-title"><h2 class="h5" id="history-title">Histórico cronológico</h2><ol class="list-group list-group-numbered" data-history><li class="list-group-item text-secondary">Carregando histórico…</li></ol></section>
 <section class="my-4"><h2 class="h5">Aceite interno</h2><p class="small text-warning">O aceite interno não substitui assinatura digital ICP-Brasil.</p><form data-aceite><input class="form-control mb-2" name="nome" placeholder="Nome do responsável" required><input class="form-control mb-2" name="documentoMascarado" placeholder="Documento mascarado" required><textarea class="form-control mb-2" name="observacao" placeholder="Observação"></textarea><label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirmado" required> Confirmo o aceite do serviço executado</label><button class="btn btn-outline-success btn-lg w-100">Registrar aceite</button></form></section>
 <button class="btn btn-success btn-lg w-100" data-action="concluir">Concluir atendimento</button>
 <div class="visually-hidden" aria-live="polite" data-live></div>
</main>
<script type="module" src="~/js/ordem-servico/tecnico.js"></script>
