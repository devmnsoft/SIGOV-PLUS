@using Sigov.Application.Saude
@{
    ViewData["Title"] = "Ficha do Paciente";
    var paciente = ViewBag.Paciente as PacienteDetalheResponse;
    var id = ViewData["PacienteId"];
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Saude">Saúde</a></li>
    <li class="breadcrumb-item"><a href="/Saude/Pacientes">Pacientes</a></li>
    <li class="breadcrumb-item active" aria-current="page">Ficha</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Ficha Cadastral do Paciente</h1>
    <p class="text-muted mb-0">Identificação e dados gerais de saúde protegidos pela LGPD.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/Saude/Pacientes" class="btn btn-outline-secondary">Voltar</a>
    @if (paciente is not null)
    {
      <a href="/Saude/Prontuario/@paciente.Id" class="btn btn-primary">Abrir Prontuário Eletrônico</a>
    }
  </div>
</div>

<details class="how-to mb-4" open>
  <summary class="fw-bold">Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>CPF e CNS mascarados. Inativo não agenda.</p>
    <ul>
      <li><strong>Proteção LGPD:</strong> Dados clínicos e identificadores são mascarados na visualização comum.</li>
      <li><strong>Acesso ao Prontuário:</strong> O prontuário integral exige permissão assistencial específica e cada consulta é registrada na auditoria.</li>
      <li><strong>Histórico Clínico:</strong> Use as ações rápidas para iniciar acolhimento ou registrar dose vacinal.</li>
    </ul>
  </div>
</details>

@if (paciente is null)
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <p class="text-muted mb-3">Registro de paciente ID @id não localizado ou acesso restrito pelo controle de tenant.</p>
      <a href="/Saude/Pacientes" class="btn btn-primary">Retornar à Lista de Pacientes</a>
    </div>
  </div>
}
else
{
  var cnsMask = string.IsNullOrWhiteSpace(paciente.CartaoSus) ? "Não informado" : (paciente.CartaoSus.Length > 7 ? paciente.CartaoSus[..3] + "******" + paciente.CartaoSus[^4..] : "***");
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
      <span>Identificação do Paciente</span>
      <span class="badge @(paciente.Situacao == "ATIVO" ? "text-bg-success" : "text-bg-secondary")">@paciente.Situacao</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3">
          <label class="text-muted small d-block">Código do Paciente</label>
          <span class="fs-5 fw-semibold">@paciente.CodigoPaciente</span>
        </div>
        <div class="col-md-3">
          <label class="text-muted small d-block">Cartão SUS (CNS Protegido)</label>
          <code class="fs-6">@cnsMask</code>
        </div>
        <div class="col-md-3">
          <label class="text-muted small d-block">Prontuário Número</label>
          <span class="fs-5">@(string.IsNullOrWhiteSpace(paciente.ProntuarioNumero) ? "—" : paciente.ProntuarioNumero)</span>
        </div>
        <div class="col-md-3">
          <label class="text-muted small d-block">Grupo Sanguíneo</label>
          <span class="badge text-bg-light border fs-6">@(string.IsNullOrWhiteSpace(paciente.GrupoSanguineo) ? "Não informado" : paciente.GrupoSanguineo)</span>
        </div>
        <div class="col-12">
          <label class="text-muted small d-block">Alergias Relatadas</label>
          <div class="p-2 border rounded bg-light">
            @(string.IsNullOrWhiteSpace(paciente.Alergias) ? "Nenhuma alergia conhecida registrada." : paciente.Alergias)
          </div>
        </div>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
      <span class="text-muted small">Acesso auditado com base na permissão <code>saude.paciente.visualizar</code>.</span>
      <div class="d-flex gap-2">
        <a href="/Saude/Agenda" class="btn btn-sm btn-outline-primary">Agendar Consulta</a>
        <a href="/Saude/Vacinacao" class="btn btn-sm btn-outline-success">Registrar Vacina</a>
        <a href="/Saude/Prontuario/@paciente.Id" class="btn btn-sm btn-primary">Visualizar Prontuário</a>
      </div>
    </div>
  </div>
}

