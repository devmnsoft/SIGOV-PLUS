@model Sigov.Web.Models.Saude.AgendaSaudeFormViewModel
@using Sigov.Application.Saude
@{
    ViewData["Title"] = "Agenda de Saúde";
    var agendas = ViewBag.Agendas as IEnumerable<AgendaSaudeResponse> ?? Array.Empty<AgendaSaudeResponse>();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Saude">Saúde</a></li>
    <li class="breadcrumb-item active" aria-current="page">Agenda</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Agenda de Atendimento e Consultas</h1>
    <p class="text-muted mb-0">Programação de horários assistenciais nas unidades municipais.</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#agendaModal">Novo Agendamento</button>
</div>

<details class="how-to mb-4" open>
  <summary class="fw-bold">Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Profissional não sobrepõe horário. Cancelar pede motivo.</p>
    <ul>
      <li><strong>Prevenção de Conflitos:</strong> O sistema bloqueia agendamentos sobrepostos para o mesmo profissional de saúde no mesmo intervalo.</li>
      <li><strong>Unidades e Profissionais:</strong> Apenas profissionais e estabelecimentos ativos podem receber novos horários de consulta.</li>
      <li><strong>Cancelamento com Auditoria:</strong> Cancelar um horário reservado exige obrigatoriamente a descrição do motivo.</li>
    </ul>
  </div>
</details>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
    <span>Horários Agendados</span>
    <span class="badge text-bg-secondary">Total: @agendas.Count()</span>
  </div>
  <div class="card-body p-0">
    @if (!agendas.Any())
    {
      <div class="text-center py-5">
        <p class="text-muted mb-3">Nenhum agendamento encontrado para o período selecionado.</p>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#agendaModal">Reservar Primeiro Horário</button>
      </div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Início</th>
              <th>Fim</th>
              <th>Tipo</th>
              <th>Status</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var a in agendas)
            {
              <tr>
                <td class="fw-semibold">#@a.Id</td>
                <td>@a.DataInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@a.DataFim.ToLocalTime().ToString("HH:mm")</td>
                <td><span class="badge text-bg-light border">@a.TipoAgendamento</span></td>
                <td>
                  @if (a.Status == "AGENDADA")
                  {
                    <span class="badge text-bg-primary">AGENDADA</span>
                  }
                  else if (a.Status == "ATENDIDA")
                  {
                    <span class="badge text-bg-success">ATENDIDA</span>
                  }
                  else if (a.Status == "CANCELADA")
                  {
                    <span class="badge text-bg-secondary">CANCELADA</span>
                  }
                  else
                  {
                    <span class="badge text-bg-info">@a.Status</span>
                  }
                </td>
                <td class="text-end">
                  @if (a.Status != "CANCELADA" && a.Status != "ATENDIDA")
                  {
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelarModal-@a.Id">
                      Cancelar Horário
                    </button>

                    <div class="modal fade" id="cancelarModal-@a.Id" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content text-start">
                          <form method="post" action="/Saude/Agenda/Cancelar/@a.Id">
                            @Html.AntiForgeryToken()
                            <div class="modal-header">
                              <h5 class="modal-title">Cancelar Agendamento #@a.Id</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                              <p class="text-danger fw-semibold">Cancelar este horário? Informe o motivo.</p>
                              <div class="mb-3">
                                <label class="form-label">Motivo do Cancelamento <span class="text-danger">*</span></label>
                                <textarea name="motivo" class="form-control" rows="3" placeholder="Informe o motivo da desmarcação" required></textarea>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                              <button type="submit" class="btn btn-danger" data-confirm="Cancelar este horário? Informe o motivo.">Confirmar Cancelamento</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  }
                  else
                  {
                    <span class="text-muted small">Sem ações</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

<div class="modal fade" id="agendaModal" tabindex="-1" aria-labelledby="agendaModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="agendaModalLabel">Novo Horário na Agenda</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <partial name="_FormAgenda" model="Model" />
      </div>
    </div>
  </div>
</div>

