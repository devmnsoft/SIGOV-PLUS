@model Sigov.Web.Models.Saude.SaudeDashboardViewModel
@{ ViewData["Title"] = Model.Titulo; }
<div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-4"><div><span class="badge text-bg-success mb-2">Saúde360 + ACS360</span><h1 class="h2">@Model.Titulo</h1><p class="text-muted">Atenção básica, território, produção ACS, sincronização e vigilâncias no contexto autorizado.</p></div><a class="btn btn-success" href="/Saude/ACS">Abrir operação ACS360</a></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Período</label><select class="form-select"><option>Hoje</option><option>Últimos 30 dias</option><option>Competência atual</option></select></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select"><option>Todos</option><option>Pendente</option><option>Realizada</option><option>Recusada/ausente</option></select></div><div class="col-md-3"><label class="form-label">Condição acompanhada</label><select class="form-select"><option>Todas</option><option>Gestante</option><option>Hipertensão</option><option>Diabetes</option><option>Acamado</option></select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100" type="button">Atualizar indicadores</button></div></div></div></div>
<div id="saude-dashboard" class="row g-3" data-api="/api/saude/dashboard"></div>
<div class="row g-3 mt-1"><div class="col-lg-8"><div class="card h-100"><div class="card-header"><strong>Cobertura e produtividade</strong></div><div class="card-body text-muted">Os consolidados são calculados exclusivamente a partir dos cadastros e visitas persistidos. Use Territórios para detalhar área, microárea, equipe e ACS.</div></div></div><div class="col-lg-4"><div class="card h-100 border-warning"><div class="card-header"><strong>Alertas operacionais</strong></div><div class="card-body"><a href="/Saude/ACS/Conflitos" class="d-block mb-2">Conflitos de sincronização</a><a href="/Saude/ACS/ExportacaoEsus" class="d-block mb-2">Inconsistências e-SUS/SISAB</a><a href="/Saude/Vigilancias/Alertas" class="d-block">Alertas de vigilância</a></div></div></div></div>
@section Scripts { <script src="~/js/modules/saude.dashboard.js"></script> }
