@model Sigov.Web.Models.Saude.AcsIndividuoFormViewModel
<form class="saude-ajax-form" data-api="/api/saude/acs/individuos">
 @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="row g-3">
  <div class="col-md-6"><label asp-for="PessoaId" class="form-label required"></label><select asp-for="PessoaId" class="form-select saude-lookup" data-api="/api/pessoas"><option value="">Busque e selecione a pessoa canônica</option></select><span asp-validation-for="PessoaId" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="AcsCadastroDomiciliarId" class="form-label required"></label><select asp-for="AcsCadastroDomiciliarId" class="form-select saude-lookup" data-api="/api/saude/acs/domicilios"><option value="">Selecione o domicílio</option></select><span asp-validation-for="AcsCadastroDomiciliarId" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="PacienteId" class="form-label"></label><select asp-for="PacienteId" class="form-select saude-lookup" data-api="/api/saude/pacientes"><option value="">Sem vínculo de prontuário</option></select><span asp-validation-for="PacienteId" class="text-danger"></span></div>
  <div class="col-12"><fieldset><legend class="h6">Condições acompanhadas</legend>@foreach (var item in new[]{"GESTANTE","HIPERTENSAO","DIABETES","ACAMADO","TUBERCULOSE","HANSENIASE","SAUDE_MENTAL","DEFICIENCIA"}) { <label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="CondicoesSaude" value="@item" /><span class="form-check-label">@item.Replace('_',' ')</span></label> }<span asp-validation-for="CondicoesSaude" class="text-danger d-block"></span></fieldset></div>
 </div><button class="btn btn-primary mt-3" type="submit">Salvar cadastro individual</button>
</form>
