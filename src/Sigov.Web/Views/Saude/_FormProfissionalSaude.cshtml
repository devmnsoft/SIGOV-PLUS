@model Sigov.Web.Models.Saude.ProfissionalSaudeFormViewModel
@using Sigov.Application.Saude
@using Sigov.Application.Core
@{
    var unidades = ViewBag.Unidades as IEnumerable<UnidadeSaudeResponse> ?? Array.Empty<UnidadeSaudeResponse>();
    var pessoas = ViewBag.Pessoas as IEnumerable<PessoaResumoResponse> ?? Array.Empty<PessoaResumoResponse>();
}

<form method="post" action="/Saude/Profissionais/Novo">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
  <div class="row g-3">
    <div class="col-12">
      <label class="form-label">Pessoa <span class="text-danger">*</span></label>
      <select name="PessoaId" class="form-select" required>
        <option value="">Selecione a pessoa cadastrada...</option>
        @foreach (var pessoa in pessoas)
        {
          <option value="@pessoa.Id">@pessoa.Nome (@(string.IsNullOrWhiteSpace(pessoa.Documento) ? $"ID {pessoa.Id}" : pessoa.Documento))</option>
        }
      </select>
      <span class="form-text">O profissional será vinculado a esta pessoa no cadastro oficial.</span>
    </div>
    <div class="col-md-4">
      <label asp-for="CodigoProfissional" class="form-label">Código do Profissional <span class="text-danger">*</span></label>
      <input asp-for="CodigoProfissional" class="form-control" placeholder="ex: MED-0012" required />
      <span asp-validation-for="CodigoProfissional" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
      <label asp-for="TipoProfissional" class="form-label">Categoria Profissional</label>
      <select asp-for="TipoProfissional" class="form-select">
        <option value="MEDICO">Médico(a)</option>
        <option value="ENFERMEIRO">Enfermeiro(a)</option>
        <option value="TECNICO_ENFERMAGEM">Técnico(a) de Enfermagem</option>
        <option value="DENTISTA">Cirurgião-Dentista</option>
        <option value="FARMACEUTICO">Farmacêutico(a)</option>
        <option value="ACS">Agente Comunitário de Saúde (ACS)</option>
        <option value="OUTRO">Outro Profissional de Saúde</option>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Unidade de Lotação Principal</label>
      <select name="UnidadeSaudeId" class="form-select">
        <option value="">Atuação descentralizada / Geral</option>
        @foreach (var u in unidades)
        {
          <option value="@u.Id">@u.Nome (@u.Codigo)</option>
        }
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Conselho de Classe</label>
      <select name="ConselhoClasse" class="form-select">
        <option value="">Não informado</option>
        <option value="CRM">CRM</option>
        <option value="COREN">COREN</option>
        <option value="CRO">CRO</option>
        <option value="CRF">CRF</option>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Número no Conselho</label>
      <input type="text" name="NumeroConselho" class="form-control" placeholder="Número do registro" />
    </div>
    <div class="col-md-4">
      <label class="form-label">Situação</label>
      <select name="Situacao" class="form-select">
        <option value="ATIVO" selected>ATIVO</option>
        <option value="INATIVO">INATIVO</option>
      </select>
    </div>
  </div>
  <div class="d-flex justify-content-end gap-2 mt-4">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="submit" class="btn btn-primary">Salvar Profissional</button>
  </div>
</form>
