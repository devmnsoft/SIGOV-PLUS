@model Sigov.Web.Models.Saude.AcsDomicilioFormViewModel
<form class="saude-ajax-form" data-api="/api/saude/acs/domicilios">
 @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="row g-3">
  <div class="col-md-4"><label asp-for="CodigoDomicilio" class="form-label required"></label><input asp-for="CodigoDomicilio" class="form-control" autocomplete="off" /><span asp-validation-for="CodigoDomicilio" class="text-danger"></span></div>
  <div class="col-md-8"><label asp-for="AcsMicroareaId" class="form-label required"></label><select asp-for="AcsMicroareaId" class="form-select saude-lookup" data-api="/api/saude/acs/microareas"><option value="">Selecione a microárea</option></select><span asp-validation-for="AcsMicroareaId" class="text-danger"></span></div>
  <div class="col-12"><label asp-for="EnderecoDescricao" class="form-label required"></label><input asp-for="EnderecoDescricao" class="form-control" placeholder="Logradouro, número ou referência territorial validável" /><span asp-validation-for="EnderecoDescricao" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" inputmode="decimal" /><span asp-validation-for="Latitude" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" inputmode="decimal" /><span asp-validation-for="Longitude" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="PrecisaoMetros" class="form-label"></label><input asp-for="PrecisaoMetros" class="form-control" inputmode="decimal" /><span asp-validation-for="PrecisaoMetros" class="text-danger"></span></div>
 </div><button class="btn btn-primary mt-3" type="submit">Salvar domicílio</button>
</form>
