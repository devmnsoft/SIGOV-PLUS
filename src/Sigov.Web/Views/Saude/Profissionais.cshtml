@model Sigov.Web.Models.Saude.ProfissionalSaudeFormViewModel
@using Sigov.Application.Saude
@{
    ViewData["Title"] = "Profissionais de Saúde";
    var profissionais = ViewBag.Profissionais as IEnumerable<ProfissionalSaudeResponse> ?? Array.Empty<ProfissionalSaudeResponse>();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Saude">Saúde</a></li>
    <li class="breadcrumb-item active" aria-current="page">Profissionais</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Profissionais de Saúde</h1>
    <p class="text-muted mb-0">Corpo clínico e assistencial vinculado às unidades de saúde municipais.</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#saudeFormModal">Novo Profissional</button>
</div>

<details class="how-to mb-4" open>
  <summary class="fw-bold">Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Cadastre e gerencie profissionais de saúde. Inativo não agenda, não acolhe e não atende.</p>
    <ul>
      <li><strong>Vínculo com Unidade:</strong> Selecione a unidade de saúde por nome para estabelecer a escala assistencial do profissional.</li>
      <li><strong>Situação Operacional:</strong> Somente profissionais ATIVOS constam nos seletores de agendamento e atendimento clínico.</li>
      <li><strong>Registro Profissional:</strong> Conselho de classe e CBO habilitam a execução de procedimentos regulados pelo SUS.</li>
    </ul>
  </div>
</details>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
    <span>Quadro de Profissionais</span>
    <span class="badge text-bg-secondary">Total: @profissionais.Count()</span>
  </div>
  <div class="card-body p-0">
    @if (!profissionais.Any())
    {
      <div class="text-center py-5">
        <p class="text-muted mb-3">Nenhum profissional de saúde cadastrado no momento.</p>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#saudeFormModal">Cadastrar Primeiro Profissional</button>
      </div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Código</th>
              <th>Categoria / Tipo</th>
              <th>Unidade Vinculada</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var p in profissionais)
            {
              <tr>
                <td class="fw-semibold">@p.CodigoProfissional</td>
                <td><span class="badge text-bg-light border">@p.TipoProfissional</span></td>
                <td>@(p.UnidadeSaudeId.HasValue ? $"Unidade ID #{p.UnidadeSaudeId}" : "Geral / Descentralizado")</td>
                <td>
                  @if (p.Situacao == "ATIVO")
                  {
                    <span class="badge text-bg-success">ATIVO</span>
                  }
                  else
                  {
                    <span class="badge text-bg-danger">INATIVO</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

<div class="modal fade" id="saudeFormModal" tabindex="-1" aria-labelledby="saudeFormModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="saudeFormModalLabel">Novo Profissional de Saúde</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <partial name="_FormProfissionalSaude" model="Model" />
      </div>
    </div>
  </div>
</div>

