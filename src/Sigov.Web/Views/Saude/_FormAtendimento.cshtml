@model Sigov.Web.Models.Saude.AtendimentoSaudeFormViewModel
@using Sigov.Application.Saude
@{
    var unidades = ViewBag.Unidades as IEnumerable<UnidadeSaudeResponse> ?? Array.Empty<UnidadeSaudeResponse>();
    var profissionais = ViewBag.Profissionais as IEnumerable<ProfissionalSaudeResponse> ?? Array.Empty<ProfissionalSaudeResponse>();
    var pacientes = ViewBag.Pacientes as IEnumerable<PacienteResumoResponse> ?? Array.Empty<PacienteResumoResponse>();
}

<form method="post" action="/Saude/Atendimentos/Novo">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Unidade de Saúde <span class="text-danger">*</span></label>
      <select name="UnidadeSaudeId" class="form-select" required>
        <option value="">Selecione a unidade...</option>
        @foreach (var u in unidades)
        {
          <option value="@u.Id">@u.Nome (@u.Codigo)</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Profissional Responsável <span class="text-danger">*</span></label>
      <select name="ProfissionalSaudeId" class="form-select" required>
        <option value="">Selecione o profissional...</option>
        @foreach (var pr in profissionais)
        {
          <option value="@pr.Id">@pr.CodigoProfissional (@pr.TipoProfissional)</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Paciente <span class="text-danger">*</span></label>
      <select name="PacienteId" class="form-select" required>
        <option value="">Selecione o paciente...</option>
        @foreach (var pac in pacientes)
        {
          <option value="@pac.Id">@pac.CodigoPaciente (CNS: @pac.CartaoSus)</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Classificação de Risco (Manchester) <span class="text-danger">*</span></label>
      <select name="ClassificacaoRisco" class="form-select" required>
        <option value="">Selecione a classificação...</option>
        <option value="AZUL">AZUL — Não Urgente</option>
        <option value="VERDE">VERDE — Pouco Urgente</option>
        <option value="AMARELO">AMARELO — Urgente</option>
        <option value="LARANJA">LARANJA — Muito Urgente</option>
        <option value="VERMELHO">VERMELHO — Emergência Imediata</option>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Tipo de Atendimento</label>
      <select name="TipoAtendimento" class="form-select">
        <option value="ACOLHIMENTO" selected>Acolhimento / Triagem Inicial</option>
        <option value="CONSULTA">Consulta Médica / Enfermagem</option>
        <option value="URGENCIA">Atendimento de Urgência</option>
        <option value="PROCEDIMENTO">Procedimento Ambulatorial</option>
      </select>
    </div>
    <div class="col-12">
      <label class="form-label">Queixa Principal / Motivo do Acolhimento</label>
      <textarea name="QueixaPrincipal" class="form-control" rows="3" placeholder="Relato inicial do paciente e sinais vitais aferidos"></textarea>
      <span class="text-muted small">Dados sensíveis protegidos: não constam em listagens públicas ou exportações resumidas.</span>
    </div>
  </div>
  <div class="d-flex justify-content-end gap-2 mt-4">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="submit" class="btn btn-primary">Registrar Acolhimento</button>
  </div>
</form>

