@model Sigov.Web.Models.Saude.AcsVisitaFormViewModel
<form class="saude-ajax-form" data-api="/api/saude/acs/visitas">
 @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="row g-3">
  <div class="col-md-6"><label asp-for="ProfissionalAcsId" class="form-label required"></label><select asp-for="ProfissionalAcsId" class="form-select saude-lookup" data-api="/api/saude/profissionais"><option value="">Selecione o ACS</option></select><span asp-validation-for="ProfissionalAcsId" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="AcsMicroareaId" class="form-label required"></label><select asp-for="AcsMicroareaId" class="form-select saude-lookup" data-api="/api/saude/acs/microareas"><option value="">Selecione a microárea</option></select><span asp-validation-for="AcsMicroareaId" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="AcsCadastroDomiciliarId" class="form-label"></label><select asp-for="AcsCadastroDomiciliarId" class="form-select saude-lookup" data-api="/api/saude/acs/domicilios"><option value="">Selecione um domicílio</option></select><span asp-validation-for="AcsCadastroDomiciliarId" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="AcsCadastroIndividualId" class="form-label"></label><select asp-for="AcsCadastroIndividualId" class="form-select saude-lookup" data-api="/api/saude/acs/individuos"><option value="">Selecione um cidadão, se aplicável</option></select><span asp-validation-for="AcsCadastroIndividualId" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataVisita" class="form-label required"></label><input asp-for="DataVisita" class="form-control" /><span asp-validation-for="DataVisita" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Turno" class="form-label required"></label><select asp-for="Turno" class="form-select"><option>MANHA</option><option>TARDE</option><option>NOITE</option><option>INTEGRAL</option></select><span asp-validation-for="Turno" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Desfecho" class="form-label required"></label><select asp-for="Desfecho" class="form-select"><option>REALIZADA</option><option>RECUSADA</option><option>AUSENTE</option></select><span asp-validation-for="Desfecho" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="TipoVisita" class="form-label required"></label><select asp-for="TipoVisita" class="form-select"><option>ROTINA</option><option>BUSCA_ATIVA</option><option>ACOMPANHAMENTO</option></select><span asp-validation-for="TipoVisita" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" inputmode="decimal" /><span asp-validation-for="Latitude" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" inputmode="decimal" /><span asp-validation-for="Longitude" class="text-danger"></span></div>
  <div class="col-12"><label asp-for="Observacao" class="form-label"></label><textarea asp-for="Observacao" class="form-control" rows="3"></textarea><span asp-validation-for="Observacao" class="text-danger"></span></div>
 </div><button class="btn btn-primary mt-3" type="submit">Registrar visita</button>
</form>
