@model Sigov.Web.Models.Saude.UnidadeSaudeFormViewModel
@using Sigov.Application.Saude
@{
    ViewData["Title"] = "Unidades de Saúde";
    var unidades = ViewBag.Unidades as IEnumerable<UnidadeSaudeResponse> ?? Array.Empty<UnidadeSaudeResponse>();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Saude">Saúde</a></li>
    <li class="breadcrumb-item active" aria-current="page">Unidades</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Unidades de Saúde</h1>
    <p class="text-muted mb-0">Gestão territorial de estabelecimentos de saúde da atenção básica e especializada.</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#saudeFormModal">Cadastrar Nova Unidade</button>
</div>

<details class="how-to mb-4" open>
  <summary class="fw-bold">Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>Cadastre e consulte unidades da rede municipal. Unidades inativas não podem agendar, acolher ou dispensar insumos.</p>
    <ul>
      <li><strong>Identificação Única:</strong> O código da unidade e o CNES oficial identificam o estabelecimento no cadastro nacional.</li>
      <li><strong>Situação Operacional:</strong> Mantenha a situação ATIVA para habilitar escalas de profissionais e agenda de consultas.</li>
      <li><strong>Esfera e Território:</strong> Unidades básicas centralizam microáreas atendidas pelos agentes comunitários.</li>
    </ul>
  </div>
</details>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
    <span>Unidades Cadastradas</span>
    <span class="badge text-bg-secondary">Total: @unidades.Count()</span>
  </div>
  <div class="card-body p-0">
    @if (!unidades.Any())
    {
      <div class="text-center py-5">
        <p class="text-muted mb-3">Nenhuma unidade de saúde encontrada no contexto atual.</p>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#saudeFormModal">Cadastrar Primeira Unidade</button>
      </div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Código</th>
              <th>Nome da Unidade</th>
              <th>CNES</th>
              <th>Tipo</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var u in unidades)
            {
              <tr>
                <td class="fw-semibold">@u.Codigo</td>
                <td>@u.Nome</td>
                <td>@(string.IsNullOrWhiteSpace(u.Cnes) ? "—" : u.Cnes)</td>
                <td><span class="badge text-bg-light border">@u.TipoUnidade</span></td>
                <td>
                  @if (u.Situacao == "ATIVA" || u.Ativo)
                  {
                    <span class="badge text-bg-success">ATIVA</span>
                  }
                  else
                  {
                    <span class="badge text-bg-danger">INATIVA</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

<div class="modal fade" id="saudeFormModal" tabindex="-1" aria-labelledby="saudeFormModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="saudeFormModalLabel">Nova Unidade de Saúde</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <partial name="_FormUnidadeSaude" model="Model" />
      </div>
    </div>
  </div>
</div>

