@model Sigov.Web.Models.Saude.PacienteFormViewModel
@using Sigov.Application.Saude
@{
    ViewData["Title"] = "Pacientes";
    var pacientes = ViewBag.Pacientes as IEnumerable<PacienteResumoResponse> ?? Array.Empty<PacienteResumoResponse>();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Início</a></li>
    <li class="breadcrumb-item"><a href="/Saude">Saúde</a></li>
    <li class="breadcrumb-item active" aria-current="page">Pacientes</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Pacientes</h1>
    <p class="text-muted mb-0">Cadastro de cidadãos atendidos pela atenção básica e especializada.</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#saudeFormModal">Novo Paciente</button>
</div>

<details class="how-to mb-4" open>
  <summary class="fw-bold">Como usar esta tela</summary>
  <div class="mt-2 text-muted">
    <p>CPF e CNS mascarados. Inativo não agenda.</p>
    <ul>
      <li><strong>Proteção de Dados Pessoais:</strong> CPF e Cartão SUS são mascarados por padrão na listagem e no resumo conforme LGPD.</li>
      <li><strong>Status Cadastral:</strong> Pacientes com situação INATIVO não podem receber agendamentos ou atendimentos novos.</li>
      <li><strong>Prontuário Único:</strong> Cada paciente possui um prontuário eletrônico vinculado gerado no primeiro atendimento.</li>
    </ul>
  </div>
</details>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
    <span>Lista de Pacientes</span>
    <span class="badge text-bg-secondary">Total: @pacientes.Count()</span>
  </div>
  <div class="card-body p-0">
    @if (!pacientes.Any())
    {
      <div class="text-center py-5">
        <p class="text-muted mb-3">Nenhum paciente cadastrado no momento.</p>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#saudeFormModal">Cadastrar Primeiro Paciente</button>
      </div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Código</th>
              <th>Cartão SUS</th>
              <th>Prontuário Nº</th>
              <th>Situação</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var p in pacientes)
            {
              var cnsMask = string.IsNullOrWhiteSpace(p.CartaoSus) ? "—" : (p.CartaoSus.Length > 7 ? p.CartaoSus[..3] + "******" + p.CartaoSus[^4..] : "***");
              <tr>
                <td class="fw-semibold">@p.CodigoPaciente</td>
                <td><code>@cnsMask</code></td>
                <td>@(string.IsNullOrWhiteSpace(p.ProntuarioNumero) ? "—" : p.ProntuarioNumero)</td>
                <td>
                  @if (p.Situacao == "ATIVO")
                  {
                    <span class="badge text-bg-success">ATIVO</span>
                  }
                  else
                  {
                    <span class="badge text-bg-secondary">INATIVO</span>
                  }
                </td>
                <td class="text-end">
                  <a href="/Saude/Pacientes/Detalhe/@p.Id" class="btn btn-sm btn-outline-primary">Ficha / Prontuário</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

<div class="modal fade" id="saudeFormModal" tabindex="-1" aria-labelledby="saudeFormModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="saudeFormModalLabel">Cadastrar Paciente</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <partial name="_FormPaciente" model="Model" />
      </div>
    </div>
  </div>
</div>

