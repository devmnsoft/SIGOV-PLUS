@model Sigov.Web.Models.Saude.AgendaSaudeFormViewModel
@using Sigov.Application.Saude
@{
    var unidades = ViewBag.Unidades as IEnumerable<UnidadeSaudeResponse> ?? Array.Empty<UnidadeSaudeResponse>();
    var profissionais = ViewBag.Profissionais as IEnumerable<ProfissionalSaudeResponse> ?? Array.Empty<ProfissionalSaudeResponse>();
    var pacientes = ViewBag.Pacientes as IEnumerable<PacienteResumoResponse> ?? Array.Empty<PacienteResumoResponse>();
    var agora = DateTime.Now;
    var horaInicio = new DateTime(agora.Year, agora.Month, agora.Day, agora.Hour + 1, 0, 0);
    var horaFim = horaInicio.AddMinutes(30);
}

<form method="post" action="/Saude/Agenda/Nova">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Unidade de Atendimento <span class="text-danger">*</span></label>
      <select name="UnidadeSaudeId" class="form-select" required>
        <option value="">Selecione a unidade...</option>
        @foreach (var u in unidades)
        {
          <option value="@u.Id">@u.Nome (@u.Codigo)</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Profissional de Saúde <span class="text-danger">*</span></label>
      <select name="ProfissionalSaudeId" class="form-select" required>
        <option value="">Selecione o profissional...</option>
        @foreach (var pr in profissionais)
        {
          <option value="@pr.Id">@pr.CodigoProfissional (@pr.TipoProfissional)</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Paciente <span class="text-danger">*</span></label>
      <select name="PacienteId" class="form-select" required>
        <option value="">Selecione o paciente...</option>
        @foreach (var pac in pacientes)
        {
          <option value="@pac.Id">@pac.CodigoPaciente (CNS: @pac.CartaoSus)</option>
        }
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Tipo de Agendamento</label>
      <select name="TipoAgendamento" class="form-select">
        <option value="CONSULTA" selected>Consulta Médica / Enfermagem</option>
        <option value="RETORNO">Retorno Ambulatorial</option>
        <option value="EXAME">Coleta de Exames</option>
        <option value="PROCEDIMENTO">Procedimento / Curativo</option>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Data e Hora Inicial <span class="text-danger">*</span></label>
      <input type="datetime-local" name="DataInicio" class="form-control" value="@horaInicio.ToString("yyyy-MM-ddTHH:mm")" required />
    </div>
    <div class="col-md-6">
      <label class="form-label">Data e Hora Final <span class="text-danger">*</span></label>
      <input type="datetime-local" name="DataFim" class="form-control" value="@horaFim.ToString("yyyy-MM-ddTHH:mm")" required />
    </div>
    <div class="col-12">
      <label class="form-label">Observações Clínicas / Encaminhamento</label>
      <textarea name="Observacao" class="form-control" rows="2" placeholder="Observações de acolhimento ou preparo para a consulta"></textarea>
    </div>
  </div>
  <div class="d-flex justify-content-end gap-2 mt-4">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="submit" class="btn btn-primary">Confirmar Agendamento</button>
  </div>
</form>

