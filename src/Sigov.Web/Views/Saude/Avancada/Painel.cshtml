@{ var modulo=ViewData["Modulo"]?.ToString()??"Saúde Avançada";var pagina=ViewData["Pagina"]?.ToString()??"Dashboard";ViewData["Title"]=$"{pagina} · {modulo}"; }
<section class="health-command-center" data-health-module="@modulo">
<header class="health-premium-header"><div><span class="lgpd-badge">LGPD · dado sensível</span><p class="health-eyebrow">SIGOV+ · Saúde Avançada RC50.49</p><h1>@pagina</h1><p>Operação municipal segura de @modulo, com persistência por tenant, auditoria e CorrelationId.</p></div><a class="btn btn-primary" href="/Saude/Retaguarda/Dashboard">Retaguarda ACS</a></header>
<div class="health-kpi-grid"><article class="health-dashboard-card"><span>Operação</span><strong>Dados reais</strong><small>Sem persistência simulada</small></article><article class="sync-status-card"><span>Sincronização</span><strong>Por lote</strong><small>Duplicidade offline protegida</small></article><article class="geopoint-card"><span>Georreferência</span><strong>Protegida</strong><small>Mapa preparatório</small></article><article class="sla-card"><span>Governança</span><strong>SLA auditável</strong><small>Alertas por severidade</small></article></div>
<div class="health-panel"><div class="filter-bar"><label>Período <input type="date" /></label><label>Status <select><option>Todos</option><option>Pendente</option><option>Ativo</option></select></label><button class="btn btn-outline-primary">Filtrar</button></div><div class="responsive-data-table"><table><thead><tr><th>Referência</th><th>Status</th><th>Origem</th><th>Auditoria</th><th>Ações</th></tr></thead><tbody><tr class="empty-state"><td colspan="5"><strong>Nenhum registro para os filtros.</strong><span>Cadastre pela API ou ajuste o período. O estado vazio não simula dados.</span></td></tr></tbody></table></div></div>
<footer class="health-trust-strip"><span>🔒 Acesso mínimo necessário</span><span>◎ CorrelationId</span><span>Preparatório: e-SUS/SISAB e mapa</span></footer>
</section>
