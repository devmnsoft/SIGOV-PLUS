@{ViewData["Title"]="Relatórios de Obras";var reports=new[]{("obras-status-localidade","Obras por status/localidade"),("obras-unidade","Obras por unidade/secretaria"),("orcamento","Orçamento da obra"),("cronograma","Cronograma físico-financeiro"),("medicoes-periodo","Medições por período"),("medicoes-homologadas","Medições homologadas"),("medicoes-status","Medições por status"),("diario","Diário de obra"),("fiscalizacoes","Fiscalizações"),("ocorrencias","Ocorrências"),("nao-conformidades","Não conformidades"),("aditivos","Aditivos"),("reajustes","Reajustes"),("reequilibrios","Reequilíbrios"),("transparencia","Transparência"),("evidencias","Evidências"),("ocorrencias-ordens","Ocorrências e ordens de serviço"),("convenios-repasses","Convênios e repasses"),("integracao-financeira","Integração financeira de medições"),("auditoria","Auditoria do módulo")};}<h1 class="h3">Relatórios CSV</h1><p class="text-muted">Exportações segregadas por tenant/entidade, protegidas por RBAC, neutralizadas contra fórmulas e auditadas.</p><partial name="_Nav" /><details class="card card-body mb-3 sigov-screen-guide"><summary class="fw-semibold">Como usar esta tela</summary><div class="small text-muted mt-2">Use os filtros para restringir os dados do contexto institucional atual e selecione Exportar CSV. A permissão específica de relatório é obrigatória; alguns registros podem conter dados sensíveis e devem ser tratados conforme a LGPD. Após a solicitação, um arquivo CSV protegido contra fórmulas é gerado somente com os dados autorizados; quando não houver resultados, confira os filtros antes de tentar novamente.</div></details><div class="row g-3">@foreach(var r in reports){<div class="col-md-6 col-xl-4"><a class="card card-body text-decoration-none h-100" href="@Url.Action("Csv", "Obras", new { relatorio = r.Item1 })"><strong>@r.Item2</strong><span class="small text-muted">Baixar CSV oficial</span></a></div>}</div>
