@model Sigov.Application.Obras.Engenharia.ObrasDashboard
@{ViewData["Title"]="Obras Públicas";}<div class="d-flex justify-content-between"><div><h1 class="h3">Obras Públicas e Engenharia</h1><p class="text-muted">Indicadores oficiais consolidados do PostgreSQL.</p></div><a class="btn btn-primary align-self-start" href="/Obras/Cadastro/Nova">Nova obra</a></div><partial name="_Nav" />
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-3"><label class="form-label">Período inicial</label><input type="date" name="Inicio" class="form-control" /></div><div class="col-md-3"><label class="form-label">Período final</label><input type="date" name="Fim" class="form-control" /></div><div class="col-md-2"><label class="form-label">Status</label><input name="Status" class="form-control" /></div><div class="col-md-2"><label class="form-label">Unidade</label><input name="Unidade" class="form-control" /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Aplicar filtros</button></div></div></form>
<div class="row g-3">@foreach(var k in new[]{("Planejadas",Model.Planejadas.ToString()),("Contratadas",Model.Contratadas.ToString()),("Em execução",Model.EmExecucao.ToString()),("Paralisadas",Model.Paralisadas.ToString()),("Concluídas",Model.Concluidas.ToString()),("Valor contratado",Model.ValorContratado.ToString("C")),("Valor medido",Model.ValorMedido.ToString("C")),("Saldo a medir",Model.SaldoMedir.ToString("C")),("Medições pendentes",Model.MedicoesPendentes.ToString()),("Fiscalizações pendentes",Model.FiscalizacoesPendentes.ToString()),("Ordens abertas",Model.OrdensAbertas.ToString())}){<div class="col-sm-6 col-lg-3"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="small text-muted">@k.Item1</div><div class="fs-3 fw-semibold">@k.Item2</div></div></div></div>}</div>
