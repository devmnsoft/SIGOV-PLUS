@model Sigov.Application.Obras.Engenharia.ObrasDashboard
@{ViewData["Title"]="Obras360";var cards=new[]{("Em andamento",Model.EmExecucao.ToString(),"primary"),("Paralisadas",Model.Paralisadas.ToString(),"danger"),("Medições pendentes",Model.MedicoesPendentes.ToString(),"warning"),("Medições aprovadas",Model.MedicoesAprovadas.ToString(),"success"),("Ocorrências abertas",Model.OcorrenciasAbertas.ToString(),"warning"),("NC vencidas",Model.NaoConformidadesVencidas.ToString(),"danger"),("Diários pendentes",Model.DiariosPendentes.ToString(),"info"),("Publicações pendentes",Model.PublicacoesPendentes.ToString(),"secondary")};}
<div class="d-flex justify-content-between flex-wrap gap-3"><div><span class="badge text-bg-primary">FUNC13 · Obras360</span><h1 class="display-6 fw-semibold mt-2">Operação de obras públicas</h1><p class="text-muted">Cronograma, campo, medição e rastreabilidade financeira em uma visão oficial.</p></div><a class="btn btn-primary align-self-start" href="/Obras/Cadastro/Nova">Nova obra</a></div><partial name="_Nav"/>
<form method="get" class="card card-body border-0 shadow-sm mb-4"><div class="row g-2"><div class="col-md-4"><label class="form-label">Obra</label><input name="busca" class="form-control" placeholder="Código ou nome"/></div><div class="col-md-2"><label class="form-label">Início</label><input name="inicio" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">Fim</label><input name="fim" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">Todos</option><option>EM_EXECUCAO</option><option>PARALISADA</option></select></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Filtrar</button></div></div></form>
<div class="row g-3">@foreach(var c in cards){<div class="col-6 col-lg-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="text-muted small">@c.Item1</span><div class="fs-2 fw-bold text-@c.Item3">@c.Item2</div></div></div></div>}</div>
<div class="row g-3 mt-1"><div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Execução físico-financeira</h2><div class="d-flex justify-content-between"><span>Previsto @Model.PercentualPrevisto.ToString("N1")%</span><span>Executado @Model.PercentualExecutado.ToString("N1")%</span></div><div class="progress mt-2" role="progressbar"><div class="progress-bar" style="width:@Math.Clamp(Model.PercentualExecutado,0,100).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div></div></div><div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Saldo contratual</h2><div class="fs-3 fw-bold">@Model.SaldoMedir.ToString("C")</div><div class="text-muted">Medido: @Model.ValorMedido.ToString("C") de @Model.ValorContratado.ToString("C")</div></div></div></div></div>
