@model Sigov.Web.Models.Obras.ObrasRegistroFormViewModel
@{ViewData["Title"]=(Model.Id.HasValue?"Editar":"Novo")+" registro Obras360";var statuses=new[]{"RASCUNHO","ENVIADO","EM_ANALISE","APROVADA","REJEITADA","ATIVA","ABERTA","EM_EXECUCAO","CONCLUIDA","PENDENTE","PUBLICADA","CANCELADA"};}
<div class="d-flex justify-content-between align-items-start"><div><span class="badge text-bg-primary">Obras360 · FUNC13</span><h1 class="h3 mt-2">@(Model.Id.HasValue?"Editar":"Novo") — @Model.Recurso</h1><p class="text-muted">Registro oficial com segregação de contexto e trilha de auditoria.</p></div></div>
<partial name="_Nav" />
<form method="post" action="/Obras/@Model.Recurso/Salvar" class="card border-0 shadow-sm"><div class="card-body p-4">
 @Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="Recurso" type="hidden"/>
 <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
 <div class="row g-3">
  <div class="col-lg-6"><label asp-for="ObraId" class="form-label fw-semibold">Obra <span class="text-danger">*</span></label><select asp-for="ObraId" class="form-select" required><option value="0">Selecione a obra</option>@foreach(var o in Model.Obras){<option value="@o.Id">@o.Texto</option>}</select><span asp-validation-for="ObraId" class="text-danger"></span></div>
  <div class="col-lg-3"><label asp-for="Codigo" class="form-label">Número/código</label><input asp-for="Codigo" class="form-control"/><span asp-validation-for="Codigo" class="text-danger"></span></div>
  <div class="col-lg-3"><label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label><select asp-for="Status" class="form-select">@foreach(var s in statuses){<option value="@s">@s.Replace('_',' ')</option>}</select><span asp-validation-for="Status" class="text-danger"></span></div>
  <div class="col-12"><label asp-for="Descricao" class="form-label fw-semibold">Descrição/atividades/fundamento <span class="text-danger">*</span></label><textarea asp-for="Descricao" rows="4" class="form-control" required></textarea><span asp-validation-for="Descricao" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Valor" class="form-label">Valor</label><input asp-for="Valor" min="0" step="0.01" class="form-control"/><span asp-validation-for="Valor" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Data" class="form-label">Data/competência</label><input asp-for="Data" type="date" class="form-control"/><span asp-validation-for="Data" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Justificativa" class="form-label">Justificativa</label><textarea asp-for="Justificativa" class="form-control"></textarea><span asp-validation-for="Justificativa" class="text-danger"></span></div>
  <div class="col-12"><label asp-for="DadosJson" class="form-label">Memória de cálculo e metadados técnicos (JSON)</label><textarea asp-for="DadosJson" class="form-control font-monospace" rows="5"></textarea><span asp-validation-for="DadosJson" class="text-danger"></span><div class="form-text">Somente metadados reais. Geoevidências usam a referência transversal; este formulário não simula upload.</div></div>
 </div>
 <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Salvar e auditar</button><a href="/Obras/@Model.Recurso" class="btn btn-outline-secondary">Cancelar</a></div>
</div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
