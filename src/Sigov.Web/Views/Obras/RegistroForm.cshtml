@model Sigov.Application.Obras.Engenharia.ObrasRegistroRequest
@{var recurso=(string?)ViewData["Recurso"]??"registro";ViewData["Title"]="Novo registro";}<h1 class="h3">Novo registro — @recurso</h1><partial name="_Nav" /><form method="post" action="/Obras/@recurso/Salvar" class="card card-body"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-3"><label class="form-label">ID da obra *</label><input asp-for="ObraId" min="1" class="form-control" required /></div><div class="col-md-3"><label class="form-label">Número/código</label><input asp-for="Codigo" class="form-control" /></div><div class="col-md-6"><label class="form-label">Descrição *</label><input asp-for="Descricao" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Status *</label><input asp-for="Status" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Valor</label><input asp-for="Valor" min="0" class="form-control" /></div><div class="col-md-4"><label class="form-label">Data/competência</label><input asp-for="Data" type="date" class="form-control" /></div><div class="col-12"><label class="form-label">Justificativa</label><textarea asp-for="Justificativa" class="form-control"></textarea></div><div class="col-12"><label class="form-label">Detalhes técnicos (JSON válido)</label><textarea asp-for="DadosJson" class="form-control font-monospace" rows="5"></textarea><div class="form-text">Use para checklist, equipe, equipamentos, ART/RRT, percentuais, prazos e referências documentais específicas.</div></div></div><button class="btn btn-primary mt-4 align-self-start">Salvar e auditar</button></form>
