@model Sigov.Web.Models.Obras.ObrasListaViewModel
@{ViewData["Title"]=Model.Titulo;}<div class="d-flex justify-content-between"><div><h1 class="h3">@Model.Titulo</h1><p class="text-muted">Registros operacionais oficiais, segregados por tenant e entidade.</p></div>@if(Model.Recurso!="auditoria"&&Model.Recurso!="integracao-financeira"){<a class="btn btn-primary align-self-start" href="/Obras/@Model.Recurso/Novo">Novo registro</a>}</div><partial name="_Nav" />@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}<form class="row g-2 mb-3"><div class="col-md-7"><input name="busca" class="form-control" value="@Model.Filtro.Busca" placeholder="Buscar por código ou descrição" /></div><div class="col-md-3"><input name="status" class="form-control" value="@Model.Filtro.Status" placeholder="Status" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Código</th><th>Descrição</th><th>Status</th><th>Data</th><th class="text-end">Valor</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Codigo</td><td>@x.Descricao</td><td><span class="badge text-bg-secondary">@x.Status</span></td><td>@x.Data?.ToString("d")</td><td class="text-end">@x.Valor?.ToString("C")</td><td>@if(Model.Recurso=="medicoes"&&x.Status=="APROVADA"){<form method="post" action="/Obras/Medicoes/@x.Id/Homologar"><button class="btn btn-sm btn-success">Homologar</button>@Html.AntiForgeryToken()</form>}</td></tr>}@if(Model.Items.Count==0){<tr><td colspan="6" class="text-center text-muted py-5">Nenhum registro encontrado para os filtros informados.</td></tr>}</tbody></table></div>
