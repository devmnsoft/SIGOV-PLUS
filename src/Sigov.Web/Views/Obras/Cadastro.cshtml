@model Sigov.Application.Obras.Engenharia.ObrasPagina
@{ViewData["Title"]="Cadastro de obras";}<div class="d-flex justify-content-between"><div><h1 class="h3">Cadastro de obras</h1><p class="text-muted">Planejamento, contratação e execução.</p></div><a class="btn btn-primary align-self-start" href="/Obras/Cadastro/Nova">Nova obra</a></div><partial name="_Nav" />
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}<form class="row g-2 mb-3"><div class="col-md-7"><input class="form-control" name="busca" value="@Context.Request.Query["busca"]" placeholder="Código, nome ou localidade" /></div><div class="col-md-3"><input class="form-control" name="status" value="@Context.Request.Query["status"]" placeholder="Status" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Buscar</button></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Código</th><th>Obra</th><th>Unidade/localidade</th><th>Status</th><th class="text-end">Contratado</th><th>Previsão</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Codigo</td><td><strong>@x.Nome</strong><div class="small text-muted">@x.Tipo</div></td><td>@x.Unidade<br/><span class="small text-muted">@x.Localidade</span></td><td><span class="badge text-bg-secondary">@x.Status</span></td><td class="text-end">@x.ValorContratado.ToString("C")</td><td>@x.InicioPrevisto?.ToString("d") – @x.FimPrevisto?.ToString("d")</td></tr>}@if(Model.Items.Count==0){<tr><td colspan="6" class="text-center text-muted py-5">Nenhuma obra encontrada. Cadastre a primeira obra para iniciar a operação.</td></tr>}</tbody></table></div><p class="text-muted">Página @Model.Pagina · @Model.Total registro(s)</p>
