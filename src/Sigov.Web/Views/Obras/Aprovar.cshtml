@model Sigov.Application.Obras.Engenharia.ObrasRegistro
@{ViewData["Title"]="Aprovar medição";}<span class="badge text-bg-warning">Decisão por alçada</span><h1 class="h3 mt-2">Medição @Model.Codigo</h1><partial name="_Nav"/><div class="alert alert-info">A homologação somente é liberada após aprovação e validação dos saldos contratual e orçamentário.</div><div class="card card-body border-0 shadow-sm"><p>@Model.Descricao</p><strong>@Model.Valor?.ToString("C")</strong><form method="post" action="/Obras/Medicoes/@Model.Id/Homologar" class="mt-3">@Html.AntiForgeryToken()<button class="btn btn-success">Confirmar homologação auditada</button></form></div>
