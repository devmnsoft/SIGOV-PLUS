@model Sigov.Application.Obras.Engenharia.ObraRequest
@{ViewData["Title"]="Nova obra";}<h1 class="h3">Cadastro da obra</h1><partial name="_Nav" /><form method="post" action="/Obras/Cadastro/Salvar" class="card card-body shadow-sm">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-3"><label class="form-label">Código *</label><input asp-for="Codigo" class="form-control" required /></div><div class="col-md-9"><label class="form-label">Nome *</label><input asp-for="Nome" class="form-control" required /></div><div class="col-12"><label class="form-label">Descrição</label><textarea asp-for="Descricao" class="form-control"></textarea></div><div class="col-md-4"><label class="form-label">Tipo *</label><input asp-for="TipoObra" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Secretaria/unidade</label><input asp-for="Unidade" class="form-control" /></div><div class="col-md-4"><label class="form-label">Localidade *</label><input asp-for="Localidade" class="form-control" required /></div><div class="col-12"><label class="form-label">Endereço</label><input asp-for="Endereco" class="form-control" /></div><div class="col-md-3"><label class="form-label">Valor estimado</label><input asp-for="ValorEstimado" class="form-control" min="0" /></div><div class="col-md-3"><label class="form-label">Valor contratado</label><input asp-for="ValorContratado" class="form-control" min="0" /></div><div class="col-md-3"><label class="form-label">Início previsto</label><input asp-for="InicioPrevisto" type="date" class="form-control" /></div><div class="col-md-3"><label class="form-label">Fim previsto</label><input asp-for="FimPrevisto" type="date" class="form-control" /></div><div class="col-md-4"><label class="form-label">Status</label><select asp-for="Status" class="form-select">@foreach(var s in new[]{"PLANEJADA","LICITADA","CONTRATADA","EM_EXECUCAO","PARALISADA","CONCLUIDA","CANCELADA","RESCINDIDA"}){<option>@s</option>}</select></div><div class="col-md-4"><label class="form-label">Fiscal</label><input asp-for="Fiscal" class="form-control" /></div><div class="col-md-4"><label class="form-label">Contrato (referência opcional)</label><input asp-for="ContratoReferencia" class="form-control" /></div><div class="col-md-6"><label class="form-label">Fonte de recurso</label><input asp-for="FonteRecurso" class="form-control" /></div><div class="col-md-6"><label class="form-label">Justificativa de paralisação/cancelamento/rescisão</label><textarea asp-for="Justificativa" class="form-control"></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Salvar no cadastro oficial</button><a href="/Obras/Cadastro" class="btn btn-link">Cancelar</a></div></form>
