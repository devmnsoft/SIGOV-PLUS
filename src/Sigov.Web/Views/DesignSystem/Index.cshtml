@using Sigov.Web.Models.Ui
@{
    ViewData["Title"] = "Design System";
    var timeline = new TimelineViewModel("Histórico demonstrativo", new[] {
        new TimelineItemViewModel("Protocolo criado", "Registro recebido e classificado.", "Hoje, 09:42", "success"),
        new TimelineItemViewModel("Encaminhado para análise", "Unidade responsável notificada.", "Hoje, 10:18", "info")
    });
    var filters = new FilterBarViewModel("/DesignSystem", new[] {
        new FilterFieldViewModel("termo", "Busca", "search", "Número, assunto ou responsável"),
        new FilterFieldViewModel("inicio", "Início", "date"),
        new FilterFieldViewModel("fim", "Fim", "date")
    }, ClearUrl: "/DesignSystem");
}
<div class="design-system" id="design-system">
    <header class="design-system__hero">
        <span class="badge bg-light text-dark mb-3">Uso interno · RC43</span>
        <h1 class="display-5 fw-bold">Design System SIGOV+</h1>
        <p class="lead mb-0">Componentes acessíveis e reutilizáveis para jornadas consistentes em todos os módulos, temas e tamanhos de tela.</p>
    </header>

    <nav class="design-system__nav" aria-label="Seções do design system">
        <a href="#acoes">Ações</a><a href="#indicadores">Indicadores</a><a href="#feedback">Feedback</a><a href="#formularios">Formulários</a><a href="#dados">Dados</a><a href="#estados">Estados</a><a href="#aparencia">Aparência</a>
    </nav>

    <section class="design-system__section" id="acoes">
        <h2 class="h4">Botões, badges e ações</h2>
        <p class="text-muted">Variantes possuem finalidade semântica, foco visível e área de toque adequada.</p>
        <div class="design-system__surface design-system__actions">
            @await Html.PartialAsync("_UiButton", new UiButtonViewModel("Salvar alterações"))
            @await Html.PartialAsync("_UiButton", new UiButtonViewModel("Voltar", Variant: "ghost"))
            @await Html.PartialAsync("_UiButton", new UiButtonViewModel("Ação secundária", Variant: "secondary"))
            @await Html.PartialAsync("_UiButton", new UiButtonViewModel("Excluir", Variant: "danger"))
            @await Html.PartialAsync("_UiButton", new UiButtonViewModel("Indisponível", Disabled: true))
            @await Html.PartialAsync("_StatusBadge", "Ativo")
            @await Html.PartialAsync("_StatusBadge", "Pendente")
            @await Html.PartialAsync("_StatusBadge", "Erro")
        </div>
    </section>

    <section class="design-system__section" id="indicadores">
        <h2 class="h4">Cards e KPIs</h2>
        <div class="design-system__grid">
            @await Html.PartialAsync("_KpiCard", new { Title = "Protocolos no prazo", Value = "128", Description = "Atualizado com dados do tenant" })
            @await Html.PartialAsync("_KpiCard", new { Title = "Pendências críticas", Value = "3", Description = "Requerem atenção hoje" })
            @await Html.PartialAsync("_ModuleCard", new ModuleCardViewModel("GED", "Gestão documental", "Documentos, versões e temporalidade.", "Ativo", "documents", "/Ged"))
        </div>
    </section>

    <section class="design-system__section" id="feedback">
        <h2 class="h4">Alertas, toast e modal</h2>
        <div class="design-system__grid">
            <div class="design-system__surface"><div class="alert alert-info mb-2" role="status"><strong>Informação:</strong> os filtros consideram o tenant atual.</div><div class="alert alert-warning mb-0" role="alert"><strong>Atenção:</strong> revise dados sigilosos antes de exportar.</div></div>
            <div class="design-system__surface design-system__actions"><button class="sigov-btn sigov-btn--primary" type="button" data-ds-toast>Exibir toast</button><button class="sigov-btn sigov-btn--ghost" type="button" data-bs-toggle="modal" data-bs-target="#designSystemModal">Abrir modal</button></div>
        </div>
    </section>

    <section class="design-system__section" id="formularios">
        <h2 class="h4">Formulários e filtros</h2>
        @await Html.PartialAsync("_FilterBar", filters)
        <form class="design-system__surface mt-3" method="post" action="/DesignSystem" onsubmit="return false">
            @Html.AntiForgeryToken()
            <div class="row g-3"><div class="col-md-6"><label class="form-label" for="ds-name">Nome do registro</label><input class="form-control" id="ds-name" required maxlength="120" aria-describedby="ds-name-help"><div class="form-text" id="ds-name-help">Use um nome claro e pesquisável.</div></div><div class="col-md-6"><label class="form-label" for="ds-status">Status</label><select class="form-select" id="ds-status"><option>Ativo</option><option>Pendente</option><option>Arquivado</option></select></div><div class="col-12"><label class="form-label" for="ds-notes">Observação</label><textarea class="form-control" id="ds-notes" rows="3"></textarea></div></div>
            <div class="design-system__actions mt-3"><button class="sigov-btn sigov-btn--primary" type="submit">Salvar</button><button class="sigov-btn sigov-btn--ghost" type="reset">Limpar</button></div>
        </form>
    </section>

    <section class="design-system__section" id="dados">
        <h2 class="h4">Tabela e timeline</h2>
        <div class="design-system__surface mb-3">
            @await Html.PartialAsync("_DataTableToolbar", new DataTableToolbarViewModel("Protocolos recentes", "Buscar nos resultados", "Novo protocolo", "/Protocolo/Novo"))
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th scope="col">Número</th><th scope="col">Assunto</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Ações</span></th></tr></thead><tbody><tr><td data-label="Número">2026/00128</td><td data-label="Assunto">Solicitação administrativa</td><td data-label="Status">@await Html.PartialAsync("_StatusBadge", "Em andamento")</td><td><a href="#">Abrir<span class="visually-hidden"> protocolo 2026/00128</span></a></td></tr></tbody></table></div>
        </div>
        <div class="design-system__surface">@await Html.PartialAsync("_Timeline", timeline)</div>
    </section>

    <section class="design-system__section" id="estados">
        <h2 class="h4">Empty state e carregamento</h2>
        <div class="design-system__grid">
            @await Component.InvokeAsync("EmptyState", new EmptyStateViewModel("Nenhum resultado", "Ajuste os filtros ou crie o primeiro registro.", "documents", "Criar registro", "/", "/Ajuda"))
            <div class="design-system__surface" aria-label="Conteúdo carregando" aria-busy="true"><span class="visually-hidden">Carregando</span><div class="sigov-skeleton-card mb-3"></div><div class="sigov-loading-skeleton design-system__skeleton-line"></div></div>
        </div>
    </section>

    <section class="design-system__section" id="aparencia">
        <h2 class="h4">Cores, tema e densidade</h2>
        <div class="design-system__grid mb-3"><div class="design-system__swatch design-system__swatch--primary">Primária</div><div class="design-system__swatch design-system__swatch--secondary">Secundária</div><div class="design-system__swatch bg-success">Sucesso</div><div class="design-system__swatch bg-danger">Crítico</div></div>
        <div class="design-system__surface design-system__actions"><button class="sigov-btn sigov-btn--ghost" type="button" data-ds-theme>Alternar tema</button><button class="sigov-btn sigov-btn--ghost" type="button" data-ds-density>Alternar densidade</button></div>
    </section>
</div>

<div class="modal fade" id="designSystemModal" tabindex="-1" aria-labelledby="designSystemModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="designSystemModalTitle">Confirmar operação</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body">Revise os dados antes de continuar. A ação será registrada na auditoria.</div><div class="modal-footer"><button type="button" class="sigov-btn sigov-btn--ghost" data-bs-dismiss="modal">Cancelar</button><button type="button" class="sigov-btn sigov-btn--primary" data-bs-dismiss="modal">Confirmar</button></div></div></div></div>

@section Scripts { <script src="~/js/sigov-design-system.js" asp-append-version="true"></script> }
