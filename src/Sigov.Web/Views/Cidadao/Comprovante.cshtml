@model Sigov.Application.Cidadao.CidadaoSolicitacao
@{ViewData["Title"]="Solicitação protocolada";}<partial name="_PortalHead"/><main class="cidadao-shell cidadao-section"><article class="receipt"><span class="receipt-icon">✓</span><span class="cidadao-kicker">Solicitação recebida</span><h1>Protocolo @Model.Protocolo</h1><p>Guarde o protocolo e o código verificador. O código protege sua consulta pública.</p><div class="receipt-code"><span>Código verificador</span><strong>@Model.CodigoVerificador</strong></div><dl><div><dt>Serviço</dt><dd>@Model.Servico</dd></div><div><dt>Status</dt><dd><span class="status-badge">@Model.Status.Replace('_',' ')</span></dd></div><div><dt>Prazo estimado</dt><dd>@Model.PrazoEm?.ToString("dd/MM/yyyy")</dd></div></dl><a class="primary-action" href="/Cidadao/MinhasSolicitacoes">Ver minhas solicitações</a></article></main>
