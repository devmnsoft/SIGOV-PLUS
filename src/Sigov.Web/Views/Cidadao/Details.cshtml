@model Sigov.Application.Cidadao.CidadaoServico
@{ViewData["Title"]=Model.Nome;}<partial name="_PortalHead"/><main class="cidadao-shell cidadao-section"><a href="/Cidadao/Servicos">← Voltar ao catálogo</a><article class="service-detail"><span class="service-category">@Model.Categoria.Replace('_',' ')</span><h1>@Model.Nome</h1><p class="lead">@Model.Descricao</p><div class="detail-facts"><div><strong>Prazo estimado</strong><span>@Model.PrazoDias dias</span></div><div><strong>Canal</strong><span>@Model.Canal</span></div><div><strong>Para quem</strong><span>@Model.PublicoAlvo</span></div><div><strong>Responsável</strong><span>@(Model.UnidadeResponsavel??"Consulte a entidade")</span></div></div><section><h2>O que é necessário</h2><p>@(Model.Requisitos??"Não há documentos adicionais informados.")</p></section><a class="primary-action" asp-action="Solicitar" asp-route-servico="@Model.Id">Começar solicitação</a></article></main>
