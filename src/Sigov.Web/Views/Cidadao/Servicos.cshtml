@model Sigov.Web.Models.Cidadao.CidadaoPortalViewModel
@{ViewData["Title"]="Catálogo de serviços";var categories=(string[]?)ViewBag.Categorias??[];}
<partial name="_PortalHead"/><main class="cidadao-shell cidadao-section"><span class="cidadao-kicker">Carta de serviços</span><h1>Encontre o serviço certo</h1>
<form method="get" class="catalog-filter"><div><label for="q">Buscar</label><input id="q" name="q" value="@Model.Busca" placeholder="Nome ou assunto" /></div><div><label for="categoria">Área</label><select id="categoria" name="categoria"><option value="">Todas as áreas</option>@foreach(var x in categories){<option value="@x" selected="@(Model.Categoria==x)">@x.Replace('_',' ')</option>}</select></div><button>Aplicar filtros</button></form>
<p class="result-count">@Model.Destaques.Count serviço(s) encontrado(s)</p><div class="service-grid">@foreach(var item in Model.Destaques){<article class="service-card"><span class="service-category">@item.Categoria.Replace('_',' ')</span><h2><a asp-action="Details" asp-route-id="@item.Id">@item.Nome</a></h2><p>@item.Descricao</p><dl><div><dt>Prazo</dt><dd>@item.PrazoDias dias</dd></div><div><dt>Atendimento</dt><dd>@item.Canal</dd></div></dl><a class="service-cta" asp-action="Details" asp-route-id="@item.Id">Ver orientações</a></article>}</div>@if(Model.Destaques.Count==0){<div class="cidadao-empty">Nenhum serviço corresponde aos filtros informados.</div>}</main>
