@model Sigov.Web.Models.Cidadao.CidadaoSolicitarViewModel
@{ViewData["Title"]="Nova solicitação";}<partial name="_PortalHead"/><main class="cidadao-shell cidadao-section"><span class="cidadao-kicker">Nova solicitação</span><h1>Conte o que você precisa</h1><ol class="stepper"><li class="done">Serviço</li><li class="active">Informações</li><li>Protocolo</li></ol>
<form method="post" class="citizen-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="Form.ServicoId"></label><select asp-for="Form.ServicoId" required><option value="">Escolha pelo nome do serviço</option>@foreach(var x in Model.Servicos){<option value="@x.Id">@x.Nome — @x.Canal</option>}</select><span asp-validation-for="Form.ServicoId"></span></div><div class="form-field"><label asp-for="Form.Descricao"></label><textarea asp-for="Form.Descricao" rows="6" placeholder="Explique sua necessidade sem incluir dados pessoais desnecessários."></textarea><span asp-validation-for="Form.Descricao"></span></div><div class="form-row"><div class="form-field"><label asp-for="Form.Email"></label><input asp-for="Form.Email" autocomplete="email"/><span asp-validation-for="Form.Email"></span></div><div class="form-field"><label asp-for="Form.Telefone"></label><input asp-for="Form.Telefone" autocomplete="tel"/><span asp-validation-for="Form.Telefone"></span></div></div><div class="privacy-box"><input asp-for="Form.AceiteLgpd"/><label asp-for="Form.AceiteLgpd"></label><p>Finalidade: receber, instruir e comunicar o andamento da solicitação. Coletamos apenas os dados necessários.</p><span asp-validation-for="Form.AceiteLgpd"></span></div><button class="primary-action" type="submit">Protocolar solicitação</button>@Html.AntiForgeryToken()</form></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
