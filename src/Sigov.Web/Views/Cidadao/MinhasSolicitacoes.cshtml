@model IReadOnlyList<Sigov.Application.Cidadao.CidadaoSolicitacao>
@{ViewData["Title"]="Minhas solicitações";}<partial name="_PortalHead"/><main class="cidadao-shell cidadao-section"><span class="cidadao-kicker">Área do cidadão</span><h1>Minhas solicitações</h1>@if(Model.Count==0){<div class="cidadao-empty"><strong>Você ainda não possui solicitações.</strong><p>Explore o catálogo para iniciar um atendimento.</p><a href="/Cidadao/Servicos">Ver serviços</a></div>}else{<div class="responsive-table"><table><thead><tr><th>Protocolo</th><th>Serviço</th><th>Status</th><th>Prazo</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Protocolo</strong></td><td>@x.Servico</td><td><span class="status-badge">@x.Status.Replace('_',' ')</span></td><td>@x.PrazoEm?.ToString("dd/MM/yyyy")</td></tr>}</tbody></table></div>}</main>
