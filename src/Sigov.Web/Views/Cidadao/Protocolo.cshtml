@model Sigov.Web.Models.Cidadao.ConsultaProtocoloViewModel
@{ViewData["Title"]="Consultar protocolo";}<partial name="_PortalHead"/><main class="cidadao-shell cidadao-section narrow"><span class="cidadao-kicker">Acompanhamento seguro</span><h1>Consulte seu protocolo</h1><p>Informe os dois códigos exibidos no comprovante. Nenhum dado pessoal será exibido sem validação.</p><form method="post" class="citizen-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="Protocolo"></label><input asp-for="Protocolo" autocomplete="off"/><span asp-validation-for="Protocolo"></span></div><div class="form-field"><label asp-for="Verificador"></label><input asp-for="Verificador" autocomplete="off"/><span asp-validation-for="Verificador"></span></div><button class="primary-action">Consultar andamento</button>@Html.AntiForgeryToken()</form>@if(Model.Resultado is not null){<section class="timeline-card"><h2>@Model.Resultado.Servico</h2><p><span class="status-badge">@Model.Resultado.Status.Replace('_',' ')</span></p><ol class="timeline">@foreach(var x in Model.Resultado.Historico??[]){<li><span></span><div><strong>@x.Status.Replace('_',' ')</strong><p>@x.Descricao</p><time>@x.RegistradoEm.ToString("dd/MM/yyyy HH:mm")</time></div></li>}</ol></section>}</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
