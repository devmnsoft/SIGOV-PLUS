{
  "Sigov": {
    "ApiBaseUrl": "http://api:8080",
    "Brand": {
      "Name": "SIGOV"
    },
    "ReleaseChannel": "dev"
  },
  "Storage": {
    "Local": {
      "RootPath": "/app/storage"
    }
  },
  "OcrWorker": {
    "Enabled": false
  },
  "PreviewWorker": {
    "Enabled": false
  },
  "Workers": {
    "LoanOverdue": {
      "Enabled": false
    }
  },
  "Database": {
    "ValidateSchemaOnStartup": true,
    "FailFastOnInvalidSchema": false,
    "DisableWorkersWhenSchemaInvalid": true
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "sigov-web"
    }
  }
}
